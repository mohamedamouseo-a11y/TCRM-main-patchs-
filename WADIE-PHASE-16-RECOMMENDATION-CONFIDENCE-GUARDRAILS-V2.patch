+function score(value: number | null | undefined) {
+  return value === null || value === undefined ? "—" : `${value.toFixed(1)}/100`;
+}
+
+function pct(value: number | null | undefined) {
+  return value === null || value === undefined ? "—" : `${value.toFixed(1)}%`;
+}
+
+function variantFor(advisory: string): "destructive" | "secondary" | "outline" {
+  if (advisory === "caution") return "destructive";
+  if (advisory === "promising") return "secondary";
+  return "outline";
+}
+
+export default function WadieRecommendationGuardrails() {
+  const { isRTL } = useLanguage();
+  const text = (en: string, ar: string) => (isRTL ? ar : en);
+  const query = trpc.wadie.recommendationGuardrails.useQuery(undefined, {
