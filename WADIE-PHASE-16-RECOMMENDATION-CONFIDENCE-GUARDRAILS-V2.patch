+import { getWadieRecommendationEffectiveness } from "./wadieRecommendationEffectivenessService";
+
+type SegmentKind = "platform" | "priority" | "category" | "account";
+type EvidenceBand = "insufficient" | "emerging" | "established";
+type Advisory = "insufficient-evidence" | "caution" | "mixed" | "promising";
+
+type EffectivenessRow = {
+  key: string;
+  tracked: number;
+  reviewed: number;
+  improved: number;
+  neutral: number;
+  worse: number;
+  inconclusive: number;
+  reviewCoveragePct: number;
+  qualityScore: number | null;
+  improvedRatePct: number | null;
+};
+
+function evidenceBand(reviewed: number): EvidenceBand {
+  if (reviewed < 3) return "insufficient";
+  if (reviewed < 8) return "emerging";
+  return "established";
+}
+
+function roundPct(value: number) {
+  return Math.round(value * 10) / 10;
+}
+
+function advisoryFor(row: EffectivenessRow): Advisory {
+  if (row.reviewed < 3) return "insufficient-evidence";
+  const worseRatePct = row.reviewed ? (row.worse / row.reviewed) * 100 : 0;
+  if ((row.qualityScore ?? 0) < 45 || worseRatePct >= 35) return "caution";
+  if (row.reviewed >= 5 && (row.qualityScore ?? 0) >= 75 && (row.improvedRatePct ?? 0) >= 60) return "promising";
+  return "mixed";
+}
+
+function guidanceFor(advisory: Advisory) {
+  switch (advisory) {
+    case "promising":
+      return "Outcome history is promising. Keep human review and continue collecting evidence before changing policy.";
+    case "caution":
+      return "Outcome history needs human attention. Review recommendation quality before approving similar future actions.";
+    case "mixed":
+      return "Outcome history is mixed. Keep normal human review and gather more reviewed outcomes.";
+    default:
+      return "Evidence is insufficient. Do not infer recommendation quality from this segment yet.";
+  }
+}
+
+function toSegments(kind: SegmentKind, rows: EffectivenessRow[]) {
+  return rows.map((row) => {
+    const advisory = advisoryFor(row);
+    return {
+      kind,
+      key: row.key,
+      tracked: row.tracked,
+      reviewed: row.reviewed,
+      improved: row.improved,
+      neutral: row.neutral,
+      worse: row.worse,
+      inconclusive: row.inconclusive,
+      reviewCoveragePct: row.reviewCoveragePct,
+      qualityScore: row.qualityScore,
+      improvedRatePct: row.improvedRatePct,
+      worseRatePct: row.reviewed ? roundPct((row.worse / row.reviewed) * 100) : null,
+      evidenceBand: evidenceBand(row.reviewed),
+      advisory,
+      guidance: guidanceFor(advisory),
+    };
+  });
+}
+
+function attentionWeight(advisory: Advisory) {
+  switch (advisory) {
+    case "caution": return 4;
+    case "insufficient-evidence": return 3;
+    case "mixed": return 2;
+    case "promising": return 1;
+  }
+}
+
+export async function getWadieRecommendationGuardrails() {
+  const analytics = await getWadieRecommendationEffectiveness();
+  const segments = [
+    ...toSegments("platform", analytics.byPlatform),
+    ...toSegments("priority", analytics.byPriority),
+    ...toSegments("category", analytics.byCategory),
+    ...toSegments("account", analytics.byAccount),
+  ].sort((a, b) =>
+    attentionWeight(b.advisory) - attentionWeight(a.advisory)
+    || b.reviewed - a.reviewed
+    || String(a.key).localeCompare(String(b.key)),
+  );
+
+  return {
+    phase: "recommendation-confidence-guardrails-v1" as const,
+    mode: "read-only-human-decision-support" as const,
+    thresholds: {
+      minimumReviewedForSignal: 3,
+      establishedEvidenceReviewed: 8,
+      cautionQualityScoreBelow: 45,
+      cautionWorseRatePctAtOrAbove: 35,
+      promisingQualityScoreAtOrAbove: 75,
+      promisingImprovedRatePctAtOrAbove: 60,
+      promisingMinimumReviewed: 5,
+    },
+    totals: {
+      segments: segments.length,
+      insufficientEvidence: segments.filter((item) => item.advisory === "insufficient-evidence").length,
+      caution: segments.filter((item) => item.advisory === "caution").length,
+      mixed: segments.filter((item) => item.advisory === "mixed").length,
+      promising: segments.filter((item) => item.advisory === "promising").length,
+      establishedEvidence: segments.filter((item) => item.evidenceBand === "established").length,
+    },
+    segments: segments.slice(0, 100),
+    attention: segments.filter((item) => item.advisory === "caution").slice(0, 20),
+    generatedAt: new Date().toISOString(),
+    source: "phase15-recommendation-effectiveness-analytics" as const,
+    localMetadataWritesApplied: false as const,
+    liveMcpCallsApplied: false as const,
+    adPlatformMutationsApplied: false as const,
+    automaticOptimizationLearningApplied: false as const,
+    automaticExecutionPolicyChangesApplied: false as const,
+    executionStillRequiresHumanApproval: true as const,
+  };
+}
