+                [text("Caution", "تحتاج حذر"), data.totals.caution],
+                [text("Mixed", "مختلطة"), data.totals.mixed],
+                [text("Promising", "واعدة"), data.totals.promising],
+                [text("Insufficient evidence", "أدلة غير كافية"), data.totals.insufficientEvidence],
+              ].map(([label, value]) => (
+                <div key={String(label)} className="rounded-xl border border-border/60 bg-background/55 p-3">
+                  <p className="text-[10px] font-black uppercase tracking-[0.08em] text-muted-foreground">{label}</p>
