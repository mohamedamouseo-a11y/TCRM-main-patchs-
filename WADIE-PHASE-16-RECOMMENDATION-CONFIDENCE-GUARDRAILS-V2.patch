+                  <AlertTriangle className="h-4 w-4 text-destructive" />
+                  {text("Human attention", "تحتاج مراجعة بشرية")}
+                </p>
+                <div className="grid gap-2 lg:grid-cols-2">
+                  {data.attention.slice(0, 6).map((item) => (
+                    <div key={`${item.kind}:${item.key}`} className="rounded-xl border border-border/60 bg-card px-3 py-2.5">
+                      <div className="flex flex-wrap items-center gap-2">
+                        <Badge variant="outline" className="rounded-full text-[10px]">{kindLabel(item.kind)}</Badge>
+                        <span className="text-xs font-black">{item.key}</span>
+                      </div>
+                      <p className="mt-1 text-[10px] font-semibold text-muted-foreground">{item.guidance}</p>
+                    </div>
+                  ))}
+                </div>
+              </div>
+            )}
