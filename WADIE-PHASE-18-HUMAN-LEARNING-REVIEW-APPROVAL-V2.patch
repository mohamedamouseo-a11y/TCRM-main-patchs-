+import { mkdir, readFile, rename, writeFile } from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { getWadieLearningCandidates } from "./wadieLearningCandidateService";
+
+export type WadieLearningReviewDecision = "approved" | "rejected" | "needs-revision" | "observing";
+
+type WadieLearningReviewEntry = {
+  candidateId: string;
+  kind: "platform" | "priority" | "category" | "account";
+  key: string;
+  decision: WadieLearningReviewDecision;
+  note: string;
+  reviewedAt: string;
+  reviewedBy: string;
+};
+
+type LearningReviewFile = {
+  version: 1;
+  items: WadieLearningReviewEntry[];
+};
+
+function storagePath() {
+  const configured = String(process.env.WADIE_LEARNING_REVIEW_FILE || "").trim();
+  if (configured) return path.resolve(configured);
+  return path.join(os.homedir(), ".tcrm", "wadie-learning-reviews.json");
+}
+
+function candidateId(kind: string, key: string) {
+  return `${kind}:${key}`;
+}
+
+function cleanText(value: unknown, max: number) {
+  return String(value ?? "").trim().replace(/\s+/g, " ").slice(0, max);
+}
+
+async function readStore(): Promise<LearningReviewFile> {
+  try {
+    const parsed = JSON.parse(await readFile(storagePath(), "utf8"));
+    return { version: 1, items: Array.isArray(parsed?.items) ? parsed.items : [] };
+  } catch (error: any) {
+    if (error?.code === "ENOENT") return { version: 1, items: [] };
+    throw error;
+  }
+}
+
+async function writeStore(store: LearningReviewFile) {
+  const file = storagePath();
+  await mkdir(path.dirname(file), { recursive: true, mode: 0o700 });
+  const temp = `${file}.${process.pid}.${Date.now()}.tmp`;
+  await writeFile(temp, `${JSON.stringify(store, null, 2)}\n`, { encoding: "utf8", mode: 0o600 });
+  await rename(temp, file);
+}
+
+export async function getWadieLearningReviewSnapshot() {
+  const [source, store] = await Promise.all([
+    getWadieLearningCandidates(),
+    readStore(),
+  ]);
+  const reviewById = new Map(store.items.map((item) => [item.candidateId, item]));
+
+  const candidates = source.candidates.map((candidate) => {
+    const id = candidateId(candidate.kind, candidate.key);
+    const review = reviewById.get(id) ?? null;
+    return {
+      ...candidate,
+      candidateId: id,
+      reviewStatus: review?.decision ?? "pending" as const,
+      reviewNote: review?.note ?? "",
+      reviewedAt: review?.reviewedAt ?? null,
+      reviewedBy: review?.reviewedBy ?? null,
+    };
+  });
+
+  return {
+    phase: "human-learning-review-approval-v1" as const,
+    mode: "local-human-governed-learning-review" as const,
+    totals: {
+      candidates: candidates.length,
+      pending: candidates.filter((item) => item.reviewStatus === "pending").length,
+      approved: candidates.filter((item) => item.reviewStatus === "approved").length,
+      rejected: candidates.filter((item) => item.reviewStatus === "rejected").length,
+      needsRevision: candidates.filter((item) => item.reviewStatus === "needs-revision").length,
+      observing: candidates.filter((item) => item.reviewStatus === "observing").length,
+    },
+    candidates: candidates.slice(0, 100),
+    priorityReview: candidates
+      .filter((item) => item.reviewStatus === "pending" || item.reviewStatus === "needs-revision")
+      .slice(0, 24),
+    generatedAt: new Date().toISOString(),
+    source: "phase17-human-learning-candidates" as const,
+    humanReviewRequired: true as const,
+    reviewPersistenceLocalOnly: true as const,
+    learningMemoryWritesApplied: false as const,
+    approvedCandidatesAppliedToOptimization: false as const,
+    liveMcpCallsApplied: false as const,
+    adPlatformMutationsApplied: false as const,
+    automaticOptimizationLearningApplied: false as const,
+    automaticExecutionPolicyChangesApplied: false as const,
+    executionStillRequiresHumanApproval: true as const,
+  };
+}
+
+export async function recordWadieLearningReview(input: {
+  kind: "platform" | "priority" | "category" | "account";
+  key: string;
+  decision: WadieLearningReviewDecision;
+  note?: string;
+}, actorUserId: string) {
+  const [source, store] = await Promise.all([
+    getWadieLearningCandidates(),
+    readStore(),
+  ]);
+  const key = cleanText(input.key, 160);
+  const candidate = source.candidates.find((item) => item.kind === input.kind && item.key === key);
+  if (!candidate) throw new Error("Wadie learning candidate not found in current Phase 17 snapshot");
+
+  const id = candidateId(input.kind, key);
+  const entry: WadieLearningReviewEntry = {
+    candidateId: id,
+    kind: input.kind,
+    key,
+    decision: input.decision,
+    note: cleanText(input.note, 600),
+    reviewedAt: new Date().toISOString(),
+    reviewedBy: String(actorUserId || "unknown"),
+  };
+
+  const existing = store.items.findIndex((item) => item.candidateId === id);
+  if (existing >= 0) store.items[existing] = entry;
+  else store.items.push(entry);
+  store.items = store.items.slice(-1000);
+  await writeStore(store);
+
+  return getWadieLearningReviewSnapshot();
+}
+
+export function getWadieLearningReviewStorageInfo() {
+  return {
+    path: storagePath(),
+    containsCredentials: false,
+    localMetadataOnly: true,
+    learningMemoryWritesApplied: false,
+    adPlatformMutationsApplied: false,
+  };
+}
