+import { useState } from "react";
+import { Activity, Brain, CheckCircle2, Eye, RotateCcw, ShieldCheck, XCircle } from "lucide-react";
+import { Badge } from "@/components/ui/badge";
+import { Button } from "@/components/ui/button";
+import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
+import { Input } from "@/components/ui/input";
+import { useLanguage } from "@/contexts/LanguageContext";
+import { trpc } from "@/lib/trpc";
+
+type ReviewDecision = "approved" | "rejected" | "needs-revision" | "observing";
+
+function variantFor(status: string): "destructive" | "secondary" | "outline" {
+  if (status === "rejected") return "destructive";
+  if (status === "approved") return "secondary";
+  return "outline";
+}
+
+export default function WadieLearningReview() {
+  const { isRTL } = useLanguage();
+  const text = (en: string, ar: string) => (isRTL ? ar : en);
+  const [notes, setNotes] = useState<Record<string, string>>({});
+  const query = trpc.wadie.learningReview.useQuery(undefined, {
+    refetchOnWindowFocus: false,
+    refetchInterval: 60_000,
+  });
+  const recordReview = trpc.wadie.recordLearningReview.useMutation({
+    onSuccess: () => void query.refetch(),
+  });
+  const data = query.data;
+
+  const decisionLabel = (value: string) => {
+    if (value === "approved") return text("Approved", "معتمد");
+    if (value === "rejected") return text("Rejected", "مرفوض");
+    if (value === "needs-revision") return text("Needs revision", "يحتاج تعديل");
+    if (value === "observing") return text("Keep observing", "استمرار المراقبة");
+    return text("Pending review", "بانتظار المراجعة");
+  };
+
+  const submit = (item: any, decision: ReviewDecision) => {
+    recordReview.mutate({
+      kind: item.kind,
+      key: item.key,
+      decision,
+      note: notes[item.candidateId]?.trim() || undefined,
+    });
+  };
+
+  return (
+    <Card data-wadie-learning-review="phase18-v1" className="rounded-2xl border-border/70 bg-card shadow-[0_14px_34px_-28px_rgba(15,23,42,0.72)]">
+      <CardHeader className="pb-3">
+        <div className="flex flex-wrap items-center justify-between gap-3">
+          <div>
+            <CardTitle className="flex items-center gap-2 text-xl">
+              <Brain className="h-5 w-5 text-violet-600" />
+              {text("Human Learning Review & Approval", "مراجعة واعتماد التعلم البشري")}
+            </CardTitle>
+            <p className="mt-1 text-xs font-semibold text-muted-foreground">
+              {text(
+                "Review Phase 17 candidates and record a human disposition. Approval does not activate learning or change execution behavior.",
+                "راجع مرشحات Phase 17 وسجّل القرار البشري. الاعتماد لا يفعّل التعلم ولا يغيّر سلوك التنفيذ.",
+              )}
+            </p>
+          </div>
+          <div className="flex flex-wrap gap-2">
+            <Badge variant="outline" className="rounded-full px-3 py-1 font-bold">
+              <ShieldCheck className="me-1 h-3.5 w-3.5 text-emerald-500" />
+              {text("Human decision only", "قرار بشري فقط")}
+            </Badge>
+            <Button variant="outline" size="sm" className="h-9 rounded-xl font-bold" disabled={query.isFetching} onClick={() => void query.refetch()}>
+              <Activity className={`me-2 h-4 w-4 ${query.isFetching ? "animate-spin" : ""}`} />
+              {text("Refresh review", "تحديث المراجعة")}
+            </Button>
+          </div>
+        </div>
+      </CardHeader>
+
+      <CardContent className="space-y-4">
+        {data && (
+          <>
+            <div className="grid grid-cols-2 gap-2 md:grid-cols-6">
+              {[
+                [text("Candidates", "المرشحات"), data.totals.candidates],
+                [text("Pending", "قيد المراجعة"), data.totals.pending],
+                [text("Approved", "معتمد"), data.totals.approved],
+                [text("Rejected", "مرفوض"), data.totals.rejected],
+                [text("Needs revision", "يحتاج تعديل"), data.totals.needsRevision],
+                [text("Observing", "مراقبة"), data.totals.observing],
+              ].map(([label, value]) => (
+                <div key={String(label)} className="rounded-xl border border-border/60 bg-background/55 p-3">
+                  <p className="text-[10px] font-black uppercase tracking-[0.08em] text-muted-foreground">{label}</p>
+                  <p className="mt-1 text-lg font-black">{value}</p>
+                </div>
+              ))}
+            </div>
+
+            <div className="space-y-3">
+              {data.candidates.slice(0, 24).map((item) => (
+                <div key={item.candidateId} className="rounded-2xl border border-border/60 bg-background/45 p-4">
+                  <div className="flex flex-wrap items-center justify-between gap-2">
+                    <div className="min-w-0">
+                      <div className="flex flex-wrap items-center gap-2">
+                        <Badge variant="outline" className="rounded-full text-[10px]">{item.kind}</Badge>
+                        <span className="truncate text-xs font-black">{item.key}</span>
+                        <Badge variant={variantFor(item.reviewStatus)} className="rounded-full text-[10px]">
+                          {decisionLabel(item.reviewStatus)}
+                        </Badge>
+                      </div>
+                      <p className="mt-1 text-[10px] font-semibold text-muted-foreground">{item.rationale}</p>
+                    </div>
+                    <div className="text-end text-[10px] font-semibold text-muted-foreground">
+                      <div>{text("Reviewed outcomes", "نتائج تمت مراجعتها")}: {item.reviewed}</div>
+                      {item.reviewedAt && <div>{text("Human review recorded", "تم تسجيل المراجعة البشرية")}</div>}
+                    </div>
+                  </div>
+
+                  <div className="mt-3 grid gap-2 lg:grid-cols-[1fr_auto]">
+                    <Input
+                      value={notes[item.candidateId] ?? item.reviewNote ?? ""}
+                      onChange={(event) => setNotes((current) => ({ ...current, [item.candidateId]: event.target.value }))}
+                      maxLength={600}
+                      placeholder={text("Optional human review note", "ملاحظة مراجعة بشرية اختيارية")}
+                      className="h-9 rounded-xl text-xs"
+                    />
+                    <div className="flex flex-wrap gap-2">
+                      <Button size="sm" variant="outline" className="h-9 rounded-xl border-emerald-500/30 text-emerald-700 dark:text-emerald-300" disabled={recordReview.isPending} onClick={() => submit(item, "approved")}>
+                        <CheckCircle2 className="me-1.5 h-3.5 w-3.5" />{text("Approve", "اعتماد")}
+                      </Button>
+                      <Button size="sm" variant="outline" className="h-9 rounded-xl border-amber-500/30 text-amber-700 dark:text-amber-300" disabled={recordReview.isPending} onClick={() => submit(item, "needs-revision")}>
+                        <RotateCcw className="me-1.5 h-3.5 w-3.5" />{text("Needs revision", "يحتاج تعديل")}
+                      </Button>
+                      <Button size="sm" variant="outline" className="h-9 rounded-xl border-sky-500/30 text-sky-700 dark:text-sky-300" disabled={recordReview.isPending} onClick={() => submit(item, "observing")}>
+                        <Eye className="me-1.5 h-3.5 w-3.5" />{text("Observe", "مراقبة")}
+                      </Button>
+                      <Button size="sm" variant="outline" className="h-9 rounded-xl border-destructive/30 text-destructive" disabled={recordReview.isPending} onClick={() => submit(item, "rejected")}>
+                        <XCircle className="me-1.5 h-3.5 w-3.5" />{text("Reject", "رفض")}
+                      </Button>
+                    </div>
+                  </div>
+                </div>
+              ))}
+            </div>
+
+            {data.candidates.length === 0 && (
+              <div className="rounded-xl border border-dashed border-border px-4 py-5 text-center text-xs font-semibold text-muted-foreground">
+                {text("No Phase 17 learning candidates are available for review yet.", "لا توجد مرشحات Phase 17 متاحة للمراجعة حتى الآن.")}
+              </div>
+            )}
+          </>
+        )}
+
+        {recordReview.error && <p className="text-xs font-semibold text-destructive">{recordReview.error.message}</p>}
+        {query.error && <p className="text-xs font-semibold text-destructive">{query.error.message}</p>}
+
+        <p className="text-[10px] font-semibold text-muted-foreground">
+          {text(
+            "Phase 18 stores only the human review decision as local metadata. Approved candidates are not written to learning memory, are not applied to optimization, call no MCP tools, change no ad platform, and never change execution policy automatically.",
+            "Phase 18 يحفظ قرار المراجعة البشرية كبيانات محلية فقط. المرشحات المعتمدة لا تُكتب في ذاكرة تعلم، ولا تُطبق على التحسين، ولا تستدعي MCP، ولا تعدل منصات الإعلانات، ولا تغيّر سياسة التنفيذ تلقائياً.",
+          )}
+        </p>
+      </CardContent>
+    </Card>
+  );
+}
