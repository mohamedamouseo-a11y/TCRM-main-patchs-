+++ b/server/utils/searchNormalizationSql.ts
@@ -0,0 +1,61 @@
+import { sql } from "drizzle-orm";
+import { normalizeSearchText } from "@shared/searchNormalization";
+
+// Mirrors the character-level transformations in shared/searchNormalization.
+// Using SQL-side normalization means a normalized query can still match legacy
+// rows that were stored before smart search existed.
+const SQL_SEARCH_REPLACEMENTS: Array<[string, string]> = [
+  ["أ", "ا"],
+  ["إ", "ا"],
+  ["آ", "ا"],
+  ["ٱ", "ا"],
+  ["ى", "ي"],
+  ["ؤ", "و"],
+  ["ئ", "ي"],
+  ["ة", "ه"],
+  ["ـ", ""],
+  ["ً", ""],
+  ["ٌ", ""],
+  ["ٍ", ""],
+  ["َ", ""],
+  ["ُ", ""],
+  ["ِ", ""],
+  ["ّ", ""],
+  ["ْ", ""],
+  ["ٰ", ""],
+  ["٠", "0"],
+  ["١", "1"],
+  ["٢", "2"],
+  ["٣", "3"],
+  ["٤", "4"],
+  ["٥", "5"],
+  ["٦", "6"],
+  ["٧", "7"],
+  ["٨", "8"],
+  ["٩", "9"],
+  ["۰", "0"],
+  ["۱", "1"],
+  ["۲", "2"],
+  ["۳", "3"],
+  ["۴", "4"],
+  ["۵", "5"],
+  ["۶", "6"],
+  ["۷", "7"],
+  ["۸", "8"],
+  ["۹", "9"],
+  ["  ", " "],
+  ["  ", " "],
+];
+
+export function normalizedSearchColumn(column: any) {
+  let expression = sql<string>`LOWER(TRIM(COALESCE(${column}, '')))`;
+  for (const [from, to] of SQL_SEARCH_REPLACEMENTS) {
+    expression = sql<string>`REPLACE(${expression}, ${from}, ${to})`;
+  }
+  return expression;
+}
+
+export function normalizedContains(column: any, query: unknown) {
+  const normalized = normalizeSearchText(query);
+  return sql`${normalizedSearchColumn(column)} LIKE ${`%${normalized}%`}`;
+}
