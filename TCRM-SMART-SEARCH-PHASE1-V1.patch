@@ -0,0 +1,33 @@
+import { describe, expect, it } from "vitest";
+import { isSearchReady, normalizeSearchText } from "./searchNormalization";
+
+describe("search normalization", () => {
+  it("treats common Arabic alef forms as equivalent", () => {
+    expect(normalizeSearchText("الأمل")).toBe("الامل");
+    expect(normalizeSearchText("الإمل")).toBe("الامل");
+    expect(normalizeSearchText("آمال")).toBe("امال");
+  });
+
+  it("removes Arabic diacritics and tatweel", () => {
+    expect(normalizeSearchText("مُحَمَّــد")).toBe("محمد");
+  });
+
+  it("normalizes ya, hamza carriers, and taa marbuta for tolerant matching", () => {
+    expect(normalizeSearchText("هدى")).toBe("هدي");
+    expect(normalizeSearchText("بيئة")).toBe("بييه");
+    expect(normalizeSearchText("رؤوف")).toBe("رووف");
+  });
+
+  it("normalizes Arabic and Persian digits", () => {
+    expect(normalizeSearchText("٠١٢٣ ۴۵۶")).toBe("0123 456");
+  });
+
+  it("normalizes English case and repeated whitespace", () => {
+    expect(normalizeSearchText("  SEO   Campaign  ")).toBe("seo campaign");
+  });
+
+  it("uses normalized length for search readiness", () => {
+    expect(isSearchReady(" أ ")).toBe(false);
+    expect(isSearchReady(" أم ")).toBe(true);
+  });
+});
