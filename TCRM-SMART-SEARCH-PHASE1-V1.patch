+/**
+ * Canonical search normalization shared by the browser and server.
+ *
+ * Keep this intentionally deterministic: voice transcripts and typed queries
+ * must enter the exact same search pipeline.
+ */
+const ARABIC_DIACRITICS =
+  /[\u0610-\u061a\u064b-\u065f\u0670\u06d6-\u06ed]/g;
+
+const ARABIC_INDIC_DIGITS = "٠١٢٣٤٥٦٧٨٩";
+const EASTERN_ARABIC_DIGITS = "۰۱۲۳۴۵۶۷۸۹";
+
+function normalizeDigit(char: string) {
+  const arabicIndic = ARABIC_INDIC_DIGITS.indexOf(char);
+  if (arabicIndic >= 0) return String(arabicIndic);
+  const easternArabic = EASTERN_ARABIC_DIGITS.indexOf(char);
+  if (easternArabic >= 0) return String(easternArabic);
+  return char;
+}
+
+export function normalizeSearchText(value: unknown): string {
+  return String(value ?? "")
+    .normalize("NFKC")
+    .toLocaleLowerCase("en-US")
+    .replace(ARABIC_DIACRITICS, "")
+    .replace(/\u0640/g, "")
+    .replace(/[أإآٱ]/g, "ا")
+    .replace(/ى/g, "ي")
+    .replace(/ؤ/g, "و")
+    .replace(/ئ/g, "ي")
+    .replace(/ة/g, "ه")
+    .replace(/[٠-٩۰-۹]/g, normalizeDigit)
+    .replace(/\s+/g, " ")
+    .trim();
+}
+
+export function isSearchReady(value: unknown, minLength = 2): boolean {
+  return normalizeSearchText(value).length >= minLength;
+}
+
+export const SEARCH_NORMALIZATION_VERSION = "tcrm-smart-search-v1";
