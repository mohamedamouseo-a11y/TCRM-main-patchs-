@@ -0,0 +1,137 @@
+import { useEffect, useRef, useState } from "react";
+import { Mic, MicOff } from "lucide-react";
+import { toast } from "sonner";
+import { cn } from "@/lib/utils";
+
+type VoiceSearchLabels = {
+  start: string;
+  listening: string;
+  unsupported: string;
+  error: string;
+};
+
+type VoiceSearchButtonProps = {
+  language: string;
+  onTranscript: (transcript: string) => void;
+  labels: VoiceSearchLabels;
+  className?: string;
+};
+
+function getSpeechRecognitionConstructor() {
+  if (typeof window === "undefined") return null;
+  const w = window as any;
+  return w.SpeechRecognition || w.webkitSpeechRecognition || null;
+}
+
+export default function VoiceSearchButton({
+  language,
+  onTranscript,
+  labels,
+  className,
+}: VoiceSearchButtonProps) {
+  const recognitionRef = useRef<any>(null);
+  const [listening, setListening] = useState(false);
+  const [supported, setSupported] = useState(() =>
+    typeof window === "undefined"
+      ? true
+      : Boolean(getSpeechRecognitionConstructor())
+  );
+
+  useEffect(() => {
+    setSupported(Boolean(getSpeechRecognitionConstructor()));
+    return () => {
+      try {
+        recognitionRef.current?.abort?.();
+      } catch {
+        // Browser speech implementations may throw during teardown.
+      }
+      recognitionRef.current = null;
+    };
+  }, []);
+
+  const stopListening = () => {
+    try {
+      recognitionRef.current?.stop?.();
+    } catch {
+      setListening(false);
+    }
+  };
+
+  const startListening = () => {
+    if (listening) {
+      stopListening();
+      return;
+    }
+
+    const SpeechRecognitionCtor = getSpeechRecognitionConstructor();
+    if (!SpeechRecognitionCtor) {
+      setSupported(false);
+      toast.error(labels.unsupported);
+      return;
+    }
+
+    try {
+      const recognition = new SpeechRecognitionCtor();
+      recognition.lang = language;
+      recognition.continuous = false;
+      recognition.interimResults = false;
+      recognition.maxAlternatives = 1;
+
+      recognition.onstart = () => setListening(true);
+      recognition.onresult = (event: any) => {
+        const transcript = Array.from(event?.results ?? [])
+          .map((result: any) => result?.[0]?.transcript ?? "")
+          .join(" ")
+          .trim();
+        if (transcript) onTranscript(transcript);
+      };
+      recognition.onerror = (event: any) => {
+        setListening(false);
+        if (event?.error !== "aborted") toast.error(labels.error);
+      };
+      recognition.onend = () => {
+        setListening(false);
+        if (recognitionRef.current === recognition) {
+          recognitionRef.current = null;
+        }
+      };
+
+      recognitionRef.current = recognition;
+      recognition.start();
+    } catch {
+      setListening(false);
+      recognitionRef.current = null;
+      toast.error(labels.error);
+    }
+  };
+
+  return (
+    <button
+      type="button"
+      onClick={startListening}
+      disabled={!supported}
+      aria-label={listening ? labels.listening : labels.start}
+      aria-pressed={listening}
+      title={
+        supported
+          ? listening
+            ? labels.listening
+            : labels.start
+          : labels.unsupported
+      }
+      className={cn(
+        "relative z-10 inline-flex h-8 w-8 items-center justify-center rounded-full text-muted-foreground transition",
+        "hover:bg-primary/10 hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/40",
+        "disabled:cursor-not-allowed disabled:opacity-35",
+        listening && "bg-primary/10 text-primary",
+        className
+      )}
+    >
+      {listening ? (
+        <MicOff className="h-4 w-4" />
+      ) : (
+        <Mic className="h-4 w-4" />
+      )}
+    </button>
+  );
+}
