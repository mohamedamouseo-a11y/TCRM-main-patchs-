--- /dev/null
+++ b/client/src/leads-filters-premium-v3.css
@@ -0,0 +1,116 @@
+/* TCRM_LEADS_FILTERS_PREMIUM_V3
+   Fix desktop spacing collisions and strengthen Search UX.
+   Presentation only. No filter/query behavior changes. */
+
+@media (min-width: 1181px) {
+  .tcrm-leads-filter-grid {
+    grid-template-columns: repeat(20, minmax(0, 1fr)) !important;
+    column-gap: 18px !important;
+    row-gap: 14px !important;
+  }
+
+  .tcrm-leads-filter-grid > div:not(.tcrm-leads-filter-actions) {
+    grid-column: span 2 !important;
+  }
+
+  .tcrm-leads-filter-grid > .tcrm-leads-filter-search {
+    grid-column: span 6 !important;
+    min-width: 0 !important;
+  }
+
+  .tcrm-leads-filter-grid > .tcrm-leads-filter-date {
+    grid-column: span 4 !important;
+    min-width: 0 !important;
+  }
+
+  .tcrm-leads-filter-grid > .tcrm-leads-filter-stage {
+    grid-column: span 2 !important;
+    min-width: 0 !important;
+  }
+
+  .tcrm-leads-filter-grid > div:nth-last-child(2) {
+    grid-column: span 6 !important;
+  }
+
+  .tcrm-leads-filter-actions {
+    grid-column: span 8 !important;
+    gap: 10px !important;
+  }
+}
+
+.tcrm-leads-filter-search > div {
+  position: relative;
+}
+
+.tcrm-leads-filter-search input {
+  height: 42px !important;
+  min-height: 42px !important;
+  border-radius: 12px !important;
+  border: 1px solid hsl(var(--border) / 0.9) !important;
+  background: hsl(var(--background)) !important;
+  box-shadow:
+    inset 0 1px 0 hsl(var(--background) / 0.8),
+    0 1px 2px hsl(var(--foreground) / 0.035) !important;
+  font-size: 13px !important;
+  transition: border-color 160ms ease, box-shadow 160ms ease, background 160ms ease;
+}
+
+[dir="ltr"] .tcrm-leads-filter-search input {
+  padding-left: 40px !important;
+  padding-right: 14px !important;
+}
+
+[dir="rtl"] .tcrm-leads-filter-search input {
+  padding-right: 40px !important;
+  padding-left: 14px !important;
+}
+
+.tcrm-leads-filter-search input::placeholder {
+  color: hsl(var(--muted-foreground) / 0.72) !important;
+}
+
+.tcrm-leads-filter-search input:hover {
+  border-color: hsl(var(--primary) / 0.32) !important;
+}
+
+.tcrm-leads-filter-search input:focus-visible {
+  border-color: hsl(var(--primary) / 0.55) !important;
+  box-shadow: 0 0 0 3px hsl(var(--primary) / 0.09) !important;
+  outline: none !important;
+}
+
+.tcrm-leads-filter-search svg {
+  width: 15px !important;
+  height: 15px !important;
+  color: hsl(var(--primary) / 0.72) !important;
+}
+
+.tcrm-leads-filter-date,
+.tcrm-leads-filter-stage {
+  overflow: visible !important;
+}
+
+.tcrm-leads-filter-date > div,
+.tcrm-leads-filter-date > div > button,
+.tcrm-leads-filter-date button,
+.tcrm-leads-filter-stage > button {
+  width: 100% !important;
+  min-width: 0 !important;
+  max-width: 100% !important;
+}
+
+.tcrm-leads-filter-date button,
+.tcrm-leads-filter-stage > button {
+  height: 40px !important;
+  min-height: 40px !important;
+}
+
+@media (max-width: 1180px) {
+  .tcrm-leads-filter-search input {
+    height: 40px !important;
+    min-height: 40px !important;
+  }
+}
