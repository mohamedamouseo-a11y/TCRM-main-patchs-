+import { describe, expect, it } from "vitest";
+import {
+  __applyDarwishSmartRankingForTests,
+  __buildDarwishGroupEvidenceForTests,
+  type DarwishGroupMatchingCandidate,
+} from "./darwishSmartGroupMatchingService";
+
+const candidate = (overrides: Partial<DarwishGroupMatchingCandidate> = {}): DarwishGroupMatchingCandidate => ({
+  groupJid: "120363000001@g.us",
+  groupName: "Acme Marketing",
+  evolutionInstance: "main",
+  chatwootConversationId: null,
+  lastActivityAt: null,
+  linkedClientId: null,
+  status: "unlinked",
+  eligible: true,
+  ...overrides,
+});
+
+describe("Darwish smart WhatsApp group matching", () => {
+  it("detects exact phone evidence from participant/JID data", () => {
+    const evidence = __buildDarwishGroupEvidenceForTests(
+      { id: 118, clientName: "Ahmed Ali", businessProfile: "Acme", knownPhones: ["201001234567"] },
+      candidate(),
+      [{
+        groupJid: "120363000001@g.us",
+        evolutionInstance: "main",
+        senderJid: "201001234567@s.whatsapp.net",
+        senderName: "Ahmed",
+        participants: [{ id: "201001234567@s.whatsapp.net", name: "Ahmed Ali" }],
+        payload: { data: { message: { conversation: "محتاجين نراجع الحملة" } } },
+      }],
+    );
+
+    expect(evidence.detectedPhones).toContain("201001234567");
+    expect(evidence.deterministicSignals).toContain("exact_phone");
+    expect(evidence.deterministicScore).toBeGreaterThanOrEqual(55);
+  });
+
+  it("ignores invented candidate keys and recommends only a strong clear winner", () => {
+    const first = candidate();
+    const second = candidate({ groupJid: "120363000002@g.us", groupName: "Other Group" });
+
+    const result = __applyDarwishSmartRankingForTests([first, second], {
+      candidates: [
+        { candidateKey: "main::120363000001@g.us", confidence: 91, reasons: ["Exact phone match"], matchedSignals: ["exact_phone"] },
+        { candidateKey: "main::120363000002@g.us", confidence: 60, reasons: ["Weak name similarity"], matchedSignals: ["name"] },
+        { candidateKey: "main::INVENTED@g.us", confidence: 100, reasons: ["Invented"], matchedSignals: ["other"] },
+      ],
+    });
+
+    expect(result[0].groupJid).toBe("120363000001@g.us");
+    expect(result[0].darwishRecommended).toBe(true);
+    expect(result[0].smartConfidence).toBe(91);
+    expect(result.some((item) => item.groupJid === "INVENTED@g.us")).toBe(false);
+  });
+
+  it("does not recommend when top candidates are too close", () => {
+    const result = __applyDarwishSmartRankingForTests(
+      [candidate(), candidate({ groupJid: "120363000002@g.us" })],
+      {
+        candidates: [
+          { candidateKey: "main::120363000001@g.us", confidence: 84, reasons: [], matchedSignals: ["name"] },
+          { candidateKey: "main::120363000002@g.us", confidence: 79, reasons: [], matchedSignals: ["name"] },
+        ],
+      },
+    );
+
+    expect(result.every((item) => item.darwishRecommended === false)).toBe(true);
+  });
+
+  it("never evaluates a group already linked to another client", () => {
+    const blocked = candidate({
+      linkedClientId: 999,
+      status: "linked_other",
+      eligible: false,
+    });
+
+    const result = __applyDarwishSmartRankingForTests([blocked], {
+      candidates: [{
+        candidateKey: "main::120363000001@g.us",
+        confidence: 100,
+        reasons: ["Should be ignored"],
+        matchedSignals: ["exact_phone"],
+      }],
+    });
+
+    expect(result[0].smartMatchStatus).toBe("not_evaluated");
+    expect(result[0].darwishRecommended).toBe(false);
+    expect(result[0].smartConfidence).toBeNull();
+  });
+});
