diff --git a/server/utils/developerDataSanitizer.ts b/server/utils/developerDataSanitizer.ts
--- a/server/utils/developerDataSanitizer.ts
+++ b/server/utils/developerDataSanitizer.ts
@@ -0,0 +1,209 @@
+type SensitiveKind = "email" | "phone" | "identifier" | "money" | "text" | "secret";
+
+const IDENTITY_CONTAINER_FRAGMENTS = [
+  "client",
+  "customer",
+  "contact",
+  "lead",
+  "employee",
+  "person",
+  "member",
+  "owner",
+  "recipient",
+  "sender",
+  "user",
+  "vendor",
+  "supplier",
+];
+
+const IDENTITY_SIGNAL_KEYS = [
+  "email",
+  "phone",
+  "mobile",
+  "whatsappnumber",
+  "nationalid",
+  "passportnumber",
+  "taxid",
+  "clientid",
+  "customerid",
+  "contactid",
+  "leadid",
+  "employeeid",
+  "userid",
+];
+
+const EMAIL_KEYS = new Set([
+  "email",
+  "emailaddress",
+  "centralemail",
+  "contactemail",
+  "clientemail",
+  "customeremail",
+  "workemail",
+  "personalemail",
+  "recipientemail",
+  "senderemail",
+]);
+
+const IDENTIFIER_KEYS = new Set([
+  "nationalid",
+  "nationalidnumber",
+  "identitynumber",
+  "passportnumber",
+  "taxid",
+  "taxnumber",
+  "vatnumber",
+  "registrationnumber",
+  "commercialregistration",
+]);
+
+const ALWAYS_PRIVATE_NAME_KEYS = new Set([
+  "firstname",
+  "lastname",
+  "fullname",
+  "clientname",
+  "customername",
+  "contactname",
+  "employeename",
+  "leadname",
+  "ownername",
+  "recipientname",
+  "sendername",
+  "username",
+  "companyname",
+]);
+
+const PRIVATE_TEXT_KEYS = new Set([
+  "address",
+  "streetaddress",
+  "billingaddress",
+  "shippingaddress",
+  "notes",
+  "note",
+  "comment",
+  "comments",
+  "message",
+  "messagebody",
+  "body",
+  "content",
+  "description",
+]);
+
+const MONEY_KEYS = new Set([
+  "amount",
+  "salary",
+  "wage",
+  "price",
+  "cost",
+  "budget",
+  "balance",
+  "revenue",
+  "income",
+  "commission",
+  "fee",
+  "dealvalue",
+  "contractvalue",
+  "totalamount",
+  "paidamount",
+  "dueamount",
+]);
+
+const SECRET_FRAGMENTS = [
+  "password",
+  "secret",
+  "token",
+  "apikey",
+  "authorization",
+  "cookie",
+  "credential",
+  "smtppass",
+];
+
+function normalizeKey(key: string): string {
+  return String(key).replace(/[^a-zA-Z0-9]/g, "").toLowerCase();
+}
+
+function isIdentityContainerKey(key: string): boolean {
+  const normalized = normalizeKey(key);
+  return IDENTITY_CONTAINER_FRAGMENTS.some(fragment => normalized === fragment || normalized.endsWith(fragment));
+}
+
+function objectLooksLikeIdentityRecord(value: Record<string, unknown>): boolean {
+  const keys = Object.keys(value).map(normalizeKey);
+  return keys.some(key => IDENTITY_SIGNAL_KEYS.some(signal => key === signal || key.endsWith(signal)));
+}
+
+function classifyKey(key: string, identityRecord: boolean): SensitiveKind | null {
+  const normalized = normalizeKey(key);
+
+  if (EMAIL_KEYS.has(normalized) || normalized.endsWith("email")) return "email";
+  if (
+    normalized === "phone" ||
+    normalized.endsWith("phone") ||
+    normalized === "mobile" ||
+    normalized.endsWith("mobile") ||
+    normalized === "whatsappnumber" ||
+    normalized === "whatsappphone" ||
+    normalized === "waid"
+  ) return "phone";
+  if (IDENTIFIER_KEYS.has(normalized)) return "identifier";
+  if (SECRET_FRAGMENTS.some(fragment => normalized.includes(fragment))) return "secret";
+  if (MONEY_KEYS.has(normalized)) return "money";
+  if (PRIVATE_TEXT_KEYS.has(normalized) || normalized.endsWith("address")) return "text";
+  if (ALWAYS_PRIVATE_NAME_KEYS.has(normalized)) return "text";
+  if (normalized === "name" && identityRecord) return "text";
+
+  return null;
+}
+
+function zeroDigits(value: string): string {
+  const digitCount = (value.match(/\d/g) ?? []).length;
+  return "0".repeat(Math.max(1, digitCount));
+}
+
+function zeroValue(value: unknown, kind: SensitiveKind): unknown {
+  if (value === null || value === undefined) return value;
+  if (typeof value === "number") return 0;
+  if (typeof value === "bigint") return BigInt(0);
+  if (typeof value === "boolean") return value;
+
+  if (typeof value === "string") {
+    if (kind === "email") return "0@0.local";
+    if (kind === "phone" || kind === "identifier") return zeroDigits(value);
+    return "0";
+  }
+
+  if (Array.isArray(value)) {
+    return value.map(item => zeroValue(item, kind));
+  }
+
+  if (value instanceof Date) return value;
+  if (typeof value === "object") return {};
+  return "0";
+}
+
+function sanitizeNode(value: unknown, containerKey = "", depth = 0): unknown {
+  if (depth > 20 || value === null || value === undefined) return value;
+  if (value instanceof Date) return value;
+  if (Array.isArray(value)) return value.map(item => sanitizeNode(item, containerKey, depth + 1));
+  if (typeof value !== "object") return value;
+
+  const source = value as Record<string, unknown>;
+  const identityRecord = isIdentityContainerKey(containerKey) || objectLooksLikeIdentityRecord(source);
+  const output: Record<string, unknown> = {};
+
+  for (const [key, item] of Object.entries(source)) {
+    const kind = classifyKey(key, identityRecord);
+    output[key] = kind ? zeroValue(item, kind) : sanitizeNode(item, key, depth + 1);
+  }
+
+  return output;
+}
+
+/**
+ * Returns a sanitized clone for Developer users.
+ * The source object is never mutated, so production/database values stay untouched.
+ */
+export function sanitizeDeveloperData<T>(value: T): T {
+  return sanitizeNode(value) as T;
+}
diff --git a/scripts/apply-developer-role-migration.ts b/scripts/apply-developer-role-migration.ts
--- a/scripts/apply-developer-role-migration.ts
+++ b/scripts/apply-developer-role-migration.ts
@@ -0,0 +1,62 @@
+import { config as dotenvConfig } from "dotenv";
+import mysql from "mysql2/promise";
+
+dotenvConfig({ path: process.cwd() + "/.env", override: true });
+
+const DATABASE_URL = process.env.DATABASE_URL;
+const ROLE = "Developer";
+
+function quoteSql(value: string) {
+  return `'${value.replaceAll("'", "''")}'`;
+}
+
+function parseEnumValues(columnType: string): string[] {
+  const values: string[] = [];
+  const pattern = /'((?:''|[^'])*)'/g;
+  let match: RegExpExecArray | null;
+  while ((match = pattern.exec(columnType))) values.push(match[1].replaceAll("''", "'"));
+  return values;
+}
+
+async function main() {
+  if (!DATABASE_URL) throw new Error("DATABASE_URL is required");
+  const conn = await mysql.createConnection(DATABASE_URL);
+
+  try {
+    const [rows] = await conn.query(
+      `SELECT COLUMN_TYPE, IS_NULLABLE, COLUMN_DEFAULT
+       FROM information_schema.COLUMNS
+       WHERE TABLE_SCHEMA = DATABASE() AND TABLE_NAME = 'users' AND COLUMN_NAME = 'role'
+       LIMIT 1`,
+    );
+    const column = (rows as any[])[0];
+    if (!column) throw new Error("users.role column was not found");
+
+    const currentValues = parseEnumValues(String(column.COLUMN_TYPE ?? ""));
+    if (!currentValues.length) throw new Error("users.role is not a readable ENUM column");
+    if (currentValues.includes(ROLE)) {
+      console.log(`users.role already supports ${ROLE}`);
+      return;
+    }
+
+    const adminIndex = currentValues.indexOf("Admin");
+    const nextValues = [...currentValues];
+    nextValues.splice(adminIndex >= 0 ? adminIndex + 1 : nextValues.length, 0, ROLE);
+
+    const nullability = String(column.IS_NULLABLE) === "YES" ? "NULL" : "NOT NULL";
+    const defaultClause = column.COLUMN_DEFAULT == null ? "" : ` DEFAULT ${quoteSql(String(column.COLUMN_DEFAULT))}`;
+
+    await conn.query(
+      `ALTER TABLE \`users\`
+       MODIFY COLUMN \`role\` ENUM(${nextValues.map(quoteSql).join(",")}) ${nullability}${defaultClause}`,
+    );
+    console.log(`Added ${ROLE} to users.role enum without changing existing user rows`);
+  } finally {
+    await conn.end();
+  }
+}
+
+main().catch((error) => {
+  console.error("Developer role migration failed", error);
+  process.exit(1);
+});
