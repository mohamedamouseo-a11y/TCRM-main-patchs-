+function stopLifecycleMonitor(id: number) {
+  const timer = lifecycleMonitors.get(id);
+  if (timer) clearTimeout(timer);
+  lifecycleMonitors.delete(id);
+  lifecycleMonitorStarted.delete(id);
+}
+
+function scheduleLifecycleMonitor(id: number, delayMs = LIFECYCLE_POLL_MS) {
+  if (lifecycleMonitorStarted.has(id)) return;
+  lifecycleMonitorStarted.add(id);
+
+  const poll = async () => {
+    lifecycleMonitors.delete(id);
+    try {
+      const { meeting } = await loadMeeting(id);
+      if (TERMINAL.has(String(meeting.status || "").toLowerCase())) {
+        stopLifecycleMonitor(id);
+        return;
+      }
+
+      const remote = await getFelfelMeetingStatus(meeting.platform, meeting.nativeMeetingId);
+      const lifecycle = mapLifecycle(remote.status, remote.active, meeting.status);
+      if (lifecycle === "ended") {
+        const db = (await loadMeeting(id)).db;
+        await db.update(crmMeetings).set({
+          status: "ended",
+          felfelStatus: remote.status || "ended",
+          endedAt: meeting.endedAt || new Date(),
+        }).where(eq(crmMeetings.id, id));
+
+        // Process only after the upstream bot is no longer active, allowing
+        // Vexa to finalize transcript and recording artifacts first.
+        setTimeout(() => {
+          void processLinkedFelfelMeeting(id).catch(() => undefined);
+        }, 3_000);
+        stopLifecycleMonitor(id);
+        return;
+      }
+
+      lifecycleMonitors.set(id, setTimeout(poll, LIFECYCLE_POLL_MS));
+    } catch {
+      // Keep polling through transient gateway/runtime failures. Do not change
+      // CRM state until a definitive upstream lifecycle state is available.
+      lifecycleMonitors.set(id, setTimeout(poll, LIFECYCLE_POLL_MS));
+    }
+  };
+
+  lifecycleMonitors.set(id, setTimeout(poll, delayMs));
+}
