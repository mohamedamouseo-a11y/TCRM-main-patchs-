+async function findMeetingByIdentity(platform: string, nativeMeetingId: string) {
+  const db = await getDb();
+  if (!db) throw new Error("Database is not available");
+  const rows = await db.select().from(crmMeetings)
+    .where(and(eq(crmMeetings.platform, platform), eq(crmMeetings.nativeMeetingId, nativeMeetingId)))
+    .orderBy(desc(crmMeetings.id)).limit(1);
+  return { db, meeting: rows[0] || null };
+}
+
+async function findRemoteHistoricalMeeting(platform: string, nativeMeetingId: string) {
+  const meetings = await listFelfelMeetings();
+  return meetings.find((item) => String(item.platform) === String(platform) && String(item.nativeId) === String(nativeMeetingId)) || null;
+}
+
+export async function getFelfelStoredMeetingResult(platform: string, nativeMeetingId: string) {
+  const { meeting } = await findMeetingByIdentity(platform, nativeMeetingId);
+  if (!meeting) return null;
+  return {
+    id: Number(meeting.id),
+    status: String(meeting.status || ""),
+    transcriptStatus: meeting.transcriptStatus || null,
+    analysisStatus: meeting.analysisStatus || null,
+    transcriptData: meeting.transcriptData || null,
+    analysisData: meeting.analysisData || null,
+    lastError: meeting.lastError || null,
+  };
+}
+
+export async function recoverRecentFelfelMeeting(platform: string, nativeMeetingId: string) {
+  const { db, meeting } = await findMeetingByIdentity(platform, nativeMeetingId);
+  if (!meeting) return { found: false, queued: false };
+  const currentStatus = String(meeting.status || "").toLowerCase();
+  if (currentStatus === "processing" || TERMINAL.has(currentStatus)) {
+    return { found: true, queued: false, meetingId: Number(meeting.id), status: currentStatus };
+  }
+  const historical = await findRemoteHistoricalMeeting(platform, nativeMeetingId);
+  const historicalStatus = String(historical?.status || "").toLowerCase();
+  if (!historical || !REMOTE_TERMINAL.has(historicalStatus)) {
+    return { found: true, queued: false, meetingId: Number(meeting.id), status: currentStatus };
+  }
+  await db.update(crmMeetings).set({
+    status: "ended",
+    felfelStatus: historical.status || "completed",
+    endedAt: meeting.endedAt || new Date(),
+  }).where(eq(crmMeetings.id, meeting.id));
+  stopLifecycleMonitor(Number(meeting.id));
+  setTimeout(() => {
+    void processLinkedFelfelMeeting(Number(meeting.id)).catch(() => undefined);
+  }, 250);
+  return { found: true, queued: true, meetingId: Number(meeting.id), status: "ended" };
+}
