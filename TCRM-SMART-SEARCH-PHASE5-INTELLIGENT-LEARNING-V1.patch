+export type SearchLearningEntityType = "client" | "deal" | "company" | "contact";
+
+export type SearchLearningEntry = {
+  key: string;
+  type: SearchLearningEntityType;
+  count: number;
+  lastSelectedAt: number;
+};
+
+export type SearchLearningProfile = {
+  version: 1;
+  entries: SearchLearningEntry[];
+};
+
+export const SEARCH_LEARNING_MAX_ENTRIES = 50;
+export const SEARCH_LEARNING_TTL_MS = 180 * 24 * 60 * 60 * 1000;
+export const SEARCH_LEARNING_RECENCY_HALF_LIFE_MS = 30 * 24 * 60 * 60 * 1000;
+export const SEARCH_LEARNING_MAX_COUNT = 20;
+export const SEARCH_LEARNING_MAX_BOOST = 60;
+
+export const EMPTY_SEARCH_LEARNING_PROFILE: SearchLearningProfile = {
+  version: 1,
+  entries: [],
+};
+
+const ENTITY_KEY_RE = /^(client|deal|company|contact):[1-9]\d*$/;
+
+function isEntityType(value: unknown): value is SearchLearningEntityType {
+  return ["client", "deal", "company", "contact"].includes(String(value));
+}
+
+function isSafeTimestamp(value: unknown): value is number {
+  return Number.isFinite(value) && Number(value) > 0;
+}
+
+/**
+ * Sanitizes browser-stored learning data. The profile intentionally contains
+ * only opaque entity ids, selection count, and timestamp — never query text,
+ * names, emails, phone numbers, or result payloads.
+ */
+export function sanitizeSearchLearningProfile(
+  raw: unknown,
+  now = Date.now(),
+): SearchLearningProfile {
+  const input = raw && typeof raw === "object" ? raw as any : {};
+  const entries: unknown[] = Array.isArray(input.entries) ? input.entries : [];
+
+  const safe = entries
+    .map((entry: unknown): SearchLearningEntry | null => {
+      const candidate = entry && typeof entry === "object" ? entry as any : {};
+      const key = String(candidate?.key ?? "");
+      const type = String(candidate?.type ?? "");
+      const count = Math.max(1, Math.min(Number(candidate?.count) || 1, SEARCH_LEARNING_MAX_COUNT));
+      const lastSelectedAt = Number(candidate?.lastSelectedAt);
+
+      if (!ENTITY_KEY_RE.test(key) || !isEntityType(type) || !isSafeTimestamp(lastSelectedAt)) {
+        return null;
+      }
+      if (!key.startsWith(`${type}:`)) return null;
+      if (lastSelectedAt > now + 5 * 60 * 1000) return null;
+      if (now - lastSelectedAt > SEARCH_LEARNING_TTL_MS) return null;
+
+      return { key, type, count, lastSelectedAt };
+    })
+    .filter((entry: SearchLearningEntry | null): entry is SearchLearningEntry => Boolean(entry))
+    .sort((a, b) => b.lastSelectedAt - a.lastSelectedAt)
+    .slice(0, SEARCH_LEARNING_MAX_ENTRIES);
+
+  return { version: 1, entries: safe };
+}
+
+export function recordSearchLearningSelection(
+  profile: unknown,
+  type: SearchLearningEntityType,
+  id: number,
+  now = Date.now(),
+): SearchLearningProfile {
+  const current = sanitizeSearchLearningProfile(profile, now);
+  if (!Number.isInteger(id) || id <= 0) return current;
+
+  const key = `${type}:${id}`;
+  const existing = current.entries.find(entry => entry.key === key);
+  const nextEntry: SearchLearningEntry = {
+    key,
+    type,
+    count: Math.min((existing?.count ?? 0) + 1, SEARCH_LEARNING_MAX_COUNT),
+    lastSelectedAt: now,
+  };
+
+  return sanitizeSearchLearningProfile({
+    version: 1,
+    entries: [
+      nextEntry,
+      ...current.entries.filter(entry => entry.key !== key),
+    ],
+  }, now);
+}
+
+export function getSearchLearningBoost(
+  profile: unknown,
+  key: string,
+  now = Date.now(),
+): number {
+  const current = sanitizeSearchLearningProfile(profile, now);
+  const entry = current.entries.find(item => item.key === key);
+  if (!entry) return 0;
+
+  const age = Math.max(0, now - entry.lastSelectedAt);
+  const recency = 36 * Math.pow(0.5, age / SEARCH_LEARNING_RECENCY_HALF_LIFE_MS);
+  const frequency = Math.min(entry.count, 8) * 3;
+  return Math.max(0, Math.min(SEARCH_LEARNING_MAX_BOOST, recency + frequency));
+}
+
+export function rankSearchResultsByLearning<T>(
+  items: T[],
+  profile: unknown,
+  getKey: (item: T) => string,
+  now = Date.now(),
+): T[] {
+  return items
+    .map((item, index) => ({
+      item,
+      index,
+      boost: getSearchLearningBoost(profile, getKey(item), now),
+    }))
+    .sort((a, b) => b.boost - a.boost || a.index - b.index)
+    .map(row => row.item);
+}
