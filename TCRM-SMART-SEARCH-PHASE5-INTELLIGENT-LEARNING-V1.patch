++    expect(JSON.stringify(profile)).not.toContain("email");
++    expect(JSON.stringify(profile)).not.toContain("phone");
++  });
++
++  it("gives stronger boost to recent/frequent selections", () => {
++    let profile = recordSearchLearningSelection(
++      EMPTY_SEARCH_LEARNING_PROFILE,
++      "deal",
++      7,
++      NOW - 60 * 24 * 60 * 60 * 1000,
++    );
++    profile = recordSearchLearningSelection(profile, "deal", 8, NOW);
++    profile = recordSearchLearningSelection(profile, "deal", 8, NOW + 1);
++
++    expect(getSearchLearningBoost(profile, "deal:8", NOW + 2))
++      .toBeGreaterThan(getSearchLearningBoost(profile, "deal:7", NOW + 2));
++  });
++
++  it("expires stale learning signals", () => {
++    const profile = sanitizeSearchLearningProfile({
++      version: 1,
++      entries: [{
++        key: "company:3",
++        type: "company",
++        count: 10,
++        lastSelectedAt: NOW - SEARCH_LEARNING_TTL_MS - 1,
++      }],
++    }, NOW);
++
++    expect(profile.entries).toEqual([]);
++    expect(getSearchLearningBoost(profile, "company:3", NOW)).toBe(0);
++  });
++
++  it("caps, sanitizes, and rejects malformed entity keys", () => {
++    const entries = Array.from({ length: SEARCH_LEARNING_MAX_ENTRIES + 10 }, (_, index) => ({
++      key: `contact:${index + 1}`,
++      type: "contact",
++      count: 100,
++      lastSelectedAt: NOW - index,
++    }));
++    entries.push({
++      key: "contact:evil",
++      type: "contact",
++      count: 1,
++      lastSelectedAt: NOW,
++    });
++
++    const profile = sanitizeSearchLearningProfile({ version: 99, entries }, NOW);
++    expect(profile.version).toBe(1);
++    expect(profile.entries).toHaveLength(SEARCH_LEARNING_MAX_ENTRIES);
++    expect(profile.entries.every(entry => entry.count <= 20)).toBe(true);
++    expect(profile.entries.some(entry => entry.key === "contact:evil")).toBe(false);
++  });
++
++  it("reorders only the authorized result set supplied by the caller", () => {
++    let profile = recordSearchLearningSelection(
++      EMPTY_SEARCH_LEARNING_PROFILE,
++      "client",
++      2,
++      NOW,
++    );
++    const authorized = [{ id: 1 }, { id: 2 }, { id: 3 }];
++    const ranked = rankSearchResultsByLearning(
++      authorized,
++      profile,
++      item => `client:${item.id}`,
++      NOW,
++    );
++
++    expect(ranked.map(item => item.id)).toEqual([2, 1, 3]);
++    expect(ranked).toHaveLength(authorized.length);
++  });
++});
