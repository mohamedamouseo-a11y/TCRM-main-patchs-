+@@ -0,0 +1,54 @@
++import {
++  EMPTY_SEARCH_LEARNING_PROFILE,
++  recordSearchLearningSelection as recordSelection,
++  sanitizeSearchLearningProfile,
++  type SearchLearningEntityType,
++  type SearchLearningProfile,
++} from "@shared/searchLearning";
++
++const STORAGE_PREFIX = "tcrm-smart-search-learning-v1";
++
++function getStorageKey(userId: number) {
++  return `${STORAGE_PREFIX}:${userId}`;
++}
++
++export function loadSearchLearningProfile(
++  userId: number,
++  now = Date.now(),
++): SearchLearningProfile {
++  if (!Number.isInteger(userId) || userId <= 0 || typeof window === "undefined") {
++    return EMPTY_SEARCH_LEARNING_PROFILE;
++  }
++
++  try {
++    const raw = window.localStorage.getItem(getStorageKey(userId));
++    if (!raw) return EMPTY_SEARCH_LEARNING_PROFILE;
++    return sanitizeSearchLearningProfile(JSON.parse(raw), now);
++  } catch {
++    return EMPTY_SEARCH_LEARNING_PROFILE;
++  }
++}
++
++function persistSearchLearningProfile(
++  userId: number,
++  profile: SearchLearningProfile,
++) {
++  if (!Number.isInteger(userId) || userId <= 0 || typeof window === "undefined") return;
++  try {
++    window.localStorage.setItem(getStorageKey(userId), JSON.stringify(profile));
++  } catch {
++    // Storage may be disabled or full. Search must continue without learning.
++  }
++}
++
++export function recordSearchLearningSelection(
++  userId: number,
++  profile: SearchLearningProfile,
++  type: SearchLearningEntityType,
++  id: number,
++  now = Date.now(),
++): SearchLearningProfile {
++  const next = recordSelection(profile, type, id, now);
++  persistSearchLearningProfile(userId, next);
++  return next;
++}
