@@ -0,0 +1,68 @@
+import { Badge } from "@/components/ui/badge";
+import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
+import { useLanguage } from "@/contexts/LanguageContext";
+import { trpc } from "@/lib/trpc";
+import { ShieldCheck, Zap } from "lucide-react";
+
+export default function DarwishLimitedAutomationCard() {
+  const { lang } = useLanguage();
+  const ar = lang === "ar";
+  const healthQ = trpc.darwish.health.useQuery(undefined, {
+    refetchInterval: 30_000,
+    refetchOnWindowFocus: false,
+  });
+
+  const automation = healthQ.data?.config?.actions?.limitedAutomation;
+  const enabled = Boolean(automation?.enabled);
+
+  return (
+    <Card className="rounded-2xl border-border/70">
+      <CardHeader>
+        <div className="flex flex-wrap items-start justify-between gap-3">
+          <div>
+            <CardTitle className="flex items-center gap-2">
+              <Zap className="h-5 w-5" />
+              {ar ? "الأتمتة المحدودة الآمنة — Phase 5" : "Limited Safe Automation — Phase 5"}
+            </CardTitle>
+            <CardDescription>
+              {ar
+                ? "تنفيذ تلقائي محدود للإجراءات الداخلية منخفضة المخاطر فقط. رسائل العملاء تظل خارج الأتمتة."
+                : "Policy-controlled automation for low-risk internal actions only. Customer messaging remains outside automation."}
+            </CardDescription>
+          </div>
+          <Badge variant={enabled ? "default" : "secondary"}>
+            {enabled ? (ar ? "مفعّلة" : "Enabled") : (ar ? "مقفولة افتراضيًا" : "Disabled by default")}
+          </Badge>
+        </div>
+      </CardHeader>
+      <CardContent className="grid gap-3 text-sm md:grid-cols-2 xl:grid-cols-4">
+        <div className="rounded-xl border p-3">
+          <div className="font-semibold">{ar ? "الإجراءات المسموحة" : "Allowed actions"}</div>
+          <div className="mt-1 text-muted-foreground">
+            {automation?.internalNoteEnabled ? "internal_note" : "—"}
+            {automation?.followUpReminderEnabled ? " · follow_up_reminder" : ""}
+          </div>
+        </div>
+        <div className="rounded-xl border p-3">
+          <div className="font-semibold">{ar ? "أقصى مستوى مخاطر" : "Maximum risk"}</div>
+          <div className="mt-1 text-muted-foreground">{automation?.maxRisk || "medium"}</div>
+        </div>
+        <div className="rounded-xl border p-3">
+          <div className="font-semibold">{ar ? "هوية التنفيذ الآلي" : "Automation actor"}</div>
+          <div className="mt-1 text-muted-foreground">
+            {automation?.actorConfigured ? (ar ? "مضبوطة" : "Configured") : (ar ? "غير مضبوطة" : "Not configured")}
+          </div>
+        </div>
+        <div className="rounded-xl border p-3">
+          <div className="flex items-center gap-2 font-semibold">
+            <ShieldCheck className="h-4 w-4" />
+            {ar ? "إرسال العميل" : "Customer outbound"}
+          </div>
+          <div className="mt-1 text-muted-foreground">
+            {ar ? "مقفول — يحتاج مراجعة بشرية" : "Disabled — human approval required"}
+          </div>
+        </div>
+      </CardContent>
+    </Card>
+  );
+}
