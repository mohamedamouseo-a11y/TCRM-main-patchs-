diff --git a/server/services/darwish/chatwoot/darwishAutomationPolicy.ts b/server/services/darwish/chatwoot/darwishAutomationPolicy.ts
new file mode 100644
--- /dev/null
+++ b/server/services/darwish/chatwoot/darwishAutomationPolicy.ts
@@ -0,0 +1,104 @@
+export const DARWISH_AUTOMATION_POLICY_VERSION = "phase5-v1";
+
+export type DarwishAutomationRisk = "low" | "medium" | "high" | "critical";
+
+export type DarwishAutomationCandidate = {
+  status: string;
+  actionType: string;
+  riskLevel: string | null | undefined;
+  sourceType: string | null | undefined;
+  clientId: number | null | undefined;
+  accountManagerId: number | null | undefined;
+};
+
+export type DarwishAutomationPolicyInput = {
+  enabled: boolean;
+  internalNoteEnabled: boolean;
+  followUpReminderEnabled: boolean;
+  maxRisk: DarwishAutomationRisk;
+  requireClientContext: boolean;
+  requireAccountManager: boolean;
+  automationActorConfigured: boolean;
+  globalRateRemaining: boolean;
+  clientRateRemaining: boolean;
+  managerRateRemaining: boolean;
+};
+
+export type DarwishAutomationDecision = {
+  eligible: boolean;
+  reason:
+    | "ELIGIBLE"
+    | "AUTOMATION_DISABLED"
+    | "AUTOMATION_ACTOR_MISSING"
+    | "ACTION_TYPE_NOT_ALLOWED"
+    | "CUSTOMER_FACING_ACTION"
+    | "RISK_TOO_HIGH"
+    | "CLIENT_CONTEXT_MISSING"
+    | "ACCOUNT_MANAGER_MISSING"
+    | "RATE_LIMIT_EXCEEDED"
+    | "UNTRUSTED_SOURCE"
+    | "EXECUTION_UNCERTAIN"
+    | "POLICY_VALIDATION_FAILED";
+  policyVersion: string;
+};
+
+const RISK_RANK: Record<DarwishAutomationRisk, number> = {
+  low: 1,
+  medium: 2,
+  high: 3,
+  critical: 4,
+};
+
+function normalizeRisk(value: string | null | undefined): DarwishAutomationRisk | null {
+  const risk = String(value || "").trim().toLowerCase();
+  return risk === "low" || risk === "medium" || risk === "high" || risk === "critical"
+    ? risk
+    : null;
+}
+
+function decision(reason: DarwishAutomationDecision["reason"], eligible = false): DarwishAutomationDecision {
+  return { eligible, reason, policyVersion: DARWISH_AUTOMATION_POLICY_VERSION };
+}
+
+export function evaluateDarwishAutomationPolicy(
+  candidate: DarwishAutomationCandidate,
+  policy: DarwishAutomationPolicyInput,
+): DarwishAutomationDecision {
+  if (!policy.enabled) return decision("AUTOMATION_DISABLED");
+  if (!policy.automationActorConfigured) return decision("AUTOMATION_ACTOR_MISSING");
+
+  if (candidate.status === "execution_uncertain") return decision("EXECUTION_UNCERTAIN");
+  if (candidate.status !== "proposed") return decision("POLICY_VALIDATION_FAILED");
+
+  if (String(candidate.sourceType || "") !== "supervisor_alert") return decision("UNTRUSTED_SOURCE");
+
+  const actionType = String(candidate.actionType || "");
+  if (actionType === "customer_reply") return decision("CUSTOMER_FACING_ACTION");
+  if (actionType === "internal_note" && !policy.internalNoteEnabled) return decision("ACTION_TYPE_NOT_ALLOWED");
+  if (actionType === "follow_up_reminder" && !policy.followUpReminderEnabled) return decision("ACTION_TYPE_NOT_ALLOWED");
+  if (actionType !== "internal_note" && actionType !== "follow_up_reminder") {
+    return decision("ACTION_TYPE_NOT_ALLOWED");
+  }
+
+  const risk = normalizeRisk(candidate.riskLevel);
+  if (!risk) return decision("POLICY_VALIDATION_FAILED");
+  if (RISK_RANK[risk] > RISK_RANK[policy.maxRisk]) return decision("RISK_TOO_HIGH");
+
+  if (policy.requireClientContext && !Number(candidate.clientId || 0)) {
+    return decision("CLIENT_CONTEXT_MISSING");
+  }
+
+  if (
+    actionType === "follow_up_reminder"
+    && policy.requireAccountManager
+    && !Number(candidate.accountManagerId || 0)
+  ) {
+    return decision("ACCOUNT_MANAGER_MISSING");
+  }
+
+  if (!policy.globalRateRemaining || !policy.clientRateRemaining || !policy.managerRateRemaining) {
+    return decision("RATE_LIMIT_EXCEEDED");
+  }
+
+  return decision("ELIGIBLE", true);
+}
