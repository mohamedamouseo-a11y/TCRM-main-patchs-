+import { describe, expect, it } from "vitest";
+import { evaluateDarwishAutomationPolicy } from "./darwishAutomationPolicy";
+
+const candidate = {
+  status: "proposed",
+  actionType: "internal_note",
+  riskLevel: "low",
+  sourceType: "supervisor_alert",
+  clientId: 7,
+  accountManagerId: 4,
+};
+
+const policy = {
+  enabled: true,
+  internalNoteEnabled: true,
+  followUpReminderEnabled: true,
+  maxRisk: "medium" as const,
+  requireClientContext: true,
+  requireAccountManager: true,
+  automationActorConfigured: true,
+  globalRateRemaining: true,
+  clientRateRemaining: true,
+  managerRateRemaining: true,
+};
+
+describe("Darwish Phase 5 limited safe automation policy", () => {
+  it("allows a low-risk internal note", () => {
+    expect(evaluateDarwishAutomationPolicy(candidate, policy)).toMatchObject({ eligible: true, reason: "ELIGIBLE" });
+  });
+
+  it("allows a medium-risk follow-up reminder with an owner", () => {
+    expect(evaluateDarwishAutomationPolicy({
+      ...candidate,
+      actionType: "follow_up_reminder",
+      riskLevel: "medium",
+    }, policy)).toMatchObject({ eligible: true, reason: "ELIGIBLE" });
+  });
+
+  it("blocks high-risk actions", () => {
+    expect(evaluateDarwishAutomationPolicy({ ...candidate, riskLevel: "high" }, policy).reason).toBe("RISK_TOO_HIGH");
+  });
+
+  it("always blocks customer replies", () => {
+    expect(evaluateDarwishAutomationPolicy({ ...candidate, actionType: "customer_reply" }, policy).reason)
+      .toBe("CUSTOMER_FACING_ACTION");
+  });
+
+  it("blocks untrusted sources", () => {
+    expect(evaluateDarwishAutomationPolicy({ ...candidate, sourceType: "manual" }, policy).reason)
+      .toBe("UNTRUSTED_SOURCE");
+  });
+
+  it("blocks missing client context", () => {
+    expect(evaluateDarwishAutomationPolicy({ ...candidate, clientId: null }, policy).reason)
+      .toBe("CLIENT_CONTEXT_MISSING");
+  });
+
+  it("blocks follow-up reminders with no account manager", () => {
+    expect(evaluateDarwishAutomationPolicy({
+      ...candidate,
+      actionType: "follow_up_reminder",
+      accountManagerId: null,
+    }, policy).reason).toBe("ACCOUNT_MANAGER_MISSING");
+  });
+
+  it("blocks when the master switch is disabled", () => {
+    expect(evaluateDarwishAutomationPolicy(candidate, { ...policy, enabled: false }).reason)
+      .toBe("AUTOMATION_DISABLED");
+  });
+
+  it("blocks when the system automation actor is not configured", () => {
+    expect(evaluateDarwishAutomationPolicy(candidate, { ...policy, automationActorConfigured: false }).reason)
+      .toBe("AUTOMATION_ACTOR_MISSING");
+  });
+
+  it("blocks when any rate limit is exhausted", () => {
+    expect(evaluateDarwishAutomationPolicy(candidate, { ...policy, clientRateRemaining: false }).reason)
+      .toBe("RATE_LIMIT_EXCEEDED");
+  });
+
+  it("blocks uncertain executions from automatic retry", () => {
+    expect(evaluateDarwishAutomationPolicy({ ...candidate, status: "execution_uncertain" }, policy).reason)
+      .toBe("EXECUTION_UNCERTAIN");
+  });
+});
