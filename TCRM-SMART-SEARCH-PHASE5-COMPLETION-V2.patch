new file mode 100644
index 0000000..e635b03
--- /dev/null
+++ b/client/src/lib/searchLearningStore.ts
@@ -0,0 +1,54 @@
+import {
+  EMPTY_SEARCH_LEARNING_PROFILE,
+  recordSearchLearningSelection as recordSelection,
+  sanitizeSearchLearningProfile,
+  type SearchLearningEntityType,
+  type SearchLearningProfile,
+} from "@shared/searchLearning";
+
+const STORAGE_PREFIX = "tcrm-smart-search-learning-v1";
+
+export function getSearchLearningStorageKey(userId: number) {
+  return `${STORAGE_PREFIX}:${userId}`;
+}
+
+export function loadSearchLearningProfile(
+  userId: number,
+  now = Date.now(),
+): SearchLearningProfile {
+  if (!Number.isInteger(userId) || userId <= 0 || typeof window === "undefined") {
+    return EMPTY_SEARCH_LEARNING_PROFILE;
+  }
+
+  try {
+    const raw = window.localStorage.getItem(getSearchLearningStorageKey(userId));
+    if (!raw) return EMPTY_SEARCH_LEARNING_PROFILE;
+    return sanitizeSearchLearningProfile(JSON.parse(raw), now);
+  } catch {
+    return EMPTY_SEARCH_LEARNING_PROFILE;
+  }
+}
+
+function persistSearchLearningProfile(
+  userId: number,
+  profile: SearchLearningProfile,
+) {
+  if (!Number.isInteger(userId) || userId <= 0 || typeof window === "undefined") return;
+  try {
+    window.localStorage.setItem(getSearchLearningStorageKey(userId), JSON.stringify(profile));
+  } catch {
+    // Storage may be disabled, blocked, or full. Search continues without persistence.
+  }
+}
+
+export function recordSearchLearningSelection(
+  userId: number,
+  profile: SearchLearningProfile,
+  type: SearchLearningEntityType,
+  id: number,
+  now = Date.now(),
+): SearchLearningProfile {
+  const next = recordSelection(profile, type, id, now);
+  persistSearchLearningProfile(userId, next);
+  return next;
+}
diff --git a/shared/searchLearning.test.ts b/shared/searchLearning.test.ts
new file mode 100644
index 0000000..7421f0b
--- /dev/null
+++ b/shared/searchLearning.test.ts
@@ -0,0 +1,117 @@
+import { describe, expect, it } from "vitest";
+import {
+  EMPTY_SEARCH_LEARNING_PROFILE,
+  SEARCH_LEARNING_MAX_COUNT,
+  SEARCH_LEARNING_MAX_ENTRIES,
+  SEARCH_LEARNING_TTL_MS,
+  getSearchLearningBoost,
+  rankSearchResultsByLearning,
+  recordSearchLearningSelection,
+  sanitizeSearchLearningProfile,
+} from "./searchLearning";
+
+const NOW = 2_000_000_000_000;
+
+describe("search learning", () => {
+  it("learns repeated selections without storing query text or PII", () => {
+    let profile = recordSearchLearningSelection(
+      EMPTY_SEARCH_LEARNING_PROFILE,
+      "client",
+      42,
+      NOW,
+    );
+    profile = recordSearchLearningSelection(profile, "client", 42, NOW + 1_000);
+
+    expect(profile.entries).toEqual([
+      {
+        key: "client:42",
+        type: "client",
+        count: 2,
+        lastSelectedAt: NOW + 1_000,
+      },
+    ]);
+    const serialized = JSON.stringify(profile);
+    expect(serialized).not.toContain("query");
+    expect(serialized).not.toContain("email");
+    expect(serialized).not.toContain("phone");
+    expect(serialized).not.toContain("name");
+  });
+
+  it("gives stronger boost to recent and frequent selections", () => {
+    let profile = recordSearchLearningSelection(
+      EMPTY_SEARCH_LEARNING_PROFILE,
+      "deal",
+      7,
+      NOW - 60 * 24 * 60 * 60 * 1000,
+    );
+    profile = recordSearchLearningSelection(profile, "deal", 8, NOW);
+    profile = recordSearchLearningSelection(profile, "deal", 8, NOW + 1);
+
+    expect(getSearchLearningBoost(profile, "deal:8", NOW + 2))
+      .toBeGreaterThan(getSearchLearningBoost(profile, "deal:7", NOW + 2));
+  });
+
+  it("expires stale learning signals", () => {
+    const profile = sanitizeSearchLearningProfile({
+      version: 1,
+      entries: [{
+        key: "company:3",
+        type: "company",
+        count: 10,
+        lastSelectedAt: NOW - SEARCH_LEARNING_TTL_MS - 1,
+      }],
+    }, NOW);
+
+    expect(profile.entries).toEqual([]);
+    expect(getSearchLearningBoost(profile, "company:3", NOW)).toBe(0);
+  });
+
+  it("caps, sanitizes, and rejects malformed entity keys", () => {
+    const entries: any[] = Array.from({ length: SEARCH_LEARNING_MAX_ENTRIES + 10 }, (_, index) => ({
+      key: `contact:${index + 1}`,
+      type: "contact",
+      count: 100,
+      lastSelectedAt: NOW - index,
+    }));
+    entries.push({
+      key: "contact:evil",
+      type: "contact",
+      count: 1,
+      lastSelectedAt: NOW,
+    });
+
+    const profile = sanitizeSearchLearningProfile({ version: 99, entries }, NOW);
+    expect(profile.version).toBe(1);
+    expect(profile.entries).toHaveLength(SEARCH_LEARNING_MAX_ENTRIES);
+    expect(profile.entries.every(entry => entry.count <= SEARCH_LEARNING_MAX_COUNT)).toBe(true);
+    expect(profile.entries.some(entry => entry.key === "contact:evil")).toBe(false);
+  });
+
+  it("caps repeated selection counts", () => {
+    let profile = EMPTY_SEARCH_LEARNING_PROFILE;
+    for (let index = 0; index < SEARCH_LEARNING_MAX_COUNT + 10; index += 1) {
+      profile = recordSearchLearningSelection(profile, "client", 11, NOW + index);
+    }
+    expect(profile.entries[0]?.count).toBe(SEARCH_LEARNING_MAX_COUNT);
+  });
+
+  it("reorders only the authorized result set supplied by the caller", () => {
+    const profile = recordSearchLearningSelection(
+      EMPTY_SEARCH_LEARNING_PROFILE,
+      "client",
+      2,
+      NOW,
+    );
+    const authorized = [{ id: 1 }, { id: 2 }, { id: 3 }];
+    const ranked = rankSearchResultsByLearning(
+      authorized,
+      profile,
+      item => `client:${item.id}`,
+      NOW,
+    );
+
+    expect(ranked.map(item => item.id)).toEqual([2, 1, 3]);
+    expect(ranked).toHaveLength(authorized.length);
+    expect(ranked.every(item => authorized.includes(item))).toBe(true);
+  });
+});
diff --git a/shared/searchLearningStore.test.ts b/shared/searchLearningStore.test.ts
new file mode 100644
index 0000000..5dac565
--- /dev/null
+++ b/shared/searchLearningStore.test.ts
@@ -0,0 +1,71 @@
+import { afterEach, describe, expect, it } from "vitest";
+import { EMPTY_SEARCH_LEARNING_PROFILE } from "./searchLearning";
+import {
+  getSearchLearningStorageKey,
+  loadSearchLearningProfile,
+  recordSearchLearningSelection,
+} from "../client/src/lib/searchLearningStore";
+
+const NOW = 2_000_000_000_000;
+const originalWindow = (globalThis as any).window;
+
+afterEach(() => {
+  if (originalWindow === undefined) delete (globalThis as any).window;
+  else (globalThis as any).window = originalWindow;
+});
+
+function installStorage(options?: { readValue?: string | null; throwRead?: boolean; throwWrite?: boolean }) {
+  const writes = new Map<string, string>();
+  (globalThis as any).window = {
+    localStorage: {
+      getItem(key: string) {
+        if (options?.throwRead) throw new Error("blocked");
+        return writes.get(key) ?? options?.readValue ?? null;
+      },
+      setItem(key: string, value: string) {
+        if (options?.throwWrite) throw new Error("quota");
+        writes.set(key, value);
+      },
+    },
+  };
+  return writes;
+}
+
+describe("search learning local store", () => {
+  it("isolates storage by authenticated user id", () => {
+    expect(getSearchLearningStorageKey(10)).not.toBe(getSearchLearningStorageKey(11));
+    expect(getSearchLearningStorageKey(10)).toContain(":10");
+  });
+
+  it("returns empty learning when stored JSON is corrupted", () => {
+    installStorage({ readValue: "{bad-json" });
+    expect(loadSearchLearningProfile(10, NOW)).toEqual(EMPTY_SEARCH_LEARNING_PROFILE);
+  });
+
+  it("fails open when localStorage reads are blocked", () => {
+    installStorage({ throwRead: true });
+    expect(loadSearchLearningProfile(10, NOW)).toEqual(EMPTY_SEARCH_LEARNING_PROFILE);
+  });
+
+  it("keeps search learning usable when persistence fails", () => {
+    installStorage({ throwWrite: true });
+    const next = recordSearchLearningSelection(
+      10,
+      EMPTY_SEARCH_LEARNING_PROFILE,
+      "deal",
+      7,
+      NOW,
+    );
+    expect(next.entries[0]).toMatchObject({ key: "deal:7", count: 1 });
+  });
+
+  it("persists only the sanitized profile shape", () => {
+    const writes = installStorage();
+    recordSearchLearningSelection(10, EMPTY_SEARCH_LEARNING_PROFILE, "client", 42, NOW);
+    const stored = writes.get(getSearchLearningStorageKey(10)) ?? "";
+    expect(stored).toContain("client:42");
+    expect(stored).not.toContain("query");
+    expect(stored).not.toContain("email");
+    expect(stored).not.toContain("phone");
+  });
+});
