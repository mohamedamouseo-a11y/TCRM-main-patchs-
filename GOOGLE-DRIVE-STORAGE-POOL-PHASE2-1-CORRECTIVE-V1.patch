+function editFn(path, name, fn) {
+  let s = read(path);
+  const markers = [`export async function ${name}`, `async function ${name}`, `export function ${name}`, `function ${name}`];
+  let start = -1;
+  for (const m of markers) { const i = s.indexOf(m); if (i >= 0 && (start < 0 || i < start)) start = i; }
+  if (start < 0) throw new Error(`Function not found: ${name}`);
+  const endings = ["\nexport async function ", "\nasync function ", "\nexport function ", "\nfunction ", "\nexport class ", "\nexport type "];
+  let end = s.length;
+  for (const e of endings) { const i = s.indexOf(e, start + 10); if (i >= 0 && i < end) end = i; }
+  const block = s.slice(start, end);
+  const next = fn(block);
+  if (next === block) throw new Error(`No change in ${name}`);
+  write(path, s.slice(0, start) + next + s.slice(end));
+}
+function editTable(path, table, fn) {
+  let s = read(path);
+  const at = s.indexOf(`mysqlTable("${table}"`);
+  if (at < 0) throw new Error(`Table not found: ${table}`);
+  const start = s.lastIndexOf("export const ", at);
+  let end = s.indexOf("\nexport const ", at);
+  if (end < 0) end = s.length;
+  const block = s.slice(start, end);
+  const next = fn(block);
+  if (next === block) throw new Error(`No schema change for ${table}`);
+  write(path, s.slice(0, start) + next + s.slice(end));
