--- a/server/utils/searchNormalizationSql.ts
+++ b/server/utils/searchNormalizationSql.ts
@@ -1,4 +1,5 @@
-import { sql } from "drizzle-orm";
+import { or, sql } from "drizzle-orm";
+import { buildFuzzyContainsPatterns } from "@shared/searchFuzzy";
 import { normalizeSearchText } from "@shared/searchNormalization";
 
 // Mirrors the character-level transformations in shared/searchNormalization.
@@ -59,3 +60,22 @@
   const normalized = normalizeSearchText(query);
   return sql`${normalizedSearchColumn(column)} LIKE ${`%${normalized}%`}`;
 }
+
+/**
+ * Bounded typo tolerance for human-readable text fields.
+ *
+ * Phase 2 deliberately limits fuzzy expansion to one edit (substitution,
+ * missing/extra character, or adjacent transposition). Short/structured/long
+ * queries fall back to one exact normalized LIKE pattern. The fixed `!` escape
+ * character must stay in sync with shared/searchFuzzy.ts.
+ */
+export function fuzzyContains(column: any, query: unknown) {
+  const expression = normalizedSearchColumn(column);
+  const patterns = buildFuzzyContainsPatterns(query);
+  if (patterns.length === 0) return sql`1 = 0`;
+
+  const clauses = patterns.map(
+    (pattern) => sql`${expression} LIKE ${pattern} ESCAPE '!'`,
+  );
+  return or(...clauses) ?? sql`1 = 0`;
+}
