new file mode 100644
--- /dev/null
+++ b/shared/searchFuzzy.ts
@@ -0,0 +1,114 @@
+import { normalizeSearchText } from "./searchNormalization";
+
+export const FUZZY_SEARCH_MIN_QUERY_LENGTH = 4;
+export const FUZZY_SEARCH_MAX_QUERY_LENGTH = 14;
+export const FUZZY_SEARCH_MAX_PATTERNS = 56;
+
+const FUZZY_LETTER_RE = /[A-Za-z\u0621-\u064A\u0671-\u06D3]/;
+const LIKE_ESCAPE = "!";
+
+function escapeLikeLiteral(value: string): string {
+  return value
+    .replaceAll(LIKE_ESCAPE, `${LIKE_ESCAPE}${LIKE_ESCAPE}`)
+    .replaceAll("%", `${LIKE_ESCAPE}%`)
+    .replaceAll("_", `${LIKE_ESCAPE}_`);
+}
+
+function literal(chars: string[]): string {
+  return escapeLikeLiteral(chars.join(""));
+}
+
+function containsPattern(body: string): string {
+  return `%${body}%`;
+}
+
+/**
+ * Fuzzy expansion is intentionally conservative. It is enabled only for
+ * human-language queries that are long enough to avoid noisy three-character
+ * matches and short enough to keep SQL expansion bounded.
+ */
+export function isFuzzySearchEligible(value: unknown): boolean {
+  const normalized = normalizeSearchText(value);
+  const chars = Array.from(normalized);
+
+  return (
+    chars.length >= FUZZY_SEARCH_MIN_QUERY_LENGTH &&
+    chars.length <= FUZZY_SEARCH_MAX_QUERY_LENGTH &&
+    FUZZY_LETTER_RE.test(normalized) &&
+    !normalized.includes("@")
+  );
+}
+
+/**
+ * Build MySQL LIKE patterns for bounded edit-distance-one matching.
+ *
+ * Pattern order is intentional:
+ *  1) exact normalized contains
+ *  2) one substituted character
+ *  3) one missing character in the query
+ *  4) one adjacent transposition
+ *  5) one extra character in the query
+ *
+ * Literal `%`, `_`, and `!` are escaped with `!`; the server SQL helper uses
+ * `ESCAPE '!'`. `_` inserted by this function is therefore the only wildcard
+ * that represents a fuzzy character.
+ */
+export function buildFuzzyContainsPatterns(value: unknown): string[] {
+  const normalized = normalizeSearchText(value);
+  if (!normalized) return [];
+
+  const chars = Array.from(normalized);
+  const patterns = new Set<string>([containsPattern(literal(chars))]);
+
+  if (!isFuzzySearchEligible(normalized)) return Array.from(patterns);
+
+  const add = (pattern: string) => {
+    if (patterns.size < FUZZY_SEARCH_MAX_PATTERNS) patterns.add(pattern);
+  };
+
+  // Substitution: query "احمد" can match stored "اخمد" via "ا_مد".
+  for (let i = 0; i < chars.length; i += 1) {
+    if (chars[i] === " ") continue;
+    add(
+      containsPattern(
+        `${literal(chars.slice(0, i))}_${literal(chars.slice(i + 1))}`,
+      ),
+    );
+  }
+
+  // Missing character in query: "ahmd" can match "ahmed" via "ahm_d".
+  for (let i = 1; i < chars.length; i += 1) {
+    if (chars[i - 1] === " " || chars[i] === " ") continue;
+    add(
+      containsPattern(
+        `${literal(chars.slice(0, i))}_${literal(chars.slice(i))}`,
+      ),
+    );
+  }
+
+  // Adjacent transposition: "mohmaed" can match "mohamed".
+  for (let i = 0; i < chars.length - 1; i += 1) {
+    if (
+      chars[i] === " " ||
+      chars[i + 1] === " " ||
+      chars[i] === chars[i + 1]
+    ) {
+      continue;
+    }
+    const swapped = [...chars];
+    [swapped[i], swapped[i + 1]] = [swapped[i + 1], swapped[i]];
+    add(containsPattern(literal(swapped)));
+  }
+
+  // Extra character in query. Do not reduce four-character queries to a noisy
+  // three-character contains match.
+  if (chars.length >= FUZZY_SEARCH_MIN_QUERY_LENGTH + 1) {
+    for (let i = 0; i < chars.length; i += 1) {
+      if (chars[i] === " ") continue;
+      const deleted = [...chars.slice(0, i), ...chars.slice(i + 1)];
+      add(containsPattern(literal(deleted)));
+    }
+  }
+
+  return Array.from(patterns);
+}
diff --git a/shared/searchFuzzy.test.ts b/shared/searchFuzzy.test.ts
new file mode 100644
--- /dev/null
+++ b/shared/searchFuzzy.test.ts
@@ -0,0 +1,74 @@
+import { describe, expect, it } from "vitest";
+import {
+  buildFuzzyContainsPatterns,
+  FUZZY_SEARCH_MAX_PATTERNS,
+  isFuzzySearchEligible,
+} from "./searchFuzzy";
+import { normalizeSearchText } from "./searchNormalization";
+
+function escapeRegex(value: string) {
+  return value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
+}
+
+function likePatternToRegex(pattern: string) {
+  let source = "";
+  for (let i = 0; i < pattern.length; i += 1) {
+    const char = pattern[i];
+    if (char === "!") {
+      i += 1;
+      source += escapeRegex(pattern[i] ?? "");
+    } else if (char === "%") {
+      source += ".*";
+    } else if (char === "_") {
+      source += ".";
+    } else {
+      source += escapeRegex(char);
+    }
+  }
+  return new RegExp(`^${source}$`, "u");
+}
+
+function fuzzyMatches(query: string, candidate: string) {
+  const normalizedCandidate = normalizeSearchText(candidate);
+  return buildFuzzyContainsPatterns(query).some((pattern) =>
+    likePatternToRegex(pattern).test(normalizedCandidate),
+  );
+}
+
+describe("bounded fuzzy search patterns", () => {
+  it("keeps normalized exact matching as the first pattern", () => {
+    expect(buildFuzzyContainsPatterns(" أحمَد ")[0]).toBe("%احمد%");
+  });
+
+  it("tolerates one substituted Arabic character", () => {
+    expect(fuzzyMatches("اخمد", "أحمد")).toBe(true);
+  });
+
+  it("tolerates one missing or extra character", () => {
+    expect(fuzzyMatches("ahmd", "Ahmed")).toBe(true);
+    expect(fuzzyMatches("ahmmed", "Ahmed")).toBe(true);
+  });
+
+  it("tolerates one adjacent transposition", () => {
+    expect(fuzzyMatches("mohmaed", "Mohamed")).toBe(true);
+    expect(fuzzyMatches("احدم", "أحمد")).toBe(true);
+  });
+
+  it("keeps short queries and emails exact-only", () => {
+    expect(isFuzzySearchEligible("ali")).toBe(false);
+    expect(buildFuzzyContainsPatterns("ali")).toEqual(["%ali%"]);
+    expect(isFuzzySearchEligible("user@example.com")).toBe(false);
+    expect(buildFuzzyContainsPatterns("user@example.com")).toHaveLength(1);
+  });
+
+  it("escapes literal SQL LIKE wildcard characters", () => {
+    const exact = buildFuzzyContainsPatterns("ab_cd")[0];
+    expect(exact).toBe("%ab!_cd%");
+    expect(fuzzyMatches("ab_cd", "ab_cd")).toBe(true);
+  });
+
+  it("caps SQL expansion to a predictable maximum", () => {
+    const patterns = buildFuzzyContainsPatterns("abcdefghijklmn");
+    expect(patterns.length).toBeLessThanOrEqual(FUZZY_SEARCH_MAX_PATTERNS);
+  });
+});
