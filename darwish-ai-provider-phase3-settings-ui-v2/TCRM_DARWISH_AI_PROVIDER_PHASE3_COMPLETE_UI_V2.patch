+import { Router, type NextFunction, type Request, type Response } from "express";
+import { authenticateRequest } from "../auth";
+import { normalizeUserRole } from "../roleUtils";
+import {
+  createDarwishAiProvider,
+  createDarwishAiProviderModel,
+  createDarwishAiRoutingPolicy,
+  createDarwishAiRoutingTarget,
+  deleteDarwishAiProvider,
+  deleteDarwishAiProviderModel,
+  deleteDarwishAiProviderSecret,
+  deleteDarwishAiRoutingPolicy,
+  deleteDarwishAiRoutingTarget,
+  getDarwishAiProviderSettingsSnapshot,
+  saveDarwishAiProviderSecret,
+  updateDarwishAiProvider,
+  updateDarwishAiProviderModel,
+  updateDarwishAiRoutingPolicy,
+  updateDarwishAiRoutingTarget,
+} from "../services/darwish/aiProviders/darwishAiProviderSettingsService";
+import { getDarwishAiProviderFoundationState } from "../services/darwish/aiProviders/darwishAiProviderFoundationService";
+import { getDarwishAiProviderRoutingState } from "../services/darwish/aiProviders/darwishAiProviderRoutingService";
+
+type AsyncHandler = (req: Request, res: Response) => Promise<void>;
+
+function guarded(handler: AsyncHandler) {
+  return async (req: Request, res: Response, next: NextFunction) => {
+    try {
+      const user = await authenticateRequest(req);
+      if (!user) { res.status(401).json({ error: "Unauthorized" }); return; }
+      const role = normalizeUserRole(user.role ?? "");
+      if (role !== "Admin" && role !== "Developer") {
+        res.status(403).json({ error: "Darwish AI provider settings require Admin or Developer role" });
+        return;
+      }
+      await handler(req, res);
+    } catch (error) { next(error); }
+  };
+}
+
+function body(req: Request) { return req.body && typeof req.body === "object" ? req.body : {}; }
+
+export function createDarwishAiProvidersRouter() {
+  const router = Router();
+  router.get("/settings", guarded(async (_req, res) => { res.json(await getDarwishAiProviderSettingsSnapshot()); }));
+  router.get("/health", guarded(async (_req, res) => { res.json({ foundation: getDarwishAiProviderFoundationState(), routing: getDarwishAiProviderRoutingState(), phase: 3, darwishRuntimeIntegrated: false }); }));
+  router.post("/providers", guarded(async (req, res) => { res.status(201).json(await createDarwishAiProvider(body(req) as any)); }));
+  router.put("/providers/:id", guarded(async (req, res) => { await updateDarwishAiProvider(Number(req.params.id), body(req) as any); res.json({ ok: true }); }));
+  router.delete("/providers/:id", guarded(async (req, res) => { await deleteDarwishAiProvider(Number(req.params.id)); res.json({ ok: true }); }));
+  router.put("/providers/:id/secrets/:secretKey", guarded(async (req, res) => { await saveDarwishAiProviderSecret(Number(req.params.id), req.params.secretKey, String(body(req).value ?? "")); res.json({ ok: true }); }));
+  router.delete("/providers/:id/secrets/:secretKey", guarded(async (req, res) => { await deleteDarwishAiProviderSecret(Number(req.params.id), req.params.secretKey); res.json({ ok: true }); }));
+  router.post("/models", guarded(async (req, res) => { res.status(201).json(await createDarwishAiProviderModel(body(req) as any)); }));
+  router.put("/models/:id", guarded(async (req, res) => { await updateDarwishAiProviderModel(Number(req.params.id), body(req) as any); res.json({ ok: true }); }));
+  router.delete("/models/:id", guarded(async (req, res) => { await deleteDarwishAiProviderModel(Number(req.params.id)); res.json({ ok: true }); }));
+  router.post("/routing/policies", guarded(async (req, res) => { res.status(201).json(await createDarwishAiRoutingPolicy(body(req) as any)); }));
+  router.put("/routing/policies/:id", guarded(async (req, res) => { await updateDarwishAiRoutingPolicy(Number(req.params.id), body(req) as any); res.json({ ok: true }); }));
+  router.delete("/routing/policies/:id", guarded(async (req, res) => { await deleteDarwishAiRoutingPolicy(Number(req.params.id)); res.json({ ok: true }); }));
+  router.post("/routing/targets", guarded(async (req, res) => { res.status(201).json(await createDarwishAiRoutingTarget(body(req) as any)); }));
+  router.put("/routing/targets/:id", guarded(async (req, res) => { await updateDarwishAiRoutingTarget(Number(req.params.id), body(req) as any); res.json({ ok: true }); }));
+  router.delete("/routing/targets/:id", guarded(async (req, res) => { await deleteDarwishAiRoutingTarget(Number(req.params.id)); res.json({ ok: true }); }));
+  return router;
+}
