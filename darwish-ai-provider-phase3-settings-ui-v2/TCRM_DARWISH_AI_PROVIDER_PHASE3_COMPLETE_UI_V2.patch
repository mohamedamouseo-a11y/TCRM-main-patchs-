+import { useEffect, useMemo, useState } from "react";
+import { Badge } from "@/components/ui/badge";
+import { Button } from "@/components/ui/button";
+import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
+import { Input } from "@/components/ui/input";
+import { Label } from "@/components/ui/label";
+import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from "@/components/ui/select";
+import { Switch } from "@/components/ui/switch";
+import { useLanguage } from "@/contexts/LanguageContext";
+import { Bot, ChevronDown, KeyRound, RefreshCw, Route, ServerCog, Trash2 } from "lucide-react";
+import { toast } from "sonner";
+
+type Provider = { id:number; providerKey:string; displayName:string; adapterType:string; baseUrl:string|null; enabled:boolean; config:Record<string,unknown>|null; configuredSecretKeys:string[] };
+type Model = { id:number; providerId:number; modelKey:string; displayName:string|null; enabled:boolean; config:Record<string,unknown>|null };
+type Policy = { id:number; routeKey:string; displayName:string; selectionStrategy:"priority"|"weighted_random"; enabled:boolean; maxAttempts:number; timeoutMs:number; config:Record<string,unknown>|null };
+type Target = { id:number; policyId:number; providerId:number; modelId:number; priority:number; weight:number; enabled:boolean; timeoutMs:number|null; config:Record<string,unknown>|null };
+type Snapshot = { providers:Provider[]; models:Model[]; policies:Policy[]; targets:Target[]; secretsReturnedInPlaintext:false };
+const API = "/api/darwish/ai-providers";
+
+async function api(path:string, init?:RequestInit) {
+  const response = await fetch(`${API}${path}`, { credentials:"include", headers:{"Content-Type":"application/json", ...(init?.headers||{})}, ...init });
+  const payload = await response.json().catch(() => ({}));
+  if (!response.ok) throw new Error(payload?.error || payload?.message || `Request failed (${response.status})`);
+  return payload;
+}
+
+export default function DarwishAiProvidersSettingsTab() {
+  const { isRTL } = useLanguage();
+  const [data,setData] = useState<Snapshot|null>(null);
+  const [loading,setLoading] = useState(true);
+  const [busy,setBusy] = useState<string|null>(null);
+  const [editingProviderId,setEditingProviderId] = useState<number|null>(null);
+  const [providerForm,setProviderForm] = useState({providerKey:"",displayName:"",adapterType:"",baseUrl:"",enabled:true});
+  const [modelForm,setModelForm] = useState({providerId:"",modelKey:"",displayName:""});
+  const [secretForm,setSecretForm] = useState({providerId:"",secretKey:"",value:""});
+  const [policyForm,setPolicyForm] = useState({routeKey:"",displayName:"",selectionStrategy:"priority" as "priority"|"weighted_random",maxAttempts:"3",timeoutMs:"60000"});
+  const [targetForm,setTargetForm] = useState({policyId:"",providerId:"",modelId:"",priority:"100",weight:"1",timeoutMs:""});
+
+  const refresh = async () => { setLoading(true); try { setData(await api("/settings")); } catch(error:any) { toast.error(error?.message||"Unable to load AI provider settings"); } finally { setLoading(false); } };
+  useEffect(() => { void refresh(); }, []);
+  const providers=data?.providers||[], models=data?.models||[], policies=data?.policies||[], targets=data?.targets||[];
+  const modelsForProvider = useMemo(() => models.filter(m => String(m.providerId)===targetForm.providerId), [models,targetForm.providerId]);
+  const run = async (key:string, action:()=>Promise<void>, success:string) => { setBusy(key); try { await action(); toast.success(success); await refresh(); } catch(error:any) { toast.error(error?.message||"Operation failed"); } finally { setBusy(null); } };
+  const resetProviderForm=()=>{setEditingProviderId(null);setProviderForm({providerKey:"",displayName:"",adapterType:"",baseUrl:"",enabled:true});};
+  const saveProvider=()=>run("provider",async()=>{const payload={...providerForm,baseUrl:providerForm.baseUrl.trim()||null,config:null}; if(editingProviderId) await api(`/providers/${editingProviderId}`,{method:"PUT",body:JSON.stringify(payload)}); else await api("/providers",{method:"POST",body:JSON.stringify(payload)}); resetProviderForm();},editingProviderId?(isRTL?"تم تحديث المزود":"Provider updated"):(isRTL?"تم إضافة المزود":"Provider added"));
