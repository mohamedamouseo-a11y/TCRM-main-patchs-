+import mysql, { type Pool, type ResultSetHeader } from "mysql2/promise";
+import {
+  encryptDarwishAiProviderSecret,
+  normalizeDarwishAiProviderDraft,
+  normalizeDarwishAiProviderModelDraft,
+} from "./darwishAiProviderFoundationService";
+
+type JsonRecord = Record<string, unknown> | null;
+
+type ProviderInput = {
+  providerKey: string;
+  displayName: string;
+  adapterType: string;
+  baseUrl?: string | null;
+  enabled?: boolean;
+  config?: Record<string, unknown> | null;
+};
+
+type ModelInput = {
+  providerId: number;
+  modelKey: string;
+  displayName?: string | null;
+  enabled?: boolean;
+  config?: Record<string, unknown> | null;
+};
+
+type PolicyInput = {
+  routeKey: string;
+  displayName: string;
+  selectionStrategy: "priority" | "weighted_random";
+  enabled?: boolean;
+  maxAttempts: number;
+  timeoutMs: number;
+  config?: Record<string, unknown> | null;
+};
+
+type TargetInput = {
+  policyId: number;
+  providerId: number;
+  modelId: number;
+  priority: number;
+  weight: number;
+  enabled?: boolean;
+  timeoutMs?: number | null;
+  config?: Record<string, unknown> | null;
+};
+
+let pool: Pool | null = null;
+
+function getPool() {
+  const databaseUrl = process.env.DATABASE_URL?.trim();
+  if (!databaseUrl) throw new Error("DATABASE_URL is required");
+  if (!pool) pool = mysql.createPool(databaseUrl);
+  return pool;
+}
+
+function id(value: unknown, field = "id") {
+  const parsed = Number(value);
+  if (!Number.isInteger(parsed) || parsed <= 0) throw new Error(`${field} must be a positive integer`);
+  return parsed;
+}
+
+function int(value: unknown, field: string, min: number, max: number) {
+  const parsed = Number(value);
+  if (!Number.isInteger(parsed) || parsed < min || parsed > max) {
+    throw new Error(`${field} must be an integer between ${min} and ${max}`);
+  }
+  return parsed;
+}
+
+function text(value: unknown, field: string, max: number) {
+  if (typeof value !== "string") throw new Error(`${field} must be a string`);
+  const normalized = value.trim();
+  if (!normalized || normalized.length > max) throw new Error(`${field} must be 1-${max} characters`);
+  return normalized;
+}
+
+function json(value: unknown): JsonRecord {
+  if (value == null) return null;
+  if (typeof value !== "object" || Array.isArray(value)) throw new Error("config must be an object");
+  return value as Record<string, unknown>;
+}
+
+function decodeJson(value: unknown): JsonRecord {
+  if (value == null) return null;
+  if (typeof value === "object") return value as Record<string, unknown>;
+  try {
+    const parsed = JSON.parse(String(value));
+    return parsed && typeof parsed === "object" && !Array.isArray(parsed) ? parsed : null;
+  } catch {
+    return null;
+  }
+}
+
+function bool(value: unknown, fallback = true) {
+  return value == null ? fallback : Boolean(value);
+}
+
+export async function getDarwishAiProviderSettingsSnapshot() {
+  const db = getPool();
+  const [providersRaw] = await db.query<any[]>(
+    `SELECT id, provider_key, display_name, adapter_type, base_url, enabled, config_json
+       FROM darwish_ai_providers ORDER BY display_name, id`
+  );
+  const [modelsRaw] = await db.query<any[]>(
+    `SELECT id, provider_id, model_key, display_name, enabled, config_json
+       FROM darwish_ai_provider_models ORDER BY provider_id, display_name, model_key, id`
+  );
+  const [secretsRaw] = await db.query<any[]>(
+    `SELECT provider_id, secret_key FROM darwish_ai_provider_secrets ORDER BY provider_id, secret_key`
+  );
+  const [policiesRaw] = await db.query<any[]>(
+    `SELECT id, route_key, display_name, selection_strategy, enabled, max_attempts, timeout_ms, config_json
+       FROM darwish_ai_routing_policies ORDER BY route_key, id`
+  );
+  const [targetsRaw] = await db.query<any[]>(
+    `SELECT id, policy_id, provider_id, model_id, priority, weight, enabled, timeout_ms, config_json
+       FROM darwish_ai_routing_targets ORDER BY policy_id, priority, id`
+  );
+
+  return {
+    providers: providersRaw.map((row) => ({
+      id: Number(row.id),
+      providerKey: row.provider_key,
+      displayName: row.display_name,
+      adapterType: row.adapter_type,
+      baseUrl: row.base_url,
+      enabled: Boolean(row.enabled),
+      config: decodeJson(row.config_json),
+      configuredSecretKeys: secretsRaw
+        .filter((secret) => Number(secret.provider_id) === Number(row.id))
+        .map((secret) => String(secret.secret_key)),
+    })),
+    models: modelsRaw.map((row) => ({
+      id: Number(row.id),
+      providerId: Number(row.provider_id),
+      modelKey: row.model_key,
+      displayName: row.display_name,
+      enabled: Boolean(row.enabled),
+      config: decodeJson(row.config_json),
+    })),
+    policies: policiesRaw.map((row) => ({
+      id: Number(row.id),
+      routeKey: row.route_key,
+      displayName: row.display_name,
+      selectionStrategy: row.selection_strategy,
+      enabled: Boolean(row.enabled),
+      maxAttempts: Number(row.max_attempts),
+      timeoutMs: Number(row.timeout_ms),
+      config: decodeJson(row.config_json),
+    })),
+    targets: targetsRaw.map((row) => ({
+      id: Number(row.id),
+      policyId: Number(row.policy_id),
+      providerId: Number(row.provider_id),
+      modelId: Number(row.model_id),
+      priority: Number(row.priority),
+      weight: Number(row.weight),
+      enabled: Boolean(row.enabled),
+      timeoutMs: row.timeout_ms == null ? null : Number(row.timeout_ms),
+      config: decodeJson(row.config_json),
+    })),
+    secretsReturnedInPlaintext: false,
+    providersHardcoded: false,
+    modelsHardcoded: false,
+  };
+}
+
+export async function createDarwishAiProvider(input: ProviderInput) {
+  const normalized = normalizeDarwishAiProviderDraft(input);
+  const [result] = await getPool().execute<ResultSetHeader>(
+    `INSERT INTO darwish_ai_providers
+      (provider_key, display_name, adapter_type, base_url, enabled, config_json)
+     VALUES (?, ?, ?, ?, ?, ?)`,
+    [normalized.providerKey, normalized.displayName, normalized.adapterType, normalized.baseUrl, normalized.enabled ? 1 : 0, normalized.config ? JSON.stringify(normalized.config) : null],
+  );
+  return { id: Number(result.insertId) };
+}
+
+export async function updateDarwishAiProvider(providerId: number, input: ProviderInput) {
+  const normalized = normalizeDarwishAiProviderDraft(input);
+  await getPool().execute(
+    `UPDATE darwish_ai_providers SET provider_key=?, display_name=?, adapter_type=?, base_url=?, enabled=?, config_json=? WHERE id=?`,
+    [normalized.providerKey, normalized.displayName, normalized.adapterType, normalized.baseUrl, normalized.enabled ? 1 : 0, normalized.config ? JSON.stringify(normalized.config) : null, id(providerId)],
+  );
+}
+
+export async function deleteDarwishAiProvider(providerId: number) {
+  const db = getPool();
+  const provider = id(providerId);
+  const [targetRows] = await db.query<any[]>("SELECT COUNT(*) AS count FROM darwish_ai_routing_targets WHERE provider_id=?", [provider]);
+  if (Number(targetRows[0]?.count || 0) > 0) throw new Error("Provider is used by routing targets");
+  await db.execute("DELETE FROM darwish_ai_provider_secrets WHERE provider_id=?", [provider]);
+  await db.execute("DELETE FROM darwish_ai_provider_models WHERE provider_id=?", [provider]);
+  await db.execute("DELETE FROM darwish_ai_providers WHERE id=?", [provider]);
+}
+
+export async function saveDarwishAiProviderSecret(providerId: number, secretKey: string, plaintext: string) {
+  const provider = id(providerId, "providerId");
+  const encrypted = encryptDarwishAiProviderSecret(text(secretKey, "secretKey", 128), text(plaintext, "secret", 20000));
+  await getPool().execute(
+    `INSERT INTO darwish_ai_provider_secrets (provider_id, secret_key, encrypted_value, key_version)
+     VALUES (?, ?, ?, ?) ON DUPLICATE KEY UPDATE encrypted_value=VALUES(encrypted_value), key_version=VALUES(key_version)`,
+    [provider, encrypted.secretKey, encrypted.encryptedValue, encrypted.keyVersion],
+  );
+}
+
+export async function deleteDarwishAiProviderSecret(providerId: number, secretKey: string) {
+  await getPool().execute("DELETE FROM darwish_ai_provider_secrets WHERE provider_id=? AND secret_key=?", [id(providerId, "providerId"), text(secretKey, "secretKey", 128)]);
+}
+
+export async function createDarwishAiProviderModel(input: ModelInput) {
+  const normalized = normalizeDarwishAiProviderModelDraft(input);
+  const [result] = await getPool().execute<ResultSetHeader>(
+    `INSERT INTO darwish_ai_provider_models (provider_id, model_key, display_name, enabled, config_json) VALUES (?, ?, ?, ?, ?)`,
+    [id(input.providerId, "providerId"), normalized.modelKey, normalized.displayName, normalized.enabled ? 1 : 0, normalized.config ? JSON.stringify(normalized.config) : null],
+  );
+  return { id: Number(result.insertId) };
+}
+
+export async function updateDarwishAiProviderModel(modelId: number, input: ModelInput) {
+  const normalized = normalizeDarwishAiProviderModelDraft(input);
+  await getPool().execute(
+    `UPDATE darwish_ai_provider_models SET provider_id=?, model_key=?, display_name=?, enabled=?, config_json=? WHERE id=?`,
+    [id(input.providerId, "providerId"), normalized.modelKey, normalized.displayName, normalized.enabled ? 1 : 0, normalized.config ? JSON.stringify(normalized.config) : null, id(modelId)],
+  );
+}
+
+export async function deleteDarwishAiProviderModel(modelId: number) {
+  const model = id(modelId, "modelId");
+  const [targetRows] = await getPool().query<any[]>("SELECT COUNT(*) AS count FROM darwish_ai_routing_targets WHERE model_id=?", [model]);
+  if (Number(targetRows[0]?.count || 0) > 0) throw new Error("Model is used by routing targets");
+  await getPool().execute("DELETE FROM darwish_ai_provider_models WHERE id=?", [model]);
+}
+
+export async function createDarwishAiRoutingPolicy(input: PolicyInput) {
+  const routeKey = text(input.routeKey, "routeKey", 128).toLowerCase();
+  if (!/^[a-z0-9][a-z0-9._-]{0,127}$/.test(routeKey)) throw new Error("routeKey contains unsupported characters");
+  if (!["priority", "weighted_random"].includes(input.selectionStrategy)) throw new Error("Unsupported selectionStrategy");
+  const [result] = await getPool().execute<ResultSetHeader>(
+    `INSERT INTO darwish_ai_routing_policies (route_key, display_name, selection_strategy, enabled, max_attempts, timeout_ms, config_json) VALUES (?, ?, ?, ?, ?, ?, ?)`,
+    [routeKey, text(input.displayName, "displayName", 191), input.selectionStrategy, bool(input.enabled) ? 1 : 0, int(input.maxAttempts, "maxAttempts", 1, 100), int(input.timeoutMs, "timeoutMs", 100, 600000), json(input.config) ? JSON.stringify(input.config) : null],
+  );
+  return { id: Number(result.insertId) };
+}
+
+export async function updateDarwishAiRoutingPolicy(policyId: number, input: PolicyInput) {
+  const routeKey = text(input.routeKey, "routeKey", 128).toLowerCase();
+  if (!/^[a-z0-9][a-z0-9._-]{0,127}$/.test(routeKey)) throw new Error("routeKey contains unsupported characters");
+  if (!["priority", "weighted_random"].includes(input.selectionStrategy)) throw new Error("Unsupported selectionStrategy");
+  await getPool().execute(
+    `UPDATE darwish_ai_routing_policies SET route_key=?, display_name=?, selection_strategy=?, enabled=?, max_attempts=?, timeout_ms=?, config_json=? WHERE id=?`,
+    [routeKey, text(input.displayName, "displayName", 191), input.selectionStrategy, bool(input.enabled) ? 1 : 0, int(input.maxAttempts, "maxAttempts", 1, 100), int(input.timeoutMs, "timeoutMs", 100, 600000), json(input.config) ? JSON.stringify(input.config) : null, id(policyId)],
+  );
+}
+
+export async function deleteDarwishAiRoutingPolicy(policyId: number) {
+  const policy = id(policyId, "policyId");
+  await getPool().execute("DELETE FROM darwish_ai_routing_targets WHERE policy_id=?", [policy]);
+  await getPool().execute("DELETE FROM darwish_ai_routing_policies WHERE id=?", [policy]);
+}
+
+export async function createDarwishAiRoutingTarget(input: TargetInput) {
+  const [result] = await getPool().execute<ResultSetHeader>(
+    `INSERT INTO darwish_ai_routing_targets (policy_id, provider_id, model_id, priority, weight, enabled, timeout_ms, config_json) VALUES (?, ?, ?, ?, ?, ?, ?, ?)`,
+    [id(input.policyId, "policyId"), id(input.providerId, "providerId"), id(input.modelId, "modelId"), int(input.priority, "priority", 0, 1000000), int(input.weight, "weight", 1, 1000000), bool(input.enabled) ? 1 : 0, input.timeoutMs == null ? null : int(input.timeoutMs, "timeoutMs", 100, 600000), json(input.config) ? JSON.stringify(input.config) : null],
+  );
