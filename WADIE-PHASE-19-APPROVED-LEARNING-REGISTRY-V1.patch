+import { getWadieLearningReviewSnapshot } from "./wadieLearningReviewService";
+
+export async function getWadieApprovedLearningRegistry() {
+  const review = await getWadieLearningReviewSnapshot();
+
+  const entries = review.candidates
+    .filter((item) => item.reviewStatus === "approved")
+    .map((item) => ({
+      registryId: item.candidateId,
+      kind: item.kind,
+      key: item.key,
+      disposition: item.disposition,
+      evidenceBand: item.evidenceBand,
+      reviewed: item.reviewed,
+      qualityScore: item.qualityScore,
+      improvedRatePct: item.improvedRatePct,
+      worseRatePct: item.worseRatePct,
+      reviewCoveragePct: item.reviewCoveragePct,
+      rationale: item.rationale,
+      approvedAt: item.reviewedAt,
+      approvedBy: item.reviewedBy,
+      approvalNote: item.reviewNote,
+      stagingStatus: "awaiting-playbook-curation" as const,
+      activationStatus: "inactive" as const,
+      eligibleForPhase20Curation: true as const,
+    }))
+    .sort((a, b) =>
+      String(b.approvedAt ?? "").localeCompare(String(a.approvedAt ?? ""))
+      || String(a.kind).localeCompare(String(b.kind))
+      || String(a.key).localeCompare(String(b.key)),
+    );
+
+  return {
+    phase: "approved-learning-registry-v1" as const,
+    mode: "read-only-human-approved-playbook-staging" as const,
+    totals: {
+      approved: entries.length,
+      platform: entries.filter((item) => item.kind === "platform").length,
+      priority: entries.filter((item) => item.kind === "priority").length,
+      category: entries.filter((item) => item.kind === "category").length,
+      account: entries.filter((item) => item.kind === "account").length,
+    },
+    entries: entries.slice(0, 100),
+    generatedAt: new Date().toISOString(),
+    source: "phase18-human-learning-review-approval" as const,
+    humanApprovedOnly: true as const,
+    registryDerivedFromPhase18Only: true as const,
+    registryPersistenceEnabled: false as const,
+    playbookStagingEnabled: true as const,
+    playbookCurationRequired: true as const,
+    playbookActivationEnabled: false as const,
+    learningMemoryWritesApplied: false as const,
+    automaticRecommendationReuseApplied: false as const,
+    liveMcpCallsApplied: false as const,
+    adPlatformMutationsApplied: false as const,
+    automaticOptimizationLearningApplied: false as const,
+    automaticExecutionPolicyChangesApplied: false as const,
+    executionStillRequiresHumanApproval: true as const,
+  };
+}
