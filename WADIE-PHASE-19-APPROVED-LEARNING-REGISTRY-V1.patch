+import { Activity, Brain, CheckCircle2, ShieldCheck, Sparkles } from "lucide-react";
+import { Badge } from "@/components/ui/badge";
+import { Button } from "@/components/ui/button";
+import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
+import { useLanguage } from "@/contexts/LanguageContext";
+import { trpc } from "@/lib/trpc";
+
+function score(value: number | null | undefined) {
+  return value === null || value === undefined ? "—" : `${value.toFixed(1)}/100`;
+}
+
+function pct(value: number | null | undefined) {
+  return value === null || value === undefined ? "—" : `${value.toFixed(1)}%`;
+}
+
+export default function WadieApprovedLearningRegistry() {
+  const { isRTL } = useLanguage();
+  const text = (en: string, ar: string) => (isRTL ? ar : en);
+  const query = trpc.wadie.approvedLearningRegistry.useQuery(undefined, {
+    refetchOnWindowFocus: false,
+    refetchInterval: 60_000,
+  });
+  const data = query.data;
+
+  const kindLabel = (kind: string) => {
+    if (kind === "platform") return text("Platform", "المنصة");
+    if (kind === "priority") return text("Priority", "الأولوية");
+    if (kind === "category") return text("Category", "النوع");
+    return text("Account", "الحساب");
+  };
+
+  return (
+    <Card data-wadie-approved-learning-registry="phase19-v1" className="rounded-2xl border-border/70 bg-card shadow-[0_14px_34px_-28px_rgba(15,23,42,0.72)]">
+      <CardHeader className="pb-3">
+        <div className="flex flex-wrap items-center justify-between gap-3">
+          <div>
+            <CardTitle className="flex items-center gap-2 text-xl">
+              <Brain className="h-5 w-5 text-indigo-600" />
+              {text("Approved Learning Registry", "سجل التعلم المعتمد")}
+            </CardTitle>
+            <p className="mt-1 text-xs font-semibold text-muted-foreground">
+              {text(
+                "Human-approved Phase 18 candidates staged for future playbook curation. Nothing in this registry is active learning.",
+                "مرشحات Phase 18 المعتمدة بشرياً والمجهزة لتنظيمها لاحقاً في Playbooks. لا يمثل أي عنصر هنا تعلماً مفعلاً.",
+              )}
+            </p>
+          </div>
+          <div className="flex flex-wrap gap-2">
+            <Badge variant="outline" className="rounded-full px-3 py-1 font-bold">
+              <ShieldCheck className="me-1 h-3.5 w-3.5 text-emerald-500" />
+              {text("Approved only", "المعتمد فقط")}
+            </Badge>
+            <Badge variant="outline" className="rounded-full px-3 py-1 font-bold">
+              <Sparkles className="me-1 h-3.5 w-3.5 text-indigo-500" />
+              {text("Staged, not active", "مجهز وغير مفعل")}
+            </Badge>
+            <Button variant="outline" size="sm" className="h-9 rounded-xl font-bold" disabled={query.isFetching} onClick={() => void query.refetch()}>
+              <Activity className={`me-2 h-4 w-4 ${query.isFetching ? "animate-spin" : ""}`} />
+              {text("Refresh registry", "تحديث السجل")}
+            </Button>
+          </div>
+        </div>
+      </CardHeader>
+
+      <CardContent className="space-y-4">
+        {data && (
+          <>
+            <div className="grid grid-cols-2 gap-2 md:grid-cols-5">
+              {[
+                [text("Approved", "معتمد"), data.totals.approved],
+                [text("Platform", "منصة"), data.totals.platform],
+                [text("Priority", "أولوية"), data.totals.priority],
+                [text("Category", "نوع"), data.totals.category],
+                [text("Account", "حساب"), data.totals.account],
+              ].map(([label, value]) => (
+                <div key={String(label)} className="rounded-xl border border-border/60 bg-background/55 p-3">
+                  <p className="text-[10px] font-black uppercase tracking-[0.08em] text-muted-foreground">{label}</p>
+                  <p className="mt-1 text-lg font-black">{value}</p>
+                </div>
+              ))}
+            </div>
+
+            <div className="grid gap-3 lg:grid-cols-2">
+              {data.entries.slice(0, 24).map((item) => (
+                <div key={item.registryId} className="rounded-2xl border border-border/60 bg-background/45 p-4">
+                  <div className="flex flex-wrap items-center justify-between gap-2">
+                    <div className="flex min-w-0 flex-wrap items-center gap-2">
+                      <CheckCircle2 className="h-4 w-4 shrink-0 text-emerald-500" />
+                      <Badge variant="outline" className="rounded-full text-[10px]">{kindLabel(item.kind)}</Badge>
+                      <span className="truncate text-xs font-black">{item.key}</span>
+                    </div>
+                    <Badge variant="secondary" className="rounded-full text-[10px]">
+                      {text("Awaiting playbook curation", "بانتظار تنظيم Playbook")}
+                    </Badge>
+                  </div>
+
+                  <div className="mt-3 grid grid-cols-2 gap-2 text-[10px] font-semibold text-muted-foreground md:grid-cols-4">
+                    <span>{text("Reviewed", "مراجعة")}: {item.reviewed}</span>
+                    <span>{text("Quality", "الجودة")}: {score(item.qualityScore)}</span>
+                    <span>{text("Improved", "التحسن")}: {pct(item.improvedRatePct)}</span>
+                    <span>{text("Coverage", "التغطية")}: {pct(item.reviewCoveragePct)}</span>
