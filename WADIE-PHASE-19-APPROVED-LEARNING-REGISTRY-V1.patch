+                    </p>
+                  )}
+                  <div className="mt-3 flex flex-wrap items-center justify-between gap-2 text-[10px] font-semibold text-muted-foreground">
+                    <span>{text("Source disposition", "تصنيف المصدر")}: {item.disposition}</span>
+                    <span>{text("Activation", "التفعيل")}: {text("Inactive", "غير مفعل")}</span>
+                  </div>
+                </div>
+              ))}
+            </div>
+
+            {data.entries.length === 0 && (
+              <div className="rounded-xl border border-dashed border-border px-4 py-5 text-center text-xs font-semibold text-muted-foreground">
+                {text("No human-approved learning candidates are staged yet.", "لا توجد مرشحات تعلم معتمدة بشرياً ومجهزة حتى الآن.")}
+              </div>
+            )}
+          </>
+        )}
+
+        {query.error && <p className="text-xs font-semibold text-destructive">{query.error.message}</p>}
+        <p className="text-[10px] font-semibold text-muted-foreground">
+          {text(
+            "Phase 19 is a read-only registry derived from Phase 18 approvals. It creates no learning memory, activates no playbook, reuses no recommendation automatically, calls no MCP tools, changes no ad platform, and changes no execution policy.",
+            "Phase 19 سجل للقراءة فقط مشتق من اعتمادات Phase 18. لا ينشئ ذاكرة تعلم، ولا يفعّل Playbook، ولا يعيد استخدام توصيات تلقائياً، ولا يستدعي MCP، ولا يعدل منصات الإعلانات أو سياسة التنفيذ.",
+          )}
+        </p>
+      </CardContent>
+    </Card>
+  );
+}
