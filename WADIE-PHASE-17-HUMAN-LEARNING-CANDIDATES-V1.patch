+import { getWadieRecommendationGuardrails } from "./wadieRecommendationGuardrailService";
+
+type Disposition = "promote" | "revise" | "observe" | "collect-evidence";
+
+function dispositionFor(advisory: string): Disposition {
+  if (advisory === "promising") return "promote";
+  if (advisory === "caution") return "revise";
+  if (advisory === "mixed") return "observe";
+  return "collect-evidence";
+}
+
+function weight(disposition: Disposition) {
+  switch (disposition) {
+    case "revise": return 4;
+    case "promote": return 3;
+    case "collect-evidence": return 2;
+    case "observe": return 1;
+  }
+}
+
+function rationaleFor(disposition: Disposition, guidance: string) {
+  switch (disposition) {
+    case "promote":
+      return `Promising historical evidence. Human reviewers may consider this pattern as a future playbook candidate. ${guidance}`;
+    case "revise":
+      return `Historical outcomes indicate risk. Human reviewers should revise the pattern before any future reuse. ${guidance}`;
+    case "observe":
+      return `The evidence is mixed. Keep the pattern under observation and collect more reviewed outcomes. ${guidance}`;
+    case "collect-evidence":
+      return `There is not enough evidence to form a reusable lesson. Collect more human-reviewed outcomes first. ${guidance}`;
+  }
+}
+
+export async function getWadieLearningCandidates() {
+  const guardrails = await getWadieRecommendationGuardrails();
+
+  const candidates = guardrails.segments
+    .map((segment) => {
+      const disposition = dispositionFor(segment.advisory);
+      return {
+        kind: segment.kind,
+        key: segment.key,
+        disposition,
+        evidenceBand: segment.evidenceBand,
+        reviewed: segment.reviewed,
+        qualityScore: segment.qualityScore,
+        improvedRatePct: segment.improvedRatePct,
+        worseRatePct: segment.worseRatePct,
+        reviewCoveragePct: segment.reviewCoveragePct,
+        rationale: rationaleFor(disposition, segment.guidance),
+      };
+    })
+    .sort((a, b) =>
+      weight(b.disposition) - weight(a.disposition)
+      || b.reviewed - a.reviewed
+      || String(a.key).localeCompare(String(b.key)),
+    );
+
+  return {
+    phase: "human-learning-candidates-v1" as const,
+    mode: "read-only-human-learning-review" as const,
+    totals: {
+      candidates: candidates.length,
+      promote: candidates.filter((item) => item.disposition === "promote").length,
+      revise: candidates.filter((item) => item.disposition === "revise").length,
+      observe: candidates.filter((item) => item.disposition === "observe").length,
+      collectEvidence: candidates.filter((item) => item.disposition === "collect-evidence").length,
+    },
+    candidates: candidates.slice(0, 100),
+    priorityReview: candidates.filter((item) => item.disposition === "revise" || item.disposition === "promote").slice(0, 20),
+    generatedAt: new Date().toISOString(),
+    source: "phase16-recommendation-confidence-guardrails" as const,
+    humanReviewRequired: true as const,
+    learningMemoryWritesApplied: false as const,
+    liveMcpCallsApplied: false as const,
+    adPlatformMutationsApplied: false as const,
+    automaticOptimizationLearningApplied: false as const,
+    automaticExecutionPolicyChangesApplied: false as const,
+    executionStillRequiresHumanApproval: true as const,
+  };
+}
