+function score(value: number | null | undefined) {
+  return value === null || value === undefined ? "—" : `${value.toFixed(1)}/100`;
+}
+
+function pct(value: number | null | undefined) {
+  return value === null || value === undefined ? "—" : `${value.toFixed(1)}%`;
+}
+
+function variantFor(disposition: string): "destructive" | "secondary" | "outline" {
+  if (disposition === "revise") return "destructive";
+  if (disposition === "promote") return "secondary";
+  return "outline";
+}
+
+export default function WadieLearningCandidates() {
+  const { isRTL } = useLanguage();
+  const text = (en: string, ar: string) => (isRTL ? ar : en);
+  const query = trpc.wadie.learningCandidates.useQuery(undefined, {
