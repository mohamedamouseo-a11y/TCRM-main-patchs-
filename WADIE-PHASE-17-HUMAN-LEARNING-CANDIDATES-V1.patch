+        {query.error && <p className="text-xs font-semibold text-destructive">{query.error.message}</p>}
+        <p className="text-[10px] font-semibold text-muted-foreground">
+          {text(
+            "Phase 17 only prepares candidates for human review. It writes no learning memory, calls no MCP tools, changes no ad platform, and never changes execution policy automatically.",
+            "Phase 17 يجهز مرشحات للمراجعة البشرية فقط. لا يكتب ذاكرة تعلم، ولا يستدعي MCP، ولا يعدل منصات الإعلانات، ولا يغير سياسة التنفيذ تلقائياً.",
+          )}
+        </p>
+      </CardContent>
+    </Card>
+  );
+}
