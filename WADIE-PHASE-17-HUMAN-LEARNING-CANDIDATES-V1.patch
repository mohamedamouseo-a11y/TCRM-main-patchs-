+    if (kind === "category") return text("Category", "النوع");
+    return text("Account", "الحساب");
+  };
+
+  const dispositionLabel = (value: string) => {
+    if (value === "promote") return text("Candidate to promote", "مرشح للتعزيز");
+    if (value === "revise") return text("Revise before reuse", "يحتاج مراجعة قبل إعادة الاستخدام");
+    if (value === "observe") return text("Keep observing", "استمرار المراقبة");
