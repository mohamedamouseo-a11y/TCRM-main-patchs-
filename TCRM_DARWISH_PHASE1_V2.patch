+  uniqueIndex("uq_darwish_group_links_chat").on(table.whatsappChatId),
+  index("idx_darwish_group_links_client").on(table.linkedClientId),
+  index("idx_darwish_group_links_manager").on(table.linkedAccountManagerId),
+  index("idx_darwish_group_links_status").on(table.resolutionStatus, table.lastEvaluatedAt),
+]);
+
+export type DarwishGroupJob = typeof darwishGroupJobs.$inferSelect;
+export type DarwishGroupLink = typeof darwishGroupLinks.$inferSelect;
