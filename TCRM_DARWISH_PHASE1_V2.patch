+  index("idx_darwish_group_jobs_chat").on(table.whatsappChatId, table.status),
+]);
+
+export const darwishGroupLinks = mysqlTable("darwish_group_links", {
+  id: int().autoincrement().notNull(),
+  whatsappChatId: int("whatsapp_chat_id").notNull(),
+  linkedClientId: int("linked_client_id"),
+  linkedAccountManagerId: int("linked_account_manager_id"),
+  resolutionStatus: mysqlEnum("resolution_status", ["Unresolved", "Resolved", "Ambiguous"]).default("Unresolved").notNull(),
+  confidence: int().default(0).notNull(),
+  reason: varchar({ length: 500 }),
+  evidence: json(),
+  resolvedAt: timestamp("resolved_at", { mode: "string" }),
+  lastEvaluatedAt: timestamp("last_evaluated_at", { mode: "string" }).default(sql`(now())`).notNull(),
+  createdAt: timestamp("created_at", { mode: "string" }).default(sql`(now())`).notNull(),
+  updatedAt: timestamp("updated_at", { mode: "string" }).default(sql`(now())`).onUpdateNow().notNull(),
+}, (table) => [
