diff --git a/server/services/darwish/darwishGroupResolver.test.ts b/server/services/darwish/darwishGroupResolver.test.ts
new file mode 100644
index 0000000..af36f48
--- /dev/null
+++ b/server/services/darwish/darwishGroupResolver.test.ts
@@ -0,0 +1,80 @@
+import { describe, expect, it } from "vitest";
+import {
+  extractDarwishClientPhones,
+  normalizeDarwishPhone,
+  resolveDarwishClientCandidates,
+} from "./darwishGroupResolver";
+
+describe("Darwish Phase 1 group resolver", () => {
+  it("normalizes international phone formatting without fuzzy guessing", () => {
+    expect(normalizeDarwishPhone("+20 100 123 4567")).toBe("201001234567");
+    expect(normalizeDarwishPhone("0020-100-123-4567")).toBe("201001234567");
+    expect(normalizeDarwishPhone("123")).toBeNull();
+  });
+
+  it("extracts primary, contact and legacy other phones", () => {
+    expect(
+      extractDarwishClientPhones({
+        id: 1,
+        phone: "+20 100 000 0001",
+        contactPhone: "201000000002",
+        otherPhones: '["+20 100 000 0003", "201000000004"]',
+      }),
+    ).toEqual([
+      "201000000001",
+      "201000000002",
+      "201000000003",
+      "201000000004",
+    ]);
+  });
+
+  it("resolves a single client from participant evidence", () => {
+    const result = resolveDarwishClientCandidates({
+      participantPhones: ["+20 100 000 0001"],
+      senderJids: [],
+      clients: [
+        { id: 11, phone: "201000000001", accountManagerId: 7 },
+        { id: 12, phone: "201000000099", accountManagerId: 8 },
+      ],
+    });
+    expect(result.status).toBe("Resolved");
+    expect(result.clientId).toBe(11);
+    expect(result.accountManagerId).toBe(7);
+    expect(result.confidence).toBe(95);
+  });
+
+  it("uses inbound sender JIDs when participant rows are missing", () => {
+    const result = resolveDarwishClientCandidates({
+      participantPhones: [],
+      senderJids: ["201000000001@s.whatsapp.net"],
+      clients: [{ id: 11, phone: "201000000001", accountManagerId: 7 }],
+    });
+    expect(result.status).toBe("Resolved");
+    expect(result.clientId).toBe(11);
+    expect(result.confidence).toBe(80);
+  });
+
+  it("refuses to guess when multiple clients match the same group", () => {
+    const result = resolveDarwishClientCandidates({
+      participantPhones: ["201000000001", "201000000002"],
+      senderJids: [],
+      clients: [
+        { id: 11, phone: "201000000001", accountManagerId: 7 },
+        { id: 12, phone: "201000000002", accountManagerId: 8 },
+      ],
+    });
+    expect(result.status).toBe("Ambiguous");
+    expect(result.clientId).toBeNull();
+    expect(result.accountManagerId).toBeNull();
+  });
+
+  it("stays unresolved when there is no exact match", () => {
+    const result = resolveDarwishClientCandidates({
+      participantPhones: ["201999999999"],
+      senderJids: [],
+      clients: [{ id: 11, phone: "201000000001", accountManagerId: 7 }],
+    });
+    expect(result.status).toBe("Unresolved");
+    expect(result.clientId).toBeNull();
+  });
+});
diff --git a/server/services/darwish/darwishGroupResolver.ts b/server/services/darwish/darwishGroupResolver.ts
new file mode 100644
index 0000000..50c3b8a
--- /dev/null
+++ b/server/services/darwish/darwishGroupResolver.ts
@@ -0,0 +1,148 @@
+export type DarwishClientCandidate = {
+  id: number;
+  phone?: string | null;
+  contactPhone?: string | null;
+  otherPhones?: string | null;
+  accountManagerId?: number | null;
+};
+
+export type DarwishResolution = {
+  status: "Unresolved" | "Resolved" | "Ambiguous";
+  clientId: number | null;
+  accountManagerId: number | null;
+  confidence: number;
+  reason: string;
+  evidence: {
+    participantEvidenceCount: number;
+    senderEvidenceCount: number;
+    matchedClientIds: number[];
+    source: "participants" | "senders" | "participants+senders" | "none";
+  };
+};
+
+export function normalizeDarwishPhone(value: unknown): string | null {
+  let digits = String(value ?? "").replace(/\D+/g, "");
+  if (digits.startsWith("00")) digits = digits.slice(2);
+  if (digits.length < 7 || digits.length > 18) return null;
+  return digits;
+}
+
+export function darwishPhoneFromJid(value: unknown): string | null {
+  const local = String(value ?? "").trim().split("@")[0] || "";
+  return normalizeDarwishPhone(local);
+}
+
+function parseOtherPhones(value: unknown): string[] {
+  const raw = String(value ?? "").trim();
+  if (!raw) return [];
+  try {
+    const parsed = JSON.parse(raw);
+    if (Array.isArray(parsed)) return parsed.flatMap(item => parseOtherPhones(item));
+  } catch {
+    // Legacy values are commonly comma/space/newline separated.
+  }
+  return raw
+    .split(/[\s,;|/]+/g)
+    .map(normalizeDarwishPhone)
+    .filter((phone): phone is string => Boolean(phone));
+}
+
+export function extractDarwishClientPhones(client: DarwishClientCandidate): string[] {
+  return [
+    normalizeDarwishPhone(client.phone),
+    normalizeDarwishPhone(client.contactPhone),
+    ...parseOtherPhones(client.otherPhones),
+  ].filter((phone, index, all): phone is string => Boolean(phone) && all.indexOf(phone) === index);
+}
+
+export function resolveDarwishClientCandidates(input: {
+  participantPhones?: unknown[];
+  senderJids?: unknown[];
+  clients: DarwishClientCandidate[];
+}): DarwishResolution {
+  const participantPhones = new Set(
+    (input.participantPhones || [])
+      .map(normalizeDarwishPhone)
+      .filter((phone): phone is string => Boolean(phone)),
+  );
+  const senderPhones = new Set(
+    (input.senderJids || [])
+      .map(darwishPhoneFromJid)
+      .filter((phone): phone is string => Boolean(phone)),
+  );
+
+  const participantMatches = new Set<number>();
+  const senderMatches = new Set<number>();
+  const byId = new Map<number, DarwishClientCandidate>();
+
+  for (const client of input.clients) {
+    const clientId = Number(client.id);
+    if (!Number.isInteger(clientId) || clientId <= 0) continue;
+    byId.set(clientId, client);
+    const phones = extractDarwishClientPhones(client);
+    if (phones.some(phone => participantPhones.has(phone))) participantMatches.add(clientId);
+    if (phones.some(phone => senderPhones.has(phone))) senderMatches.add(clientId);
+  }
+
+  const matchedClientIds = [...new Set([...participantMatches, ...senderMatches])].sort((a, b) => a - b);
+  const source =
+    participantMatches.size && senderMatches.size
+      ? "participants+senders"
+      : participantMatches.size
+        ? "participants"
+        : senderMatches.size
+          ? "senders"
+          : "none";
+
+  const evidence = {
+    participantEvidenceCount: participantPhones.size,
+    senderEvidenceCount: senderPhones.size,
+    matchedClientIds,
+    source,
+  } as DarwishResolution["evidence"];
+
+  if (!matchedClientIds.length) {
+    return {
+      status: "Unresolved",
+      clientId: null,
+      accountManagerId: null,
+      confidence: 0,
+      reason: "No exact normalized customer phone match was found in group participants or inbound senders.",
+      evidence,
+    };
+  }
+
+  if (matchedClientIds.length > 1) {
+    return {
+      status: "Ambiguous",
+      clientId: null,
+      accountManagerId: null,
+      confidence: 0,
+      reason: "More than one TCRM client matched the group evidence; Darwish will not guess.",
+      evidence,
+    };
+  }
+
+  const clientId = matchedClientIds[0];
+  const client = byId.get(clientId);
+  const matchedByParticipants = participantMatches.has(clientId);
+  const matchedBySenders = senderMatches.has(clientId);
+  const confidence = matchedByParticipants && matchedBySenders ? 100 : matchedByParticipants ? 95 : 80;
+
+  return {
+    status: "Resolved",
+    clientId,
+    accountManagerId:
+      client?.accountManagerId && Number(client.accountManagerId) > 0
+        ? Number(client.accountManagerId)
+        : null,
+    confidence,
+    reason:
+      matchedByParticipants && matchedBySenders
+        ? "A single client matched both group participant and inbound sender evidence."
+        : matchedByParticipants
+          ? "A single client matched an exact normalized group participant phone."
+          : "A single client matched an exact normalized inbound group sender phone.",
+    evidence,
+  };
+}
diff --git a/server/services/darwish/darwishQueueService.ts b/server/services/darwish/darwishQueueService.ts
new file mode 100644
index 0000000..39733d0
--- /dev/null
+++ b/server/services/darwish/darwishQueueService.ts
@@ -0,0 +1,361 @@
+import crypto from "node:crypto";
+import { and, asc, desc, eq, gt, isNull, lte, or, sql } from "drizzle-orm";
+import {
+  clients,
+  darwishGroupJobs,
+  darwishGroupLinks,
+  whatsappChats,
+  whatsappGroupParticipants,
+  whatsappMessages,
+} from "../../../drizzle/schema";
+import { getDb } from "../../db";
+import { resolveDarwishClientCandidates } from "./darwishGroupResolver";
+
+let workerTimer: ReturnType<typeof setInterval> | null = null;
+let reconcileTimer: ReturnType<typeof setInterval> | null = null;
+let workerBusy = false;
+let reconcileCursor = 0;
+
+function enabled() {
+  return String(process.env.DARWISH_ENABLED || "true").toLowerCase() !== "false";
+}
+
+function retryDelaySeconds(attempt: number) {
+  return Math.min(300, Math.max(5, 5 * 2 ** Math.max(0, attempt - 1)));
+}
+
+export async function enqueueDarwishGroupMessage(input: {
+  whatsappSessionId: number;
+  whatsappChatId: number;
+  whatsappMessageId: number;
+  providerMessageId: string;
+  direction: "Inbound" | "Outbound";
+}) {
+  if (!enabled()) return { queued: false, reason: "disabled" };
+  const db = await getDb();
+  if (!db) return { queued: false, reason: "database_unavailable" };
+
+  await db
+    .insert(darwishGroupJobs)
+    .values({
+      whatsappSessionId: Number(input.whatsappSessionId),
+      whatsappChatId: Number(input.whatsappChatId),
+      whatsappMessageId: Number(input.whatsappMessageId),
+      providerMessageId: String(input.providerMessageId).slice(0, 255),
+      direction: input.direction,
+      status: "Pending",
+      availableAt: new Date() as any,
+    })
+    .onDuplicateKeyUpdate({
+      set: {
+        providerMessageId: String(input.providerMessageId).slice(0, 255),
+        direction: input.direction,
+        updatedAt: new Date() as any,
+      },
+    });
+
+  return { queued: true };
+}
+
+async function recoverStaleJobs() {
+  const db = await getDb();
+  if (!db) return;
+  await db
+    .update(darwishGroupJobs)
+    .set({
+      status: "Pending",
+      lockToken: null,
+      lockedAt: null,
+      availableAt: new Date() as any,
+    })
+    .where(
+      and(
+        eq(darwishGroupJobs.status, "Processing"),
+        lte(darwishGroupJobs.lockedAt, sql`DATE_SUB(NOW(), INTERVAL 10 MINUTE)` as any),
+      ),
+    );
+}
+
+async function claimNextJob() {
+  const db = await getDb();
+  if (!db) return null;
+  const [candidate] = await db
+    .select()
+    .from(darwishGroupJobs)
+    .where(
+      and(
+        or(eq(darwishGroupJobs.status, "Pending"), eq(darwishGroupJobs.status, "Retry")),
+        lte(darwishGroupJobs.availableAt, new Date() as any),
+      ),
+    )
+    .orderBy(asc(darwishGroupJobs.id))
+    .limit(1);
+  if (!candidate) return null;
+
+  const lockToken = crypto.randomUUID();
+  const result: any = await db
+    .update(darwishGroupJobs)
+    .set({
+      status: "Processing",
+      lockToken,
+      lockedAt: new Date() as any,
+      attemptCount: sql`${darwishGroupJobs.attemptCount} + 1`,
+    })
+    .where(
+      and(
+        eq(darwishGroupJobs.id, Number(candidate.id)),
+        or(eq(darwishGroupJobs.status, "Pending"), eq(darwishGroupJobs.status, "Retry")),
+      ),
+    );
+  const affected = Number(result?.[0]?.affectedRows ?? result?.affectedRows ?? 0);
+  if (!affected) return null;
+
+  const [claimed] = await db
+    .select()
+    .from(darwishGroupJobs)
+    .where(and(eq(darwishGroupJobs.id, Number(candidate.id)), eq(darwishGroupJobs.lockToken, lockToken)))
+    .limit(1);
+  return claimed || null;
+}
+
+async function completeJob(jobId: number, lockToken: string | null) {
+  const db = await getDb();
+  if (!db) return;
+  await db
+    .update(darwishGroupJobs)
+    .set({
+      status: "Completed",
+      completedAt: new Date() as any,
+      lockToken: null,
+      lockedAt: null,
+      lastError: null,
+    })
+    .where(
+      and(
+        eq(darwishGroupJobs.id, jobId),
+        eq(darwishGroupJobs.lockToken, String(lockToken || "")),
+      ),
+    );
+}
+
+async function failJob(job: any, error: unknown) {
+  const db = await getDb();
+  if (!db) return;
+  const attemptCount = Number(job.attemptCount || 0);
+  const maxAttempts = Number(job.maxAttempts || 5);
+  const terminal = attemptCount >= maxAttempts;
+  await db
+    .update(darwishGroupJobs)
+    .set({
+      status: terminal ? "Failed" : "Retry",
+      availableAt: terminal
+        ? (new Date() as any)
+        : (new Date(Date.now() + retryDelaySeconds(attemptCount) * 1000) as any),
+      lockToken: null,
+      lockedAt: null,
+      lastError: String((error as any)?.message || error || "Unknown Darwish queue error").slice(0, 4000),
+    })
+    .where(
+      and(
+        eq(darwishGroupJobs.id, Number(job.id)),
+        eq(darwishGroupJobs.lockToken, String(job.lockToken || "")),
+      ),
+    );
+}
+
+export async function resolveDarwishGroupLink(chatId: number) {
+  const db = await getDb();
+  if (!db) throw new Error("Database is not available");
+
+  const [chat] = await db
+    .select({
+      id: whatsappChats.id,
+      chatType: whatsappChats.chatType,
+    })
+    .from(whatsappChats)
+    .where(and(eq(whatsappChats.id, Number(chatId)), isNull(whatsappChats.deletedAt)))
+    .limit(1);
+
+  if (!chat || String(chat.chatType) !== "Group") {
+    return { skipped: true, reason: "not_group" as const };
+  }
+
+  const participants = await db
+    .select({ phoneNumber: whatsappGroupParticipants.phoneNumber })
+    .from(whatsappGroupParticipants)
+    .where(eq(whatsappGroupParticipants.chatId, Number(chatId)))
+    .limit(5000);
+
+  const senders = await db
+    .select({ senderJid: whatsappMessages.senderJid })
+    .from(whatsappMessages)
+    .where(
+      and(
+        eq(whatsappMessages.chatId, Number(chatId)),
+        eq(whatsappMessages.direction, "Inbound"),
+      ),
+    )
+    .orderBy(desc(whatsappMessages.id))
+    .limit(500);
+
+  const customerRows = await db
+    .select({
+      id: clients.id,
+      phone: clients.phone,
+      contactPhone: clients.contactPhone,
+      otherPhones: clients.otherPhones,
+      accountManagerId: clients.accountManagerId,
+    })
+    .from(clients)
+    .where(isNull(clients.deletedAt));
+
+  const resolution = resolveDarwishClientCandidates({
+    participantPhones: participants.map(row => row.phoneNumber),
+    senderJids: senders.map(row => row.senderJid),
+    clients: customerRows,
+  });
+
+  const now = new Date() as any;
+  await db
+    .insert(darwishGroupLinks)
+    .values({
+      whatsappChatId: Number(chatId),
+      linkedClientId: resolution.clientId,
+      linkedAccountManagerId: resolution.accountManagerId,
+      resolutionStatus: resolution.status,
+      confidence: resolution.confidence,
+      reason: resolution.reason.slice(0, 500),
+      evidence: resolution.evidence,
+      resolvedAt: resolution.status === "Resolved" ? now : null,
+      lastEvaluatedAt: now,
+    })
+    .onDuplicateKeyUpdate({
+      set: {
+        linkedClientId: resolution.clientId,
+        linkedAccountManagerId: resolution.accountManagerId,
+        resolutionStatus: resolution.status,
+        confidence: resolution.confidence,
+        reason: resolution.reason.slice(0, 500),
+        evidence: resolution.evidence,
+        resolvedAt: resolution.status === "Resolved" ? now : null,
+        lastEvaluatedAt: now,
+      },
+    });
+
+  return { skipped: false, ...resolution };
+}
+
+export async function processDarwishQueue(input: { limit?: number } = {}) {
+  if (!enabled()) return { processed: 0, disabled: true };
+  if (workerBusy) return { processed: 0, busy: true };
+  workerBusy = true;
+  let processed = 0;
+  try {
+    await recoverStaleJobs();
+    const limit = Math.max(1, Math.min(25, Number(input.limit || 5)));
+    for (let index = 0; index < limit; index += 1) {
+      const job = await claimNextJob();
+      if (!job) break;
+      try {
+        await resolveDarwishGroupLink(Number(job.whatsappChatId));
+        await completeJob(Number(job.id), job.lockToken);
+        processed += 1;
+      } catch (error) {
+        await failJob(job, error);
+      }
+    }
+    return { processed, busy: false };
+  } finally {
+    workerBusy = false;
+  }
+}
+
+export async function reconcileDarwishGroups(input: { limit?: number } = {}) {
+  if (!enabled()) return { processed: 0, disabled: true };
+  const db = await getDb();
+  if (!db) return { processed: 0, reason: "database_unavailable" };
+  const limit = Math.max(1, Math.min(200, Number(input.limit || 100)));
+
+  let rows = await db
+    .select({ id: whatsappChats.id })
+    .from(whatsappChats)
+    .where(
+      and(
+        eq(whatsappChats.chatType, "Group"),
+        isNull(whatsappChats.deletedAt),
+        gt(whatsappChats.id, reconcileCursor),
+      ),
+    )
+    .orderBy(asc(whatsappChats.id))
+    .limit(limit);
+
+  if (!rows.length && reconcileCursor > 0) {
+    reconcileCursor = 0;
+    rows = await db
+      .select({ id: whatsappChats.id })
+      .from(whatsappChats)
+      .where(and(eq(whatsappChats.chatType, "Group"), isNull(whatsappChats.deletedAt)))
+      .orderBy(asc(whatsappChats.id))
+      .limit(limit);
+  }
+
+  let processed = 0;
+  for (const row of rows) {
+    reconcileCursor = Math.max(reconcileCursor, Number(row.id));
+    try {
+      await resolveDarwishGroupLink(Number(row.id));
+      processed += 1;
+    } catch (error) {
+      console.warn(
+        "[Darwish] group reconciliation failed",
+        Number(row.id),
+        String((error as Error)?.message || error),
+      );
+    }
+  }
+  return { processed, cursor: reconcileCursor };
+}
+
+export async function startDarwishQueueWorker() {
+  if (workerTimer || !enabled()) return;
+  const db = await getDb();
+  if (!db) {
+    console.warn("[Darwish] worker not started: database unavailable");
+    return;
+  }
+  try {
+    await db.select({ id: darwishGroupJobs.id }).from(darwishGroupJobs).limit(1);
+    await db.select({ id: darwishGroupLinks.id }).from(darwishGroupLinks).limit(1);
+  } catch {
+    console.warn("[Darwish] worker not started: run the Darwish Phase 1 migration first");
+    return;
+  }
+
+  const intervalMs = Math.max(1000, Number(process.env.DARWISH_QUEUE_INTERVAL_MS || 3000));
+  const batchSize = Math.max(1, Math.min(25, Number(process.env.DARWISH_QUEUE_BATCH_SIZE || 5)));
+  const run = () =>
+    processDarwishQueue({ limit: batchSize }).catch(error =>
+      console.error("[Darwish] queue failed:", String((error as Error)?.message || error)),
+    );
+  const interval = setInterval(run, intervalMs);
+  (interval as any).unref?.();
+  workerTimer = interval;
+  void run();
+
+  const reconcileIntervalMs = Math.max(
+    60_000,
+    Number(process.env.DARWISH_RECONCILE_INTERVAL_MS || 5 * 60_000),
+  );
+  const reconcileRun = () =>
+    reconcileDarwishGroups({ limit: Number(process.env.DARWISH_RECONCILE_BATCH_SIZE || 100) }).catch(error =>
+      console.error("[Darwish] reconciliation failed:", String((error as Error)?.message || error)),
+    );
+  const reconcileInterval = setInterval(reconcileRun, reconcileIntervalMs);
+  (reconcileInterval as any).unref?.();
+  reconcileTimer = reconcileInterval;
+  void reconcileRun();
+
+  console.log(
+    `[Darwish] Phase 1 worker started (queue=${intervalMs}ms, reconcile=${reconcileIntervalMs}ms)`,
+  );
+}
