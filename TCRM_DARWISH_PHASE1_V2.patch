diff --git a/scripts/apply-darwish-phase1-migration.ts b/scripts/apply-darwish-phase1-migration.ts
new file mode 100644
index 0000000..f5207f0
--- /dev/null
+++ b/scripts/apply-darwish-phase1-migration.ts
@@ -0,0 +1,100 @@
+import { config as dotenvConfig } from "dotenv";
+import { createConnection, type ConnectionOptions } from "mysql2/promise";
+
+dotenvConfig({ path: process.cwd() + "/.env", override: true });
+
+function databaseConfig(): string | ConnectionOptions {
+  if (process.env.DATABASE_URL) return process.env.DATABASE_URL;
+  const cfg: ConnectionOptions = {
+    host: process.env.DB_HOST || process.env.MYSQL_HOST || "127.0.0.1",
+    port: Number(process.env.DB_PORT || process.env.MYSQL_PORT || 3306),
+    user: process.env.DB_USER || process.env.MYSQL_USER || "",
+    password: process.env.DB_PASSWORD || process.env.MYSQL_PASSWORD || "",
+    database: process.env.DB_NAME || process.env.MYSQL_DATABASE || "",
+    multipleStatements: false,
+  };
+  if (!cfg.user || !cfg.database) {
+    throw new Error("DATABASE_URL or DB_HOST/DB_USER/DB_PASSWORD/DB_NAME is required");
+  }
+  return cfg;
+}
+
+const statements = [
+  `CREATE TABLE IF NOT EXISTS darwish_group_jobs (
+    id INT NOT NULL AUTO_INCREMENT,
+    whatsapp_session_id INT NOT NULL,
+    whatsapp_chat_id INT NOT NULL,
+    whatsapp_message_id INT NOT NULL,
+    provider_message_id VARCHAR(255) NOT NULL,
+    direction ENUM('Inbound','Outbound') NOT NULL,
+    status ENUM('Pending','Processing','Retry','Completed','Failed') NOT NULL DEFAULT 'Pending',
+    attempt_count INT NOT NULL DEFAULT 0,
+    max_attempts INT NOT NULL DEFAULT 5,
+    available_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    locked_at TIMESTAMP NULL,
+    lock_token VARCHAR(96) NULL,
+    last_error TEXT NULL,
+    completed_at TIMESTAMP NULL,
+    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
+    PRIMARY KEY (id),
+    UNIQUE KEY uq_darwish_group_jobs_message (whatsapp_message_id),
+    KEY idx_darwish_group_jobs_ready (status, available_at, id),
+    KEY idx_darwish_group_jobs_chat (whatsapp_chat_id, status)
+  ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci`,
+
+  `CREATE TABLE IF NOT EXISTS darwish_group_links (
+    id INT NOT NULL AUTO_INCREMENT,
+    whatsapp_chat_id INT NOT NULL,
+    linked_client_id INT NULL,
+    linked_account_manager_id INT NULL,
+    resolution_status ENUM('Unresolved','Resolved','Ambiguous') NOT NULL DEFAULT 'Unresolved',
+    confidence INT NOT NULL DEFAULT 0,
+    reason VARCHAR(500) NULL,
+    evidence JSON NULL,
+    resolved_at TIMESTAMP NULL,
+    last_evaluated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
+    PRIMARY KEY (id),
+    UNIQUE KEY uq_darwish_group_links_chat (whatsapp_chat_id),
+    KEY idx_darwish_group_links_client (linked_client_id),
+    KEY idx_darwish_group_links_manager (linked_account_manager_id),
+    KEY idx_darwish_group_links_status (resolution_status, last_evaluated_at)
+  ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci`,
+];
+
+async function main() {
+  const apply = process.argv.includes("--apply");
+  if (!apply) {
+    console.log("[Darwish] DRY RUN — no database changes will be made.");
+    console.log("[Darwish] Planned tables: darwish_group_jobs, darwish_group_links");
+    console.log("[Darwish] Re-run with --apply to execute.");
+    return;
+  }
+
+  const config = databaseConfig();
+  const conn = await createConnection(config as any);
+  try {
+    for (const statement of statements) await conn.query(statement);
+    const [rows] = await conn.query<any[]>(
+      `SELECT table_name
+       FROM information_schema.tables
+       WHERE table_schema = DATABASE()
+         AND table_name IN ('darwish_group_jobs','darwish_group_links')
+       ORDER BY table_name`,
+    );
+    const names = rows.map(row => String(row.TABLE_NAME || row.table_name));
+    if (!names.includes("darwish_group_jobs") || !names.includes("darwish_group_links")) {
+      throw new Error("Darwish Phase 1 migration verification failed");
+    }
+    console.log("[Darwish] Phase 1 migration applied successfully.");
+  } finally {
+    await conn.end();
+  }
+}
+
+main().catch(error => {
+  console.error("[Darwish] migration failed:", String((error as Error)?.message || error));
+  process.exitCode = 1;
+});
