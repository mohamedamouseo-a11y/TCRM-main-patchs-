+  const claimed = await loadProposal(id);
+  if (claimed.status !== "executing") throw new Error("Darwish action execution lock could not be acquired");
+  await recordActionEvent(db, id, "execution_started", actorUserId);
+  try {
+    let result: Record<string, unknown>;
+    if (claimed.actionType === "internal_note") result = await e