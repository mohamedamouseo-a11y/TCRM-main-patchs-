diff --git a/services/chatwoot-runtime/apply-darwish-phase4-migration.ts b/services/chatwoot-runtime/apply-darwish-phase4-migration.ts
new file mode 100644
index 0000000..44c0879
--- /dev/null
+++ b/services/chatwoot-runtime/apply-darwish-phase4-migration.ts
@@ -0,0 +1,63 @@
+import { sql } from "drizzle-orm";
+import { getDb } from "../../server/db";
+
+const apply = process.argv.includes("--apply");
+const statements = [
+  `CREATE TABLE IF NOT EXISTS darwish_action_proposals (
+    id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
+    proposal_key VARCHAR(64) NOT NULL,
+    source_type VARCHAR(32) NOT NULL,
+    source_id BIGINT NULL,
+    client_id INT NULL,
+    group_jid VARCHAR(255) NULL,
+    group_name VARCHAR(255) NULL,
+    account_manager_id INT NULL,
+    chatwoot_conversation_id VARCHAR(128) NULL,
+    action_type VARCHAR(32) NOT NULL,
+    title VARCHAR(500) NOT NULL,
+    summary TEXT NOT NULL,
+    payload JSON NULL,
+    risk_level VARCHAR(16) NULL,
+    status VARCHAR(16) NOT NULL DEFAULT 'proposed',
+    reviewed_by INT NULL,
+    reviewed_at DATETIME NULL,
+    rejection_reason TEXT NULL,
+    executed_at DATETIME NULL,
+    execution_result JSON NULL,
+    last_error TEXT NULL,
+    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
+    PRIMARY KEY (id),
+    UNIQUE KEY uq_darwish_action_proposal_key (proposal_key),
+    KEY idx_darwish_action_status (status, created_at),
+    KEY idx_darwish_action_type (action_type, status),
+    KEY idx_darwish_action_client (client_id),
+    KEY idx_darwish_action_am (account_manager_id),
+    KEY idx_darwish_action_source (source_type, source_id)
+  ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci`,
+  `CREATE TABLE IF NOT EXISTS darwish_action_events (
+    id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
+    proposal_id BIGINT UNSIGNED NOT NULL,
+    event_type VARCHAR(32) NOT NULL,
+    actor_user_id INT NULL,
+    metadata JSON NULL,
+    created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
+    PRIMARY KEY (id),
+    KEY idx_darwish_action_event_proposal (proposal_id, created_at),
+    KEY idx_darwish_action_event_actor (actor_user_id, created_at),
+    KEY idx_darwish_action_event_type (event_type, created_at)
+  ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci`,
+];
+
+console.log(`DARWISH_PHASE4_STATEMENTS=${statements.length}`);
+if (!apply) {
+  console.log("DRY_RUN_ONLY=YES");
+  for (const statement of statements) console.log(statement.split("\n")[0]);
+  process.exit(0);
+}
+
+const db = await getDb();
+if (!db) throw new Error("Database unavailable");
+for (const statement of statements) await db.execute(sql.raw(statement));
+console.log("DARWISH_PHASE4_MIGRATION=APPLIED");
+process.exit(0);
