+  rejectAction: darwishApproverProcedure.input(z.object({ id: z.number().int().positive(), reason: z.string().trim().max(1000).optional() })).mutation(({ input, ctx }) => rejectDarwishAction(input.id, Number(ctx.user.id), input.reason)),
