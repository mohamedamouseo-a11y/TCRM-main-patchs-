+++ b/server/services/darwish/chatwoot/darwishActionService.ts
@@ -0,0 +1,516 @@
+import { createHash } from "node:crypto";
+import { sql } from "drizzle-orm";
+import { getDb } from "../../../db";
+import { callTaraProviderWithFallback } from "../../tara/taraMultiProviderService";
+import { sendDarwishApprovedChatwootReply } from "./darwishChatwootService";
+
+type DarwishActionType = "internal_note" | "follow_up_reminder" | "customer_reply";
+type DarwishActionStatus = "proposed" | "approved" | "executing" | "execution_uncertain" | "executed" | "rejected";
+
+type SupervisorAlertInput = {
+  id: number;
+  alertType: string;
+  severity: string;
+  title: string;
+  summary: string;
+  clientId: number | null;
+  groupJid: string | null;
+  groupName: string | null;
+  accountManagerId: number | null;
+  leadId?: number | null;
+};
+
+type ActionSuggestion = {
+  actionType: Exclude<DarwishActionType, "customer_reply">;
+  title: string;
+  summary: string;
+  payload: Record<string, unknown>;
+};
+
+function rowsOf(result: any): any[] {
+  if (Array.isArray(result) && Array.isArray(result[0])) return result[0] as any[];
+  return Array.isArray(result) ? result : [];
+}
+
+function numberOf(value: unknown) {
+  const n = Number(value);
+  return Number.isFinite(n) ? n : 0;
+}
+
+function parseJsonValue(value: unknown) {
+  if (!value) return {};
+  if (typeof value === "object") return value as Record<string, unknown>;
+  try {
+    const parsed = JSON.parse(String(value));
+    return parsed && typeof parsed === "object" ? parsed as Record<string, unknown> : {};
+  } catch {
+    return {};
+  }
+}
+
+function parseStringArray(value: unknown): string[] {
+  const parsed = Array.isArray(value) ? value : (() => {
+    try { return JSON.parse(String(value || "[]")); } catch { return []; }
+  })();
+  return Array.isArray(parsed) ? parsed.map(String).map((item) => item.trim()).filter(Boolean).slice(0, 20) : [];
+}
+
+function safeText(value: unknown, max: number) {
+  return String(value ?? "").replace(/\u0000/g, "").trim().slice(0, max);
+}
+
+function proposalKey(sourceType: string, sourceId: number | string, actionType: DarwishActionType) {
+  return createHash("sha256").update(`${sourceType}\0${sourceId}\0${actionType}`).digest("hex");
+}
+
+export function deriveDarwishActionSuggestions(alert: SupervisorAlertInput): ActionSuggestion[] {
+  const base = {
+    clientId: alert.clientId,
+    leadId: alert.leadId ?? null,
+    groupJid: alert.groupJid,
+    groupName: alert.groupName,
+    accountManagerId: alert.accountManagerId,
+    sourceAlertId: alert.id,
+    sourceAlertType: a