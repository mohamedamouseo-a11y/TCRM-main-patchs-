+import { useState } from "react";
+import { Bot, Loader2 } from "lucide-react";
+import { toast } from "sonner";
+
+import { Button } from "@/components/ui/button";
+import { Dialog, DialogContent, DialogFooter, DialogHeader, DialogTitle } from "@/components/ui/dialog";
+import { Input } from "@/components/ui/input";
+import { Label } from "@/components/ui/label";
+import { trpc } from "@/lib/trpc";
+
+type FelfelJoinButtonProps = {
+  clientId?: number;
+  leadId?: number;
+  dealId?: number;
+  title?: string;
+  isRTL?: boolean;
+  className?: string;
+};
+
+export default function FelfelJoinButton({
+  clientId,
+  leadId,
+  dealId,
+  title,
+  isRTL = false,
+  className,
+}: FelfelJoinButtonProps) {
+  const [open, setOpen] = useState(false);
+  const [meetingUrl, setMeetingUrl] = useState("");
+
+  const joinMeeting = trpc.felfel.joinFromCrmContext.useMutation({
+    onSuccess: (result) => {
+      if (result.reused) {
+        toast.info(isRTL ? "فلفل مرتبط بالفعل بهذا الاجتماع." : "Felfel is already linked to this meeting.");
+      } else {
+        toast.success(isRTL ? "تم إرسال طلب انضمام فلفل للاجتماع." : "Felfel join request sent.");
+      }
+      setMeetingUrl("");
+      setOpen(false);
+    },
+    onError: (error) => {
+      toast.error(isRTL ? "تعذر إدخال فلفل إلى الاجتماع." : "Felfel could not join the meeting.", {
+        description: error.message,
+      });
+    },
+  });
+
+  const submit = () => {
+    const url = meetingUrl.trim();
+    if (!url) {
+      toast.error(isRTL ? "أضف رابط الاجتماع أولًا." : "Enter the meeting URL first.");
+      return;
+    }
+    joinMeeting.mutate({
+      meetingUrl: url,
+      clientId,
+      leadId,
+      dealId,
+      title: title?.trim() || undefined,
+    });
+  };
+
+  return (
+    <>
+      <Button
+        type="button"
+        variant="outline"
+        size="sm"
+        className={className || "gap-2 rounded-xl"}
+        onClick={() => setOpen(true)}
+        disabled={joinMeeting.isPending}
+        title={isRTL ? "إدخال فلفل إلى الاجتماع" : "Join meeting with Felfel"}
+      >
+        {joinMeeting.isPending ? <Loader2 size={15} className="animate-spin" /> : <Bot size={15} />}
+        {isRTL ? "فلفل" : "Felfel"}
+      </Button>
+
+      <Dialog open={open} onOpenChange={(next) => !joinMeeting.isPending && setOpen(next)}>
+        <DialogContent className="sm:max-w-md" dir={isRTL ? "rtl" : "ltr"}>
+          <DialogHeader>
+            <DialogTitle>{isRTL ? "انضم بفلفل" : "Join with Felfel"}</DialogTitle>
+          </DialogHeader>
+
+          <div className="space-y-2 py-2">
+            <Label htmlFor="felfel-crm-meeting-url">
+              {isRTL ? "رابط الاجتماع" : "Meeting URL"}
+            </Label>
+            <Input
+              id="felfel-crm-meeting-url"
+              type="url"
+              autoComplete="off"
+              placeholder="https://meet.google.com/..."
+              value={meetingUrl}
+              onChange={(event) => setMeetingUrl(event.target.value)}
+              onKeyDown={(event) => {
+                if (event.key === "Enter") {
+                  event.preventDefault();
+                  submit();
+                }
+              }}
+              disabled={joinMeeting.isPending}
+              dir="ltr"
+            />
+            <p className="text-xs text-muted-foreground">
+              {isRTL
+                ? "يدعم Google Meet وMicrosoft Teams وZoom وJitsi. سيتم ربط الاجتماع تلقائيًا بالسجل الحالي."
+                : "Supports Google Meet, Microsoft Teams, Zoom and Jitsi. The meeting will be linked to the current CRM record."}
+            </p>
+          </div>
+
+          <DialogFooter>
+            <Button type="button" variant="outline" onClick={() => setOpen(false)} disabled={joinMeeting.isPending}>
+              {isRTL ? "إلغاء" : "Cancel"}
+            </Button>
+            <Button type="button" onClick={submit} disabled={joinMeeting.isPending || !meetingUrl.trim()}>
+              {joinMeeting.isPending && <Loader2 size={15} className="me-2 animate-spin" />}
+              {isRTL ? "إدخال فلفل" : "Join Felfel"}
+            </Button>
+          </DialogFooter>
+        </DialogContent>
+      </Dialog>
+    </>
+  );
+}
