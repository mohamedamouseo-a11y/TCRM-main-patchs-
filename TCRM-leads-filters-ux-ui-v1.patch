+++ b/client/src/leads-filters-premium-v1.css
@@ -0,0 +1,212 @@
+/* TCRM_LEADS_FILTERS_PREMIUM_V1
+   Presentation-only UX/UI polish for Sales > Leads filters.
+   Keeps all existing query/filter behavior unchanged. */
+
+.tcrm-leads-filter-card {
+  overflow: hidden;
+  border: 1px solid hsl(var(--border) / 0.7) !important;
+  background: hsl(var(--card) / 0.96);
+  box-shadow:
+    0 1px 2px hsl(var(--foreground) / 0.03),
+    0 14px 34px hsl(var(--foreground) / 0.045) !important;
+}
+
+.tcrm-leads-filter-header {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 16px;
+  padding: 18px 20px 16px;
+}
+
+.tcrm-leads-filter-heading {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  min-width: 0;
+}
+
+.tcrm-leads-filter-heading-icon {
+  display: inline-flex;
+  width: 42px;
+  height: 42px;
+  flex: 0 0 42px;
+  align-items: center;
+  justify-content: center;
+  border: 1px solid hsl(var(--primary) / 0.12);
+  border-radius: 12px;
+  color: hsl(var(--primary));
+  background: hsl(var(--primary) / 0.08);
+}
+
+.tcrm-leads-filter-title {
+  margin: 0;
+  color: hsl(var(--foreground));
+  font-size: 15px;
+  font-weight: 700;
+  line-height: 1.25;
+  letter-spacing: -0.01em;
+}
+
+.tcrm-leads-filter-subtitle {
+  margin: 4px 0 0;
+  color: hsl(var(--muted-foreground));
+  font-size: 12px;
+  line-height: 1.35;
+}
+
+.tcrm-leads-filter-toggle {
+  height: 34px !important;
+  flex: 0 0 auto;
+  border-radius: 10px !important;
+  padding-inline: 10px !important;
+  color: hsl(var(--primary)) !important;
+  font-size: 12px !important;
+  font-weight: 600 !important;
+}
+
+.tcrm-leads-filter-toggle:hover {
+  background: hsl(var(--primary) / 0.07) !important;
+}
+
+.tcrm-leads-filter-body {
+  border-top: 1px solid hsl(var(--border) / 0.65);
+  padding: 18px 20px 20px;
+  background:
+    linear-gradient(180deg, hsl(var(--muted) / 0.12), transparent 42px),
+    hsl(var(--card));
+}
+
+.tcrm-leads-filter-grid {
+  align-items: flex-end !important;
+  gap: 14px 16px !important;
+}
+
+.tcrm-leads-filter-grid > div:not(.tcrm-leads-filter-actions) {
+  flex: 1 1 160px !important;
+  min-width: 160px !important;
+}
+
+.tcrm-leads-filter-grid > div:first-child {
+  flex: 2.2 1 320px !important;
+  min-width: 280px !important;
+}
+
+.tcrm-leads-filter-grid > div:nth-child(2) {
+  flex: 1.45 1 230px !important;
+  min-width: 220px !important;
+}
+
+.tcrm-leads-filter-grid label {
+  color: hsl(var(--muted-foreground));
+  font-size: 11px;
+  font-weight: 650;
+  line-height: 1.2;
+  letter-spacing: 0.01em;
+}
+
+.tcrm-leads-filter-grid > div:not(.tcrm-leads-filter-actions) input,
+.tcrm-leads-filter-grid > div:not(.tcrm-leads-filter-actions) > button,
+.tcrm-leads-filter-grid > div:not(.tcrm-leads-filter-actions) > div > button {
+  width: 100% !important;
+  min-height: 42px !important;
+  border-radius: 12px !important;
+  border-color: hsl(var(--border) / 0.85) !important;
+  background: hsl(var(--background)) !important;
+  box-shadow: 0 1px 1px hsl(var(--foreground) / 0.02);
+}
+
+.tcrm-leads-filter-grid > div:not(.tcrm-leads-filter-actions) input:hover,
+.tcrm-leads-filter-grid > div:not(.tcrm-leads-filter-actions) > button:hover,
+.tcrm-leads-filter-grid > div:not(.tcrm-leads-filter-actions) > div > button:hover {
+  border-color: hsl(var(--primary) / 0.28) !important;
+}
+
+.tcrm-leads-filter-grid > div:not(.tcrm-leads-filter-actions) input:focus-visible,
+.tcrm-leads-filter-grid > div:not(.tcrm-leads-filter-actions) > button:focus-visible,
+.tcrm-leads-filter-grid > div:not(.tcrm-leads-filter-actions) > div > button:focus-visible {
+  border-color: hsl(var(--primary) / 0.42) !important;
+  box-shadow: 0 0 0 3px hsl(var(--primary) / 0.08) !important;
+}
+
+.tcrm-leads-filter-actions {
+  display: flex;
+  flex: 1 0 100%;
+  align-items: center;
+  justify-content: flex-end;
+  flex-wrap: wrap;
+  gap: 10px;
+  margin-top: 2px;
+  padding-top: 15px;
+  border-top: 1px solid hsl(var(--border) / 0.6);
+}
+
+.tcrm-leads-filter-actions > button,
+.tcrm-leads-filter-actions [data-radix-collection-item] {
+  min-height: 40px;
+}
+
+.tcrm-leads-reset-button,
+.tcrm-leads-sla-button,
+.tcrm-leads-columns-button {
+  min-width: 112px;
+  border-radius: 11px !important;
+  font-weight: 600 !important;
+}
+
+.tcrm-leads-reset-button:disabled {
+  opacity: 0.45;
+}
+
+.tcrm-leads-columns-button {
+  border-color: hsl(var(--primary) / 0.22) !important;
+  color: hsl(var(--foreground));
+}
+
+@media (max-width: 1280px) {
+  .tcrm-leads-filter-grid > div:not(.tcrm-leads-filter-actions) {
+    flex-basis: 180px !important;
+  }
+
+  .tcrm-leads-filter-grid > div:first-child {
+    flex-basis: 300px !important;
+  }
+}
+
+@media (max-width: 720px) {
+  .tcrm-leads-filter-header {
+    align-items: flex-start;
+    padding: 16px;
+  }
+
+  .tcrm-leads-filter-heading-icon {
+    width: 38px;
+    height: 38px;
+    flex-basis: 38px;
+  }
+
+  .tcrm-leads-filter-subtitle {
+    display: none;
+  }
+
+  .tcrm-leads-filter-body {
+    padding: 16px;
+  }
+
+  .tcrm-leads-filter-grid > div:not(.tcrm-leads-filter-actions),
+  .tcrm-leads-filter-grid > div:first-child,
+  .tcrm-leads-filter-grid > div:nth-child(2) {
+    flex: 1 1 100% !important;
+    min-width: 100% !important;
+  }
+
+  .tcrm-leads-filter-actions {
+    justify-content: stretch;
+  }
+
+  .tcrm-leads-filter-actions > button,
+  .tcrm-leads-filter-actions > div > button {
+    flex: 1 1 30%;
+    min-width: 96px;
+  }
+}
