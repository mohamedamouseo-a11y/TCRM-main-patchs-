+import { useState } from "react";
+import { Activity, BookOpenCheck, CheckCircle2, CirclePause, ShieldCheck, XCircle } from "lucide-react";
+import { Badge } from "@/components/ui/badge";
+import { Button } from "@/components/ui/button";
+import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
+import { Input } from "@/components/ui/input";
+import { useLanguage } from "@/contexts/LanguageContext";
+import { trpc } from "@/lib/trpc";
+
+type ReuseDecision = "approved-reference" | "hold" | "rejected";
+
+function variantFor(status: string): "destructive" | "secondary" | "outline" {
+  if (status === "rejected") return "destructive";
+  if (status === "approved-reference") return "secondary";
+  return "outline";
+}
+
+export default function WadieRecommendationReuse() {
+  const { isRTL } = useLanguage();
+  const text = (en: string, ar: string) => (isRTL ? ar : en);
+  const [notes, setNotes] = useState<Record<string, string>>({});
+  const query = trpc.wadie.recommendationReuse.useQuery(undefined, {
+    refetchOnWindowFocus: false,
+    refetchInterval: 60_000,
+  });
+  const review = trpc.wadie.recordRecommendationReuseReview.useMutation({
+    onSuccess: () => void query.refetch(),
+  });
+  const data = query.data;
+
+  const statusLabel = (value: string) => {
+    if (value === "approved-reference") return text("Approved reference", "مرجع معتمد");
+    if (value === "hold") return text("On hold", "معلّق");
+    if (value === "rejected") return text("Rejected", "مرفوض");
+    return text("Pending review", "بانتظار المراجعة");
+  };
+
+  const submit = (item: any, decision: ReuseDecision) => {
+    review.mutate({
+      registryId: item.registryId,
+      decision,
+      note: notes[item.registryId]?.trim() || undefined,
+    });
+  };
+
+  return (
+    <Card data-wadie-recommendation-reuse="phase21-v1" className="rounded-2xl border-border/70 bg-card shadow-[0_14px_34px_-28px_rgba(15,23,42,0.72)]">
+      <CardHeader className="pb-3">
+        <div className="flex flex-wrap items-center justify-between gap-3">
+          <div>
+            <CardTitle className="flex items-center gap-2 text-xl">
+              <BookOpenCheck className="h-5 w-5 text-cyan-600" />
+              {text("Guardrailed Recommendation Reuse", "إعادة استخدام التوصيات بضوابط")}
+            </CardTitle>
+            <p className="mt-1 text-xs font-semibold text-muted-foreground">
+              {text(
+                "Human-review Phase 20 playbooks before they can be used as advisory references. Approval never injects, executes, or applies a recommendation automatically.",
+                "راجع Playbooks من Phase 20 بشرياً قبل السماح باستخدامها كمراجع استشارية. الاعتماد لا يحقن أو ينفذ أو يطبق أي توصية تلقائياً.",
+              )}
+            </p>
+          </div>
+          <div className="flex flex-wrap gap-2">
+            <Badge variant="outline" className="rounded-full px-3 py-1 font-bold">
+              <ShieldCheck className="me-1 h-3.5 w-3.5 text-emerald-500" />
+              {text("Reference only", "مرجع فقط")}
+            </Badge>
+            <Button variant="outline" size="sm" className="h-9 rounded-xl font-bold" disabled={query.isFetching} onClick={() => void query.refetch()}>
+              <Activity className={`me-2 h-4 w-4 ${query.isFetching ? "animate-spin" : ""}`} />
+              {text("Refresh reuse review", "تحديث مراجعة إعادة الاستخدام")}
+            </Button>
+          </div>
+        </div>
+      </CardHeader>
+
+      <CardContent className="space-y-4">
+        {data && (
+          <>
+            <div className="grid grid-cols-2 gap-2 md:grid-cols-4">
+              {[
+                [text("Ready playbooks", "Playbooks الجاهزة"), data.totals.readyPlaybooks],
+                [text("Pending", "قيد المراجعة"), data.totals.pending],
+                [text("Approved references", "مراجع معتمدة"), data.totals.approvedReference],
+                [text("Held / Rejected", "معلق / مرفوض"), data.totals.hold + data.totals.rejected],
+              ].map(([label, value]) => (
+                <div key={String(label)} className="rounded-xl border border-border/60 bg-background/55 p-3">
+                  <p className="text-[10px] font-black uppercase tracking-[0.08em] text-muted-foreground">{label}</p>
+                  <p className="mt-1 text-lg font-black">{value}</p>
+                </div>
+              ))}
+            </div>
+
+            <div className="space-y-3">
+              {data.candidates.slice(0, 24).map((item) => (
+                <div key={item.registryId} className="rounded-2xl border border-border/60 bg-background/45 p-4">
+                  <div className="flex flex-wrap items-center justify-between gap-2">
+                    <div className="min-w-0">
+                      <div className="flex flex-wrap items-center gap-2">
+                        <Badge variant="outline" className="rounded-full text-[10px]">{item.kind}</Badge>
+                        <span className="truncate text-xs font-black">{item.title}</span>
+                        <Badge variant={variantFor(item.reuseReviewStatus)} className="rounded-full text-[10px]">{statusLabel(item.reuseReviewStatus)}</Badge>
+                      </div>
+                      <p className="mt-1 text-[10px] font-semibold text-muted-foreground">{item.objective}</p>
+                    </div>
+                    <div className="text-end text-[10px] font-semibold text-muted-foreground">
+                      <div>{text("Reference", "المرجع")}: {item.humanRecommendationReferenceEnabled ? text("Available", "متاح") : text("Inactive", "غير مفعل")}</div>
+                      <div>{text("Execution", "التنفيذ")}: {text("Not executable", "غير قابل للتنفيذ")}</div>
+                    </div>
+                  </div>
+
+                  {item.instructions && <p className="mt-2 rounded-lg border border-border/50 bg-card px-3 py-2 text-[10px] font-semibold text-muted-foreground">{item.instructions}</p>}
+                  {item.guardrailNotes && <p className="mt-2 text-[10px] font-semibold text-amber-700 dark:text-amber-300">{text("Guardrails", "الضوابط")}: {item.guardrailNotes}</p>}
+
+                  <div className="mt-3 grid gap-2 lg:grid-cols-[1fr_auto]">
+                    <Input
+                      value={notes[item.registryId] ?? item.reuseReviewNote ?? ""}
+                      onChange={(event) => setNotes((current) => ({ ...current, [item.registryId]: event.target.value }))}
+                      maxLength={600}
+                      placeholder={text("Optional human reuse-review note", "ملاحظة بشرية اختيارية لمراجعة إعادة الاستخدام")}
+                      className="h-9 rounded-xl text-xs"
+                    />
+                    <div className="flex flex-wrap gap-2">
+                      <Button size="sm" variant="outline" className="h-9 rounded-xl border-emerald-500/30 text-emerald-700 dark:text-emerald-300" disabled={review.isPending} onClick={() => submit(item, "approved-reference")}>
+                        <CheckCircle2 className="me-1.5 h-3.5 w-3.5" />{text("Approve as reference", "اعتماد كمرجع")}
+                      </Button>
+                      <Button size="sm" variant="outline" className="h-9 rounded-xl border-amber-500/30 text-amber-700 dark:text-amber-300" disabled={review.isPending} onClick={() => submit(item, "hold")}>
+                        <CirclePause className="me-1.5 h-3.5 w-3.5" />{text("Hold", "تعليق")}
+                      </Button>
+                      <Button size="sm" variant="outline" className="h-9 rounded-xl border-destructive/30 text-destructive" disabled={review.isPending} onClick={() => submit(item, "rejected")}>
+                        <XCircle className="me-1.5 h-3.5 w-3.5" />{text("Reject", "رفض")}
+                      </Button>
+                    </div>
+                  </div>
+                </div>
+              ))}
+            </div>
+
+            {data.candidates.length === 0 && (
+              <div className="rounded-xl border border-dashed border-border px-4 py-5 text-center text-xs font-semibold text-muted-foreground">
+                {text("No Phase 20 playbooks are ready for reuse review yet.", "لا توجد Playbooks من Phase 20 جاهزة لمراجعة إعادة الاستخدام حتى الآن.")}
+              </div>
+            )}
+          </>
+        )}
+
+        {review.error && <p className="text-xs font-semibold text-destructive">{review.error.message}</p>}
+        {query.error && <p className="text-xs font-semibold text-destructive">{query.error.message}</p>}
+        <p className="text-[10px] font-semibold text-muted-foreground">
+          {text(
+            "Phase 21 approves playbooks for human advisory reference only. It performs no automatic recommendation injection, no execution, no MCP calls, no ad-platform mutations, no learning-memory writes, and no execution-policy changes.",
+            "Phase 21 يعتمد Playbooks كمراجع استشارية بشرية فقط. لا يقوم بحقن توصيات تلقائياً أو التنفيذ أو استدعاء MCP أو تعديل منصات الإعلانات أو كتابة ذاكرة تعلم أو تغيير سياسة التنفيذ.",
+          )}
+        </p>
+      </CardContent>
+    </Card>
+  );
+}
