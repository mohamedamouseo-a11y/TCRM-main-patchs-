@@ -0,0 +1,90 @@
+import { mkdir, readFile, rename, writeFile } from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { getWadiePlaybookCurationSnapshot } from "./wadiePlaybookCurationService";
+
+export type WadieRecommendationReuseDecision = "approved-reference" | "hold" | "rejected";
+type Review = { registryId: string; decision: WadieRecommendationReuseDecision; reviewedAt: string; reviewedBy: string };
+type Store = { version: 1; items: Review[] };
+
+function storagePath() {
+  const configured = String(process.env.WADIE_RECOMMENDATION_REUSE_FILE || "").trim();
+  return configured ? path.resolve(configured) : path.join(os.homedir(), ".tcrm", "wadie-recommendation-reuse.json");
+}
+async function readStore(): Promise<Store> {
+  try {
+    const parsed = JSON.parse(await readFile(storagePath(), "utf8"));
+    return { version: 1, items: Array.isArray(parsed?.items) ? parsed.items : [] };
+  } catch (error: any) {
+    if (error?.code === "ENOENT") return { version: 1, items: [] };
+    throw error;
+  }
+}
+async function writeStore(store: Store) {
+  const file = storagePath();
+  await mkdir(path.dirname(file), { recursive: true, mode: 0o700 });
+  const temp = `${file}.${process.pid}.${Date.now()}.tmp`;
+  await writeFile(temp, `${JSON.stringify(store, null, 2)}\n`, { encoding: "utf8", mode: 0o600 });
+  await rename(temp, file);
+}
+
+export async function getWadieRecommendationReuseSnapshot() {
+  const [playbooks, store] = await Promise.all([getWadiePlaybookCurationSnapshot(), readStore()]);
+  const byId = new Map(store.items.map((item) => [item.registryId, item]));
+  const candidates = playbooks.entries
+    .filter((item) => item.curationStatus === "ready-for-reuse-review" && item.eligibleForPhase21ReuseReview)
+    .map((item) => {
+      const review = byId.get(item.registryId) ?? null;
+      const approved = review?.decision === "approved-reference";
+      return {
+        ...item,
+        reuseReviewStatus: review?.decision ?? "pending-review" as const,
+        reuseReviewedAt: review?.reviewedAt ?? null,
+        reuseReviewedBy: review?.reviewedBy ?? null,
+        humanRecommendationReferenceEnabled: approved,
+        referenceStatus: approved ? "available-for-human-reference" as const : "inactive" as const,
+        activationStatus: "inactive" as const,
+        executionStatus: "not-executable" as const,
+      };
+    });
+  return {
+    phase: "guardrailed-recommendation-reuse-v2" as const,
+    mode: "human-approved-advisory-reference-only" as const,
+    totals: {
+      readyPlaybooks: candidates.length,
+      pending: candidates.filter((item) => item.reuseReviewStatus === "pending-review").length,
+      approvedReference: candidates.filter((item) => item.reuseReviewStatus === "approved-reference").length,
+      hold: candidates.filter((item) => item.reuseReviewStatus === "hold").length,
+      rejected: candidates.filter((item) => item.reuseReviewStatus === "rejected").length,
+    },
+    candidates: candidates.slice(0, 100),
+    approvedReferences: candidates.filter((item) => item.reuseReviewStatus === "approved-reference").slice(0, 100),
+    source: "phase20-human-curated-playbooks" as const,
+    phase20ReadyOnly: true as const,
+    humanReuseApprovalRequired: true as const,
+    reuseReviewPersistenceLocalOnly: true as const,
+    humanRecommendationReferenceEnabled: true as const,
+    automaticRecommendationInjectionEnabled: false as const,
+    recommendationExecutionEnabled: false as const,
+    learningMemoryWritesApplied: false as const,
+    liveMcpCallsApplied: false as const,
+    adPlatformMutationsApplied: false as const,
+    automaticOptimizationLearningApplied: false as const,
+    automaticRecommendationReuseApplied: false as const,
+    automaticExecutionPolicyChangesApplied: false as const,
+    executionStillRequiresHumanApproval: true as const,
+  };
+}
+
+export async function recordWadieRecommendationReuseReview(input: { registryId: string; decision: WadieRecommendationReuseDecision }, actorUserId: string) {
+  const [playbooks, store] = await Promise.all([getWadiePlaybookCurationSnapshot(), readStore()]);
+  const registryId = String(input.registryId || "").trim().slice(0, 240);
+  const playbook = playbooks.entries.find((item) => item.registryId === registryId && item.curationStatus === "ready-for-reuse-review" && item.eligibleForPhase21ReuseReview);
+  if (!playbook) throw new Error("Wadie Phase 20 playbook is not currently eligible for reuse review");
+  const entry: Review = { registryId, decision: input.decision, reviewedAt: new Date().toISOString(), reviewedBy: String(actorUserId || "unknown") };
+  const existing = store.items.findIndex((item) => item.registryId === registryId);
+  if (existing >= 0) store.items[existing] = entry; else store.items.push(entry);
+  store.items = store.items.slice(-1000);
+  await writeStore(store);
+  return getWadieRecommendationReuseSnapshot();
+}
