@@ -0,0 +1,59 @@
+import { describe, expect, it } from "vitest";
+import { sanitizeDeveloperData } from "./developerDataSanitizer";
+
+describe("developerDataSanitizer", () => {
+  it("zeros identity, financial values, file metadata, and resource URLs", () => {
+    const source = {
+      client: {
+        id: 17,
+        name: "Real Customer",
+        email: "real@example.com",
+        phone: "+201234567890",
+        dealValue: 125000,
+        monthlyFee: 5000,
+        fileName: "real-customer-contract.pdf",
+        downloadUrl: "/api/crm-files/91/download",
+        driveFileId: "drive-secret-id",
+        status: "active",
+      },
+      analytics: { totalRevenue: 900000, grossProfit: 200000 },
+    };
+
+    const sanitized = sanitizeDeveloperData(source);
+    expect(sanitized.client.id).toBe(17);
+    expect(sanitized.client.name).toBe("0");
+    expect(sanitized.client.email).toBe("0@0.local");
+    expect(sanitized.client.phone).toMatch(/^0+$/);
+    expect(sanitized.client.dealValue).toBe(0);
+    expect(sanitized.client.monthlyFee).toBe(0);
+    expect(sanitized.client.fileName).toBe("0");
+    expect(sanitized.client.downloadUrl).toBe("0");
+    expect(sanitized.client.driveFileId).toBe("0");
+    expect(sanitized.analytics.totalRevenue).toBe(0);
+    expect(sanitized.analytics.grossProfit).toBe(0);
+  });
+
+  it("preserves structural fields and does not mutate the source", () => {
+    const source = { client: { id: 2, name: "Client", status: "active", stageId: 8, dealValue: 1000 } };
+    const sanitized = sanitizeDeveloperData(source);
+    expect(sanitized.client.id).toBe(2);
+    expect(sanitized.client.status).toBe("active");
+    expect(sanitized.client.stageId).toBe(8);
+    expect(source.client.name).toBe("Client");
+    expect(source.client.dealValue).toBe(1000);
+  });
+
+  it("sanitizes nested identity and resource data", () => {
+    const sanitized = sanitizeDeveloperData({
+      rows: [{ customer: { name: "A", website: "https://real.example", mobile: "01012345678" } }],
+      attachmentUrl: "https://files.example/private",
+      invoiceAmount: 3500,
+    });
+    expect(sanitized.rows[0].customer.name).toBe("0");
+    expect(sanitized.rows[0].customer.website).toBe("0");
+    expect(sanitized.rows[0].customer.mobile).toMatch(/^0+$/);
+    expect(sanitized.attachmentUrl).toBe("0");
+    expect(sanitized.invoiceAmount).toBe(0);
+  });
+});
+
