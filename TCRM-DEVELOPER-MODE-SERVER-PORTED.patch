@@ -0,0 +1,37 @@
+import { describe, expect, it } from "vitest";
+import { getDeveloperAccessDenialReason } from "./developerAccessPolicy";
+
+describe("developerAccessPolicy", () => {
+  it("blocks user deletion", () => {
+    expect(getDeveloperAccessDenialReason({ path: "users.delete", type: "mutation", input: { id: 9 } })).toContain("delete users");
+  });
+
+  it("blocks privilege escalation", () => {
+    expect(getDeveloperAccessDenialReason({ path: "users.promoteOwner", type: "mutation" })).toContain("Admin");
+  });
+
+  it("allows only Developer test-account creation", () => {
+    expect(getDeveloperAccessDenialReason({ path: "users.create", type: "mutation", input: { role: "Developer" } })).toBeNull();
+    expect(getDeveloperAccessDenialReason({ path: "users.create", type: "mutation", input: { role: "SalesAgent" } })).toContain("Developer test accounts");
+    expect(getDeveloperAccessDenialReason({ path: "users.create", type: "mutation", input: {} })).toContain("Developer test accounts");
+  });
+
+  it("blocks user security/role changes", () => {
+    expect(getDeveloperAccessDenialReason({ path: "users.update", type: "mutation", input: { id: 4, role: "Admin" } })).not.toBeNull();
+    expect(getDeveloperAccessDenialReason({ path: "users.update", type: "mutation", input: { id: 4, isActive: false } })).not.toBeNull();
+    expect(getDeveloperAccessDenialReason({ path: "users.update", type: "mutation", input: { id: 4, sessionVersion: 3 } })).not.toBeNull();
+  });
+
+  it("blocks password-reset, public-share, and export bypasses", () => {
+    expect(getDeveloperAccessDenialReason({ path: "auth.adminSetPassword", type: "mutation", input: { userId: 2 } })).not.toBeNull();
+    expect(getDeveloperAccessDenialReason({ path: "crmFiles.createPublicViewOnlyShareLink", type: "mutation", input: { crmFileId: 2 } })).not.toBeNull();
+    expect(getDeveloperAccessDenialReason({ path: "leads.export", type: "mutation" })).not.toBeNull();
+  });
+
+  it("leaves normal feature mutations and queries available", () => {
+    expect(getDeveloperAccessDenialReason({ path: "leads.update", type: "mutation", input: { id: 3, stage: "New" } })).toBeNull();
+    expect(getDeveloperAccessDenialReason({ path: "users.update", type: "mutation", input: { id: 4, name: "Test" } })).toBeNull();
+    expect(getDeveloperAccessDenialReason({ path: "users.delete", type: "query", input: { id: 3 } })).toBeNull();
+  });
+});
+
diff --git a/server/utils/developerDataSanitizer.ts b/server/utils/developerDataSanitizer.ts
new file mode 100644
--- /dev/null
+++ b/server/utils/developerDataSanitizer.ts
@@ -0,0 +1,132 @@
+type SensitiveKind = "email" | "phone" | "identifier" | "money" | "text" | "secret" | "resource";
+
+const IDENTITY_CONTAINER_FRAGMENTS = [
+  "client", "customer", "contact", "lead", "employee", "person", "member",
+  "owner", "recipient", "sender", "user", "vendor", "supplier",
+];
+
+const IDENTITY_SIGNAL_KEYS = [
+  "email", "phone", "mobile", "whatsappnumber", "nationalid", "passportnumber",
+  "taxid", "clientid", "customerid", "contactid", "leadid", "employeeid", "userid",
+];
+
+const EMAIL_KEYS = new Set([
+  "email", "emailaddress", "centralemail", "contactemail", "clientemail", "customeremail",
+  "workemail", "personalemail", "recipientemail", "senderemail",
+]);
+
+const IDENTIFIER_KEYS = new Set([
+  "nationalid", "nationalidnumber", "identitynumber", "passportnumber", "taxid", "taxnumber",
+  "vatnumber", "registrationnumber", "commercialregistration",
+]);
+
+const ALWAYS_PRIVATE_NAME_KEYS = new Set([
+  "firstname", "lastname", "fullname", "clientname", "customername", "contactname",
+  "employeename", "leadname", "ownername", "recipientname", "sendername", "username", "companyname",
+]);
+
+const PRIVATE_TEXT_KEYS = new Set([
+  "address", "streetaddress", "billingaddress", "shippingaddress", "notes", "note", "comment",
+  "comments", "message", "messagebody", "body", "content", "description", "filename",
+  "originalfilename", "attachmentname",
+]);
+
+const PRIVATE_RESOURCE_KEYS = new Set([
+  "fileurl", "mediaurl", "attachmenturl", "downloadurl", "previewurl", "protectedurl", "publicurl",
+  "shareurl", "signedurl", "storageurl", "driveurl", "thumbnailurl", "avatarurl", "profilepictureurl",
+  "storagekey", "drivefileid",
+]);
+
+const MONEY_KEYS = new Set([
+  "amount", "salary", "wage", "price", "cost", "budget", "balance", "revenue", "income",
+  "commission", "fee", "dealvalue", "contractvalue", "totalamount", "paidamount", "dueamount",
+  "monthlyfee", "annualfee", "servicefee", "paymentamount", "invoiceamount", "grossprofit", "netprofit",
+  "profit", "loss", "subtotal", "grandtotal",
+]);
+
+const MONEY_SUFFIXES = [
+  "amount", "salary", "wage", "price", "cost", "budget", "balance", "revenue", "income",
+  "commission", "fee", "profit", "loss", "subtotal", "grandtotal",
+];
+
+const SECRET_FRAGMENTS = [
+  "password", "secret", "token", "apikey", "authorization", "cookie", "credential", "smtppass",
+];
+
+function normalizeKey(key: string): string {
+  return String(key).replace(/[^a-zA-Z0-9]/g, "").toLowerCase();
+}
+
+function isIdentityContainerKey(key: string): boolean {
+  const normalized = normalizeKey(key);
+  return IDENTITY_CONTAINER_FRAGMENTS.some(fragment => normalized === fragment || normalized.endsWith(fragment));
+}
+
+function objectLooksLikeIdentityRecord(value: Record<string, unknown>): boolean {
+  const keys = Object.keys(value).map(normalizeKey);
+  return keys.some(key => IDENTITY_SIGNAL_KEYS.some(signal => key === signal || key.endsWith(signal)));
+}
+
+function classifyKey(key: string, identityRecord: boolean): SensitiveKind | null {
+  const normalized = normalizeKey(key);
+  if (EMAIL_KEYS.has(normalized) || normalized.endsWith("email")) return "email";
+  if (
+    normalized === "phone" || normalized.endsWith("phone") || normalized === "mobile" ||
+    normalized.endsWith("mobile") || normalized === "whatsappnumber" ||
+    normalized === "whatsappphone" || normalized === "waid"
+  ) return "phone";
+  if (IDENTIFIER_KEYS.has(normalized)) return "identifier";
+  if (SECRET_FRAGMENTS.some(fragment => normalized.includes(fragment))) return "secret";
+  if (PRIVATE_RESOURCE_KEYS.has(normalized)) return "resource";
+  if (MONEY_KEYS.has(normalized) || MONEY_SUFFIXES.some(suffix => normalized.endsWith(suffix))) return "money";
+  if (PRIVATE_TEXT_KEYS.has(normalized) || normalized.endsWith("address")) return "text";
+  if (ALWAYS_PRIVATE_NAME_KEYS.has(normalized)) return "text";
+  if (normalized === "website" && identityRecord) return "text";
+  if (normalized === "name" && identityRecord) return "text";
+  return null;
+}
+
+function zeroDigits(value: string): string {
+  const digitCount = (value.match(/\d/g) ?? []).length;
+  return "0".repeat(Math.max(1, digitCount));
+}
+
+function zeroValue(value: unknown, kind: SensitiveKind): unknown {
+  if (value === null || value === undefined) return value;
+  if (typeof value === "number") return 0;
+  if (typeof value === "bigint") return BigInt(0);
+  if (typeof value === "boolean") return value;
+  if (typeof value === "string") {
+    if (kind === "email") return "0@0.local";
+    if (kind === "phone" || kind === "identifier") return zeroDigits(value);
+    return "0";
+  }
+  if (Array.isArray(value)) return value.map(item => zeroValue(item, kind));
+  if (value instanceof Date) return value;
+  if (typeof value === "object") return {};
+  return "0";
+}
+
+function sanitizeNode(value: unknown, containerKey = "", depth = 0): unknown {
+  if (depth > 20 || value === null || value === undefined) return value;
+  if (value instanceof Date) return value;
+  if (Array.isArray(value)) return value.map(item => sanitizeNode(item, containerKey, depth + 1));
+  if (typeof value !== "object") return value;
+
+  const source = value as Record<string, unknown>;
+  const identityRecord = isIdentityContainerKey(containerKey) || objectLooksLikeIdentityRecord(source);
+  const output: Record<string, unknown> = {};
+
+  for (const [key, item] of Object.entries(source)) {
+    const kind = classifyKey(key, identityRecord);
+    output[key] = kind ? zeroValue(item, kind) : sanitizeNode(item, key, depth + 1);
+  }
+
+  return output;
+}
+
+/** Returns a sanitized clone; database/source objects are never mutated. */
+export function sanitizeDeveloperData<T>(value: T): T {
+  return sanitizeNode(value) as T;
+}
+
