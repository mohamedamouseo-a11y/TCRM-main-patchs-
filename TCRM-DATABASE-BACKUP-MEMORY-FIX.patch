+      const sql=path.join(dir,"db.sql"),encrypted=path.join(dir,name);
+      await dump(sql);
+      const meta=await encryptFile(sql,encrypted);
+      const up=await drive.files.create({requestBody:{name,parents:[f]},media:{mimeType:"application/octet-stream",body:fs.createReadStream(encrypted)},fields:"id,name,size,createdTime,webViewLink"});
+      await retention(drive,f);
+      await writeJson(STATE(),{...(await state()),lastSuccessAt:now.toISOString(),lastError:"",lastBackupName:name});
