+export async function createTcrmDbBackup(actor?:any){
+  if(backupInProgress)throw new TcrmDbBackupError("Database backup already running",409);
+  backupInProgress=true;
+  let dir="";
+  try{
+    const c=await config();
+    if(!c.googleDrive.refreshTokenEnc)throw new TcrmDbBackupError("Google Drive is not connected",400);
+    const now=new Date(),name=`TCRM_DB_${now.toISOString().replace("T","_").replace(/:/g,"-").replace(/\.\d{3}Z$/,"")}.sql.enc`;
+    await writeJson(STATE(),{...(await state()),lastAttemptAt:now.toISOString(),lastError:""});
+    try{
+      const {drive,c:dc}=await driveClient(),f=await folder(drive,dc);
+      dir=path.join(TMP(),String(Date.now()));
