+async function dump(file:string){
+  const d=dbUrl();
+  await ensureDir(path.dirname(file));
+  await run(process.env.TCRM_MYSQLDUMP_BIN||"mysqldump",["--single-transaction","--quick","--routines","--triggers","--events","--hex-blob","--host",d.host,"--port",d.port,"--user",d.user,"--result-file",file,d.database],{MYSQL_PWD:d.password});
+  const s=await fsp.stat(file);
+  if(s.size<1024)throw new Error("Database dump is unexpectedly small");
+  const fh=await fsp.open(file,"r");
+  try{
+    const b=Buffer.allocUnsafe(Math.min(2_000_000,s.size));
+    const {bytesRead}=await fh.read(b,0,b.length,0);
+    const head=b.subarray(0,bytesRead).toString("utf8");
+    if(!/CREATE TABLE|INSERT INTO/i.test(head))throw new Error("Database dump verification failed");
+  }finally{
+    await fh.close();
+  }
+}
+async function encryptFile(src:string,dst:string){
+  const iv=crypto.randomBytes(12),c=crypto.createCipheriv("aes-256-gcm",key(),iv),hash=crypto.createHash("sha256"),body=dst+".body";
+  try{
+    await new Promise<void>((resolve,reject)=>{
+      const i=fs.createReadStream(src),o=fs.createWriteStream(body,{mode:0o600});
+      i.on("data",d=>hash.update(d));
+      i.on("error",reject);c.on("error",reject);o.on("error",reject);o.on("finish",resolve);
+      i.pipe(c).pipe(o);
+    });
+    const meta={v:1,iv:iv.toString("base64"),tag:c.getAuthTag().toString("base64"),sha256:hash.digest("hex")};
+    await fsp.writeFile(dst,Buffer.from("TCRMDB01\n"+JSON.stringify(meta)+"\n"),{mode:0o600});
+    await new Promise<void>((resolve,reject)=>{
+      const i=fs.createReadStream(body),o=fs.createWriteStream(dst,{flags:"a"});
+      i.on("error",reject);o.on("error",reject);o.on("finish",resolve);i.pipe(o);
+    });
+    return meta;
+  }finally{
+    await fsp.rm(body,{force:true}).catch(()=>{});
+  }
+}
