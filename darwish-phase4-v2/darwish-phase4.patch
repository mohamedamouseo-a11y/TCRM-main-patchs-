@@ -0,0 +1,516 @@
+import { createHash } from "node:crypto";
+import { sql } from "drizzle-orm";
+import { getDb } from "../../../db";
+import { callTaraProviderWithFallback } from "../../tara/taraMultiProviderService";
+import { sendDarwishApprovedChatwootReply } from "./darwishChatwootService";
+
+type ActionType = "internal_note" | "follow_up_reminder" | "customer_reply";
+type ProposalStatus = "proposed" | "approved" | "executing" | "execution_uncertain" | "executed" | "rejected";
+
+type SupervisorAlertInput = {
+  id: number;
+  alertType: string;
+  severity: string;
+  title: string;
+  summary: string;
+  clientId: number | null;
+  clientName?: string | null;
+  groupJid: string;
+  groupName?: string | null;
+  accountManagerId: number | null;
+};
+
+type ActionSuggestion = {
+  actionType: ActionType;
+  title: string;
+  summary: string;
+  payload: Record<string, unknown>;
+};
+
+function rowsOf(result: any): any[] {
+  if (Array.isArray(result) && Array.isArray(result[0])) return result[0] as any[];
+  return Array.isArray(result) ? result : [];
+}
+
+function numberOf(value: unknown) {
+  const n = Number(value);
+  return Number.isFinite(n) ? n : 0;
+}
+
+function parseJson(value: unknown): Record<string, any> {
+  if (!value) return {};
+  if (typeof value === "object" && !Array.isArray(value)) return value as Record<string, any>;
+  try {
+    const parsed = JSON.parse(String(value));
+    return parsed && typeof parsed === "object" && !Array.isArray(parsed) ? parsed : {};
+  } catch {
+    return {};
+  }
+}
+
+function safeText(value: unknown, max = 2000) {
+  return String(value ?? "").replace(/\u0000/g, "").trim().slice(0, max);
+}
+
+function actionKey(sourceType: string, sourceId: number, actionType: ActionType) {
+  return createHash("sha256").update(`${sourceType}\0${sourceId}\0${actionType}`).digest("hex");
+}
+
+export function deriveDarwishActionSuggestions(alert: SupervisorAlertInput): ActionSuggestion[] {
+  const context = {
+    supervisorAlertId: alert.id,
+    alertType: alert.alertType,
+    severity: alert.severity,
+    alertTitle: alert.title,
+    alertSummary: alert.summary,
+  };
+  if (alert.alertType === "response_delay") {
+    return [{
+      actionType: "follow_up_reminder",
+      title: "متابعة استجابة العميل",
+      summary: "اقتراح تذكير داخلي لمدير الحساب لمراجعة المحادثة المتأخرة.",
+      payload: { ...context, reminderMinutes: 30 },
+    }];
+  }
+  if (alert.alertType === "repeated_complaint") {
+    return [{
+      actionType: "internal_note",
+      title: "توثيق الشكوى المتكررة",
+      summary: "اقتراح إضافة ملاحظة داخلية على العميل لتجميع سياق الشكوى المتكررة.",
+      payload: { ...context, note: `درويش: ${safeText(alert.title, 300)} — ${safeText(alert.summary, 1200)}` },
+    }];
+  }
+  if (alert.alertType === "critical_case" || alert.alertType === "churn_risk") {
+    return [
+      {
+        actionType: "internal_note",
+        title: alert.alertType === "churn_risk" ? "توثيق مخاطر فقدان العميل" : "توثيق الحالة الحرجة",
+        summary: "اقتراح ملاحظة داخلية تحفظ ملخص الخطر للمراجعة البشرية.",
+        payload: { ...context, note: `درويش: ${safeText(alert.title, 300)} — ${safeText(alert.summary, 1200)}` },
+      },
+      {
+        actionType: "follow_up_reminder",
+        title: "متابعة عاجلة مع العميل",
+        summary: "اقتراح تذكير داخلي لمدير الحساب لمراجعة الحالة. لا يتم إرسال أي رسالة للعميل.",
+        payload: { ...context, reminderMinutes: alert.severity === "critical" ? 15 : 30 },
+      },
+    ];
+  }
+  return [];
+}
+
+async function recordActionEvent(db: any, proposalId: number, eventType: string, actorUserId?: number | null, metadata?: unknown) {
+  await db.execute(sql`
+    INSERT INTO darwish_action_events (proposal_id, event_type, actor_user_id, metadata)
+    VALUES (${proposalId}, ${safeText(eventType, 32)}, ${actorUserId || null}, ${metadata == null ? null : JSON.stringify(metadata)})
+  `);
+}
+
+export async function refreshDarwishActionProposals(limit = 100) {
+  const db = await getDb();
+  if (!db) throw new Error("Database unavailable");
+  const safeLimit = Math.max(1, Math.min(500, Math.floor(limit)));
+  const alerts = rowsOf(await db.execute(sql`
+    SELECT a.id, a.alert_type AS alertType, a.severity, a.title, a.summary,
+           a.client_id AS clientId, c.leadName AS clientName, a.group_jid AS groupJid,
+           a.group_name AS groupName, a.account_manager_id AS accountManagerId
+    FROM darwish_supervisor_alerts a
+    LEFT JOIN clients c ON c.id = a.client_id
+    WHERE a.active = 1
+    ORDER BY FIELD(a.severity, 'critical','high','medium','low'), a.last_seen_at DESC, a.id DESC
+    LIMIT ${safeLimit}
+  `));
+  let created = 0;
+  let existing = 0;
+  for (const raw of alerts) {
+    const alert: SupervisorAlertInput = {
+      id: numberOf(raw.id),
+      alertType: safeText(raw.alertType, 32),
+      severity: safeText(raw.severity, 16),
+      title: safeText(raw.title, 500),
+      summary: safeText(raw.summary, 4000),
+      clientId: raw.clientId == null ? null : numberOf(raw.clientId),
+      clientName: raw.clientName ? safeText(raw.clientName, 255) : null,
+      groupJid: safeText(raw.groupJid, 255),
+      groupName: raw.groupName ? safeText(raw.groupName, 255) : null,
+      accountManagerId: raw.accountManagerId == null ? null : numberOf(raw.accountManagerId),
+    };
+    for (const suggestion of deriveDarwishActionSuggestions(alert)) {
+      const key = actionKey("supervisor_alert", alert.id, suggestion.actionType);
+      const result: any = await db.execute(sql`
+        INSERT INTO darwish_action_proposals (
+          proposal_key, source_type, source_id, client_id, group_jid, group_name, account_manager_id,
+          action_type, title, summary, payload, risk_level, status
+        ) VALUES (
+          ${key}, 'supervisor_alert', ${alert.id}, ${alert.clientId}, ${alert.groupJid || null}, ${alert.groupName}, ${alert.accountManagerId},
+          ${suggestion.actionType}, ${suggestion.title}, ${suggestion.summary}, ${JSON.stringify(suggestion.payload)}, ${alert.severity}, 'proposed'
+        )
+        ON DUPLICATE KEY UPDATE
+          title = IF(status = 'proposed', VALUES(title), title),
+          summary = IF(status = 'proposed', VALUES(summary), summary),
+          payload = IF(status = 'proposed', VALUES(payload), payload),
+          risk_level = IF(status = 'proposed', VALUES(risk_level), risk_level),
+          updated_at = CURRENT_TIMESTAMP
+      `);
+      const meta = Array.isArray(result) ? result[0] : result;
+      if (Number(meta?.affectedRows || 0) === 1) {
+        created += 1;
+        const insertedId = Number(meta?.insertId || 0);
+        if (insertedId) await recordActionEvent(db, insertedId, "proposed", null, { source: "darwish_worker", automaticExecution: false });
+      } else existing += 1;
+    }
+  }
+  return { alertsReviewed: alerts.length, created, existing };
+}
