index 0000000..40d87e9
--- /dev/null
+++ b/server/services/darwish/chatwoot/darwishActionService.test.ts
@@ -0,0 +1,46 @@
+import { describe, expect, it } from "vitest";
+import {
+  __deriveDarwishActionSuggestionsForTests,
+  __isDarwishActionExecutableStatusForTests,
+  __normalizeDarwishReplyDraftForTests,
+} from "./darwishActionService";
+
+const baseAlert = {
+  id: 10,
+  severity: "high",
+  title: "تنبيه",
+  summary: "العميل يحتاج متابعة",
+  clientId: 15,
+  clientName: "Client",
+  groupJid: "120@g.us",
+  groupName: "Client Group",
+  accountManagerId: 22,
+  alertType: "critical_case",
+};
+
+describe("Darwish Phase 4 human-approved actions", () => {
+  it("proposes an internal note and follow-up for a critical case", () => {
+    const suggestions = __deriveDarwishActionSuggestionsForTests(baseAlert);
+    expect(suggestions.map((item) => item.actionType)).toContain("internal_note");
+    expect(suggestions.map((item) => item.actionType)).toContain("follow_up_reminder");
+  });
+
+  it("proposes follow-up only for response delay", () => {
+    const suggestions = __deriveDarwishActionSuggestionsForTests({ ...baseAlert, alertType: "response_delay" });
+    expect(suggestions.map((item) => item.actionType)).toEqual(["follow_up_reminder"]);
+  });
+
+  it("proposes an internal note for repeated complaints", () => {
+    const suggestions = __deriveDarwishActionSuggestionsForTests({ ...baseAlert, alertType: "repeated_complaint" });
+    expect(suggestions.map((item) => item.actionType)).toEqual(["internal_note"]);
+  });
+
+  it("treats only approved actions as executable", () => {
+    expect(__isDarwishActionExecutableStatusForTests("approved")).toBe(true);
+    expect(__isDarwishActionExecutableStatusForTests("proposed")).toBe(false);
+    expect(__isDarwishActionExecutableStatusForTests("execution_uncertain")).toBe(false);
+  });
+
+  it("normalizes fenced reply drafts without sending them", () => {
+    expect(__normalizeDarwishReplyDraftForTests("```json\n{\"reply\":\"أهلًا، نتابع المشكلة الآن\"}\n```"))
+      .toBe("أهلًا، نتابع المشكلة الآن");
+  });
+});
diff --git a/server/services/darwish/chatwoot/darwishActionService.ts b/server/services/darwish/chatwoot/darwishActionService.ts
