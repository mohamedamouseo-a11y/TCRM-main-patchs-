+export async function approveDarwishAction(id: number, actorUserId: number) {
+  const db = await getDb();
+  if (!db) throw new Error("Database unavailable");
+  const result: any = await db.execute(sql`
+    UPDATE darwish_action_proposals
+    SET status = 'approved', reviewed_by = ${actorUserId}, reviewed_at = CURRENT_TIMESTAMP,
+        rejection_reason = NULL, last_error = NULL, updated_at = CURRENT_TIMESTAMP
+    WHERE id = ${id} AND status = 'proposed'
+  `);
+  const meta = Array.isArray(result) ? result[0] : result;
+  if (Number(meta?.affectedRows || 0) !== 1) throw new Error("Action is not awaiting approval");
+  await recordActionEvent(db, id, "approved", actorUserId, { executionTriggered: false });
+  return loadProposal(id);
+}
+
+export async function rejectDarwishAction(id: number, actorUserId: number, reason?: string) {
+  const db = await getDb();
+  if (!db) throw new Error("Database unavailable");
+  const result: any = await db.execute(sql`
+    UPDATE darwish_action_proposals
+    SET status = 'rejected', reviewed_by = ${actorUserId}, reviewed_at = CURRENT_TIMESTAMP,
+        rejection_reason = ${safeText(reason, 1000) || null}, updated_at = CURRENT_TIMESTAMP
+    WHERE id = ${id} AND status IN ('proposed','approved')
+  `);
+  const meta = Array.isArray(result) ? result[0] : result;
+  if (Number(meta?.affectedRows || 0) !== 1) throw new Error("Action cannot be rejected in its current state");
+  await recordActionEvent(db, id, "rejected", actorUserId, { reason: safeText(reason, 1000) || null });
+  return loadProposal(id);
+}
+
+async function executeInternalNote(db: any, proposal: any, actorUserId: number) {
+  if (!proposal.clientId) throw new Error("Internal note action requires a TCRM client");
+  const payload = parseJson(proposal.payload);
+  const marker = `[Darwish Action #${proposal.id}]`;
+  const note = `${marker}\n${safeText(payload.note || proposal.summary, 5000)}`;
+  const existing = rowsOf(await db.execute(sql`
+    SELECT id FROM client_notes WHERE clientId = ${proposal.clientId} AND note LIKE ${`${marker}%`} LIMIT 1
+  `))[0];
+  if (existing?.id) return { kind: "internal_note", noteId: numberOf(existing.id), idempotent: true };
+  const result: any = await db.execute(sql`
+    INSERT INTO client_notes (clientId, note, createdBy, createdAt, updatedAt)
+    VALUES (${proposal.clientId}, ${note}, ${actorUserId}, CURRENT_TIMESTAMP, CURRENT_TIMESTAMP)
+  `);
+  const meta = Array.isArray(result) ? result[0] : result;
+  return { kind: "internal_note", noteId: Number(meta?.insertId || 0), idempotent: false };
+}
+
+async function executeFollowUpReminder(db: any, proposal: any) {
+  const userId = numberOf(proposal.accountManagerId);
+  if (!userId) throw new Error("Follow-up reminder requires an Account Manager");
+  const payload = parseJson(proposal.payload);
+  const minutes = Math.max(5, Math.min(1440, numberOf(payload.reminderMinutes) || 30));
+  const existing = rowsOf(await db.execute(sql`
+    SELECT id FROM in_app_notifications
+    WHERE userId = ${userId} AND JSON_UNQUOTE(JSON_EXTRACT(metadata, '$.darwishActionProposalId')) = ${String(proposal.id)}
+    LIMIT 1
+  `))[0];
+  if (existing?.id) return { kind: "follow_up_reminder", notificationId: numberOf(existing.id), idempotent: true };
+  const result: any = await db.execute(sql`
+    INSERT INTO in_app_notifications (userId, type, title, titleAr, body, bodyAr, isRead, link, metadata, createdAt)
+    VALUES (
+      ${userId}, 'follow_up_reminder', 'Darwish customer follow-up', 'متابعة عميل من درويش',
+      ${`Review the customer service case within ${minutes} minutes.`}, ${`راجع حالة خدمة العميل خلال ${minutes} دقيقة.`},
+      0, '/darwish', ${JSON.stringify({ darwishActionProposalId: proposal.id, clientId: proposal.clientId || null, minutes })}, CURRENT_TIMESTAMP
+    )
+  `);
+  const meta = Array.isArray(result) ? result[0] : result;
+  return { kind: "follow_up_reminder", notificationId: Number(meta?.insertId || 0), idempotent: false };
+}
+
+async function executeCustomerReply(proposal: any) {
+  const payload = parseJson(proposal.payload);
+  const content = safeText(payload.content, 4000);
+  const conversationId = safeText(proposal.chatwootConversationId || payload.chatwootConversationId, 128);
+  if (!conversationId) throw new Error("Approved customer reply has no Chatwoot conversation id");
+  if (!content) throw new Error("Approved customer reply is empty");
+  const body = await sendDarwishApprovedChatwootReply(conversationId, content);
+  return { kind: "customer_reply", chatwootConversationId: conversationId, response: body };
+}
+
+export async function executeDarwishApprovedAction(id: number, actorUserId: number) {
+  const db = await getDb();
+  if (!db) throw new Error("Database unavailable");
+  const existing = await loadProposal(id);
+  if (!existing) throw new Error("Darwish action proposal not found");
+  if (existing.status === "executed") return existing;
+  if (existing.status === "execution_uncertain") throw new Error("Action execution is uncertain; manually verify before retrying");
+  if (existing.status !== "approved") throw new Error("Action must be explicitly approved before execution");
+  const claim: any = await db.execute(sql`
+    UPDATE darwish_action_proposals
+    SET status = 'executing', last_error = NULL, updated_at = CURRENT_TIMESTAMP
+    WHERE id = ${id} AND status = 'approved'
+  `);
+  const claimMeta = Array.isArray(claim) ? claim[0] : claim;
+  if (Number(claimMeta?.affectedRows || 0) !== 1) throw new Error("Action execution could not be claimed");
+  const claimed = await loadProposal(id);
+  if (!claimed) throw new Error("Darwish action disappeared after claim");
+  await recordActionEvent(db, id, "execution_started", actorUserId);
+  try {
+    let result: Record<string, unknown>;
+    if (claimed.actionType === "internal_note") result = await executeInternalNote(db, claimed, actorUserId);
+    else if (claimed.actionType === "follow_up_reminder") result = await executeFollowUpReminder(db, claimed);
+    else if (claimed.actionType === "customer_reply") result = await executeCustomerReply(claimed);
+    else throw new Error(`Unsupported Darwish action type: ${claimed.actionType}`);
+    await db.execute(sql`
+      UPDATE darwish_action_proposals
+      SET status = 'executed', executed_at = CURRENT_TIMESTAMP, execution_result = ${JSON.stringify(result)},
+          last_error = NULL, updated_at = CURRENT_TIMESTAMP
+      WHERE id = ${id} AND status = 'executing'
+    `);
+    await recordActionEvent(db, id, "executed", actorUserId, result);
+    return loadProposal(id);
+  } catch (error) {
+    const message = safeText(error instanceof Error ? error.message : String(error), 2000);
+    const uncertain = claimed.actionType === "customer_reply";
+    await db.execute(sql`
+      UPDATE darwish_action_proposals
+      SET status = ${uncertain ? "execution_uncertain" : "approved"}, last_error = ${message}, updated_at = CURRENT_TIMESTAMP
+      WHERE id = ${id} AND status = 'executing'
+    `);
+    await recordActionEvent(db, id, uncertain ? "execution_uncertain" : "execution_failed", actorUserId, { error: message });
+    throw error;
+  }
+}
