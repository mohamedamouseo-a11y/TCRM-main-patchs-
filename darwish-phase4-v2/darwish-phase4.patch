+export async function listDarwishActionProposals(limit = 50, status = "all") {
+  const db = await getDb();
+  if (!db) return [];
+  const safeLimit = Math.max(1, Math.min(200, Math.floor(limit)));
+  const allowedStatuses = new Set(["proposed", "approved", "executing", "execution_uncertain", "executed", "rejected"]);
+  const filterStatus = allowedStatuses.has(status) ? status : "all";
+  const filter = filterStatus === "all" ? sql`` : sql`WHERE p.status = ${filterStatus}`;
+  return rowsOf(await db.execute(sql`
+    SELECT p.id, p.source_type AS sourceType, p.source_id AS sourceId, p.client_id AS clientId,
+           c.leadName AS clientName, p.group_jid AS groupJid, p.group_name AS groupName,
+           p.account_manager_id AS accountManagerId, p.chatwoot_conversation_id AS chatwootConversationId,
+           p.action_type AS actionType, p.title, p.summary, p.payload, p.risk_level AS riskLevel,
+           p.status, p.reviewed_by AS reviewedBy, p.reviewed_at AS reviewedAt,
+           p.executed_at AS executedAt, p.execution_result AS executionResult,
+           p.last_error AS lastError, p.created_at AS createdAt, p.updated_at AS updatedAt
+    FROM darwish_action_proposals p
+    LEFT JOIN clients c ON c.id = p.client_id
+    ${filter}
+    ORDER BY FIELD(p.status, 'proposed','approved','execution_uncertain','executing','executed','rejected'), p.updated_at DESC, p.id DESC
+    LIMIT ${safeLimit}
+  `)).map((row) => ({ ...row, payload: parseJson(row.payload), executionResult: parseJson(row.executionResult) }));
+}
