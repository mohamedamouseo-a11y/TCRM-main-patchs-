+export function normalizeDarwishReplyDraft(raw: string) {
+  const cleaned = safeText(raw, 8000).replace(/^```(?:json)?\s*/i, "").replace(/\s*```$/i, "").trim();
+  try {
+    const parsed = JSON.parse(cleaned);
+    const reply = safeText(parsed?.reply || parsed?.message || parsed?.content, 4000);
+    if (reply) return reply;
+  } catch {
+    // Providers may return plain text. Drafting is internal-only and does not transmit anything.
+  }
+  return cleaned.slice(0, 4000);
+}
+
+export async function draftDarwishReplyFromIntelligence(intelligenceId: number, actorUserId: number) {
+  const db = await getDb();
+  if (!db) throw new Error("Database unavailable");
+  const row = rowsOf(await db.execute(sql`
+    SELECT i.id, i.client_id AS clientId, i.group_jid AS groupJid, i.group_name AS groupName,
+           i.summary, i.sentiment, i.urgency, i.complaint_detected AS complaintDetected,
+           i.customer_needs AS customerNeeds, i.risks, i.recommended_actions AS recommendedActions,
+           i.escalation_required AS escalationRequired, i.escalation_reason AS escalationReason,
+           c.accountManagerId AS accountManagerId, c.leadName AS clientName
+    FROM darwish_intelligence i
+    LEFT JOIN clients c ON c.id = i.client_id
+    WHERE i.id = ${intelligenceId} LIMIT 1
+  `))[0];
+  if (!row) throw new Error("Darwish intelligence result not found");
+  const context = {
+    summary: safeText(row.summary, 4000), sentiment: safeText(row.sentiment, 32), urgency: safeText(row.urgency, 32),
+    complaintDetected: Boolean(numberOf(row.complaintDetected)), customerNeeds: parseJson(row.customerNeeds), risks: parseJson(row.risks),
+    recommendedActions: parseJson(row.recommendedActions), escalationRequired: Boolean(numberOf(row.escalationRequired)),
+    escalationReason: safeText(row.escalationReason, 1000),
+  };
+  const provider = await callTaraProviderWithFallback([
+    { role: "system", content: "أنت درويش مساعد خدمة عملاء داخلي. اكتب مسودة رد عربية مهنية ومختصرة بناءً على التحليل. لا تدّعِ تنفيذ أي إجراء ولا تعد العميل بشيء غير مؤكد. أعد JSON فقط بالشكل {\"reply\":\"...\"}. هذه مسودة للمراجعة البشرية ولن يتم إرسالها تلقائيًا." },
+    { role: "user", content: JSON.stringify(context) },
+  ], { temperature: 0.2, maxTokens: 700 });
+  const reply = normalizeDarwishReplyDraft(provider.content || "");
+  if (!reply) throw new Error("Darwish reply draft provider returned empty content");
+  const key = actionKey("intelligence", numberOf(row.id), "customer_reply");
+  await db.execute(sql`
+    INSERT INTO darwish_action_proposals (
+      proposal_key, source_type, source_id, client_id, group_jid, group_name, account_manager_id,
+      action_type, title, summary, payload, risk_level, status
+    ) VALUES (
+      ${key}, 'intelligence', ${numberOf(row.id)}, ${row.clientId == null ? null : numberOf(row.clientId)}, ${safeText(row.groupJid, 255) || null}, ${row.groupName ? safeText(row.groupName, 255) : null},
+      ${row.accountManagerId == null ? null : numberOf(row.accountManagerId)}, 'customer_reply', 'مسودة رد للعميل', 'مسودة أنشأها درويش للمراجعة البشرية فقط.',
+      ${JSON.stringify({ content: reply, provider: provider.provider || null, model: provider.model || null })}, ${safeText(row.urgency, 16)}, 'proposed'
+    )
+    ON DUPLICATE KEY UPDATE
+      title = IF(status = 'proposed', VALUES(title), title),
+      summary = IF(status = 'proposed', VALUES(summary), summary),
+      payload = IF(status = 'proposed', VALUES(payload), payload),
+      risk_level = IF(status = 'proposed', VALUES(risk_level), risk_level),
+      updated_at = CURRENT_TIMESTAMP
+  `);
+  const proposal = rowsOf(await db.execute(sql`SELECT id FROM darwish_action_proposals WHERE proposal_key = ${key} LIMIT 1`))[0];
+  if (proposal?.id) await recordActionEvent(db, numberOf(proposal.id), "draft_refreshed", actorUserId, { provider: provider.provider || null, noSend: true });
+  return loadProposal(numberOf(proposal?.id));
+}
+
+async function loadProposal(id: number) {
+  const db = await getDb();
+  if (!db) throw new Error("Database unavailable");
+  const row = rowsOf(await db.execute(sql`
+    SELECT id, source_type AS sourceType, source_id AS sourceId, client_id AS clientId,
+           group_jid AS groupJid, group_name AS groupName, account_manager_id AS accountManagerId,
+           chatwoot_conversation_id AS chatwootConversationId, action_type AS actionType, title, summary,
+           payload, risk_level AS riskLevel, status, reviewed_by AS reviewedBy, reviewed_at AS reviewedAt,
+           executed_at AS executedAt, execution_result AS executionResult, last_error AS lastError
+    FROM darwish_action_proposals WHERE id = ${id} LIMIT 1
+  `))[0];
+  return row ? { ...row, payload: parseJson(row.payload), executionResult: parseJson(row.executionResult) } : null;
+}
