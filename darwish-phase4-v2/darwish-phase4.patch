+export async function getDarwishActionStats() {
+  const db = await getDb();
+  if (!db) return { proposed: 0, approved: 0, executing: 0, uncertain: 0, executed: 0, rejected: 0, replyQueue: 0 };
+  const row = rowsOf(await db.execute(sql`
+    SELECT SUM(status = 'proposed') AS proposed,
+           SUM(status = 'approved') AS approved,
+           SUM(status = 'executing') AS executing,
+           SUM(status = 'execution_uncertain') AS uncertain,
+           SUM(status = 'executed') AS executed,
+           SUM(status = 'rejected') AS rejected,
+           SUM(action_type = 'customer_reply' AND status IN ('proposed','approved','execution_uncertain')) AS replyQueue
+    FROM darwish_action_proposals
+  `))[0] || {};
+  return {
+    proposed: numberOf(row.proposed), approved: numberOf(row.approved), executing: numberOf(row.executing),
+    uncertain: numberOf(row.uncertain), executed: numberOf(row.executed), rejected: numberOf(row.rejected), replyQueue: numberOf(row.replyQueue),
+  };
+}
