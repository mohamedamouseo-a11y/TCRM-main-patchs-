+++ b/server/utils/developerAccessPolicy.test.ts
@@ -0,0 +1,33 @@
+import { describe, expect, it } from "vitest";
+import { getDeveloperAccessDenialReason } from "./developerAccessPolicy";
+
+describe("developerAccessPolicy", () => {
+  it("blocks user deletion and privilege escalation", () => {
+    expect(getDeveloperAccessDenialReason({ path: "users.delete", type: "mutation", input: { id: 9 } })).toContain("delete users");
+    expect(getDeveloperAccessDenialReason({ path: "users.promoteOwner", type: "mutation" })).toContain("Admin");
+  });
+
+  it("allows creating Developer test accounts but not bypass accounts", () => {
+    expect(getDeveloperAccessDenialReason({ path: "users.create", type: "mutation", input: { role: "Developer" } })).toBeNull();
+    expect(getDeveloperAccessDenialReason({ path: "users.create", type: "mutation", input: { role: "SalesAgent" } })).toContain("Developer test accounts");
+    expect(getDeveloperAccessDenialReason({ path: "users.create", type: "mutation", input: {} })).toContain("Developer test accounts");
+  });
+
+  it("blocks role, activation, and session-security changes on users", () => {
+    expect(getDeveloperAccessDenialReason({ path: "users.update", type: "mutation", input: { id: 4, role: "Admin" } })).not.toBeNull();
+    expect(getDeveloperAccessDenialReason({ path: "users.update", type: "mutation", input: { id: 4, isActive: false } })).not.toBeNull();
+    expect(getDeveloperAccessDenialReason({ path: "users.update", type: "mutation", input: { id: 4, name: "Test" } })).toBeNull();
+  });
+
+  it("blocks password-reset, public-share, and export bypasses", () => {
+    expect(getDeveloperAccessDenialReason({ path: "auth.adminSetPassword", type: "mutation", input: { userId: 2 } })).not.toBeNull();
+    expect(getDeveloperAccessDenialReason({ path: "crmFiles.createPublicViewOnlyShareLink", type: "mutation", input: { crmFileId: 2 } })).not.toBeNull();
+    expect(getDeveloperAccessDenialReason({ path: "leads.export", type: "mutation" })).not.toBeNull();
+  });
+
+  it("leaves normal feature mutations available", () => {
+    expect(getDeveloperAccessDenialReason({ path: "leads.update", type: "mutation", input: { id: 3, stage: "New" } })).toBeNull();
+    expect(getDeveloperAccessDenialReason({ path: "users.delete", type: "query", input: { id: 3 } })).toBeNull();
+  });
+});
+
