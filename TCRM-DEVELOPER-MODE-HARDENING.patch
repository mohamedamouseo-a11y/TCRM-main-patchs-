new file mode 100644
--- /dev/null
+++ b/server/utils/developerAccessPolicy.ts
@@ -0,0 +1,67 @@
+export type DeveloperAccessPolicyInput = {
+  path: string;
+  type?: string | null;
+  input?: unknown;
+};
+
+const EXACT_MUTATION_DENIALS: Record<string, string> = {
+  "users.delete": "Developer mode cannot delete users.",
+  "users.promoteOwner": "Developer mode cannot promote itself to Admin.",
+  "auth.adminSetPassword": "Developer mode cannot reset another user's password.",
+  "crmFiles.createPublicViewOnlyShareLink": "Developer mode cannot create public CRM file links.",
+};
+
+const BLOCKED_USER_UPDATE_FIELDS = new Set([
+  "role",
+  "isActive",
+  "password",
+  "passwordHash",
+  "sessionVersion",
+]);
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+  return Boolean(value) && typeof value === "object" && !Array.isArray(value);
+}
+
+function hasBlockedUserUpdateField(input: unknown): boolean {
+  if (!isRecord(input)) return false;
+  return Object.keys(input).some((key) => BLOCKED_USER_UPDATE_FIELDS.has(key));
+}
+
+function isExportMutationPath(path: string): boolean {
+  const operation = String(path.split(".").pop() || "").toLowerCase();
+  return operation.includes("export");
+}
+
+/**
+ * Returns a user-facing denial reason for Developer-only mutation restrictions.
+ * Queries remain available and are sanitized separately by developerDataProtection.
+ */
+export function getDeveloperAccessDenialReason({
+  path,
+  type,
+  input,
+}: DeveloperAccessPolicyInput): string | null {
+  if (type && type !== "mutation") return null;
+
+  const exactReason = EXACT_MUTATION_DENIALS[path];
+  if (exactReason) return exactReason;
+
+  if (path === "users.create") {
+    const requestedRole = isRecord(input) ? String(input.role ?? "SalesAgent") : "SalesAgent";
+    if (requestedRole !== "Developer") {
+      return "Developer mode may create only Developer test accounts.";
+    }
+  }
+
+  if (path === "users.update" && hasBlockedUserUpdateField(input)) {
+    return "Developer mode cannot change user roles, activation state, passwords, or session security.";
+  }
+
+  if (isExportMutationPath(path)) {
+    return "Developer mode cannot export production data.";
+  }
+
+  return null;
+}
+
diff --git a/server/utils/developerAccessPolicy.test.ts b/server/utils/developerAccessPolicy.test.ts
new file mode 100644
