+++ b/server/utils/developerDataSanitizer.test.ts
@@ -0,0 +1,43 @@
+import { describe, expect, it } from "vitest";
+import { sanitizeDeveloperData } from "./developerDataSanitizer";
+
+describe("developerDataSanitizer", () => {
+  it("zeros customer identity, financial values, file metadata, and resource URLs without mutating source", () => {
+    const source = {
+      client: {
+        id: 17,
+        name: "Real Customer",
+        email: "real@example.com",
+        phone: "+201234567890",
+        dealValue: 125000,
+        monthlyFee: 5000,
+        fileName: "real-customer-contract.pdf",
+        downloadUrl: "/api/crm-files/91/download",
+        driveFileId: "drive-secret-id",
+        status: "active",
+      },
+      analytics: {
+        totalRevenue: 900000,
+        grossProfit: 200000,
+      },
+    };
+
+    const sanitized = sanitizeDeveloperData(source);
+
+    expect(sanitized.client.id).toBe(17);
+    expect(sanitized.client.name).toBe("0");
+    expect(sanitized.client.email).toBe("0@0.local");
+    expect(sanitized.client.phone).toMatch(/^0+$/);
+    expect(sanitized.client.dealValue).toBe(0);
+    expect(sanitized.client.monthlyFee).toBe(0);
+    expect(sanitized.client.fileName).toBe("0");
+    expect(sanitized.client.downloadUrl).toBe("0");
+    expect(sanitized.client.driveFileId).toBe("0");
+    expect(sanitized.client.status).toBe("active");
+    expect(sanitized.analytics.totalRevenue).toBe(0);
+    expect(sanitized.analytics.grossProfit).toBe(0);
+
+    expect(source.client.name).toBe("Real Customer");
+    expect(source.client.dealValue).toBe(125000);
+  });
+});
