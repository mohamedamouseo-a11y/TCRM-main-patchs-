+type DeveloperTablePreviewRowsProps = {
+  columns: number;
+  rows?: number;
+};
+
+export function DeveloperTablePreviewRows({ columns, rows = 4 }: DeveloperTablePreviewRowsProps) {
+  return (
+    <>
+      {Array.from({ length: rows }).map((_, rowIndex) => (
+        <tr
+          key={`developer-preview-row-${rowIndex}`}
+          aria-hidden="true"
+          data-developer-table-preview="true"
+          className="border-b border-border/70"
+        >
+          {Array.from({ length: columns }).map((__, columnIndex) => (
+            <td key={columnIndex} className="px-4 py-3">
+              <div
+                className="h-2.5 rounded-full bg-gradient-to-r from-muted/80 via-violet-500/15 to-muted/60"
+                style={{
+                  width: `${48 + ((rowIndex * 13 + columnIndex * 17) % 42)}%`,
+                  minWidth: columnIndex === 0 ? 72 : 34,
+                }}
+              />
+            </td>
+          ))}
+        </tr>
+      ))}
+    </>
+  );
+}
+
+export function DeveloperListPreview({ rows = 3 }: { rows?: number }) {
+  return (
+    <div aria-hidden="true" data-developer-list-preview="true" className="space-y-2">
+      {Array.from({ length: rows }).map((_, index) => (
+        <div
+          key={index}
+          className="flex items-center gap-3 rounded-lg border border-border/60 bg-muted/20 px-3 py-2"
+        >
+          <div className="h-2.5 w-2.5 shrink-0 rounded-full bg-violet-500/45" />
+          <div className="min-w-0 flex-1 space-y-1.5">
+            <div
+              className="h-2.5 rounded-full bg-muted-foreground/15"
+              style={{ width: `${72 - index * 8}%` }}
+            />
+            <div
+              className="h-2 rounded-full bg-muted-foreground/10"
+              style={{ width: `${44 + index * 7}%` }}
+            />
+          </div>
+          <div className="h-5 w-12 rounded-full bg-violet-500/10" />
+        </div>
+      ))}
+    </div>
+  );
+}
+
+export function DeveloperStageCardsPreview() {
+  return (
+    <div
+      aria-hidden="true"
+      data-developer-stage-preview="true"
+      className="flex flex-wrap gap-3"
+    >
+      {[0, 1, 2, 3, 4].map((index) => (
+        <div
+          key={index}
+          className="flex min-w-[140px] items-center gap-2 rounded-lg border border-border bg-card p-3"
+        >
+          <div
+            className="h-8 w-2 rounded-full"
+            style={{
+              background: [
+                "rgb(99 102 241 / .55)",
+                "rgb(139 92 246 / .5)",
+                "rgb(6 182 212 / .5)",
+                "rgb(34 197 94 / .48)",
+                "rgb(245 158 11 / .48)",
+              ][index],
+            }}
+          />
+          <div className="flex-1 space-y-1.5">
+            <div className="h-2.5 w-16 rounded-full bg-muted-foreground/15" />
+            <div className="h-3 w-8 rounded-full bg-muted-foreground/20" />
+            <div className="h-2 w-12 rounded-full bg-muted-foreground/10" />
+          </div>
+        </div>
+      ))}
+    </div>
+  );
+}
