 ? "بحث العميل" : "Client search"}</Label><Input value={clientSearch} onChange={(event) => setClientSearch(event.target.value)} placeholder={ar ? "اسم العميل أو النشاط" : "Client or business name"} />{clientsQ.data?.length ? <div className="mt-2 max-h-36 overflow-auto rounded border">{clientsQ.data.map((client) => <button type="button" key={client.id} onClick={() => { setClientId(client.id); setClientSearch(client.name || client.businessProfile || String(client.id)); }} className={`block w-full px-3 py-2 text-left text-sm hover:bg-muted ${client.id === clientId ? "bg-muted" : ""}`}>{client.name || client.businessProfile || `#${client.id}`}</button>)}</div> : null}</div><div><Label>{ar ? "معرّف مثيل Evolution" : "Evolution instance"}</Label><Input value={instance} onChange={(event) => setInstance(event.target.value)} placeholder="instance-name" /></div></div>
         <div className="grid gap-4 md:grid-cols-2"><div><Label>Group JID</Label><Input value={groupJid} onChange={(event) => setGroupJid(event.target.value)} placeholder="120363...@g.us" /></div><div><Label>{ar ? "اسم المجموعة" : "Group name"}</Label><Input value={groupName} onChange={(event) => setGroupName(event.target.value)} /></div></div>
