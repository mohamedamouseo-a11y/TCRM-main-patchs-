diff --git a/server/services/darwish/chatwoot/darwishSupervisorService.test.ts b/server/services/darwish/chatwoot/darwishSupervisorService.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..4cd036d6534e0821f9155ecd2792fe85cd99d299
--- /dev/null
+++ b/server/services/darwish/chatwoot/darwishSupervisorService.test.ts
@@ -0,0 +1,27 @@
+import { describe, expect, it } from "vitest";
+import { calculateDarwishSupervisorRisk, deriveDarwishSupervisorAlerts } from "./darwishSupervisorService";
+
+describe("Darwish Phase 3 supervisor", () => {
+  it("keeps healthy conversations low risk", () => {
+    const result = calculateDarwishSupervisorRisk({ complaintCount: 0, urgentCount: 0, negativeCount: 0, escalationCount: 0, repeatedIssueCategories: [], avgResponseMinutes: 18, pendingCustomerMessages: 0, oldestPendingMinutes: null });
+    expect(result.level).toBe("low");
+    expect(result.score).toBeLessThan(20);
+  });
+
+  it("raises churn risk for repeated urgent complaints and escalation", () => {
+    const result = calculateDarwishSupervisorRisk({ complaintCount: 3, urgentCount: 2, negativeCount: 3, escalationCount: 2, repeatedIssueCategories: ["delivery"], avgResponseMinutes: 180, pendingCustomerMessages: 1, oldestPendingMinutes: 300 });
+    expect(result.score).toBeGreaterThanOrEqual(80);
+    expect(result.level).toBe("critical");
+  });
+
+  it("creates repeated complaint and response-delay alerts", () => {
+    const alerts = deriveDarwishSupervisorAlerts({ complaintCount: 2, urgentCount: 0, negativeCount: 1, escalationCount: 0, repeatedIssueCategories: ["billing"], avgResponseMinutes: 150, pendingCustomerMessages: 1, oldestPendingMinutes: 250, riskScore: 60 });
+    expect(alerts.some((alert) => alert.type === "repeated_complaint")).toBe(true);
+    expect(alerts.some((alert) => alert.type === "response_delay")).toBe(tru