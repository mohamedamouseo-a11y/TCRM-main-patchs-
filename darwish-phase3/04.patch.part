+           i.complaint_detected AS complaintDetected, i.urgency, i.sentiment,
+           i.escalation_required AS escalationRequired, i.issue_categories AS issueCategories,
+           i.generated_at AS generatedAt
+    FROM darwish_intelligence i
+    LEFT JOIN clients c ON c.id = i.client_id
