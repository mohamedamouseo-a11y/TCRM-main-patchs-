y",
+      severity: input.oldestPendingMinutes != null && input.oldestPendingMinutes >= 480 ? "high" : "medium",
+      title: "تأخر في استجابة إدارة الحساب",
+      summary: `متوسط الرد ${input.avgResponseMinutes == null ? "غير متاح" : `${Math.round(input.avgResponseMinutes)} دقيقة`}، والرسائل المنتظرة ${input.pendingCustomerMessages}.`,
+    });
+  }
+  return alerts;
+}
+
+function calculateResponseStats(rows: any[]) {
+  const pendingByScope = new Map<string, number[]>();
+  const responseDurations = new Map<string, number[]>();
+  const now = Date.now();
+  for (const row of rows) {
+    const key = scopeKey(row.clientId ? Number(row.clientId) : null, String(row.groupJid || ""), String(row.evolutionInstance || ""));
+    const at = toMillis(row.messageTimestamp) ?? toMillis(row.receivedAt);
+    if (at == null) continue;
+    if (String(row.direction) === "outbound") {
+      const queue = pendingByScope.get(key) || [];
+      if (queue.length) {
+        const started = queue.shift()!;
+        const minutes = Math.max(0, (at - started) / 60000);
+        const durations = responseDurations.get(key) || [];
+        durations.push(minutes);
+        responseDurations.set(key, durations);
+        pendingByScope.set(key, queue);
+      }
+    } else {
+      const queue = pendingByScope.get(key) || [];
+      queue.push(at);
+      pendingByScope.set(key, queue);
+    }
+  }
+  const result = new Map<string, { avgResponseMinutes: number | null; pendingCustomerMessages: number; oldestPendingMinutes: number | null }>();
+  const keys = new Set([...pendingByScope.keys(), ...responseDurations.keys()]);
+  for (const key of keys) {
+    const queue = pendingByScope.get(key) || [];
+    const durations = responseDurations.get(key) || [];
+    const avg = durations.length ? durations.reduce((sum, value) => sum + value, 0) / durations.length : null;
+    const oldest = queue.length ? Math.max(0, (now - Math.min(...queue)) / 60000) : null;
+    result.set(key, { avgResponseMinutes: avg, pendingCustomerMessages: queue.length, oldestPendingMinutes: oldest });
+  }
+  return result;
+}
+
+function qualityScore(avgRiskScore: number, highRiskRate: number, avgResponseMinutes: number | null) {
+  const responsePenalty = avgResponseMinutes == null ? 0 : avgResponseMinutes >= 240 ? 30 : avgResponseMinutes >= 120 ? 20 : avgResponseMinutes >= 60 ? 10 : 0;
+  return Math.max(0, Math.min(100, Math.round(100 - (avgRiskScore * 0.45) - (highRiskRate * 25) - responsePenalty)));
+}
+
