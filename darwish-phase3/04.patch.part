+    if (numberOf(row.complaintDetected) === 1) current.complaintCount += 1;
+    if (["high", "critical"].includes(String(row.urgency))) current.urgentCount += 1;
+    if (String(row.sentiment) === "negative") current.negativeCount += 1;
+    if (numberOf(row.escalationRequired) === 1) current.escalationCount += 1;
+    for (const category of parseStringArray(row.issueCategories)) {
+      current.categoryCounts.set(category, (current.categoryCounts.get(category) || 0) + 1);
+    }
+    scopes.set(key, current);
+  }
+
