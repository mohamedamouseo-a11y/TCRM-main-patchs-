e);
+  });
+
+  it("does not create churn alert below threshold", () => {
+    const alerts = deriveDarwishSupervisorAlerts({ complaintCount: 0, urgentCount: 0, negativeCount: 0, escalationCount: 0, repeatedIssueCategories: [], avgResponseMinutes: 20, pendingCustomerMessages: 0, oldestPendingMinutes: null, riskScore: 10 });
+    expect(alerts.some((alert) => alert.type === "churn_risk")).toBe(false);
+  });
+});
diff --git a/server/services/darwish/chatwoot/darwishSupervisorService.ts b/server/services/darwish/chatwoot/darwishSupervisorService.ts
new file mode 100644
index 0000000000000000000000000000000000000000..21f96ed5da18346da11630dadc8a3477dd5c8b4e
