@@ -0,0 +1,222 @@
+export const DARWISH_AI_PROVIDER_ROUTING_STATUS = "routing_fallback_ready_not_integrated" as const;
+
+export type DarwishAiSelectionStrategy = "priority" | "weighted_random";
+
+export type DarwishAiRoutingPolicy = {
+  id: number;
+  routeKey: string;
+  displayName: string;
+  selectionStrategy: DarwishAiSelectionStrategy;
+  enabled: boolean;
+  maxAttempts: number;
+  timeoutMs: number;
+  config?: Record<string, unknown> | null;
+};
+
+export type DarwishAiRoutingTarget = {
+  id: number;
+  policyId: number;
+  providerId: number;
+  modelId: number;
+  priority: number;
+  weight: number;
+  enabled: boolean;
+  providerEnabled: boolean;
+  modelEnabled: boolean;
+  timeoutMs?: number | null;
+  config?: Record<string, unknown> | null;
+};
+
+export type DarwishAiRoutePlanTarget = DarwishAiRoutingTarget & {
+  effectiveTimeoutMs: number;
+  attemptNumber: number;
+};
+
+export type DarwishAiRoutePlan = {
+  routeKey: string;
+  policyId: number;
+  selectionStrategy: DarwishAiSelectionStrategy;
+  maxAttempts: number;
+  targets: DarwishAiRoutePlanTarget[];
+};
+
+export type DarwishAiRouteAttempt = {
+  targetId: number;
+  providerId: number;
+  modelId: number;
+  attemptNumber: number;
+  durationMs: number;
+  outcome: "success" | "error" | "timeout";
+};
+
+export class DarwishAiRouteExhaustedError extends Error {
+  readonly attempts: DarwishAiRouteAttempt[];
+
+  constructor(attempts: DarwishAiRouteAttempt[]) {
+    super("Darwish AI route exhausted without a successful target");
+    this.name = "DarwishAiRouteExhaustedError";
+    this.attempts = attempts;
+  }
+}
+
+function requireInteger(value: unknown, field: string, minimum: number, maximum: number): number {
+  if (!Number.isInteger(value) || Number(value) < minimum || Number(value) > maximum) {
+    throw new Error(`${field} must be an integer between ${minimum} and ${maximum}`);
+  }
+  return Number(value);
+}
+
+function normalizeRouteKey(value: unknown): string {
+  if (typeof value !== "string") throw new Error("routeKey must be a string");
+  const routeKey = value.trim().toLowerCase();
+  if (!/^[a-z0-9][a-z0-9._-]{0,127}$/.test(routeKey)) {
+    throw new Error("routeKey contains unsupported characters");
+  }
+  return routeKey;
+}
+
+function assertPolicy(policy: DarwishAiRoutingPolicy) {
+  normalizeRouteKey(policy.routeKey);
+  if (!policy.enabled) throw new Error(`Darwish AI route ${policy.routeKey} is disabled`);
+  if (!(["priority", "weighted_random"] as string[]).includes(policy.selectionStrategy)) {
+    throw new Error("Unsupported Darwish AI selection strategy");
+  }
+  requireInteger(policy.maxAttempts, "maxAttempts", 1, 100);
+  requireInteger(policy.timeoutMs, "timeoutMs", 100, 600000);
+}
+
+function weightedOrder(targets: DarwishAiRoutingTarget[], random: () => number) {
+  const remaining = [...targets];
+  const ordered: DarwishAiRoutingTarget[] = [];
+  while (remaining.length > 0) {
+    const totalWeight = remaining.reduce((sum, item) => sum + Math.max(1, item.weight), 0);
+    let cursor = Math.min(Math.max(random(), 0), 0.999999999999) * totalWeight;
+    let selectedIndex = remaining.length - 1;
+    for (let index = 0; index < remaining.length; index += 1) {
+      cursor -= Math.max(1, remaining[index].weight);
+      if (cursor < 0) {
+        selectedIndex = index;
+        break;
+      }
+    }
+    ordered.push(remaining.splice(selectedIndex, 1)[0]);
+  }
+  return ordered;
+}
+
+export function buildDarwishAiRoutePlan(
+  policy: DarwishAiRoutingPolicy,
+  targets: DarwishAiRoutingTarget[],
+  random: () => number = Math.random,
+): DarwishAiRoutePlan {
+  assertPolicy(policy);
+
+  const eligible = targets
+    .filter((target) => target.policyId === policy.id && target.enabled && target.providerEnabled && target.modelEnabled)
+    .map((target) => ({
+      ...target,
+      priority: requireInteger(target.priority, "priority", 0, 1000000),
+      weight: requireInteger(target.weight, "weight", 1, 1000000),
+      timeoutMs: target.timeoutMs == null
+        ? null
+        : requireInteger(target.timeoutMs, "target.timeoutMs", 100, 600000),
+    }));
+
+  const priorities = [...new Set(eligible.map((target) => target.priority))].sort((a, b) => a - b);
+  const ordered: DarwishAiRoutingTarget[] = [];
+  for (const priority of priorities) {
+    const tier = eligible.filter((target) => target.priority === priority);
+    ordered.push(...(policy.selectionStrategy === "weighted_random"
+      ? weightedOrder(tier, random)
+      : tier.sort((a, b) => a.id - b.id)));
+  }
+
+  const selected = ordered.slice(0, policy.maxAttempts);
+  if (selected.length === 0) throw new Error(`Darwish AI route ${policy.routeKey} has no eligible targets`);
+
+  return {
+    routeKey: normalizeRouteKey(policy.routeKey),
+    policyId: policy.id,
+    selectionStrategy: policy.selectionStrategy,
+    maxAttempts: policy.maxAttempts,
+    targets: selected.map((target, index) => ({
+      ...target,
+      effectiveTimeoutMs: target.timeoutMs ?? policy.timeoutMs,
+      attemptNumber: index + 1,
+    })),
+  };
+}
+
+function timeoutError() {
+  const error = new Error("Darwish AI provider attempt timed out");
+  error.name = "DarwishAiProviderTimeoutError";
+  return error;
+}
+
+async function executeWithTimeout<T>(
+  target: DarwishAiRoutePlanTarget,
+  execute: (target: DarwishAiRoutePlanTarget, signal: AbortSignal) => Promise<T>,
+) {
+  const controller = new AbortController();
+  let timer: NodeJS.Timeout | undefined;
+  try {
+    return await Promise.race([
+      execute(target, controller.signal),
+      new Promise<T>((_, reject) => {
+        timer = setTimeout(() => {
+          controller.abort();
+          reject(timeoutError());
+        }, target.effectiveTimeoutMs);
+      }),
+    ]);
+  } finally {
+    if (timer) clearTimeout(timer);
+  }
+}
+
+export async function executeDarwishAiRoute<T>(
+  plan: DarwishAiRoutePlan,
+  execute: (target: DarwishAiRoutePlanTarget, signal: AbortSignal) => Promise<T>,
+  isRetryable: (error: unknown, target: DarwishAiRoutePlanTarget) => boolean,
+): Promise<{ value: T; selectedTarget: DarwishAiRoutePlanTarget; attempts: DarwishAiRouteAttempt[] }> {
+  const attempts: DarwishAiRouteAttempt[] = [];
+
+  for (const target of plan.targets) {
+    const startedAt = Date.now();
+    try {
+      const value = await executeWithTimeout(target, execute);
+      attempts.push({
+        targetId: target.id,
+        providerId: target.providerId,
+        modelId: target.modelId,
+        attemptNumber: target.attemptNumber,
+        durationMs: Date.now() - startedAt,
+        outcome: "success",
+      });
+      return { value, selectedTarget: target, attempts };
+    } catch (error) {
+      const timedOut = error instanceof Error && error.name === "DarwishAiProviderTimeoutError";
+      attempts.push({
+        targetId: target.id,
+        providerId: target.providerId,
+        modelId: target.modelId,
+        attemptNumber: target.attemptNumber,
+        durationMs: Date.now() - startedAt,
+        outcome: timedOut ? "timeout" : "error",
+      });
+      if (!isRetryable(error, target)) throw error;
+    }
+  }
+
+  throw new DarwishAiRouteExhaustedError(attempts);
+}
+
+export function getDarwishAiProviderRoutingState() {
+  return {
+    status: DARWISH_AI_PROVIDER_ROUTING_STATUS,
+    routingEnabled: true,
+    fallbackEnabled: true,
+    policiesHardcoded: false,
+    targetsHardcoded: false,
+    selectionStrategies: ["priority", "weighted_random"],
+    perPolicyTimeoutSupported: true,
+    perTargetTimeoutSupported: true,
+    disabledProviderFilteringSupported: true,
+    disabledModelFilteringSupported: true,
+    darwishAiCallsRoutedThroughRegistry: false,
+    providerAdaptersInvokedByThisPhase: false,
+    usageTrackingEnabled: false,
+    costTrackingEnabled: false,
+    outboundActions: 0,
+  } as const;
+}
+
