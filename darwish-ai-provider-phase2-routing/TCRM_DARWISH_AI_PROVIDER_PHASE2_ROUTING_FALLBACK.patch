+CREATE TABLE IF NOT EXISTS darwish_ai_routing_policies (
+  id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
+  route_key VARCHAR(128) NOT NULL,
+  display_name VARCHAR(191) NOT NULL,
+  selection_strategy VARCHAR(64) NOT NULL DEFAULT 'priority',
+  enabled BOOLEAN NOT NULL DEFAULT TRUE,
+  max_attempts INT UNSIGNED NOT NULL DEFAULT 3,
+  timeout_ms INT UNSIGNED NOT NULL DEFAULT 60000,
+  config_json JSON NULL,
+  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
+  updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
+  PRIMARY KEY (id),
+  UNIQUE KEY uq_darwish_ai_routing_policy_route (route_key),
+  KEY idx_darwish_ai_routing_policy_enabled (enabled)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
+
+--> statement-breakpoint
+
+CREATE TABLE IF NOT EXISTS darwish_ai_routing_targets (
+  id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT,
+  policy_id BIGINT UNSIGNED NOT NULL,
+  provider_id BIGINT UNSIGNED NOT NULL,
+  model_id BIGINT UNSIGNED NOT NULL,
+  priority INT UNSIGNED NOT NULL DEFAULT 100,
+  weight INT UNSIGNED NOT NULL DEFAULT 1,
+  enabled BOOLEAN NOT NULL DEFAULT TRUE,
+  timeout_ms INT UNSIGNED NULL,
+  config_json JSON NULL,
+  created_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
+  updated_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
+  PRIMARY KEY (id),
+  UNIQUE KEY uq_darwish_ai_routing_target (policy_id, provider_id, model_id),
+  KEY idx_darwish_ai_routing_target_order (policy_id, enabled, priority),
+  KEY idx_darwish_ai_routing_target_provider (provider_id),
+  KEY idx_darwish_ai_routing_target_model (model_id)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
+
diff --git a/scripts/apply-darwish-ai-provider-phase2-migration.ts b/scripts/apply-darwish-ai-provider-phase2-migration.ts
new file mode 100644
--- /dev/null
+++ b/scripts/apply-darwish-ai-provider-phase2-migration.ts
@@ -0,0 +1,113 @@
+import fs from "node:fs";
+import path from "node:path";
+import mysql, { type RowDataPacket } from "mysql2/promise";
+
+const MIGRATION_FILE = "drizzle/migrations/20260829_darwish_ai_provider_phase2_routing_fallback.sql";
+const PHASE1_TABLES = [
+  "darwish_ai_providers",
+  "darwish_ai_provider_secrets",
+  "darwish_ai_provider_models",
+] as const;
+const REQUIRED_TABLES = [
+  "darwish_ai_routing_policies",
+  "darwish_ai_routing_targets",
+] as const;
+const REQUIRED_CONFIRMATION = "APPLY_DARWISH_AI_PROVIDER_PHASE2";
+const apply = process.argv.includes("--apply");
+
+function stripComments(sql: string) {
+  return sql.split("\n").filter((line) => !line.trim().startsWith("--")).join("\n").trim();
+}
+
+function splitStatements(sql: string) {
+  return sql
+    .split(/-->\s*statement-breakpoint/g)
+    .map(stripComments)
+    .filter(Boolean)
+    .map((statement) => statement.replace(/;\s*$/, "").trim());
+}
+
+function validateStatements(statements: string[]) {
+  if (statements.length !== REQUIRED_TABLES.length) {
+    throw new Error(`Expected exactly ${REQUIRED_TABLES.length} CREATE TABLE statements`);
+  }
+  const forbidden = /(?:^|;)\s*(DROP|ALTER|INSERT|UPDATE|DELETE|TRUNCATE|REPLACE|GRANT|REVOKE)\b/im;
+  for (const [index, statement] of statements.entries()) {
+    if (forbidden.test(statement)) throw new Error(`Forbidden SQL keyword in statement ${index + 1}`);
+    const expected = new RegExp(`^CREATE\\s+TABLE\\s+IF\\s+NOT\\s+EXISTS\\s+${REQUIRED_TABLES[index]}\\b`, "i");
+    if (!expected.test(statement)) throw new Error(`Unexpected statement ${index + 1}`);
+  }
+}
+
+async function tableExists(conn: mysql.Connection, table: string) {
+  const [rows] = await conn.execute<RowDataPacket[]>(
+    "SELECT 1 FROM information_schema.TABLES WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME=? LIMIT 1",
+    [table],
+  );
+  return rows.length > 0;
+}
+
+async function rowCount(conn: mysql.Connection, table: string) {
+  const [rows] = await conn.query<RowDataPacket[]>(`SELECT COUNT(*) AS cnt FROM \`${table}\``);
+  return Number(rows[0]?.cnt ?? 0);
+}
+
+async function main() {
+  if (!process.env.DATABASE_URL) throw new Error("DATABASE_URL is required");
+  if (apply && process.env.DARWISH_AI_PROVIDER_PHASE2_CONFIRM !== REQUIRED_CONFIRMATION) {
+    throw new Error(`Set DARWISH_AI_PROVIDER_PHASE2_CONFIRM=${REQUIRED_CONFIRMATION}`);
+  }
+
+  const fullPath = path.join(process.cwd(), MIGRATION_FILE);
+  const statements = splitStatements(fs.readFileSync(fullPath, "utf8"));
+  validateStatements(statements);
+
+  const conn = await mysql.createConnection(process.env.DATABASE_URL);
+  try {
+    const phase1 = Object.fromEntries(
+      await Promise.all(PHASE1_TABLES.map(async (table) => [table, await tableExists(conn, table)])),
+    );
+    if (Object.values(phase1).some((exists) => !exists)) {
+      throw new Error("Darwish AI provider Phase 1 foundation is incomplete; refusing Phase 2");
+    }
+
+    const before = Object.fromEntries(
+      await Promise.all(REQUIRED_TABLES.map(async (table) => [table, await tableExists(conn, table)])),
+    );
+    const existingCount = Object.values(before).filter(Boolean).length;
+    if (existingCount > 0 && existingCount < REQUIRED_TABLES.length) {
+      throw new Error("Partial Darwish AI provider Phase 2 schema detected; refusing automatic repair");
+    }
+
+    console.log(JSON.stringify({
+      mode: apply ? "apply" : "dry-run",
+      migrationFile: MIGRATION_FILE,
+      phase1,
+      before,
+      validatedStatements: statements.length,
+      plannedAction: existingCount === REQUIRED_TABLES.length
+        ? "verify_existing_phase2_only"
+        : "create_exact_phase2_routing_tables_only",
+      dbPushUsed: false,
+      drizzleGenerateUsed: false,
+      drizzleMigrateUsed: false,
+      seededPolicies: 0,
+      seededTargets: 0,
+    }, null, 2));
+
+    if (!apply || existingCount === REQUIRED_TABLES.length) return;
+
+    for (const statement of statements) await conn.query(statement);
+
+    const after = Object.fromEntries(
+      await Promise.all(REQUIRED_TABLES.map(async (table) => [table, await tableExists(conn, table)])),
+    );
+    if (Object.values(after).some((exists) => !exists)) throw new Error("Phase 2 table verification failed");
+
+    const counts = Object.fromEntries(
+      await Promise.all(REQUIRED_TABLES.map(async (table) => [table, await rowCount(conn, table)])),
+    );
+    if (Object.values(counts).some((count) => count !== 0)) {
+      throw new Error("Phase 2 migration must not seed routing policies or targets");
+    }
+
+    console.log(JSON.stringify({ migrationApplied: true, schemaWrites: REQUIRED_TABLES.length, after, counts, dataWrites: 0 }, null, 2));
+  } finally {
+    await conn.end();
+  }
+}
+
+main().catch((error) => {
+  console.error("[darwish-ai-provider-phase2] failed", error instanceof Error ? error.message : error);
+  process.exit(1);
+});
+
