@@ -0,0 +1,88 @@
+import { describe, expect, it } from "vitest";
+import {
+  buildDarwishAiRoutePlan,
+  DarwishAiRouteExhaustedError,
+  executeDarwishAiRoute,
+  type DarwishAiRoutingPolicy,
+  type DarwishAiRoutingTarget,
+} from "./darwishAiProviderRoutingService";
+
+const policy: DarwishAiRoutingPolicy = {
+  id: 10,
+  routeKey: "darwish.default",
+  displayName: "Default",
+  selectionStrategy: "priority",
+  enabled: true,
+  maxAttempts: 3,
+  timeoutMs: 1000,
+};
+
+const targets: DarwishAiRoutingTarget[] = [
+  { id: 3, policyId: 10, providerId: 3, modelId: 30, priority: 20, weight: 1, enabled: true, providerEnabled: true, modelEnabled: true },
+  { id: 2, policyId: 10, providerId: 2, modelId: 20, priority: 10, weight: 1, enabled: true, providerEnabled: true, modelEnabled: true },
+  { id: 1, policyId: 10, providerId: 1, modelId: 10, priority: 10, weight: 1, enabled: true, providerEnabled: true, modelEnabled: true },
+];
+
+describe("Darwish AI provider routing", () => {
+  it("builds deterministic priority fallback order", () => {
+    const plan = buildDarwishAiRoutePlan(policy, targets);
+    expect(plan.targets.map((item) => item.id)).toEqual([1, 2, 3]);
+  });
+
+  it("filters disabled providers and models", () => {
+    const plan = buildDarwishAiRoutePlan(policy, [
+      { ...targets[0], providerEnabled: false },
+      { ...targets[1], modelEnabled: false },
+      targets[2],
+    ]);
+    expect(plan.targets.map((item) => item.id)).toEqual([1]);
+  });
+
+  it("uses weighted ordering only inside the same priority tier", () => {
+    const plan = buildDarwishAiRoutePlan({ ...policy, selectionStrategy: "weighted_random" }, [
+      { ...targets[0], priority: 1, weight: 1 },
+      { ...targets[1], priority: 1, weight: 9 },
+      { ...targets[2], priority: 2, weight: 100 },
+    ], () => 0.5);
+    expect(plan.targets[0].priority).toBe(1);
+    expect(plan.targets[1].priority).toBe(1);
+    expect(plan.targets[2].priority).toBe(2);
+  });
+
+  it("falls back after retryable failures", async () => {
+    const plan = buildDarwishAiRoutePlan(policy, targets);
+    const result = await executeDarwishAiRoute(
+      plan,
+      async (target) => {
+        if (target.id !== 3) throw new Error("retryable");
+        return "ok";
+      },
+      () => true,
+    );
+    expect(result.value).toBe("ok");
+    expect(result.selectedTarget.id).toBe(3);
+    expect(result.attempts.map((item) => item.outcome)).toEqual(["error", "error", "success"]);
+  });
+
+  it("stops immediately on non-retryable errors", async () => {
+    const plan = buildDarwishAiRoutePlan(policy, targets);
+    await expect(executeDarwishAiRoute(plan, async () => {
+      throw new Error("auth");
+    }, () => false)).rejects.toThrow("auth");
+  });
+
+  it("throws an exhausted error after all fallback targets fail", async () => {
+    const plan = buildDarwishAiRoutePlan(policy, targets);
+    await expect(executeDarwishAiRoute(plan, async () => {
+      throw new Error("retryable");
+    }, () => true)).rejects.toBeInstanceOf(DarwishAiRouteExhaustedError);
+  });
+});
