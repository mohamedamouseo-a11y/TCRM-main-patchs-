diff --git a/scripts/apply-cold-sales-permissions-migration.ts b/scripts/apply-cold-sales-permissions-migration.ts
new file mode 100644
--- /dev/null
+++ b/scripts/apply-cold-sales-permissions-migration.ts
@@ -0,0 +1,91 @@
+import { config as dotenvConfig } from "dotenv";
+import mysql from "mysql2/promise";
+
+dotenvConfig({ path: process.cwd() + "/.env", override: true });
+
+const DATABASE_URL = process.env.DATABASE_URL;
+
+const REQUIRED = [
+  { key: "leads.create", scope: "own" },
+  { key: "campaigns.view", scope: "all" },
+  { key: "campaigns.create", scope: "own" },
+] as const;
+
+async function main() {
+  if (!DATABASE_URL) throw new Error("DATABASE_URL is required");
+
+  const conn = await mysql.createConnection(DATABASE_URL);
+  try {
+    await conn.beginTransaction();
+
+    const [roleRows] = await conn.query(
+      `SELECT id
+       FROM roles
+       WHERE legacy_role_key = 'ColdSalesAgent'
+          OR role_key IN ('ColdSalesAgent', 'cold_sales_agent', 'coldsalesagent')
+       ORDER BY CASE WHEN legacy_role_key = 'ColdSalesAgent' THEN 0 ELSE 1 END, id
+       LIMIT 1`,
+    );
+    const roleId = Number((roleRows as any[])[0]?.id ?? 0);
+    if (!roleId) throw new Error("ColdSalesAgent permission role was not found");
+
+    const [actorRows] = await conn.query(
+      `SELECT id
+       FROM users
+       WHERE deletedAt IS NULL
+       ORDER BY CASE WHEN role = 'Admin' THEN 0 ELSE 1 END, id
+       LIMIT 1`,
+    );
+    const actorId = Number((actorRows as any[])[0]?.id ?? 0);
+    if (!actorId) throw new Error("No active actor user exists for permission migration");
+
+    for (const item of REQUIRED) {
+      const [permissionRows] = await conn.query(
+        `SELECT id FROM permissions WHERE permission_key = ? AND is_active = 1 LIMIT 1`,
+        [item.key],
+      );
+      const permissionId = Number((permissionRows as any[])[0]?.id ?? 0);
+      if (!permissionId) throw new Error(`Missing active permission: ${item.key}`);
+
+      const [updateResult] = await conn.query(
+        `UPDATE role_permissions
+         SET effect = 'allow', data_scope = ?, scope_config = NULL
+         WHERE role_id = ? AND permission_id = ?`,
+        [item.scope, roleId, permissionId],
+      );
+
+      if (Number((updateResult as any).affectedRows ?? 0) === 0) {
+        await conn.query(
+          `INSERT INTO role_permissions
+             (role_id, permission_id, effect, data_scope, scope_config, created_by)
+           SELECT ?, ?, 'allow', ?, NULL, ?
+           WHERE NOT EXISTS (
+             SELECT 1
+             FROM role_permissions
+             WHERE role_id = ? AND permission_id = ?
+           )`,
+          [roleId, permissionId, item.scope, actorId, roleId, permissionId],
+        );
+      }
+    }
+
+    await conn.commit();
+    console.log("ColdSalesAgent permissions ensured:", REQUIRED.map((item) => item.key).join(", "));
+  } catch (error) {
+    await conn.rollback();
+    throw error;
+  } finally {
+    await conn.end();
+  }
+}
+
+main().catch((error) => {
+  console.error("Cold Sales permissions migration failed", error);
+  process.exit(1);
+});
diff --git a/server/security/coldSalesFix.test.ts b/server/security/coldSalesFix.test.ts
new file mode 100644
--- /dev/null
+++ b/server/security/coldSalesFix.test.ts
@@ -0,0 +1,43 @@
+import { describe, expect, it } from "vitest";
+import { readFileSync } from "node:fs";
+import { resolveCorePermissionKey } from "./corePermissionPolicy";
+import { SYSTEM_ROLE_STANDARD_BASELINES } from "./systemRolePermissionBaselines";
+
+describe("Cold Sales lead/campaign regression", () => {
+  it("grants the requested ColdSalesAgent baseline without edit/delete campaign access", () => {
+    const grants = SYSTEM_ROLE_STANDARD_BASELINES.ColdSalesAgent || [];
+    const byKey = new Map(grants.map((item) => [String(item.permissionKey), String(item.dataScope)]));
+    expect(byKey.get("leads.create")).toBe("own");
+    expect(byKey.get("campaigns.view")).toBe("all");
+    expect(byKey.get("campaigns.create")).toBe("own");
+    expect(byKey.has("campaigns.edit")).toBe(false);
+    expect(byKey.has("campaigns.delete")).toBe(false);
+  });
+
+  it("central policy maps campaign creation to campaigns.create", () => {
+    expect(resolveCorePermissionKey("campaigns.create", "mutation")).toBe("campaigns.create");
+  });
+
+  it("keeps create permission-driven while update/delete retain the stricter legacy guard", () => {
+    const source = readFileSync(new URL("../routers.ts", import.meta.url), "utf8");
+    const campaignBlock = source.slice(source.indexOf("campaigns: router({"), source.indexOf("// ─── Pipeline Stages"));
+    expect(campaignBlock).toContain("create: protectedProcedure");
+    expect(campaignBlock).toContain("update: mediaBuyerOrAdminProcedure");
+    expect(campaignBlock).toContain("delete: mediaBuyerOrAdminProcedure");
+  });
+
+  it("uses canonical assigned lead scope for ColdSalesAgent dashboard statistics", () => {
+    const source = readFileSync(new URL("../db.ts", import.meta.url), "utf8");
+    const statsBlock = source.slice(
+      source.indexOf("export async function getAgentStats"),
+      source.indexOf("export async function getTeamStats"),
+    );
+    expect(statsBlock).toContain('normalizedRole === "ColdSalesAgent"');
+    expect(statsBlock).toContain('buildLeadScopeCondition("assigned"');
+    expect(statsBlock).toContain('"leads.ownerId"');
+  });
+});
