+import { Activity, AlertTriangle, CheckCircle2, ShieldCheck } from "lucide-react";
+import { Badge } from "@/components/ui/badge";
+import { Button } from "@/components/ui/button";
+import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
+import { useLanguage } from "@/contexts/LanguageContext";
+import { trpc } from "@/lib/trpc";
+
+export default function WadieGovernanceAudit() {
+  const { isRTL } = useLanguage();
+  const text = (en: string, ar: string) => (isRTL ? ar : en);
+  const query = trpc.wadie.governanceAudit.useQuery(undefined, {
+    refetchOnWindowFocus: false,
+    refetchInterval: 60_000,
+  });
+  const data = query.data;
+  const passed = data?.status === "pass";
+
+  return (
+    <Card data-wadie-governance-audit="phase22-v1" className="rounded-2xl border-border/70 bg-card shadow-[0_14px_34px_-28px_rgba(15,23,42,0.72)]">
+      <CardHeader className="pb-3">
+        <div className="flex flex-wrap items-center justify-between gap-3">
+          <div>
+            <CardTitle className="flex items-center gap-2 text-xl">
+              <ShieldCheck className="h-5 w-5 text-emerald-600" />
+              {text("Governance Audit & Final Hardening", "تدقيق الحوكمة والتأمين النهائي")}
+            </CardTitle>
+            <p className="mt-1 text-xs font-semibold text-muted-foreground">
+              {text(
+                "Final Wadie v1 safety audit across human approval, advisory reuse, kill-switch protection and automatic-action invariants.",
+                "التدقيق النهائي لسلامة Wadie v1 عبر الاعتماد البشري وإعادة الاستخدام الاستشارية وحماية مفتاح الإيقاف وضوابط منع الإجراءات التلقائية.",
+              )}
+            </p>
+          </div>
+          <div className="flex flex-wrap gap-2">
+            <Badge variant="outline" className="rounded-full px-3 py-1 font-bold">
+              {passed ? <CheckCircle2 className="me-1 h-3.5 w-3.5 text-emerald-500" /> : <AlertTriangle className="me-1 h-3.5 w-3.5 text-amber-500" />}
+              {passed ? text("Governance PASS", "الحوكمة سليمة") : text("Needs attention", "يحتاج مراجعة")}
+            </Badge>
+            <Badge variant="outline" className="rounded-full px-3 py-1 font-bold">
+              {text("Read-only audit", "تدقيق للقراءة فقط")}
+            </Badge>
+            <Button variant="outline" size="sm" className="h-9 rounded-xl font-bold" disabled={query.isFetching} onClick={() => void query.refetch()}>
+              <Activity className={`me-2 h-4 w-4 ${query.isFetching ? "animate-spin" : ""}`} />
+              {text("Run audit", "تشغيل التدقيق")}
+            </Button>
+          </div>
+        </div>
+      </CardHeader>
+
+      <CardContent className="space-y-4">
+        {data && (
+          <>
+            <div className="grid grid-cols-2 gap-2 md:grid-cols-4">
+              {[
+                [text("Checks", "الفحوصات"), data.totals.checks],
+                [text("Passed", "ناجح"), data.totals.passed],
+                [text("Critical failures", "إخفاقات حرجة"), data.totals.criticalFailures],
+                [text("Approved references", "مراجع معتمدة"), data.approvedReferences],
+              ].map(([label, value]) => (
+                <div key={String(label)} className="rounded-xl border border-border/60 bg-background/55 p-3">
+                  <p className="text-[10px] font-black uppercase tracking-[0.08em] text-muted-foreground">{label}</p>
+                  <p className="mt-1 text-lg font-black">{value}</p>
+                </div>
+              ))}
+            </div>
+
+            <div className="grid gap-2 md:grid-cols-2">
+              {data.checks.map((check) => (
+                <div key={check.id} className="rounded-xl border border-border/60 bg-background/45 p-3">
+                  <div className="flex items-center justify-between gap-2">
+                    <p className="text-xs font-black">{check.label}</p>
+                    <Badge variant={check.passed ? "secondary" : check.critical ? "destructive" : "outline"} className="rounded-full text-[10px]">
+                      {check.passed ? text("PASS", "ناجح") : text("FAIL", "فشل")}
+                    </Badge>
+                  </div>
+                  <p className="mt-1 text-[10px] font-semibold text-muted-foreground">{check.detail}</p>
+                </div>
+              ))}
+            </div>
+
+            <div className="rounded-xl border border-border/60 bg-background/45 p-3 text-[10px] font-semibold text-muted-foreground">
+              <div>{text("Execution kill switch", "مفتاح إيقاف التنفيذ")}: {data.executionSafety.killSwitch}</div>
+              <div>{text("Human approval required", "الاعتماد البشري مطلوب")}: {data.executionSafety.humanApprovalRequired ? text("Yes", "نعم") : text("No", "لا")}</div>
+              <div>{text("Destructive delete tools", "أدوات الحذف التدميرية")}: {data.executionSafety.destructiveDeleteToolsAllowed ? text("Allowed", "مسموحة") : text("Blocked", "محظورة")}</div>
+            </div>
+          </>
+        )}
+
+        {query.error && <p className="text-xs font-semibold text-destructive">{query.error.message}</p>}
+        <p className="text-[10px] font-semibold text-muted-foreground">
+          {text(
+            "Phase 22 is read-only governance verification. It adds no learning activation, automatic recommendation injection, execution path, MCP call, ad-platform mutation or execution-policy change.",
+            "Phase 22 تحقق حوكمة للقراءة فقط. لا يضيف تفعيل تعلم أو حقن توصيات تلقائياً أو مسار تنفيذ أو استدعاء MCP أو تعديل منصات الإعلانات أو تغيير سياسة التنفيذ.",
+          )}
+        </p>
+      </CardContent>
+    </Card>
+  );
+}
