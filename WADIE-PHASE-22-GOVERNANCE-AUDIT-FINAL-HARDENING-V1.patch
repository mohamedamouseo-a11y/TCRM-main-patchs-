new file mode 100644
--- /dev/null
+++ b/server/services/wadie/wadieGovernanceAuditService.ts
@@ -0,0 +1,117 @@
+import { getWadieExecutionSafety } from "./wadieExecutionQueueService";
+import { getWadiePhase21Capabilities } from "./wadieIntegrationService";
+import { getWadieRecommendationReuseSnapshot } from "./wadieRecommendationReuseService";
+
+type GovernanceCheck = {
+  id: string;
+  label: string;
+  passed: boolean;
+  critical: boolean;
+  detail: string;
+};
+
+export async function getWadieGovernanceAuditSnapshot() {
+  const capabilities = getWadiePhase21Capabilities();
+  const executionSafety = getWadieExecutionSafety();
+  const reuse = await getWadieRecommendationReuseSnapshot();
+
+  const approvedReferencesSafe = reuse.approvedReferences.every((item) =>
+    item.humanRecommendationReferenceEnabled === true
+    && item.referenceStatus === "available-for-human-reference"
+    && item.activationStatus === "inactive"
+    && item.executionStatus === "not-executable"
+  );
+
+  const automaticPathsBlocked =
+    capabilities.automaticRecommendationInjectionEnabled === false
+    && capabilities.recommendationExecutionEnabled === false
+    && capabilities.learningMemoryWritesApplied === false
+    && capabilities.reuseLiveMcpCallsApplied === false
+    && capabilities.reuseAdPlatformMutationsApplied === false
+    && capabilities.automaticOptimizationLearningApplied === false
+    && capabilities.automaticRecommendationReuseApplied === false
+    && capabilities.automaticExecutionPolicyChangesApplied === false;
+
+  const checks: GovernanceCheck[] = [
+    {
+      id: "human-approval-invariant",
+      label: "Human approval remains mandatory",
+      passed: capabilities.executionStillRequiresHumanApproval === true
+        && capabilities.humanReuseApprovalRequired === true
+        && executionSafety.humanApprovalRequired === true,
+      critical: true,
+      detail: "Phase 21 reference review and Phase 5 execution both remain human-gated.",
+    },
+    {
+      id: "execution-kill-switch",
+      label: "Execution kill switch remains enforced",
+      passed: executionSafety.killSwitch === "WADIE_EXECUTION_ENABLED",
+      critical: true,
+      detail: "Execution remains controlled by WADIE_EXECUTION_ENABLED.",
+    },
+    {
+      id: "destructive-tools-blocked",
+      label: "Destructive delete tools remain blocked",
+      passed: executionSafety.destructiveDeleteToolsAllowed === false,
+      critical: true,
+      detail: "No destructive delete tool is exposed through the execution queue.",
+    },
+    {
+      id: "advisory-reference-only",
+      label: "Approved reuse remains advisory only",
+      passed: approvedReferencesSafe,
+      critical: true,
+      detail: "Approved references stay inactive and not executable.",
+    },
+    {
+      id: "automatic-paths-blocked",
+      label: "Automatic learning/reuse/execution paths remain blocked",
+      passed: automaticPathsBlocked,
+      critical: true,
+      detail: "No automatic injection, execution, learning, MCP mutation path or policy change is enabled.",
+    },
+    {
+      id: "local-review-metadata",
+      label: "Reuse review metadata remains local-only",
+      passed: reuse.reuseReviewPersistenceLocalOnly === true,
+      critical: false,
+      detail: "Phase 21 reuse review state remains local metadata.",
+    },
+  ];
+
+  const criticalFailures = checks.filter((check) => check.critical && !check.passed).length;
+
+  return {
+    phase: "governance-audit-final-hardening-v1" as const,
+    mode: "read-only-runtime-governance-verification" as const,
+    status: criticalFailures === 0 ? "pass" as const : "attention" as const,
+    totals: {
+      checks: checks.length,
+      passed: checks.filter((check) => check.passed).length,
+      failed: checks.filter((check) => !check.passed).length,
+      criticalFailures,
+    },
+    checks,
+    approvedReferences: reuse.approvedReferences.length,
+    executionSafety: {
+      executionEnabled: executionSafety.executionEnabled,
+      killSwitch: executionSafety.killSwitch,
+      humanApprovalRequired: executionSafety.humanApprovalRequired,
+      destructiveDeleteToolsAllowed: executionSafety.destructiveDeleteToolsAllowed,
+    },
+    generatedAt: new Date().toISOString(),
+    source: "phase21-guardrailed-recommendation-reuse" as const,
+    readOnlyAudit: true as const,
+    governancePersistenceEnabled: false as const,
+    learningActivationEnabled: false as const,
+    automaticRecommendationInjectionEnabled: false as const,
+    recommendationExecutionEnabled: false as const,
+    learningMemoryWritesApplied: false as const,
+    liveMcpCallsApplied: false as const,
+    adPlatformMutationsApplied: false as const,
+    automaticOptimizationLearningApplied: false as const,
+    automaticRecommendationReuseApplied: false as const,
+    automaticExecutionPolicyChangesApplied: false as const,
+    executionStillRequiresHumanApproval: true as const,
+  };
+}
