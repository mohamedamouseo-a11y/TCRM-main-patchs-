index a9fa56e..d49599e 100644
--- a/server/services/darwish/chatwoot/darwishChatwootService.ts
+++ b/server/services/darwish/chatwoot/darwishChatwootService.ts
@@ -67,3 +67,23 @@ export async function getDarwishIntegrationHealth() {
   const [chatwoot, evolution] = await Promise.all([getDarwishChatwootHealth(), getDarwishEvolutionHealth()]);
   return { chatwoot, evolution, whatsapp: evolution };
 }
+
+export async function sendDarwishApprovedChatwootReply(conversationId: string, content: string) {
+  const config = getDarwishConfig();
+  if (!config.approvedOutboundEnabled) {
+    throw new Error("DARWISH_APPROVED_OUTBOUND_ENABLED is false; approved customer replies are blocked");
+  }
+  if (!config.enabled) throw new Error("Darwish Chatwoot integration is disabled");
+  if (!config.chatwootApiToken || !config.chatwootAccountId) {
+    throw new Error("Darwish Chatwoot account/token is not configured");
+  }
+  const safeConversationId = String(conversationId || "").trim();
+  const safeContent = String(content || "").replace(/\u0000/g, "").trim().slice(0, 4000);
+  if (!/^\d+$/.test(safeConversationId)) throw new Error("Invalid Chatwoot conversation id");
+  if (!safeContent) throw new Error("Approved Chatwoot reply is empty");
+  return request(`/api/v1/accounts/${encodeURIComponent(config.chatwootAccountId)}/conversations/${encodeURIComponent(safeConversationId)}/messages`, {
+    method: "POST",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify({ content: safeContent, message_type: "outgoing", private: false }),
+  });
+}
