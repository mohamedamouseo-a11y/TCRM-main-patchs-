xecuteInternalNote(db, claimed, actorUserId);
+    else if (claimed.actionType === "follow_up_reminder") result = await executeFollowUpReminder(db, claimed);
+    else if (claimed.actionType === "customer_reply") result = await executeCustomerReply(claimed);
+    else throw new Error(`Unsupported Darwish action type: ${claimed.actionType}`);
+    await db.execute(sql`
+      UPDATE darwish_action_proposals
+      SET status = 'executed', executed_at = CURRENT_TIMESTAMP, execution_result = ${JSON.stringify(result)},
+          last_error = NULL, updated_at = CURRENT_TIMESTAMP
+      WHERE id = ${id} AND status = 'executing'
+    `);
+    await recordActionEvent(db, id, "executed", actorUserId, result);
+    return loadProposal(id);
+  } catch (error) {
+    const message = safeText(error instanceof Error ? error.message : String(error), 2000);
+    const uncertain = claimed.actionType === "customer_reply";
+    await db.execute(sql`
+      UPDATE darwish_action_proposals
+      SET status = ${uncertain ? "execution_uncertain" : "approved"}, last_error = ${message}, updated_at = CURRENT_TIMESTAMP
+      WHERE id = ${id} AND status = 'executing'
+    `);
+    await recordActionEvent(db, id, uncertain ? "execution_uncertain" : "execution_failed", actorUserId, { error: message });
+    throw error;
+  }
+}
+
+export function __deriveDarwishActionSuggestionsForTests(alert: SupervisorAlertInput) {
+  return deriveDarwishActionSuggestions(alert);
+}
+export function __normalizeDarwishReplyDraftForTests(raw: string) { return normalizeDarwishReplyDraft(raw); }
+export function __isDarwishActionExecutableStatusForTests(status: string) { return status === "approved"; }
