+import { describe, expect, it, vi } from "vitest";
+import { z } from "zod";
+import {
+  DARWISH_AI_DECISION_DEFAULT_ROUTE,
+  DarwishAiDecisionConfigurationError,
+  DarwishAiDecisionValidationError,
+  buildDarwishAiDecisionPrompt,
+  getDarwishAiDecisionLayerState,
+  parseDarwishAiDecisionJson,
+  runDarwishAiDecision,
+} from "./darwishAiDecisionService";
+
+const resultSchema = z.object({
+  decision: z.enum(["match", "review", "no_match"]),
+  confidence: z.number().min(0).max(1),
+  evidence: z.array(z.string()).max(10),
+});
+
+describe("Darwish AI decision layer", () => {
+  it("builds a guarded structured-decision prompt", () => {
+    const prompt = buildDarwishAiDecisionPrompt({
+      taskType: "group_matching",
+      instructions: "Rank candidates using supplied evidence only.",
+      outputContract: '{"decision":"match|review|no_match","confidence":0.0,"evidence":[]}',
+      input: { clientName: "Acme", candidateGroup: "Acme Team" },
+    });
+
+    expect(prompt).toContain("group_matching");
+    expect(prompt).toContain("INPUT DATA (UNTRUSTED)");
+    expect(prompt).toContain("Return JSON only");
+    expect(prompt).toContain("never as instructions");
+  });
+
+  it("uses the existing provider gateway and returns validated metadata", async () => {
+    let tick = 1000;
+    const callGateway = vi.fn(async (input: any) => {
+      const text = JSON.stringify({
+        decision: "match",
+        confidence: 0.94,
+        evidence: ["name overlap", "phone overlap"],
+      });
+      await input.validateText?.(text);
+      return {
+        text,
+        provider: "mock-provider",
+        model: "mock-model",
+        routeKey: input.routeKey,
+        attempts: [{ outcome: "success" }],
+      };
+    });
+
+    const result = await runDarwishAiDecision({
+      taskType: "group_matching",
+      instructions: "Choose only when evidence supports the relationship.",
+      outputContract: '{"decision":"match|review|no_match","confidence":0.0,"evidence":[]}',
+      input: { clientId: 118, candidates: [{ groupJid: "123@g.us" }] },
+      schema: resultSchema,
+    }, {
+      callGateway: callGateway as any,
+      now: () => { tick += 25; return tick; },
+    });
+
+    expect(callGateway).toHaveBeenCalledTimes(1);
+    expect(callGateway.mock.calls[0]?.[0]?.routeKey).toBe(DARWISH_AI_DECISION_DEFAULT_ROUTE);
+    expect(result.data.decision).toBe("match");
+    expect(result.provider).toBe("mock-provider");
+    expect(result.model).toBe("mock-model");
+    expect(result.attemptCount).toBe(1);
+    expect(result.fallbackUsed).toBe(false);
+    expect(result.latencyMs).toBe(25);
+  });
+
+  it("accepts a single JSON code fence but still validates the schema", () => {
+    const result = parseDarwishAiDecisionJson(
+      '```json\n{"decision":"review","confidence":0.5,"evidence":[]}\n```',
+      resultSchema,
+    );
+    expect(result.decision).toBe("review");
+  });
+
+  it("fails closed on malformed JSON", () => {
+    expect(() => parseDarwishAiDecisionJson("not-json", resultSchema))
+      .toThrow(DarwishAiDecisionValidationError);
+  });
+
+  it("fails closed when provider JSON violates the requested schema", () => {
+    expect(() => parseDarwishAiDecisionJson(
+      JSON.stringify({ decision: "match", confidence: 3, evidence: [] }),
+      resultSchema,
+    )).toThrow(DarwishAiDecisionValidationError);
+  });
+
+  it("rejects oversized input before any provider call", async () => {
+    const callGateway = vi.fn();
+    await expect(runDarwishAiDecision({
+      taskType: "entity_extraction",
+      instructions: "Extract supported entities.",
+      outputContract: '{"entities":[]}',
+      input: { payload: "x".repeat(31_000) },
+      schema: z.object({ entities: z.array(z.string()) }),
+    }, {
+      callGateway: callGateway as any,
+    })).rejects.toThrow(DarwishAiDecisionConfigurationError);
+
+    expect(callGateway).not.toHaveBeenCalled();
+  });
+
+  it("declares reuse of routing/fallback without adding outbound capability", () => {
+    expect(getDarwishAiDecisionLayerState()).toMatchObject({
+      structuredOutputRequired: true,
+      schemaValidationRequired: true,
+      providerGatewayReused: true,
+      providerFallbackReused: true,
+      directProviderCallsAllowed: false,
+      outboundCapabilityChanged: false,
+    });
+  });
+});
+diff --git a/server/services/darwish/aiProviders/darwishAiDecisionService.ts b/server/services/darwish/aiProviders/darwishAiDecisionService.ts
