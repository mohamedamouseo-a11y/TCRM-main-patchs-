+function QuotationServicePreviewPage({
+  item, logoUrl, onClick,
+}: {
+  item: QuotationServiceLibraryItem;
+  logoUrl: string;
+  onClick?: () => void;
+}) {
+  const deliverables = String(item.deliverables || "")
+    .split("\\n")
+    .map((line) => line.trim())
+    .filter(Boolean);
+
+  return (
+    <section
+      className={`oq-page ${onClick ? "oq-service-clickable" : ""}`}
+      onClick={onClick}
+      onKeyDown={(e) => {
+        if (!onClick || (e.key !== "Enter" && e.key !== " ")) return;
+        e.preventDefault();
+        onClick();
+      }}
+      role={onClick ? "button" : undefined}
+      tabIndex={onClick ? 0 : undefined}
+      title={onClick ? "فتح الخدمة المقابلة في مكتبة البنود" : undefined}
+    >
+      <OfficialDecor />
+      <img className="oq-logo" src={logoUrl} alt="تميّز" onError={(e) => { (e.target as HTMLImageElement).style.display = "none"; }} />
+      <div className="oq-page-title">{item.name}</div>
+      <div className="oq-service-content oq-full-service-content">
+        <div className="oq-rich">
+          {item.description && <p>{item.description}</p>}
+          {deliverables.length > 0 && (
+            <ul className="oq-service-list">
+              {deliverables.map((line, index) => <li key={`${item.code}-preview-${index}`}>{line}</li>)}
+            </ul>
+          )}
+          <div className="oq-service-meta">
+            {item.duration && <div><strong>مدة التنفيذ:</strong> {item.duration}</div>}
+            {item.pricingModel && <div><strong>نموذج التسعير:</strong> {item.pricingModel}</div>}
+            {item.tier && <div><strong>الباقة:</strong> {item.tier}</div>}
+            {item.code && <div><strong>الكود:</strong> <span dir="ltr">{item.code}</span></div>}
+          </div>
+        </div>
+      </div>
+      <OfficialFooter />
+    </section>
+  );
+}
 
