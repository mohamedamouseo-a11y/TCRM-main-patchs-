+import { mkdir, readFile, rename, writeFile } from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { getWadieApprovedLearningRegistry } from "./wadieApprovedLearningRegistryService";
+
+export type WadiePlaybookCurationStatus = "draft" | "ready-for-reuse-review";
+
+type WadiePlaybookDraft = {
+  registryId: string;
+  title: string;
+  objective: string;
+  instructions: string;
+  guardrailNotes: string;
+  curationStatus: WadiePlaybookCurationStatus;
+  curatedAt: string;
+  curatedBy: string;
+};
+
+type PlaybookFile = {
+  version: 1;
+  items: WadiePlaybookDraft[];
+};
+
+function storagePath() {
+  const configured = String(process.env.WADIE_PLAYBOOK_CURATION_FILE || "").trim();
+  if (configured) return path.resolve(configured);
+  return path.join(os.homedir(), ".tcrm", "wadie-playbook-curation.json");
+}
+
+function cleanText(value: unknown, max: number) {
+  return String(value ?? "").trim().replace(/\s+/g, " ").slice(0, max);
+}
+
+async function readStore(): Promise<PlaybookFile> {
+  try {
+    const parsed = JSON.parse(await readFile(storagePath(), "utf8"));
+    return { version: 1, items: Array.isArray(parsed?.items) ? parsed.items : [] };
+  } catch (error: any) {
+    if (error?.code === "ENOENT") return { version: 1, items: [] };
+    throw error;
+  }
+}
+
+async function writeStore(store: PlaybookFile) {
+  const file = storagePath();
+  await mkdir(path.dirname(file), { recursive: true, mode: 0o700 });
+  const temp = `${file}.${process.pid}.${Date.now()}.tmp`;
+  await writeFile(temp, `${JSON.stringify(store, null, 2)}\n`, { encoding: "utf8", mode: 0o600 });
+  await rename(temp, file);
+}
+
+export async function getWadiePlaybookCurationSnapshot() {
+  const [registry, store] = await Promise.all([
+    getWadieApprovedLearningRegistry(),
+    readStore(),
+  ]);
+  const draftByRegistryId = new Map(store.items.map((item) => [item.registryId, item]));
+
+  const entries = registry.entries.map((entry) => {
+    const draft = draftByRegistryId.get(entry.registryId) ?? null;
+    return {
+      ...entry,
+      playbookId: `playbook:${entry.registryId}`,
+      title: draft?.title ?? "",
+      objective: draft?.objective ?? "",
+      instructions: draft?.instructions ?? "",
+      guardrailNotes: draft?.guardrailNotes ?? "",
+      curationStatus: draft?.curationStatus ?? "not-started" as const,
+      curatedAt: draft?.curatedAt ?? null,
+      curatedBy: draft?.curatedBy ?? null,
+      activationStatus: "inactive" as const,
+      eligibleForPhase21ReuseReview: draft?.curationStatus === "ready-for-reuse-review",
+    };
+  });
+
+  return {
+    phase: "human-curated-playbooks-v1" as const,
+    mode: "local-human-curated-playbook-staging" as const,
+    totals: {
+      approvedEntries: entries.length,
+      notStarted: entries.filter((item) => item.curationStatus === "not-started").length,
+      draft: entries.filter((item) => item.curationStatus === "draft").length,
+      readyForReuseReview: entries.filter((item) => item.curationStatus === "ready-for-reuse-review").length,
+    },
+    entries: entries.slice(0, 100),
+    generatedAt: new Date().toISOString(),
+    source: "phase19-approved-learning-registry" as const,
+    humanCurationRequired: true as const,
+    playbookDraftPersistenceLocalOnly: true as const,
+    playbookActivationEnabled: false as const,
+    recommendationReuseEnabled: false as const,
+    learningMemoryWritesApplied: false as const,
+    liveMcpCallsApplied: false as const,
+    adPlatformMutationsApplied: false as const,
+    automaticOptimizationLearningApplied: false as const,
+    automaticRecommendationReuseApplied: false as const,
+    automaticExecutionPolicyChangesApplied: false as const,
+    executionStillRequiresHumanApproval: true as const,
+  };
+}
+
+export async function saveWadiePlaybookDraft(input: {
+  registryId: string;
+  title: string;
+  objective: string;
+  instructions?: string;
+  guardrailNotes?: string;
+  curationStatus: WadiePlaybookCurationStatus;
+}, actorUserId: string) {
+  const [registry, store] = await Promise.all([
+    getWadieApprovedLearningRegistry(),
+    readStore(),
+  ]);
+  const registryId = cleanText(input.registryId, 240);
+  const registryEntry = registry.entries.find((item) => item.registryId === registryId);
+  if (!registryEntry) throw new Error("Wadie approved learning registry entry not found in current Phase 19 snapshot");
+
+  const entry: WadiePlaybookDraft = {
+    registryId,
+    title: cleanText(input.title, 120),
+    objective: cleanText(input.objective, 240),
+    instructions: cleanText(input.instructions, 1200),
+    guardrailNotes: cleanText(input.guardrailNotes, 800),
+    curationStatus: input.curationStatus,
+    curatedAt: new Date().toISOString(),
+    curatedBy: String(actorUserId || "unknown"),
+  };
+  if (entry.title.length < 3) throw new Error("Playbook title must be at least 3 characters");
+  if (entry.objective.length < 8) throw new Error("Playbook objective must be at least 8 characters");
+
+  const existing = store.items.findIndex((item) => item.registryId === registryId);
+  if (existing >= 0) store.items[existing] = entry;
+  else store.items.push(entry);
+  store.items = store.items.slice(-1000);
+  await writeStore(store);
+
+  return getWadiePlaybookCurationSnapshot();
+}
+
+export function getWadiePlaybookCurationStorageInfo() {
+  return {
+    path: storagePath(),
+    containsCredentials: false,
+    localMetadataOnly: true,
+    learningMemoryWritesApplied: false,
+    recommendationReuseApplied: false,
+    adPlatformMutationsApplied: false,
+  };
+}
