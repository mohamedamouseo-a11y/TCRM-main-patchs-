+import { useMemo, useState } from "react";
+import { Activity, BookOpen, CheckCircle2, Save, ShieldCheck } from "lucide-react";
+import { Badge } from "@/components/ui/badge";
+import { Button } from "@/components/ui/button";
+import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
+import { Input } from "@/components/ui/input";
+import { useLanguage } from "@/contexts/LanguageContext";
+import { trpc } from "@/lib/trpc";
+
+type CurationStatus = "draft" | "ready-for-reuse-review";
+
+type DraftFields = {
+  title: string;
+  objective: string;
+  instructions: string;
+  guardrailNotes: string;
+};
+
+export default function WadiePlaybookCuration() {
+  const { isRTL } = useLanguage();
+  const text = (en: string, ar: string) => (isRTL ? ar : en);
+  const [drafts, setDrafts] = useState<Record<string, DraftFields>>({});
+  const query = trpc.wadie.playbookCuration.useQuery(undefined, {
+    refetchOnWindowFocus: false,
+    refetchInterval: 60_000,
+  });
+  const saveDraft = trpc.wadie.savePlaybookDraft.useMutation({
+    onSuccess: () => void query.refetch(),
+  });
+  const data = query.data;
+
+  const fieldsFor = (item: any): DraftFields => drafts[item.registryId] ?? {
+    title: item.title ?? "",
+    objective: item.objective ?? "",
+    instructions: item.instructions ?? "",
+    guardrailNotes: item.guardrailNotes ?? "",
+  };
+
+  const update = (registryId: string, key: keyof DraftFields, value: string) => {
+    const item = data?.entries.find((entry) => entry.registryId === registryId);
+    if (!item) return;
+    setDrafts((current) => ({
+      ...current,
+      [registryId]: {
+        ...(current[registryId] ?? fieldsFor(item)),
+        [key]: value,
+      },
+    }));
+  };
+
+  const submit = (item: any, curationStatus: CurationStatus) => {
+    const fields = fieldsFor(item);
+    saveDraft.mutate({
+      registryId: item.registryId,
+      title: fields.title.trim(),
+      objective: fields.objective.trim(),
+      instructions: fields.instructions.trim() || undefined,
+      guardrailNotes: fields.guardrailNotes.trim() || undefined,
+      curationStatus,
+    });
+  };
+
+  const readyCount = useMemo(
+    () => data?.entries.filter((item) => item.curationStatus === "ready-for-reuse-review").length ?? 0,
+    [data],
+  );
+
+  return (
+    <Card data-wadie-playbook-curation="phase20-v1" className="rounded-2xl border-border/70 bg-card shadow-[0_14px_34px_-28px_rgba(15,23,42,0.72)]">
+      <CardHeader className="pb-3">
+        <div className="flex flex-wrap items-center justify-between gap-3">
+          <div>
+            <CardTitle className="flex items-center gap-2 text-xl">
+              <BookOpen className="h-5 w-5 text-cyan-600" />
+              {text("Human-curated Playbooks", "Playbooks منظمة بشرياً")}
+            </CardTitle>
+            <p className="mt-1 text-xs font-semibold text-muted-foreground">
+              {text(
+                "Turn Phase 19 approved registry entries into human-authored playbook drafts. Ready means ready for Phase 21 reuse review — never active automatically.",
+                "حوّل عناصر Phase 19 المعتمدة إلى مسودات Playbook يكتبها الإنسان. الجاهز يعني جاهز لمراجعة إعادة الاستخدام في Phase 21 فقط، وليس مفعلاً تلقائياً.",
+              )}
+            </p>
+          </div>
+          <div className="flex flex-wrap gap-2">
+            <Badge variant="outline" className="rounded-full px-3 py-1 font-bold">
+              <ShieldCheck className="me-1 h-3.5 w-3.5 text-emerald-500" />
+              {text("Human curated only", "تنظيم بشري فقط")}
+            </Badge>
+            <Badge variant="outline" className="rounded-full px-3 py-1 font-bold">
+              <CheckCircle2 className="me-1 h-3.5 w-3.5 text-cyan-500" />
+              {text(`${readyCount} ready for reuse review`, `${readyCount} جاهز لمراجعة إعادة الاستخدام`)}
+            </Badge>
+            <Button variant="outline" size="sm" className="h-9 rounded-xl font-bold" disabled={query.isFetching} onClick={() => void query.refetch()}>
+              <Activity className={`me-2 h-4 w-4 ${query.isFetching ? "animate-spin" : ""}`} />
+              {text("Refresh playbooks", "تحديث Playbooks")}
+            </Button>
+          </div>
+        </div>
+      </CardHeader>
+
+      <CardContent className="space-y-4">
+        {data && (
+          <>
+            <div className="grid grid-cols-2 gap-2 md:grid-cols-4">
+              {[
+                [text("Approved entries", "العناصر المعتمدة"), data.totals.approvedEntries],
+                [text("Not started", "لم يبدأ"), data.totals.notStarted],
+                [text("Drafts", "مسودات"), data.totals.draft],
+                [text("Ready for review", "جاهز للمراجعة"), data.totals.readyForReuseReview],
+              ].map(([label, value]) => (
+                <div key={String(label)} className="rounded-xl border border-border/60 bg-background/55 p-3">
+                  <p className="text-[10px] font-black uppercase tracking-[0.08em] text-muted-foreground">{label}</p>
+                  <p className="mt-1 text-lg font-black">{value}</p>
+                </div>
+              ))}
+            </div>
+
+            <div className="space-y-3">
+              {data.entries.slice(0, 24).map((item) => {
+                const fields = fieldsFor(item);
+                const canSave = fields.title.trim().length >= 3 && fields.objective.trim().length >= 8;
+                return (
+                  <div key={item.registryId} className="rounded-2xl border border-border/60 bg-background/45 p-4">
+                    <div className="flex flex-wrap items-start justify-between gap-2">
+                      <div className="min-w-0">
+                        <div className="flex flex-wrap items-center gap-2">
+                          <BookOpen className="h-4 w-4 text-cyan-600" />
+                          <Badge variant="outline" className="rounded-full text-[10px]">{item.kind}</Badge>
+                          <span className="truncate text-xs font-black">{item.key}</span>
+                        </div>
+                        <p className="mt-1 text-[10px] font-semibold text-muted-foreground">{item.rationale}</p>
+                      </div>
+                      <div className="flex flex-wrap gap-2">
+                        <Badge variant="secondary" className="rounded-full text-[10px]">
+                          {item.curationStatus === "ready-for-reuse-review"
+                            ? text("Ready for reuse review", "جاهز لمراجعة إعادة الاستخدام")
+                            : item.curationStatus === "draft"
+                              ? text("Draft", "مسودة")
+                              : text("Not started", "لم يبدأ")}
+                        </Badge>
+                        <Badge variant="outline" className="rounded-full text-[10px]">
+                          {text("Activation: Inactive", "التفعيل: غير مفعل")}
+                        </Badge>
+                      </div>
+                    </div>
+
+                    <div className="mt-3 grid gap-2 md:grid-cols-2">
+                      <Input
+                        value={fields.title}
+                        onChange={(event) => update(item.registryId, "title", event.target.value)}
+                        maxLength={120}
+                        placeholder={text("Playbook title", "عنوان Playbook")}
+                        className="h-9 rounded-xl text-xs"
+                      />
+                      <Input
+                        value={fields.objective}
+                        onChange={(event) => update(item.registryId, "objective", event.target.value)}
+                        maxLength={240}
+                        placeholder={text("Human-defined objective", "الهدف المحدد بشرياً")}
+                        className="h-9 rounded-xl text-xs"
+                      />
+                      <textarea
+                        value={fields.instructions}
+                        onChange={(event) => update(item.registryId, "instructions", event.target.value)}
+                        maxLength={1200}
+                        placeholder={text("Optional playbook instructions", "تعليمات Playbook اختيارية")}
+                        className="min-h-20 rounded-xl border border-input bg-background px-3 py-2 text-xs outline-none ring-offset-background focus:ring-2 focus:ring-ring"
+                      />
+                      <textarea
+                        value={fields.guardrailNotes}
+                        onChange={(event) => update(item.registryId, "guardrailNotes", event.target.value)}
+                        maxLength={800}
+                        placeholder={text("Optional human guardrail notes", "ضوابط بشرية اختيارية")}
+                        className="min-h-20 rounded-xl border border-input bg-background px-3 py-2 text-xs outline-none ring-offset-background focus:ring-2 focus:ring-ring"
+                      />
+                    </div>
+
+                    <div className="mt-3 flex flex-wrap items-center justify-between gap-2">
+                      <p className="text-[10px] font-semibold text-muted-foreground">
+                        {text("Source: human-approved Phase 19 registry entry", "المصدر: عنصر معتمد بشرياً من سجل Phase 19")}
+                      </p>
+                      <div className="flex flex-wrap gap-2">
+                        <Button
+                          size="sm"
+                          variant="outline"
+                          className="h-9 rounded-xl font-bold"
+                          disabled={!canSave || saveDraft.isPending}
+                          onClick={() => submit(item, "draft")}
+                        >
+                          <Save className="me-1.5 h-3.5 w-3.5" />
+                          {text("Save draft", "حفظ المسودة")}
+                        </Button>
+                        <Button
+                          size="sm"
+                          className="h-9 rounded-xl font-bold"
+                          disabled={!canSave || saveDraft.isPending}
+                          onClick={() => submit(item, "ready-for-reuse-review")}
+                        >
+                          <CheckCircle2 className="me-1.5 h-3.5 w-3.5" />
+                          {text("Ready for reuse review", "جاهز لمراجعة إعادة الاستخدام")}
+                        </Button>
+                      </div>
+                    </div>
+                  </div>
+                );
+              })}
+            </div>
+
+            {data.entries.length === 0 && (
+              <div className="rounded-xl border border-dashed border-border px-4 py-5 text-center text-xs font-semibold text-muted-foreground">
+                {text("No approved Phase 19 entries are available for playbook curation yet.", "لا توجد عناصر Phase 19 معتمدة ومتاحة لتنظيم Playbooks حتى الآن.")}
+              </div>
+            )}
+          </>
+        )}
+
+        {saveDraft.error && <p className="text-xs font-semibold text-destructive">{saveDraft.error.message}</p>}
+        {query.error && <p className="text-xs font-semibold text-destructive">{query.error.message}</p>}
+
+        <p className="text-[10px] font-semibold text-muted-foreground">
+          {text(
+            "Phase 20 stores human-authored playbook drafts as local metadata only. Ready status does not activate recommendation reuse, write learning memory, call MCP tools, mutate ad platforms, or change execution policy.",
+            "Phase 20 يحفظ مسودات Playbook المكتوبة بشرياً كبيانات محلية فقط. حالة الجاهزية لا تفعّل إعادة استخدام التوصيات، ولا تكتب ذاكرة تعلم، ولا تستدعي MCP، ولا تعدل منصات الإعلانات أو سياسة التنفيذ.",
+          )}
+        </p>
+      </CardContent>
+    </Card>
+  );
+}
