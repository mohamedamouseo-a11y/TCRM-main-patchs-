++++ b/scripts/audit-smart-search-bars.ts
+@@ -0,0 +1,73 @@
++import fs from "node:fs";
++import path from "node:path";
++
++const ROOT = path.resolve(process.cwd(), "client/src");
++const strict = process.argv.includes("--strict");
++const extensions = new Set([".ts", ".tsx"]);
++const searchSignals = [
++  /placeholder\s*=\s*(?:\{[^\n]*(?:search|Search|بحث|ابحث)[^\n]*\}|["'`][^"'`]*(?:search|Search|بحث|ابحث)[^"'`]*["'`])/,
++  /type\s*=\s*["']search["']/,
++  /<CommandInput\b/,
++  /\b(?:searchQuery|searchTerm|debouncedSearch|onSearchChange|setSearch)\b/,
++];
++const integrationSignals = [
++  /SmartSearchBar/,
++  /matchesSystemSmartSearch/,
++  /rankSystemSmartSearch/,
++  /normalizeSearchText/,
++  /VoiceSearchButton/,
++];
++const exemptSignal = /SMART_SEARCH_AUDIT_EXEMPT:\s*(.+)/;
++
++function walk(dir: string): string[] {
++  if (!fs.existsSync(dir)) return [];
++  return fs.readdirSync(dir, { withFileTypes: true }).flatMap(entry => {
++    const full = path.join(dir, entry.name);
++    if (entry.isDirectory()) return walk(full);
++    return extensions.has(path.extname(entry.name)) ? [full] : [];
++  });
++}
++
++type AuditRow = {
++  file: string;
++  lines: number[];
++  status: "integrated" | "exempt" | "pending";
++  reason?: string;
++};
++
++const rows: AuditRow[] = [];
++for (const file of walk(ROOT)) {
++  const source = fs.readFileSync(file, "utf8");
++  const lines = source.split(/\r?\n/);
++  const hitLines = lines.flatMap((line, index) =>
++    searchSignals.some(pattern => pattern.test(line)) ? [index + 1] : []
++  );
++  if (!hitLines.length) continue;
++  const exemption = source.match(exemptSignal)?.[1]?.trim();
++  const integrated = integrationSignals.some(pattern => pattern.test(source));
++  rows.push({
++    file: path.relative(process.cwd(), file).replace(/\\/g, "/"),
++    lines: hitLines.slice(0, 12),
++    status: exemption ? "exempt" : integrated ? "integrated" : "pending",
++    reason: exemption,
++  });
++}
++
++rows.sort((a, b) => a.file.localeCompare(b.file));
++const pending = rows.filter(row => row.status === "pending");
++console.log("# TCRM Smart Search Bar Audit");
++console.log("");
++console.log(`Candidates: ${rows.length} | Integrated: ${rows.filter(r => r.status === "integrated").length} | Exempt: ${rows.filter(r => r.status === "exempt").length} | Pending: ${pending.length}`);
++console.log("");
++console.log("| Status | File | Candidate lines | Reason |");
++console.log("|---|---|---:|---|");
++for (const row of rows) {
++  console.log(`| ${row.status.toUpperCase()} | ${row.file} | ${row.lines.join(", ")} | ${row.reason ?? ""} |`);
++}
++console.log("");
++console.log("Review rule: every PENDING file must be inspected manually. If it contains a true search bar, integrate Smart Search. If it is only a form/filter false-positive, add a specific SMART_SEARCH_AUDIT_EXEMPT comment explaining why.");
++
++if (strict && pending.length > 0) {
++  console.error(`\nSmart Search audit failed: ${pending.length} candidate file(s) remain unreviewed.`);
++  process.exitCode = 1;
++}
