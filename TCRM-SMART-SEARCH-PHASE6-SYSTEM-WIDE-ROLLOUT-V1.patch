++import { describe, expect, it } from "vitest";
++import {
++  matchesSystemSmartSearch,
++  rankSystemSmartSearch,
++  systemSmartSearchScore,
++} from "./systemSmartSearch";
++
++describe("system-wide smart search", () => {
++  it("reuses Arabic normalization", () => {
++    expect(matchesSystemSmartSearch("الامل", { text: ["الأمل"] })).toBe(true);
++    expect(matchesSystemSmartSearch("احمد", { text: ["أحمد"] })).toBe(true);
++  });
++
++  it("supports bounded one-edit fuzzy matching for human text", () => {
++    expect(matchesSystemSmartSearch("mohmaed", { text: ["Mohamed"] })).toBe(true);
++    expect(matchesSystemSmartSearch("احدم", { text: ["أحمد"] })).toBe(true);
++  });
++
++  it("never fuzzes structured identifiers", () => {
++    expect(matchesSystemSmartSearch("ahmd@example.com", { structured: ["ahmed@example.com"] })).toBe(false);
++    expect(matchesSystemSmartSearch("1235", { structured: ["1234"] })).toBe(false);
++    expect(matchesSystemSmartSearch("123", { structured: ["00123-456"] })).toBe(true);
++  });
++
++  it("keeps semantic ranking exact before prefix before contains before fuzzy", () => {
++    const rows = [
++      { id: "fuzzy", name: "ahmd" },
++      { id: "contains", name: "the ahmed company" },
++      { id: "prefix", name: "ahmed group" },
++      { id: "exact", name: "Ahmed" },
++    ];
++    expect(rankSystemSmartSearch("ahmed", rows, row => ({ text: [row.name] })).map(row => row.id))
++      .toEqual(["exact", "prefix", "contains", "fuzzy"]);
++  });
++
++  it("preserves stable source ordering when scores tie", () => {
++    const rows = [{ id: 1, name: "Ahmed One" }, { id: 2, name: "Ahmed Two" }];
++    expect(rankSystemSmartSearch("ahmed", rows, row => ({ text: [row.name] })).map(row => row.id))
++      .toEqual([1, 2]);
++  });
++
++  it("returns the original set for an empty query", () => {
++    const rows = [{ id: 1 }, { id: 2 }];
++    expect(rankSystemSmartSearch("", rows, () => ({ text: [] }))).toEqual(rows);
++  });
++
++  it("gives structured exact matches a score without fuzzy expansion", () => {
++    expect(systemSmartSearchScore("C-100", { structured: ["C-100"] })).toBeGreaterThan(0);
++    expect(systemSmartSearchScore("C-101", { structured: ["C-100"] })).toBe(0);
++  });
++});
