+import { normalizeSearchText } from "./searchNormalization";
+
+export type SystemSmartSearchFields = {
+  /** Human-readable fields: normalization + bounded one-edit fuzzy matching. */
+  text?: unknown[];
+  /** Structured fields: normalization + exact/prefix/contains only, never fuzzy. */
+  structured?: unknown[];
+};
+
+export const SYSTEM_SMART_SEARCH_MIN_FUZZY_LENGTH = 4;
+export const SYSTEM_SMART_SEARCH_MAX_FUZZY_LENGTH = 14;
+
+function oneEditAway(left: string, right: string): boolean {
+  const a = Array.from(left);
+  const b = Array.from(right);
+  if (Math.abs(a.length - b.length) > 1) return false;
+
+  if (a.length === b.length) {
+    const diff: number[] = [];
+    for (let index = 0; index < a.length; index += 1) {
+      if (a[index] !== b[index]) diff.push(index);
+      if (diff.length > 2) return false;
+    }
+    if (diff.length <= 1) return true;
+    const [x, y] = diff;
+    return y === x + 1 && a[x] === b[y] && a[y] === b[x];
+  }
+
+  const shorter = a.length < b.length ? a : b;
+  const longer = a.length < b.length ? b : a;
+  let i = 0;
+  let j = 0;
+  let edits = 0;
+  while (i < shorter.length && j < longer.length) {
+    if (shorter[i] === longer[j]) {
+      i += 1;
+      j += 1;
+    } else {
+      edits += 1;
+      j += 1;
+      if (edits > 1) return false;
+    }
+  }
+  return true;
+}
+
+function textFieldScore(query: string, value: unknown): number {
+  const field = normalizeSearchText(value);
+  if (!field) return 0;
+  if (field === query) return 1000;
+  if (field.startsWith(query)) return 920;
+  const words = field.split(" ").filter(Boolean);
+  if (words.some(word => word === query)) return 900;
+  if (words.some(word => word.startsWith(query))) return 860;
+  if (field.includes(query)) return 800;
+  if (
+    query.length >= SYSTEM_SMART_SEARCH_MIN_FUZZY_LENGTH &&
+    query.length <= SYSTEM_SMART_SEARCH_MAX_FUZZY_LENGTH &&
+    words.some(word => oneEditAway(query, word))
+  ) return 700;
+  return 0;
+}
+
+function structuredFieldScore(query: string, value: unknown): number {
+  const field = normalizeSearchText(value);
+  if (!field) return 0;
+  if (field === query) return 980;
+  if (field.startsWith(query)) return 840;
+  if (field.includes(query)) return 780;
+  return 0;
+}
+
+export function systemSmartSearchScore(
+  query: unknown,
+  fields: SystemSmartSearchFields,
+): number {
+  const normalized = normalizeSearchText(query);
+  if (!normalized) return 1;
+  return Math.max(
+    0,
+    ...(fields.text ?? []).map(value => textFieldScore(normalized, value)),
+    ...(fields.structured ?? []).map(value => structuredFieldScore(normalized, value)),
+  );
+}
+
+export function matchesSystemSmartSearch(
+  query: unknown,
+  fields: SystemSmartSearchFields,
+): boolean {
+  return systemSmartSearchScore(query, fields) > 0;
+}
+
+export function rankSystemSmartSearch<T>(
+  query: unknown,
+  items: T[],
+  getFields: (item: T) => SystemSmartSearchFields,
+): T[] {
+  const normalized = normalizeSearchText(query);
+  if (!normalized) return [...items];
+  return items
+    .map((item, index) => ({ item, index, score: systemSmartSearchScore(normalized, getFields(item)) }))
+    .filter(row => row.score > 0)
+    .sort((a, b) => b.score - a.score || a.index - b.index)
+    .map(row => row.item);
+}
