@@ -0,0 +1,77 @@
+import { normalizeSearchText } from "./searchNormalization";
+
+export const SEARCH_SUGGESTION_MIN_QUERY_LENGTH = 2;
+export const SEARCH_SUGGESTION_DEFAULT_LIMIT = 6;
+
+export type SearchSuggestionInput<T> = {
+  value: T;
+  fields: unknown[];
+};
+
+function oneEditAway(left: string, right: string): boolean {
+  const a = Array.from(left);
+  const b = Array.from(right);
+  if (Math.abs(a.length - b.length) > 1) return false;
+
+  if (a.length === b.length) {
+    const diff = a.reduce<number[]>((items, char, index) => {
+      if (char !== b[index]) items.push(index);
+      return items;
+    }, []);
+    if (diff.length <= 1) return true;
+    if (diff.length !== 2) return false;
+    const [x, y] = diff;
+    return y === x + 1 && a[x] === b[y] && a[y] === b[x];
+  }
+
+  const shorter = a.length < b.length ? a : b;
+  const longer = a.length < b.length ? b : a;
+  let i = 0;
+  let j = 0;
+  let edits = 0;
+  while (i < shorter.length && j < longer.length) {
+    if (shorter[i] === longer[j]) {
+      i += 1;
+      j += 1;
+    } else {
+      edits += 1;
+      j += 1;
+      if (edits > 1) return false;
+    }
+  }
+  return true;
+}
+
+function fieldScore(query: string, value: unknown) {
+  const field = normalizeSearchText(value);
+  if (!field) return 0;
+  if (field === query) return 1000;
+  if (field.startsWith(query)) return 920;
+  const words = field.split(" ").filter(Boolean);
+  if (words.some(word => word === query)) return 900;
+  if (words.some(word => word.startsWith(query))) return 860;
+  if (field.includes(query)) return 800;
+  if (query.length >= 4 && words.some(word => oneEditAway(query, word))) return 700;
+  return 0;
+}
+
+export function rankSearchSuggestions<T>(
+  query: unknown,
+  candidates: SearchSuggestionInput<T>[],
+  limit = SEARCH_SUGGESTION_DEFAULT_LIMIT,
+): T[] {
+  const normalized = normalizeSearchText(query);
+  if (normalized.length < SEARCH_SUGGESTION_MIN_QUERY_LENGTH) return [];
+  const safeLimit = Math.max(1, Math.min(Number(limit) || SEARCH_SUGGESTION_DEFAULT_LIMIT, 12));
+
+  return candidates
+    .map((candidate, index) => ({
+      value: candidate.value,
+      index,
+      score: Math.max(0, ...candidate.fields.map(field => fieldScore(normalized, field))),
+    }))
+    .filter(candidate => candidate.score > 0)
+    .sort((a, b) => b.score - a.score || a.index - b.index)
+    .slice(0, safeLimit)
+    .map(candidate => candidate.value);
+}

diff --git a/shared/searchSuggestions.test.ts b/shared/searchSuggestions.test.ts
new file mode 100644
--- /dev/null
+++ b/shared/searchSuggestions.test.ts
@@ -0,0 +1,42 @@
+import { describe, expect, it } from "vitest";
+import { rankSearchSuggestions } from "./searchSuggestions";
+
+describe("search suggestions", () => {
+  it("ranks exact, prefix, contains, then fuzzy", () => {
+    expect(rankSearchSuggestions("ahmed", [
+      { value: "fuzzy", fields: ["ahmd"] },
+      { value: "contains", fields: ["the ahmed company"] },
+      { value: "prefix", fields: ["ahmed group"] },
+      { value: "exact", fields: ["Ahmed"] },
+    ], 10)).toEqual(["exact", "prefix", "contains", "fuzzy"]);
+  });
+
+  it("reuses Arabic normalization", () => {
+    expect(rankSearchSuggestions("الامل", [
+      { value: "normalized", fields: ["الأمل"] },
+    ])).toEqual(["normalized"]);
+  });
+
+  it("recovers one-edit Arabic and English names", () => {
+    expect(rankSearchSuggestions("احدم", [
+      { value: "ahmed", fields: ["أحمد"] },
+    ])).toEqual(["ahmed"]);
+    expect(rankSearchSuggestions("mohmaed", [
+      { value: "mohamed", fields: ["Mohamed"] },
+    ])).toEqual(["mohamed"]);
+  });
+
+  it("returns no suggestions for one-character queries", () => {
+    expect(rankSearchSuggestions("a", [
+      { value: "ahmed", fields: ["Ahmed"] },
+    ])).toEqual([]);
+  });
+
+  it("keeps stable server order for tied scores and caps results", () => {
+    const candidates = Array.from({ length: 20 }, (_, index) => ({
+      value: index,
+      fields: [`test ${index}`],
+    }));
+    expect(rankSearchSuggestions("test", candidates)).toEqual([0, 1, 2, 3, 4, 5]);
+  });
+});

