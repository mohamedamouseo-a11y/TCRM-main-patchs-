+// New pool facade: priority-fill, 5% reserve, exact account binding, legacy fallback.
+const poolService = `import { sql } from "drizzle-orm";
+import { getDb } from "../db";
+import {
+  getDriveClient,
+  getGoogleDriveFileStorageSettings,
+  getGoogleDriveFileStorageSettingsForKey,
+  getGoogleDriveStorageReadiness,
+  uploadStoredFileToGoogleDriveUnsafe,
+  type GoogleDriveFileStorageSettings,
+  type StoredDriveUploadResult,
+} from "./googleDriveFileStorage";
+
+type PoolAccount = {
+  id: number | null;
+  name: string;
+  settingsKey: string;
+  priority: number;
+  isLegacyPrimary: boolean;
+};
+
+type PoolCandidate = PoolAccount & {
+  settings: GoogleDriveFileStorageSettings;
+  totalBytes: number | null;
+  usedBytes: number | null;
+  freeBytes: number | null;
+  reserveBytes: number;
+};
+
+function rowsFromExecute(result: any): any[] {
+  if (Array.isArray(result?.[0])) return result[0];
+  if (Array.isArray(result)) return result;
+  if (Array.isArray(result?.rows)) return result.rows;
+  return [];
+}
+
+async function listAccounts(): Promise<PoolAccount[]> {
+  const db = await getDb();
+  if (!db) return [];
+  try {
+    const result: any = await db.execute(sql.raw(
+      "SELECT id,name,settingsKey,priority,isLegacyPrimary FROM google_drive_storage_accounts ORDER BY priority ASC,id ASC"
+    ));
+    return rowsFromExecute(result).map((row: any) => ({
+      id: Number(row.id) || null,
+      name: String(row.name || "Google Drive"),
+      settingsKey: String(row.settingsKey || "").trim(),
+      priority: Number(row.priority || 1),
+      isLegacyPrimary: Boolean(Number(row.isLegacyPrimary || 0)),
+    })).filter((row: PoolAccount) => row.settingsKey);
+  } catch {
+    return [];
+  }
+}
+
+async function quotaFor(settings: GoogleDriveFileStorageSettings) {
+  const drive = await getDriveClient(settings);
+  const response = await drive.about.get({ fields: "storageQuota" });
+  const quota = response?.data?.storageQuota || {};
+  const total = Number(quota.limit);
+  const used = Number(quota.usage);
+  const totalBytes = Number.isFinite(total) && total > 0 ? total : null;
+  const usedBytes = Number.isFinite(used) && used >= 0 ? used : null;
+  const freeBytes = totalBytes !== null && usedBytes !== null ? Math.max(0, totalBytes - usedBytes) : null;
+  const pct = Math.max(0, Math.min(25, Number(process.env.GOOGLE_DRIVE_POOL_RESERVE_PERCENT || 5)));
+  const reserveBytes = totalBytes === null ? 0 : Math.ceil(totalBytes * pct / 100);
+  return { totalBytes, usedBytes, freeBytes, reserveBytes };
+}
+
+async function accountSettings(account: PoolAccount) {
+  if (account.id === null || account.isLegacyPrimary) {
+    return getGoogleDriveFileStorageSettings({ includeSecrets: true });
+  }
+  return getGoogleDriveFileStorageSettingsForKey(account.settingsKey, { includeSecrets: true });
+}
+
+export async function getGoogleDriveStoragePoolCandidates(requiredBytes = 0): Promise<PoolCandidate[]> {
+  let accounts = await listAccounts();
+  if (!accounts.length) {
+    accounts = [{ id: null, name: "Primary Google Drive", settingsKey: "google_drive_file_storage_settings", priority: 1, isLegacyPrimary: true }];
+  }
+  const candidates: PoolCandidate[] = [];
+  for (const account of accounts) {
+    const settings = await accountSettings(account);
+    const readiness = getGoogleDriveStorageReadiness(settings);
+    if (!settings.enabled || !readiness.ready) continue;
+    try {
+      const quota = await quotaFor(settings);
+      if (quota.freeBytes !== null && quota.freeBytes - quota.reserveBytes < Math.max(0, requiredBytes)) continue;
+      candidates.push({ ...account, settings, ...quota });
+    } catch {
+      candidates.push({ ...account, settings, totalBytes: null, usedBytes: null, freeBytes: null, reserveBytes: 0 });
+    }
+  }
+  return candidates;
+}
+
+export async function uploadStoredFileViaGoogleDrivePool(args: {
+  storageKey: string;
+  fileName: string;
+  buffer: Buffer;
+  contentType?: string | null;
+}): Promise<StoredDriveUploadResult & { storageAccountId: number | null }> {
+  const candidates = await getGoogleDriveStoragePoolCandidates(args.buffer.length);
+  if (!candidates.length) {
+    return { driveFileId: null, driveUrl: null, uploadStatus: "failed", storageAccountId: null, error: "No writable Google Drive storage account is available" };
+  }
+  let lastError = "Google Drive upload failed";
+  for (const candidate of candidates) {
+    try {
+      const result = await uploadStoredFileToGoogleDriveUnsafe(candidate.settings, args);
+      return { ...result, storageAccountId: candidate.id };
+    } catch (error: any) {
+      lastError = String(error?.message || lastError);
+      const code = Number(error?.response?.status || error?.code || 0);
+      const quota = /quota|storage.*full|insufficient.*storage/i.test(lastError) || code === 403;
+      if (!quota) break;
+    }
+  }
+  return { driveFileId: null, driveUrl: null, uploadStatus: "failed", storageAccountId: null, error: lastError };
+}
+
+export async function getPoolAccountSettings(storageAccountId?: number | null) {
+  const id = Number(storageAccountId || 0);
+  const accounts = await listAccounts();
+  const account = id > 0 ? accounts.find((item) => item.id === id) : accounts.find((item) => item.isLegacyPrimary) || accounts[0];
+  if (!account) return getGoogleDriveFileStorageSettings({ includeSecrets: true });
+  return accountSettings(account);
+}
+
+export async function getGoogleDrivePoolStatus() {
+  const candidates = await getGoogleDriveStoragePoolCandidates(0);
+  const totalBytes = candidates.reduce((sum, item) => sum + (item.totalBytes || 0), 0);
+  const usedBytes = candidates.reduce((sum, item) => sum + (item.usedBytes || 0), 0);
+  const freeBytes = candidates.reduce((sum, item) => sum + (item.freeBytes || 0), 0);
+  return {
+    ready: candidates.length > 0,
+    accounts: candidates.map(({ settings, ...item }) => item),
+    totalBytes,
+    usedBytes,
+    freeBytes,
+  };
+}
+`;
