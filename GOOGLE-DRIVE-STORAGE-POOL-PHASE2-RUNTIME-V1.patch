+function read(path){ return fs.readFileSync(path,"utf8"); }
+function write(path, value){ fs.writeFileSync(path,value); }
+function mustReplace(path, oldText, newText, count=1){
+  let s=read(path);
+  let seen=0, pos=0;
+  while ((pos=s.indexOf(oldText,pos)) !== -1){ seen++; pos += oldText.length; }
+  if (seen < count) throw new Error(`${path}: expected at least ${count} occurrence(s), found ${seen}: ${oldText.slice(0,120)}`);
+  for(let i=0;i<count;i++) s=s.replace(oldText,newText);
+  write(path,s);
+}
+function appendIfMissing(path, marker, block){
+  let s=read(path);
+  if(!s.includes(marker)){ s += (s.endsWith("\n")?"":"\n") + block; write(path,s); }
+}
