diff --git a/client/src/components/DeveloperEmptyVisual.tsx b/client/src/components/DeveloperEmptyVisual.tsx
new file mode 100644
--- /dev/null
+++ b/client/src/components/DeveloperEmptyVisual.tsx
@@ -0,0 +1,123 @@
+type PreviewVariant = "funnel" | "line" | "bars" | "donut";
+
+type DeveloperVisualPreviewProps = {
+  variant: PreviewVariant;
+  className?: string;
+};
+
+const BAR_HEIGHTS = [38, 62, 48, 78, 56, 72, 44];
+const FUNNEL_WIDTHS = [92, 78, 64, 51, 39];
+
+export function DeveloperVisualPreview({ variant, className = "h-64" }: DeveloperVisualPreviewProps) {
+  return (
+    <div
+      aria-hidden="true"
+      data-developer-empty-visual={variant}
+      className={`relative overflow-hidden rounded-xl border border-dashed border-border/70 bg-gradient-to-b from-muted/25 to-background ${className}`}
+    >
+      <div
+        className="absolute inset-0 opacity-40"
+        style={{
+          backgroundImage:
+            "linear-gradient(to right, hsl(var(--border)) 1px, transparent 1px), linear-gradient(to bottom, hsl(var(--border)) 1px, transparent 1px)",
+          backgroundSize: "20% 25%",
+        }}
+      />
+
+      {variant === "funnel" && (
+        <div className="relative flex h-full flex-col items-center justify-center gap-2 px-8">
+          {FUNNEL_WIDTHS.map((width, index) => (
+            <div
+              key={width}
+              className="h-7 rounded-md bg-gradient-to-r from-violet-500/55 via-indigo-500/45 to-cyan-500/45 shadow-sm"
+              style={{ width: `${width}%`, opacity: 0.9 - index * 0.1 }}
+            />
+          ))}
+        </div>
+      )}
+
+      {variant === "line" && (
+        <svg className="relative h-full w-full p-5" viewBox="0 0 420 180" preserveAspectRatio="none">
+          <path
+            d="M18 148 C60 124, 78 132, 112 102 S178 78, 214 96 S282 50, 316 66 S366 38, 402 52"
+            fill="none"
+            stroke="currentColor"
+            strokeWidth="4"
+            strokeLinecap="round"
+            className="text-violet-500/55"
+          />
+          {[18, 112, 214, 316, 402].map((cx, index) => (
+            <circle key={cx} cx={cx} cy={[148, 102, 96, 66, 52][index]} r="5" className="fill-violet-500/55" />
+          ))}
+        </svg>
+      )}
+
+      {variant === "bars" && (
+        <div className="relative flex h-full items-end justify-around gap-3 px-8 pb-7 pt-8">
+          {BAR_HEIGHTS.map((height, index) => (
+            <div
+              key={`${height}-${index}`}
+              className="w-full max-w-10 rounded-t-md bg-gradient-to-t from-indigo-500/50 to-cyan-400/55"
+              style={{ height: `${height}%`, opacity: 0.72 + (index % 3) * 0.08 }}
+            />
+          ))}
+        </div>
+      )}
+
+      {variant === "donut" && (
+        <div className="relative flex h-full items-center justify-center">
+          <div
+            className="h-32 w-32 rounded-full opacity-70"
+            style={{
+              background:
+                "conic-gradient(rgb(99 102 241 / .72) 0 32%, rgb(34 197 94 / .62) 32% 55%, rgb(245 158 11 / .62) 55% 76%, rgb(6 182 212 / .62) 76% 100%)",
+            }}
+          >
+            <div className="m-8 h-16 w-16 rounded-full border border-border/60 bg-card" />
+          </div>
+        </div>
+      )}
+
+      <div className="pointer-events-none absolute inset-x-5 bottom-3 h-px bg-border/60" />
+    </div>
+  );
+}
+
+const CALENDAR_PREVIEW_INDICES = new Set([9, 11, 16, 18, 23, 30]);
+
+export function DeveloperCalendarCellPreview({ index }: { index: number }) {
+  if (!CALENDAR_PREVIEW_INDICES.has(index)) return null;
+
+  const tone =
+    index % 3 === 0
+      ? "bg-violet-100/80 border-violet-200/80"
+      : index % 3 === 1
+        ? "bg-blue-100/80 border-blue-200/80"
+        : "bg-emerald-100/80 border-emerald-200/80";
+
+  return (
+    <div
+      aria-hidden="true"
+      data-developer-calendar-preview="true"
+      className={`pointer-events-none mt-1 h-4 rounded-md border ${tone}`}
+    >
+      <div className="mx-1.5 mt-[5px] h-1 w-2/3 rounded-full bg-slate-500/20" />
+    </div>
+  );
+}
+
+export function DeveloperUpcomingPreview() {
+  return (
+    <div aria-hidden="true" data-developer-upcoming-preview="true" className="space-y-2">
+      {[0, 1, 2].map((index) => (
+        <div key={index} className="flex items-start gap-2.5 rounded-xl border border-slate-100 p-2.5">
+          <div className="h-8 w-8 shrink-0 rounded-lg bg-violet-100/80" />
+          <div className="flex-1 space-y-2 pt-0.5">
+            <div className="h-2.5 rounded-full bg-slate-200/80" style={{ width: `${76 - index * 11}%` }} />
+            <div className="h-2 rounded-full bg-slate-100" style={{ width: `${54 + index * 8}%` }} />
+          </div>
+        </div>
+      ))}
+    </div>
+  );
+}
