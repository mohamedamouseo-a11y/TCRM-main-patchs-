--- /dev/null
+++ b/server/services/felfel/felfelDashboardService.ts
@@ -0,0 +1,163 @@
+// FELFEL_PHASE1_OPERATIONAL_DASHBOARD_V1
+// CRM-owned Felfel dashboard. Vexa is runtime only; crm_meetings is the source of truth.
+// @ts-nocheck
+import { and, count, desc, eq, like, or, sql } from "drizzle-orm";
+import { getDb } from "../../db";
+import { clients, crmMeetings, leads, users } from "../../../drizzle/schema";
+import { normalizeUserRole } from "../../roleUtils";
+
+const DASHBOARD_ROLES = new Set([
+  "Admin",
+  "SalesManager",
+  "SalesAgent",
+  "ColdSalesAgent",
+  "AccountManager",
+  "AccountManagerLead",
+]);
+
+function asRows(value: unknown): any[] {
+  return Array.isArray(value) ? value : [];
+}
+
+function recordingMedia(auditData: unknown) {
+  const audit = asRows(auditData);
+  const finalized = [...audit].reverse().find((entry: any) => entry?.event === "recording_finalized");
+  return asRows(finalized?.media).filter((item: any) => item?.protectedUrl || item?.driveUrl);
+}
+
+function positiveInt(value: unknown) {
+  const parsed = Number(value || 0);
+  return Number.isInteger(parsed) && parsed > 0 ? parsed : null;
+}
+
+export type FelfelDashboardFilters = {
+  actorUserId: number;
+  actorRole: string;
+  query?: string | null;
+  platform?: string | null;
+  status?: string | null;
+  recordingStatus?: string | null;
+  invokerUserId?: number | null;
+  from?: string | null;
+  to?: string | null;
+  limit?: number;
+  offset?: number;
+};
+
+export async function listFelfelDashboardMeetings(input: FelfelDashboardFilters) {
+  const db = await getDb();
+  if (!db) throw new Error("Database is not available");
+
+  const actorUserId = positiveInt(input.actorUserId);
+  const actorRole = normalizeUserRole(input.actorRole);
+  if (!actorUserId || !DASHBOARD_ROLES.has(actorRole)) {
+    throw new Error("Felfel dashboard access is not enabled for this role");
+  }
+
+  const isAdmin = actorRole === "Admin";
+  const predicates: any[] = [];
+
+  // Sales and Account Management only see meetings they personally invoked.
+  // This is enforced server-side and cannot be widened from query parameters.
+  if (isAdmin) {
+    const invokerUserId = positiveInt(input.invokerUserId);
+    if (invokerUserId) predicates.push(eq(crmMeetings.ownerUserId, invokerUserId));
+  } else {
+    predicates.push(eq(crmMeetings.ownerUserId, actorUserId));
+  }
+
+  if (input.platform) predicates.push(eq(crmMeetings.platform, String(input.platform)));
+  if (input.status) predicates.push(eq(crmMeetings.status, String(input.status)));
+  if (input.recordingStatus) predicates.push(eq(crmMeetings.recordingStatus, String(input.recordingStatus)));
+
+  if (input.from) {
+    const from = new Date(input.from);
+    if (!Number.isNaN(from.getTime())) {
+      predicates.push(sql`COALESCE(${crmMeetings.startedAt}, ${crmMeetings.scheduledAt}, ${crmMeetings.createdAt}) >= ${from}`);
+    }
+  }
+  if (input.to) {
+    const to = new Date(input.to);
+    if (!Number.isNaN(to.getTime())) {
+      predicates.push(sql`COALESCE(${crmMeetings.startedAt}, ${crmMeetings.scheduledAt}, ${crmMeetings.createdAt}) <= ${to}`);
+    }
+  }
+
+  // Smart-search foundation: every token may match meeting title, client/lead,
+  // invoker, platform/native id, or CRM identifiers.
+  const tokens = String(input.query || "").trim().split(/\s+/).filter(Boolean).slice(0, 8);
+  for (const token of tokens) {
+    const pattern = `%${token}%`;
+    predicates.push(or(
+      like(crmMeetings.title, pattern),
+      like(clients.leadName, pattern),
+      like(leads.name, pattern),
+      like(users.name, pattern),
+      like(crmMeetings.platform, pattern),
+      like(crmMeetings.nativeMeetingId, pattern),
+      sql`CAST(${crmMeetings.id} AS CHAR) LIKE ${pattern}`,
+      sql`CAST(${crmMeetings.clientId} AS CHAR) LIKE ${pattern}`,
+      sql`CAST(${crmMeetings.leadId} AS CHAR) LIKE ${pattern}`,
+    ));
+  }
+
+  const where = predicates.length ? and(...predicates) : undefined;
+  const limit = Math.min(Math.max(Number(input.limit || 30), 1), 100);
+  const offset = Math.max(Number(input.offset || 0), 0);
+
+  const selectShape = {
+    id: crmMeetings.id,
+    clientId: crmMeetings.clientId,
+    leadId: crmMeetings.leadId,
+    dealId: crmMeetings.dealId,
+    ownerUserId: crmMeetings.ownerUserId,
+    createdByUserId: crmMeetings.createdByUserId,
+    title: crmMeetings.title,
+    platform: crmMeetings.platform,
+    nativeMeetingId: crmMeetings.nativeMeetingId,
+    meetingUrl: crmMeetings.meetingUrl,
+    status: crmMeetings.status,
+    felfelStatus: crmMeetings.felfelStatus,
+    recordingStatus: crmMeetings.recordingStatus,
+    recordingDriveUrl: crmMeetings.recordingDriveUrl,
+    recordingDurationSec: crmMeetings.recordingDurationSec,
+    recordingSizeBytes: crmMeetings.recordingSizeBytes,
+    transcriptStatus: crmMeetings.transcriptStatus,
+    analysisStatus: crmMeetings.analysisStatus,
+    scheduledAt: crmMeetings.scheduledAt,
+    startedAt: crmMeetings.startedAt,
+    endedAt: crmMeetings.endedAt,
+    completedAt: crmMeetings.completedAt,
+    createdAt: crmMeetings.createdAt,
+    auditData: crmMeetings.auditData,
+    clientName: clients.leadName,
+    leadName: leads.name,
+    invokerName: users.name,
+    invokerRole: users.role,
+  };
+
+  const items = await db.select(selectShape)
+    .from(crmMeetings)
+    .leftJoin(clients, eq(crmMeetings.clientId, clients.id))
+    .leftJoin(leads, eq(crmMeetings.leadId, leads.id))
+    .leftJoin(users, eq(crmMeetings.ownerUserId, users.id))
+    .where(where)
+    .orderBy(desc(crmMeetings.createdAt))
+    .limit(limit)
+    .offset(offset);
+
+  const totalRows = await db.select({ value: count() })
+    .from(crmMeetings)
+    .leftJoin(clients, eq(crmMeetings.clientId, clients.id))
+    .leftJoin(leads, eq(crmMeetings.leadId, leads.id))
+    .leftJoin(users, eq(crmMeetings.ownerUserId, users.id))
+    .where(where);
+
+  return {
+    items: items.map((row: any) => ({
+      ...row,
+      clientName: row.clientName || row.leadName || null,
+      recordingMedia: recordingMedia(row.auditData),
+      auditData: undefined,
+    })),
+    total: Number(totalRows[0]?.value || 0),
+    limit,
+    offset,
+    scope: isAdmin ? "all" : "own",
+  };
+}
