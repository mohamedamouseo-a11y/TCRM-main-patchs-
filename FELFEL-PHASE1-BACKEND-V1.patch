+// FELFEL_PHASE1_CALENDAR_SYNC_V1
+// Mirrors the actual attended Felfel interval into the existing scoped TCRM calendar.
+// @ts-nocheck
+import { eq } from "drizzle-orm";
+import { getDb } from "../../db";
+import { clients, leads, users } from "../../../drizzle/schema";
+import {
+  createCalendarEvent,
+  findCalendarEventByFelfelMeetingId,
+  updateCalendarEvent,
+} from "../../googleCalendar";
+
+function asDate(value: unknown) {
+  if (!value) return null;
+  const date = value instanceof Date ? value : new Date(String(value));
+  return Number.isNaN(date.getTime()) ? null : date;
+}
+
+function displayTitle(rawTitle: unknown, clientName: string | null) {
+  const raw = String(rawTitle || "").trim();
+  const generic = !raw || ["felfel", "felfel meeting", "meeting"].includes(raw.toLowerCase());
+  const meetingTitle = generic ? (clientName ? `Meeting with ${clientName}` : "Meeting") : raw;
+  return `Felfel • ${meetingTitle}`;
+}
+
+export async function syncFelfelMeetingCalendar(meeting: any) {
+  const meetingId = Number(meeting?.id || 0);
+  if (!Number.isInteger(meetingId) || meetingId <= 0) return null;
+
+  const endedAt = asDate(meeting?.endedAt);
+  let startedAt = asDate(meeting?.startedAt);
+  if (!startedAt && endedAt && Number(meeting?.recordingDurationSec || 0) > 0) {
+    startedAt = new Date(endedAt.getTime() - Number(meeting.recordingDurationSec) * 1000);
+  }
+  if (!startedAt || !endedAt || startedAt.getTime() >= endedAt.getTime()) return null;
+
+  const db = await getDb();
+  if (!db) throw new Error("Database is not available");
+
+  const client = meeting.clientId
+    ? (await db.select({ leadName: clients.leadName }).from(clients).where(eq(clients.id, Number(meeting.clientId))).limit(1))[0]
+    : null;
+  const lead = meeting.leadId
+    ? (await db.select({ name: leads.name }).from(leads).where(eq(leads.id, Number(meeting.leadId))).limit(1))[0]
+    : null;
+  const invoker = meeting.ownerUserId
+    ? (await db.select({ name: users.name, email: users.email, role: users.role }).from(users).where(eq(users.id, Number(meeting.ownerUserId))).limit(1))[0]
+    : null;
+
+  const clientName = String(client?.leadName || lead?.name || "").trim() || null;
+  const invokerName = String(invoker?.name || "").trim() || `User #${meeting.ownerUserId || meeting.createdByUserId || "—"}`;
+  const invokerRole = String(invoker?.role || "").trim();
+  const summary = displayTitle(meeting.title, clientName);
+  const description = [
+    "Recorded by Felfel",
+    clientName ? `Client: ${clientName}` : "",
+    `Invoked by: ${invokerName}${invokerRole ? ` (${invokerRole})` : ""}`,
+    `CRM Meeting ID: ${meetingId}`,
+    meeting.platform ? `Platform: ${meeting.platform}` : "",
+  ].filter(Boolean).join("\n");
+
+  const payload = {
+    summary,
+    description,
+    startDateTime: startedAt.toISOString(),
+    endDateTime: endedAt.toISOString(),
+    attendees: invoker?.email ? [String(invoker.email)] : undefined,
+    leadId: Number(meeting.leadId || 0) || undefined,
+    clientId: Number(meeting.clientId || 0) || undefined,
+    leadName: clientName || undefined,
+    agentName: invokerName,
+    ownerUserId: Number(meeting.ownerUserId || meeting.createdByUserId || 0) || undefined,
+    felfelMeetingId: meetingId,
+  };
+
+  const existing = await findCalendarEventByFelfelMeetingId(meetingId);
+  if (existing?.id) return updateCalendarEvent(existing.id, payload);
+  return createCalendarEvent(payload);
+}
