+.tcrm-leads-filter-actions{display:grid!important;grid-template-columns:.9fr 1.1fr 1.1fr!important;align-items:end!important;gap:10px!important;min-width:0!important;margin:0!important;padding:0!important;border:0!important;align-self:end!important}
+.tcrm-leads-filter-actions>button,.tcrm-leads-filter-actions>div,.tcrm-leads-filter-actions>div>button{width:100%!important;min-width:0!important;max-width:100%!important}
+.tcrm-leads-filter-actions>button,.tcrm-leads-filter-actions>div>button{height:44px!important;min-height:44px!important;padding-inline:12px!important;border-radius:12px!important;font-size:11.5px!important;font-weight:650!important;white-space:nowrap!important}
