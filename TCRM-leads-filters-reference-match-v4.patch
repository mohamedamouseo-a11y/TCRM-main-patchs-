+.tcrm-leads-filter-grid>div:nth-child(7),.tcrm-leads-filter-grid>div:nth-child(8),.tcrm-leads-filter-grid>div:nth-child(9),.tcrm-leads-filter-grid>div:nth-child(10){grid-column:span 2!important}
+.tcrm-leads-filter-grid>div:nth-child(11){grid-column:span 4!important}
