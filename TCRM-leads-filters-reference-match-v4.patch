+/* TCRM Leads Filters Reference Match V4 — presentation only */
+.tcrm-leads-filter-card{border-radius:22px!important;border:1px solid hsl(var(--border)/.58)!important;background:hsl(var(--card))!important;box-shadow:0 14px 36px hsl(var(--foreground)/.055)!important}
