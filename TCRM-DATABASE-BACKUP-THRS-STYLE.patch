+function verifyOAuthState(value:string,actorId:any){const [payload,sig]=String(value||"").split("."),expected=crypto.createHmac("sha256",key()).update(payload||"").digest("hex").slice(0,32);if(!payload||!sig||sig!==expected)throw new TcrmDbBackupError("Invalid OAuth state",400);const v=JSON.parse(Buffer.from(payload,"base64url").toString("utf8"));if(v.exp<Date.now()||String(v.actorId)!==String(actorId))throw new TcrmDbBackupError("Expired OAuth state",400);}
+export async function finishTcrmDbBackupOAuth(code:string,stateValue:string,actorId:any){verifyOAuthState(stateValue,actorId);const c=await config(),a=oauth(c),r=await a.getToken(code);if(!r.tokens.refresh_token)throw new Error("Google did not return a refresh token");a.setCredentials(r.tokens);let email="";try{email=(await google.oauth2({version:"v2",auth:a}).userinfo.get()).data.email||""}catch{};c.googleDrive.refreshTokenEnc=enc(r.tokens.refresh_token);c.googleDrive.accountEmail=email;c.googleDrive.connectedAt=new Date().toISOString();await writeJson(CFG(),c);return publicCfg(c);}
+export async function disconnectTcrmDbBackup(){const c=await config();c.enabled=false;c.googleDrive.refreshTokenEnc="";c.googleDrive.accountEmail="";await writeJson(CFG(),c);return publicCfg(c);}
+export async function createTcrmDbBackup(actor?:any){const c=await config();if(!c.googleDrive.refreshTokenEnc)throw new TcrmDbBackupError("Google Drive is not connected",400);const now=new Date(),name=`TCRM_DB_${now.toISOString().replace("T","_").replace(/:/g,"-").replace(/\.\d{3}Z$/,"")}.sql.enc`,dir=path.join(TMP(),String(Date.now()));await ensureDir(dir);const sql=path.join(dir,"db.sql"),encrypted=path.join(dir,name);await writeJson(STATE(),{...(await state()),lastAttemptAt:now.toISOString(),lastError:""});try{await dump(sql);const meta=await encryptFile(sql,encrypted);const {drive,c:dc}=await driveClient(),f=await folder(drive,dc);const up=await drive.files.create({requestBody:{name,parents:[f]},media:{mimeType:"application/octet-stream",body:fs.createReadStream(encrypted)},fields:"id,name,size,createdTime,webViewLink"});await retention(drive,f);await writeJson(STATE(),{...(await state()),lastSuccessAt:now.toISOString(),lastError:"",lastBackupName:name});return {backup:up.data,sha256:meta.sha256};}catch(e:any){await writeJson(STATE(),{...(await state()),lastError:e?.message||"Backup failed"}).catch(()=>{});throw e;}finally{await fsp.rm(dir,{recursive:true,force:true}).catch(()=>{})}}
