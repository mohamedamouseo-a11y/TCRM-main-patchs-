,o={}){let x=await fetch(base+p,{credentials:"same-origin",headers:{"Content-Type":"application/json"},...o}),j=await x.json().catch(()=>({}));if(!x.ok)throw Error(j.error||"HTTP "+x.status);return j}async function load(){try{let x=await api("/status"),c=x.config,g=c.googleDrive;q("e").checked=c.enabled;q("t").value=c.scheduleTime;q("z").value=c.timeZone;q("ci").value=g.clientId||"";q("ru").value=g.redirectUri||location.origin+base+"/google-drive/callback";q("fn").value=g.folderName||"TCRM Database Backups";q("fi").value=g.folderId||"";q("em").value=g.accountEmail||(g.connected?"Connected":"Not connected");q("s").textContent="Encryption: "+(c.encryptionReady?"READY":"NOT CONFIGURED")+"\\nLast success: "+(x.state.lastSuccessAt||"—")+"\\nLast error: "+(x.state.lastError||"—");q("b").innerHTML=(x.backups||[]).map(v=>"<tr><td>"+v.name+"</td><td>"+(v.createdTime||"")+"</td><td>"+(v.size||"")+"</td><td>"+(v.webViewLink?'<a target=_blank href="'+v.webViewLink+'">Open</a>':"")+"</td></tr>").join("")}catch(e){q("m").textContent=e.message}}function p(){return{enabled:q("e").checked,scheduleTime:q("t").value,timeZone:q("z").value,googleDrive:{clientId:q("ci").value,clientSecret:q("cs").value,redirectUri:q("ru").value,folderName:q("fn").value,folderId:q("fi").value}}}q("save").onclick=async()=>{try{await api("/settings",{method:"PUT",body:JSON.stringify(p())});q("cs").value="";await load()}catch(e){q("m").textContent=e.message}};q("conn").onclick=async()=>{try{let x=p();x.enabled=false;await api("/settings",{method:"PUT",body:JSON.stringify(x)});let u=await api("/google-drive/auth-url");location.href=u.url}catch(e){q("m").textContent=e.message}};q("disc").onclick=async()=>{if(confirm("Disconnect backup Google Drive?")){await api("/google-drive/disconnect",{method:"DELETE"});load()}};q("now").onclick=async()=>{if(confirm("Create full encrypted database backup now?")){q("m").textContent="Backup running...";try{await api("/backup-now",{method:"POST"});q("m").textContent="Backup co