+// @ts-nocheck
+import crypto from "node:crypto";
+import fs from "node:fs";
+import { promises as fsp } from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { spawn } from "node:child_process";
+import { pipeline } from "node:stream/promises";
+import { Transform } from "node:stream";
+import { google } from "googleapis";
+
+const RETENTION_COUNT = 3;
+const CONFIG_VERSION = 1;
+const FILE_MAGIC = Buffer.from("TCRMDB01");
+const HEADER_MAX_BYTES = 16 * 1024;
+const BACKUP_PREFIX = "TCRM_DB_";
+const BACKUP_NAME_RE = /^TCRM_DB_\d{4}-\d{2}-\d{2}_\d{2}-\d{2}-\d{2}\.sql\.enc$/;
+const DRIVE_FOLDER_MIME = "application/vnd.google-apps.folder";
+const DRIVE_ID_RE = /^[A-Za-z0-9_-]{10,256}$/;
+const OAUTH_STATE_TTL_MS = 10 * 60 * 1000;
+const RESTORE_CONFIRMATION_TTL_MS = 10 * 60 * 1000;
+const OPERATION_LOCK_STALE_MS = 2 * 60 * 60 * 1000;
+const DRIVE_SCOPES = [
+  "https://www.googleapis.com/auth/drive.file",
+  "https://www.googleapis.com/auth/userinfo.email",
+];
+
+let schedulerTimer: NodeJS.Timeout | null = null;
+
+export class TcrmDatabaseBackupError extends Error {
+  statusCode: number;
+  code: string;
+  constructor(message: string, statusCode = 500, code = "TCRM_DATABASE_BACKUP_ERROR") {
+    super(message);
+    this.name = "TcrmDatabaseBackupError";
+    this.statusCode = statusCode;
+    this.code = code;
+  }
+}
+
+function cleanText(value: unknown, max = 1000) {
+  const text = String(value ?? "").trim();
+  return text ? text.slice(0, max) : "";
+}
+
+function getConfigDir() {
+  return path.resolve(
+    process.env.TCRM_DB_BACKUP_CONFIG_DIR
+      || path.join(process.cwd(), "storage", "database-backups"),
+  );
+}
+function getConfigPath() { return path.join(getConfigDir(), "config.json"); }
+function getStatePath() { return path.join(getConfigDir(), "state.json"); }
+function getAuditPath() { return path.join(getConfigDir(), "audit.jsonl"); }
+function getLockPath() { return path.join(getConfigDir(), "operation.lock"); }
+function getRestoreMarkerPath() { return path.join(getConfigDir(), "restore-in-progress.lock"); }
+function getTmpRoot() {
+  return path.resolve(process.env.TCRM_DB_BACKUP_TMP_DIR || path.join(os.tmpdir(), "tcrm-db-backups"));
+}
+
+function safeFolderName(value: unknown) {
+  const text = cleanText(value || "TCRM Database Backups", 120)
+    .replace(/[\\/:*?"<>|#{}%~&]/g, "-")
+    .replace(/\s+/g, " ")
+    .trim();
+  return text || "TCRM Database Backups";
+}
+
+function defaultConfig() {
+  return {
+    version: CONFIG_VERSION,
+    enabled: false,
+    scheduleTime: "02:00",
+    timeZone: "Africa/Cairo",
+    retentionCount: RETENTION_COUNT,
+    provider: "GOOGLE_DRIVE",
+    googleDrive: {
+      clientId: "",
+      clientSecretEnc: "",
+      redirectUri: "",
+      folderId: "",
+      folderName: "TCRM Database Backups",
+      refreshTokenEnc: "",
+      accountEmail: "",
+      connectedAt: null as string | null,
+    },
+  };
+}
+
+function defaultState() {
+  return {
+    lastAttemptAt: null as string | null,
+    lastSuccessAt: null as string | null,
+    lastError: "",
+    lastBackupName: "",
+    lastBackupSha256: "",
+    lastBackupSize: 0,
+    lastScheduledAttemptDate: "",
+    retentionOk: true,
+  };
+}
+
+async function ensurePrivateDir(dir: string) {
+  await fsp.mkdir(dir, { recursive: true, mode: 0o700 });
+  await fsp.chmod(dir, 0o700).catch(() => null);
+}
+
+async function readJson(filePath: string, fallback: any) {
+  try {
+    return { ...fallback, ...JSON.parse(await fsp.readFile(filePath, "utf8")) };
+  } catch (error: any) {
+    if (error?.code === "ENOENT") return { ...fallback };
+    throw new TcrmDatabaseBackupError(
+      `Cannot read database backup runtime file: ${path.basename(filePath)}`,
+      500,
+      "RUNTIME_FILE_READ_FAILED",
+    );
+  }
+}
+
+async function atomicWriteJson(filePath: string, value: any) {
+  await ensurePrivateDir(path.dirname(filePath));
+  const temp = `${filePath}.${process.pid}.${crypto.randomBytes(5).toString("hex")}.tmp`;
+  await fsp.writeFile(temp, `${JSON.stringify(value, null, 2)}\n`, { mode: 0o600 });
+  await fsp.rename(temp, filePath);
+}
+
+function normalizeScheduleTime(value: unknown) {
+  const text = cleanText(value, 5);
+  if (!/^([01]\d|2[0-3]):[0-5]\d$/.test(text)) {
+    throw new TcrmDatabaseBackupError("Schedule time must use HH:MM 24-hour format", 400, "INVALID_SCHEDULE_TIME");
+  }
+  return text;
+}
+
+function normalizeTimeZone(value: unknown) {
+  const text = cleanText(value || "Africa/Cairo", 100);
+  try {
+    new Intl.DateTimeFormat("en-US", { timeZone: text }).format(new Date());
+    return text;
+  } catch {
+    throw new TcrmDatabaseBackupError("Invalid IANA time zone", 400, "INVALID_TIME_ZONE");
+  }
+}
+
+function normalizeRedirectUri(value: unknown) {
+  const text = cleanText(value, 1000);
+  if (!text) return "";
+  let url: URL;
+  try { url = new URL(text); }
+  catch { throw new TcrmDatabaseBackupError("Invalid Google OAuth Redirect URI", 400, "INVALID_REDIRECT_URI"); }
+  if (process.env.NODE_ENV === "production" && url.protocol !== "https:") {
+    throw new TcrmDatabaseBackupError("Google OAuth Redirect URI must use HTTPS in production", 400, "INSECURE_REDIRECT_URI");
+  }
+  if (!["https:", "http:"].includes(url.protocol)) {
+    throw new TcrmDatabaseBackupError("Google OAuth Redirect URI must use HTTP(S)", 400, "INVALID_REDIRECT_URI");
+  }
+  url.hash = "";
+  return url.toString();
+}
+
+function normalizeFolderId(value: unknown, allowBlank = true) {
+  const text = cleanText(value, 300);
+  if (!text && allowBlank) return "";
+  if (!DRIVE_ID_RE.test(text)) {
+    throw new TcrmDatabaseBackupError("Invalid Google Drive folder ID", 400, "INVALID_FOLDER_ID");
+  }
+  return text;
+}
+
+async function readConfig() {
+  const stored = await readJson(getConfigPath(), defaultConfig());
+  const base = defaultConfig();
+  const drive = { ...base.googleDrive, ...(stored.googleDrive || {}) };
+  return {
+    ...base,
+    ...stored,
+    version: CONFIG_VERSION,
+    enabled: Boolean(stored.enabled),
+    retentionCount: RETENTION_COUNT,
+    provider: "GOOGLE_DRIVE",
+    scheduleTime: normalizeScheduleTime(stored.scheduleTime || base.scheduleTime),
+    timeZone: normalizeTimeZone(stored.timeZone || base.timeZone),
+    googleDrive: {
+      ...drive,
+      clientId: cleanText(drive.clientId, 300),
+      clientSecretEnc: cleanText(drive.clientSecretEnc, 12000),
+      redirectUri: normalizeRedirectUri(drive.redirectUri || ""),
+      folderId: normalizeFolderId(drive.folderId, true),
+      folderName: safeFolderName(drive.folderName),
+      refreshTokenEnc: cleanText(drive.refreshTokenEnc, 12000),
+      accountEmail: cleanText(drive.accountEmail, 320).toLowerCase(),
+      connectedAt: drive.connectedAt || null,
+    },
+  };
+}
+
+async function writeConfig(config: any) {
+  const base = defaultConfig();
+  const next = {
+    ...base,
+    ...config,
+    version: CONFIG_VERSION,
+    retentionCount: RETENTION_COUNT,
+    provider: "GOOGLE_DRIVE",
+    googleDrive: { ...base.googleDrive, ...(config.googleDrive || {}) },
+  };
+  await atomicWriteJson(getConfigPath(), next);
+  return readConfig();
+}
+
+async function readState() {
+  return readJson(getStatePath(), defaultState());
+}
+
+async function writeState(patch: any) {
+  const next = { ...(await readState()), ...patch };
+  await atomicWriteJson(getStatePath(), next);
+  return next;
+}
+
+async function appendAudit(entry: any) {
+  await ensurePrivateDir(getConfigDir());
+  const safe = {
+    at: new Date().toISOString(),
+    action: cleanText(entry.action, 80),
+    status: cleanText(entry.status, 30),
+    actorUserId: cleanText(entry.actorUserId, 100),
+    actorEmail: cleanText(entry.actorEmail, 320).toLowerCase(),
+    backupId: cleanText(entry.backupId, 300),
+    backupName: cleanText(entry.backupName, 300),
+    detail: cleanText(entry.detail, 1000),
+  };
+  await fsp.appendFile(getAuditPath(), `${JSON.stringify(safe)}\n`, { mode: 0o600 });
+}
+
+async function getRecentAudit(limit = 20) {
+  try {
+    const raw = await fsp.readFile(getAuditPath(), "utf8");
+    return raw.trim().split("\n").filter(Boolean).slice(-Math.min(Math.max(limit, 1), 50)).reverse().map((line) => {
+      try { return JSON.parse(line); } catch { return null; }
+    }).filter(Boolean);
+  } catch {
+    return [];
+  }
+}
+
+function getEncryptionKey() {
+  const configured = cleanText(process.env.TCRM_DB_BACKUP_ENCRYPTION_KEY, 1000);
+  if (!configured) {
+    throw new TcrmDatabaseBackupError(
+      "TCRM_DB_BACKUP_ENCRYPTION_KEY is not configured",
+      503,
+      "ENCRYPTION_KEY_MISSING",
+    );
+  }
+  let raw = Buffer.alloc(0);
+  if (/^[a-f0-9]{64}$/i.test(configured)) raw = Buffer.from(configured, "hex");
+  else {
+    try { raw = Buffer.from(configured, "base64"); } catch { raw = Buffer.alloc(0); }
+  }
+  if (raw.length !== 32) {
+    throw new TcrmDatabaseBackupError(
+      "TCRM_DB_BACKUP_ENCRYPTION_KEY must be exactly 32 bytes (64 hex chars or base64)",
+      503,
+      "ENCRYPTION_KEY_INVALID",
+    );
+  }
+  return raw;
+}
+
+function encryptionReady() {
+  try { getEncryptionKey(); return true; } catch { return false; }
+}
+
+function encryptionFingerprint() {
+  try { return crypto.createHash("sha256").update(getEncryptionKey()).digest("hex").slice(0, 16); }
+  catch { return ""; }
+}
+
+function encryptSecret(value: unknown) {
+  const plain = cleanText(value, 12000);
+  if (!plain) return "";
+  const iv = crypto.randomBytes(12);
+  const cipher = crypto.createCipheriv("aes-256-gcm", getEncryptionKey(), iv);
+  cipher.setAAD(Buffer.from("TCRM_DB_BACKUP_SECRET_V1"));
+  const encrypted = Buffer.concat([cipher.update(plain, "utf8"), cipher.final()]);
+  const tag = cipher.getAuthTag();
+  return `v1:${iv.toString("base64")}:${tag.toString("base64")}:${encrypted.toString("base64")}`;
+}
+
+function decryptSecret(value: unknown) {
+  const text = cleanText(value, 16000);
+  if (!text) return "";
+  const parts = text.split(":");
+  if (parts.length !== 4 || parts[0] !== "v1") {
+    throw new TcrmDatabaseBackupError("Stored backup secret has an invalid format", 500, "SECRET_FORMAT_INVALID");
+  }
+  const decipher = crypto.createDecipheriv("aes-256-gcm", getEncryptionKey(), Buffer.from(parts[1], "base64"));
+  decipher.setAAD(Buffer.from("TCRM_DB_BACKUP_SECRET_V1"));
+  decipher.setAuthTag(Buffer.from(parts[2], "base64"));
+  return Buffer.concat([decipher.update(Buffer.from(parts[3], "base64")), decipher.final()]).toString("utf8");
+}
+
+function secretUsable(value: unknown) {
+  try { return Boolean(value && encryptionReady() && decryptSecret(value)); } catch { return false; }
+}
+
+function publicConfig(config: any) {
+  return {
+    enabled: Boolean(config.enabled),
+    scheduleTime: config.scheduleTime,
+    timeZone: config.timeZone,
+    retentionCount: RETENTION_COUNT,
+    provider: "GOOGLE_DRIVE",
+    encryptionReady: encryptionReady(),
+    encryptionKeyFingerprint: encryptionFingerprint(),
+    googleDrive: {
+      clientId: config.googleDrive.clientId || "",
+      redirectUri: config.googleDrive.redirectUri || "",
+      folderId: config.googleDrive.folderId || "",
+      folderName: config.googleDrive.folderName || "TCRM Database Backups",
+      hasClientSecret: Boolean(config.googleDrive.clientSecretEnc),
+      clientSecretUsable: secretUsable(config.googleDrive.clientSecretEnc),
+      connected: secretUsable(config.googleDrive.refreshTokenEnc),
+      accountEmail: config.googleDrive.accountEmail || "",
+      connectedAt: config.googleDrive.connectedAt || null,
+    },
+  };
+}
+
+export async function saveTcrmDatabaseBackupSettings(input: any = {}) {
+  const current = await readConfig();
+  const next = JSON.parse(JSON.stringify(current));
+  let oauthChanged = false;
+
+  if (Object.prototype.hasOwnProperty.call(input, "enabled")) next.enabled = Boolean(input.enabled);
+  if (Object.prototype.hasOwnProperty.call(input, "scheduleTime")) next.scheduleTime = normalizeScheduleTime(input.scheduleTime);
+  if (Object.prototype.hasOwnProperty.call(input, "timeZone")) next.timeZone = normalizeTimeZone(input.timeZone);
+
+  const incoming = input.googleDrive && typeof input.googleDrive === "object" ? input.googleDrive : {};
+  if (Object.prototype.hasOwnProperty.call(incoming, "clientId")) {
+    const value = cleanText(incoming.clientId, 300);
+    if (value !== current.googleDrive.clientId) oauthChanged = true;
+    next.googleDrive.clientId = value;
+  }
+  if (Object.prototype.hasOwnProperty.call(incoming, "redirectUri")) {
+    const value = normalizeRedirectUri(incoming.redirectUri);
+    if (value !== current.googleDrive.redirectUri) oauthChanged = true;
+    next.googleDrive.redirectUri = value;
+  }
+  if (Object.prototype.hasOwnProperty.call(incoming, "folderId")) {
+    next.googleDrive.folderId = normalizeFolderId(incoming.folderId, true);
+  }
+  if (Object.prototype.hasOwnProperty.call(incoming, "folderName")) {
+    next.googleDrive.folderName = safeFolderName(incoming.folderName);
+  }
+
+  const action = cleanText(incoming.clientSecretAction || "keep", 20).toLowerCase();
+  if (!["keep", "set", "clear"].includes(action)) {
+    throw new TcrmDatabaseBackupError("Invalid Google client secret action", 400, "INVALID_SECRET_ACTION");
+  }
+  if (action === "set") {
+    const raw = cleanText(incoming.clientSecret, 4000);
+    if (!raw) throw new TcrmDatabaseBackupError("Google Client Secret is required", 400, "CLIENT_SECRET_REQUIRED");
+    const same = current.googleDrive.clientSecretEnc && decryptSecret(current.googleDrive.clientSecretEnc) === raw;
+    if (!same) oauthChanged = true;
+    next.googleDrive.clientSecretEnc = encryptSecret(raw);
+  } else if (action === "clear") {
+    if (current.googleDrive.clientSecretEnc) oauthChanged = true;
+    next.googleDrive.clientSecretEnc = "";
+  }
+
+  if (oauthChanged) {
+    next.googleDrive.refreshTokenEnc = "";
+    next.googleDrive.accountEmail = "";
+    next.googleDrive.connectedAt = null;
+  } else {
+    next.googleDrive.refreshTokenEnc = current.googleDrive.refreshTokenEnc;
+    next.googleDrive.accountEmail = current.googleDrive.accountEmail;
+    next.googleDrive.connectedAt = current.googleDrive.connectedAt;
+  }
+
+  if (next.enabled) {
+    if (!encryptionReady()) {
+      throw new TcrmDatabaseBackupError("Configure TCRM_DB_BACKUP_ENCRYPTION_KEY before enabling automatic backup", 409, "ENCRYPTION_NOT_READY");
+    }
+    if (!secretUsable(next.googleDrive.refreshTokenEnc)) {
+      throw new TcrmDatabaseBackupError("Connect the dedicated Google Drive before enabling automatic backup", 409, "DRIVE_NOT_CONNECTED");
+    }
+  }
+
+  return publicConfig(await writeConfig(next));
+}
+
+function parseDatabaseUrl() {
+  const raw = cleanText(process.env.DATABASE_URL, 4000);
+  if (!raw) throw new TcrmDatabaseBackupError("DATABASE_URL is not configured", 503, "DATABASE_URL_MISSING");
+  let url: URL;
+  try { url = new URL(raw); }
+  catch { throw new TcrmDatabaseBackupError("DATABASE_URL is invalid", 503, "DATABASE_URL_INVALID"); }
+  if (!["mysql:", "mysql2:"].includes(url.protocol)) {
+    throw new TcrmDatabaseBackupError("THRS-style TCRM backup requires a MySQL DATABASE_URL", 503, "DATABASE_URL_NOT_MYSQL");
+  }
+  const database = decodeURIComponent(url.pathname.replace(/^\/+/, ""));
+  if (!database) throw new TcrmDatabaseBackupError("DATABASE_URL database name is missing", 503, "DATABASE_NAME_MISSING");
+  return {
+    host: url.hostname || "127.0.0.1",
+    port: Number(url.port || 3306),
+    user: decodeURIComponent(url.username || ""),
+    password: decodeURIComponent(url.password || ""),
+    database,
+  };
+}
+
+function runCommand(bin: string, args: string[], options: any = {}) {
+  return new Promise<{ stdout: string; stderr: string }>((resolve, reject) => {
+    const child = spawn(bin, args, {
+      cwd: options.cwd || process.cwd(),
+      env: { ...process.env, ...(options.env || {}) },
+      stdio: [options.stdinPath ? "pipe" : "ignore", "pipe", "pipe"],
+      shell: false,
+    });
+    let stdout = "";
+    let stderr = "";
+    const max = Number(options.maxOutputBytes || 2 * 1024 * 1024);
+    child.stdout.on("data", (chunk) => { if (stdout.length < max) stdout += String(chunk).slice(0, max - stdout.length); });
+    child.stderr.on("data", (chunk) => { if (stderr.length < max) stderr += String(chunk).slice(0, max - stderr.length); });
+
+    let timer: NodeJS.Timeout | null = null;
+    if (options.timeoutMs) {
+      timer = setTimeout(() => child.kill("SIGKILL"), options.timeoutMs);
+      timer.unref?.();
+    }
+    if (options.stdinPath) {
+      const input = fs.createReadStream(options.stdinPath);
+      input.on("error", (error) => child.destroy(error));
+      input.pipe(child.stdin);
+    }
+    child.on("error", reject);
+    child.on("close", (code, signal) => {
+      if (timer) clearTimeout(timer);
+      if (code === 0) return resolve({ stdout, stderr });
+      reject(new TcrmDatabaseBackupError(
+        `${path.basename(bin)} failed (${code ?? signal ?? "unknown"}): ${cleanText(stderr || stdout, 1200)}`,
+        500,
+        "DATABASE_COMMAND_FAILED",
+      ));
+    });
+  });
+}
+
+function mysqlEnv(connection: any) {
+  return { MYSQL_PWD: connection.password || "" };
+}
+
+function mysqlBaseArgs(connection: any, includeDatabase = false) {
+  const args = [
+    "--protocol=TCP",
+    "--host", connection.host,
+    "--port", String(connection.port),
+    "--user", connection.user,
+    "--default-character-set=utf8mb4",
+  ];
+  if (includeDatabase) args.push("--database", connection.database);
+  return args;
+}
+
+async function createPlainDump(dumpPath: string) {
+  const connection = parseDatabaseUrl();
+  await ensurePrivateDir(path.dirname(dumpPath));
+  const bin = process.env.TCRM_MYSQLDUMP_BIN || "mysqldump";
+  const args = [
+    ...mysqlBaseArgs(connection, false),
+    "--single-transaction",
+    "--quick",
+    "--routines",
+    "--triggers",
+    "--events",
+    "--hex-blob",
+    "--skip-lock-tables",
+    `--result-file=${dumpPath}`,
+    connection.database,
+  ];
+  await runCommand(bin, args, { env: mysqlEnv(connection), timeoutMs: 30 * 60 * 1000 });
+  await fsp.chmod(dumpPath, 0o600).catch(() => null);
+  const stat = await fsp.stat(dumpPath);
+  if (stat.size < 1024) throw new TcrmDatabaseBackupError("Database dump is unexpectedly small", 500, "DUMP_TOO_SMALL");
+  return stat;
+}
+
+async function verifyPlainDump(dumpPath: string) {
+  const stat = await fsp.stat(dumpPath);
+  if (stat.size < 1024) throw new TcrmDatabaseBackupError("Database dump is unexpectedly small", 500, "DUMP_TOO_SMALL");
+  const handle = await fsp.open(dumpPath, "r");
+  try {
+    const size = Math.min(2 * 1024 * 1024, stat.size);
+    const buffer = Buffer.alloc(size);
+    await handle.read(buffer, 0, size, 0);
+    const sample = buffer.toString("utf8");
+    if (!/MySQL dump|MariaDB dump|CREATE TABLE|INSERT INTO/i.test(sample)) {
+      throw new TcrmDatabaseBackupError("Backup does not look like a valid MySQL dump", 500, "DUMP_VERIFY_FAILED");
+    }
+  } finally {
+    await handle.close();
+  }
+  return true;
+}
+
+async function sha256File(filePath: string) {
+  const hash = crypto.createHash("sha256");
+  await pipeline(
+    fs.createReadStream(filePath),
+    new Transform({ transform(chunk, _encoding, callback) { hash.update(chunk); callback(null, chunk); } }),
+    new Transform({ transform(_chunk, _encoding, callback) { callback(); } }),
+  );
+  return hash.digest("hex");
+}
+
+async function encryptDumpFile(plainPath: string, encryptedPath: string, createdAt: string) {
+  const cipherBody = `${encryptedPath}.cipher`;
+  const iv = crypto.randomBytes(12);
+  const cipher = crypto.createCipheriv("aes-256-gcm", getEncryptionKey(), iv);
+  const hash = crypto.createHash("sha256");
+  let plainSize = 0;
+  await pipeline(
+    fs.createReadStream(plainPath),
+    new Transform({ transform(chunk, _encoding, callback) { hash.update(chunk); plainSize += chunk.length; callback(null, chunk); } }),
+    cipher,
+    fs.createWriteStream(cipherBody, { mode: 0o600 }),
+  );
+  const header = {
+    version: 1,
+    createdAt,
+    format: "mysqldump_sql",
+    encryption: "AES-256-GCM",
+    iv: iv.toString("base64"),
+    tag: cipher.getAuthTag().toString("base64"),
+    sha256: hash.digest("hex"),
+    plainSize,
+  };
+  const headerBytes = Buffer.from(JSON.stringify(header), "utf8");
+  if (headerBytes.length > HEADER_MAX_BYTES) throw new TcrmDatabaseBackupError("Backup header is too large", 500, "HEADER_TOO_LARGE");
+  const length = Buffer.alloc(4);
+  length.writeUInt32BE(headerBytes.length, 0);
+  await fsp.writeFile(encryptedPath, Buffer.concat([FILE_MAGIC, length, headerBytes]), { mode: 0o600 });
+  await pipeline(fs.createReadStream(cipherBody), fs.createWriteStream(encryptedPath, { flags: "a", mode: 0o600 }));
+  await fsp.unlink(cipherBody).catch(() => null);
+  return header;
+}
+
+async function readEncryptedHeader(encryptedPath: string) {
+  const handle = await fsp.open(encryptedPath, "r");
+  try {
+    const prefix = Buffer.alloc(FILE_MAGIC.length + 4);
+    await handle.read(prefix, 0, prefix.length, 0);
+    if (!prefix.subarray(0, FILE_MAGIC.length).equals(FILE_MAGIC)) throw new TcrmDatabaseBackupError("Backup file magic is invalid", 400, "BACKUP_FORMAT_INVALID");
+    const headerLength = prefix.readUInt32BE(FILE_MAGIC.length);
+    if (headerLength <= 0 || headerLength > HEADER_MAX_BYTES) throw new TcrmDatabaseBackupError("Backup header length is invalid", 400, "BACKUP_FORMAT_INVALID");
+    const headerBytes = Buffer.alloc(headerLength);
+    await handle.read(headerBytes, 0, headerLength, prefix.length);
+    const header = JSON.parse(headerBytes.toString("utf8"));
+    return { header, dataOffset: prefix.length + headerLength };
+  } finally { await handle.close(); }
+}
+
+async function decryptBackupFile(encryptedPath: string, dumpPath: string) {
+  const { header, dataOffset } = await readEncryptedHeader(encryptedPath);
+  const decipher = crypto.createDecipheriv("aes-256-gcm", getEncryptionKey(), Buffer.from(header.iv, "base64"));
+  decipher.setAuthTag(Buffer.from(header.tag, "base64"));
+  await pipeline(fs.createReadStream(encryptedPath, { start: dataOffset }), decipher, fs.createWriteStream(dumpPath, { mode: 0o600 }));
+  await verifyPlainDump(dumpPath);
+  const digest = await sha256File(dumpPath);
+  const left = Buffer.from(digest);
+  const right = Buffer.from(String(header.sha256 || ""));
+  if (left.length !== right.length || !crypto.timingSafeEqual(left, right)) throw new TcrmDatabaseBackupError("Backup SHA-256 verification failed", 400, "BACKUP_HASH_MISMATCH");
+  return header;
+}
+
+function backupFileName(date = new Date()) {
+  return `${BACKUP_PREFIX}${date.toISOString().replace("T", "_").replace(/:/g, "-").replace(/\.\d{3}Z$/, "")}.sql.enc`;
+}
+
+async function getOAuthClient(config: any) {
+  if (!config.googleDrive.clientId || !secretUsable(config.googleDrive.clientSecretEnc) || !config.googleDrive.redirectUri) throw new TcrmDatabaseBackupError("Google OAuth Client ID, Client Secret and Redirect URI are required", 400, "GOOGLE_OAUTH_CONFIG_INCOMPLETE");
+  return new google.auth.OAuth2(config.googleDrive.clientId, decryptSecret(config.googleDrive.clientSecretEnc), config.googleDrive.redirectUri);
+}
+
+function signPayload(payload: any) {
+  const encoded = Buffer.from(JSON.stringify(payload)).toString("base64url");
+  const signature = crypto.createHmac("sha256", getEncryptionKey()).update(encoded).digest("base64url");
+  return `${encoded}.${signature}`;
+}
+
+function verifySignedPayload(token: string, purpose: string) {
+  const [encoded, supplied] = String(token || "").split(".");
+  if (!encoded || !supplied) throw new TcrmDatabaseBackupError("Signed token is invalid", 400, "SIGNED_TOKEN_INVALID");
+  const expected = crypto.createHmac("sha256", getEncryptionKey()).update(encoded).digest("base64url");
+  const left = Buffer.from(supplied); const right = Buffer.from(expected);
+  if (left.length !== right.length || !crypto.timingSafeEqual(left, right)) throw new TcrmDatabaseBackupError("Signed token is invalid", 400, "SIGNED_TOKEN_INVALID");
+  const payload = JSON.parse(Buffer.from(encoded, "base64url").toString("utf8"));
+  if (payload.purpose !== purpose || Number(payload.exp || 0) < Date.now()) throw new TcrmDatabaseBackupError("Signed token has expired", 400, "SIGNED_TOKEN_EXPIRED");
+  return payload;
+}
+
+export async function getTcrmDatabaseBackupGoogleAuthUrl(actor: any) {
+  const config = await readConfig();
+  if (!encryptionReady()) throw new TcrmDatabaseBackupError("Configure TCRM_DB_BACKUP_ENCRYPTION_KEY first", 409, "ENCRYPTION_NOT_READY");
+  const client = await getOAuthClient(config);
+  const state = signPayload({ purpose: "google-oauth", actorId: String(actor?.id || ""), exp: Date.now() + OAUTH_STATE_TTL_MS });
+  return { url: client.generateAuthUrl({ access_type: "offline", prompt: "consent", scope: DRIVE_SCOPES, state, include_granted_scopes: true }) };
+}
+
+export async function finishTcrmDatabaseBackupGoogleOAuth(code: string, state: string) {
+  verifySignedPayload(state, "google-oauth");
+  const config = await readConfig();
+  const client = await getOAuthClient(config);
+  const { tokens } = await client.getToken(cleanText(code, 3000));
+  const refreshToken = cleanText(tokens.refresh_token, 12000);
+  if (!refreshToken) throw new TcrmDatabaseBackupError("Google did not return a refresh token. Reconnect and grant offline access.", 400, "GOOGLE_REFRESH_TOKEN_MISSING");
+  client.setCredentials(tokens);
+  let accountEmail = "";
+  try {
+    const oauth2 = google.oauth2({ version: "v2", auth: client });
+    const me = await oauth2.userinfo.get();
+    accountEmail = cleanText(me.data.email, 320).toLowerCase();
+  } catch {}
+  config.googleDrive.refreshTokenEnc = encryptSecret(refreshToken);
+  config.googleDrive.accountEmail = accountEmail;
+  config.googleDrive.connectedAt = new Date().toISOString();
+  await writeConfig(config);
+  return publicConfig(await readConfig());
+}
+
+export async function disconnectTcrmDatabaseBackupGoogleDrive() {
+  const config = await readConfig();
+  config.enabled = false;
+  config.googleDrive.refreshTokenEnc = "";
+  config.googleDrive.accountEmail = "";
+  config.googleDrive.connectedAt = null;
+  await writeConfig(config);
+  return publicConfig(await readConfig());
+}
+
+async function getDriveClient() {
+  const config = await readConfig();
+  if (!secretUsable(config.googleDrive.refreshTokenEnc)) throw new TcrmDatabaseBackupError("Dedicated Google Drive is not connected", 400, "DRIVE_NOT_CONNECTED");
+  const oauth = await getOAuthClient(config);
+  oauth.setCredentials({ refresh_token: decryptSecret(config.googleDrive.refreshTokenEnc) });
+  return { drive: google.drive({ version: "v3", auth: oauth }), config };
+}
+
+async function resolveDriveFolder(drive: any, config: any, create = false) {
+  if (config.googleDrive.folderId) return config.googleDrive.folderId;
+  const name = safeFolderName(config.googleDrive.folderName);
+  const escaped = name.replace(/'/g, "\\'");
+  const list = await drive.files.list({ q: `name = '${escaped}' and mimeType = '${DRIVE_FOLDER_MIME}' and trashed = false`, fields: "files(id,name)", pageSize: 1 });
+  const found = list.data.files?.[0]?.id;
+  if (found) return found;
+  if (!create) return "";
+  const created = await drive.files.create({ requestBody: { name, mimeType: DRIVE_FOLDER_MIME }, fields: "id,name" });
+  if (!created.data.id) throw new TcrmDatabaseBackupError("Failed to create Google Drive backup folder", 500, "DRIVE_FOLDER_CREATE_FAILED");
+  config.googleDrive.folderId = created.data.id;
+  await writeConfig(config);
+  return created.data.id;
+}
+
+async function listDriveBackups(drive: any, folderId: string) {
+  if (!folderId) return [];
+  const files: any[] = [];
+  let pageToken: string | undefined;
+  do {
+    const result = await drive.files.list({ q: `'${folderId}' in parents and trashed = false`, fields: "nextPageToken,files(id,name,size,createdTime,modifiedTime,md5Checksum,webViewLink)", orderBy: "createdTime desc", pageSize: 100, pageToken });
+    for (const file of result.data.files || []) if (BACKUP_NAME_RE.test(String(file.name || ""))) files.push(file);
+    pageToken = result.data.nextPageToken || undefined;
+  } while (pageToken);
+  return files;
+}
+
+function publicBackup(file: any) {
+  return { id: file.id, name: file.name, size: Number(file.size || 0), createdAt: file.createdTime || null, modifiedAt: file.modifiedTime || null, md5Checksum: file.md5Checksum || null, webViewLink: file.webViewLink || null };
+}
+
+async function uploadBackup(drive: any, folderId: string, filePath: string, name: string) {
+  const result = await drive.files.create({ requestBody: { name, parents: [folderId] }, media: { mimeType: "application/octet-stream", body: fs.createReadStream(filePath) }, fields: "id,name,size,createdTime,modifiedTime,md5Checksum,webViewLink" });
+  if (!result.data.id) throw new TcrmDatabaseBackupError("Google Drive upload returned no file ID", 500, "DRIVE_UPLOAD_FAILED");
+  return result.data;
+}
+
+async function enforceRetention(drive: any, folderId: string, protectedIds: string[] = []) {
+  const backups = await listDriveBackups(drive, folderId);
+  const protectedSet = new Set(protectedIds.filter(Boolean));
+  const keep = new Set<string>();
+  for (const file of backups) if (keep.size < RETENTION_COUNT || protectedSet.has(String(file.id || ""))) keep.add(String(file.id || ""));
+  let deletedCount = 0;
+  for (const file of backups) {
+    const id = String(file.id || "");
+    if (!id || keep.has(id)) continue;
+    await drive.files.delete({ fileId: id });
+    deletedCount += 1;
+  }
+  return { kept: [...keep], deletedCount };
+}
+
+async function acquireOperationLock(action: string) {
+  await ensurePrivateDir(getConfigDir());
+  const lockPath = getLockPath();
+  try { const stat = await fsp.stat(lockPath); if (Date.now() - stat.mtimeMs > OPERATION_LOCK_STALE_MS) await fsp.unlink(lockPath).catch(() => null); } catch {}
+  let handle: any;
+  try { handle = await fsp.open(lockPath, "wx", 0o600); }
+  catch (error: any) { if (error?.code === "EEXIST") throw new TcrmDatabaseBackupError("Another database backup/restore operation is already running", 409, "OPERATION_IN_PROGRESS"); throw error; }
+  await handle.writeFile(JSON.stringify({ action, pid: process.pid, at: new Date().toISOString() }));
+  await handle.close();
+  return async () => { await fsp.unlink(lockPath).catch(() => null); };
+}
+
+async function createBackupInternal({ reason = "manual", actor = null, keepPlaintext = false, protectedFileIds = [] }: any = {}) {
+  const config = await readConfig();
+  if (!encryptionReady()) throw new TcrmDatabaseBackupError("Backup encryption key is not configured", 409, "ENCRYPTION_NOT_READY");
+  if (!secretUsable(config.googleDrive.refreshTokenEnc)) throw new TcrmDatabaseBackupError("Dedicated Google Drive is not connected", 400, "DRIVE_NOT_CONNECTED");
+  const createdAt = new Date().toISOString();
+  const runId = `${Date.now()}-${crypto.randomBytes(5).toString("hex")}`;
+  const tmpDir = path.join(getTmpRoot(), runId);
+  const dumpPath = path.join(tmpDir, "database.sql");
+  const encryptedPath = path.join(tmpDir, "database.sql.enc");
+  const name = backupFileName(new Date(createdAt));
+  await ensurePrivateDir(tmpDir);
+  await writeState({ lastAttemptAt: createdAt, lastError: "" });
+  try {
+    await createPlainDump(dumpPath);
+    await verifyPlainDump(dumpPath);
+    const header = await encryptDumpFile(dumpPath, encryptedPath, createdAt);
+    const { drive, config: liveConfig } = await getDriveClient();
+    const folderId = await resolveDriveFolder(drive, liveConfig, true);
+    const uploaded = await uploadBackup(drive, folderId, encryptedPath, name);
+    let retentionOk = true; let retentionDetail = "";
+    try { const retention = await enforceRetention(drive, folderId, [String(uploaded.id || ""), ...protectedFileIds]); retentionDetail = `retention kept=${retention.kept.length} deleted=${retention.deletedCount}`; }
+    catch (error: any) { retentionOk = false; retentionDetail = `retention cleanup failed: ${cleanText(error?.message, 300)}`; }
+    await writeState({ lastSuccessAt: createdAt, lastError: retentionOk ? "" : retentionDetail, lastBackupName: uploaded.name, lastBackupSha256: header.sha256, lastBackupSize: Number(uploaded.size || 0), retentionOk });
+    await appendAudit({ action: reason === "scheduled" ? "SCHEDULED_BACKUP" : reason === "pre_restore" ? "PRE_RESTORE_BACKUP" : "MANUAL_BACKUP", status: "PASS", actorUserId: actor?.id, actorEmail: actor?.email, backupId: uploaded.id, backupName: uploaded.name, detail: `${header.sha256}; ${retentionDetail}` });
+    await fsp.unlink(encryptedPath).catch(() => null);
+    if (!keepPlaintext) await fsp.rm(tmpDir, { recursive: true, force: true });
+    return { backup: publicBackup(uploaded), sha256: header.sha256, plainSize: header.plainSize, plainPath: keepPlaintext ? dumpPath : null, tmpDir: keepPlaintext ? tmpDir : null, retentionOk };
+  } catch (error: any) {
+    await writeState({ lastError: cleanText(error?.message, 800), retentionOk: false }).catch(() => null);
+    await appendAudit({ action: reason === "scheduled" ? "SCHEDULED_BACKUP" : reason === "pre_restore" ? "PRE_RESTORE_BACKUP" : "MANUAL_BACKUP", status: "FAIL", actorUserId: actor?.id, actorEmail: actor?.email, detail: error?.message }).catch(() => null);
+    await fsp.rm(tmpDir, { recursive: true, force: true }).catch(() => null);
+    throw error;
+  }
+}
+
+export async function createTcrmDatabaseBackup(options: any = {}) {
+  const release = await acquireOperationLock(options.reason || "backup");
+  try { return await createBackupInternal(options); } finally { await release(); }
+}
+
+async function downloadDriveBackup(fileId: string, destination: string) {
+  const { drive } = await getDriveClient();
+  const safeId = normalizeFolderId(fileId, false);
+  const metadata = await drive.files.get({ fileId: safeId, fields: "id,name,size,createdTime,modifiedTime,md5Checksum" });
+  if (!BACKUP_NAME_RE.test(String(metadata.data.name || ""))) throw new TcrmDatabaseBackupError("Selected Google Drive file is not a TCRM database backup", 400, "INVALID_BACKUP_FILE");
+  const response = await drive.files.get({ fileId: safeId, alt: "media" }, { responseType: "stream" });
+  await ensurePrivateDir(path.dirname(destination));
+  await pipeline(response.data as any, fs.createWriteStream(destination, { mode: 0o600 }));
+  return metadata.data;
+}
+
+async function executeMysql(sql: string, database?: string) {
+  const connection = parseDatabaseUrl();
+  const bin = process.env.TCRM_MYSQL_BIN || "mysql";
+  const args = mysqlBaseArgs(connection, false);
+  if (database) args.push("--database", database);
+  args.push("--batch", "--skip-column-names", "--execute", sql);
+  return runCommand(bin, args, { env: mysqlEnv(connection), timeoutMs: 10 * 60 * 1000 });
+}
+
+async function importDump(dumpPath: string, database: string) {
+  const connection = parseDatabaseUrl();
+  const bin = process.env.TCRM_MYSQL_BIN || "mysql";
+  await runCommand(bin, [...mysqlBaseArgs(connection, false), "--database", database], { env: mysqlEnv(connection), timeoutMs: 45 * 60 * 1000, stdinPath: dumpPath, maxOutputBytes: 4 * 1024 * 1024 });
+}
+
+function safeTempDatabaseName() { return `tcrm_restore_verify_${Date.now()}_${crypto.randomBytes(3).toString("hex")}`.replace(/[^a-z0-9_]/gi, "").slice(0, 60); }
+
+async function validateDumpInTemporaryDatabase(dumpPath: string) {
+  const database = safeTempDatabaseName();
+  try {
+    await executeMysql(`CREATE DATABASE \`${database}\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;`);
+    await importDump(dumpPath, database);
+    const result = await executeMysql(`SELECT COUNT(*) FROM information_schema.tables WHERE table_schema = '${database.replace(/'/g, "''")}' AND table_type='BASE TABLE';`);
+    const tableCount = Number(String(result.stdout || "").trim().split(/\s+/)[0] || 0);
+    if (!Number.isFinite(tableCount) || tableCount <= 0) throw new TcrmDatabaseBackupError("Temporary restore validation found no tables", 409, "RESTORE_VALIDATION_EMPTY");
+    return { tableCount };
+  } finally { await executeMysql(`DROP DATABASE IF EXISTS \`${database}\`;`).catch(() => null); }
+}
+
+function createRestoreConfirmation(actorId: unknown, fileId: string) {
+  return signPayload({ purpose: "restore-confirm", actorId: String(actorId || ""), fileId, exp: Date.now() + RESTORE_CONFIRMATION_TTL_MS });
+}
+
+export async function prepareTcrmDatabaseRestore(fileId: string, actor: any) {
+  const release = await acquireOperationLock("restore-prepare");
+  const tmpDir = path.join(getTmpRoot(), `prepare-${Date.now()}-${crypto.randomBytes(4).toString("hex")}`);
+  const encryptedPath = path.join(tmpDir, "backup.enc");
+  const dumpPath = path.join(tmpDir, "backup.sql");
+  try {
+    await ensurePrivateDir(tmpDir);
+    const file = await downloadDriveBackup(fileId, encryptedPath);
+    const header = await decryptBackupFile(encryptedPath, dumpPath);
+    const validation = await validateDumpInTemporaryDatabase(dumpPath);
+    await appendAudit({ action: "RESTORE_PREPARE", status: "PASS", actorUserId: actor?.id, actorEmail: actor?.email, backupId: file.id, backupName: file.name, detail: `tables=${validation.tableCount}; sha256=${header.sha256}` });
+    return { backup: publicBackup(file), tableCount: validation.tableCount, sha256: header.sha256, confirmationToken: createRestoreConfirmation(actor?.id, String(file.id || fileId)), confirmationText: "RESTORE", expiresInSeconds: Math.floor(RESTORE_CONFIRMATION_TTL_MS / 1000) };
+  } finally { await fsp.rm(tmpDir, { recursive: true, force: true }).catch(() => null); await release(); }
+}
+
+export function isTcrmDatabaseRestoreInProgress() { return fs.existsSync(getRestoreMarkerPath()); }
+
+export async function confirmTcrmDatabaseRestore({ fileId, confirmationToken, confirmationText, actor }: any) {
+  if (String(confirmationText || "") !== "RESTORE") throw new TcrmDatabaseBackupError("Type RESTORE exactly to confirm production database restore", 400, "RESTORE_CONFIRMATION_REQUIRED");
+  const payload = verifySignedPayload(String(confirmationToken || ""), "restore-confirm");
+  if (String(payload.actorId) !== String(actor?.id || "") || String(payload.fileId) !== String(fileId || "")) throw new TcrmDatabaseBackupError("Restore confirmation does not match this user or backup", 403, "RESTORE_CONFIRMATION_MISMATCH");
+  const release = await acquireOperationLock("restore");
+  const tmpDir = path.join(getTmpRoot(), `restore-${Date.now()}-${crypto.randomBytes(4).toString("hex")}`);
+  const encryptedPath = path.join(tmpDir, "target.enc");
+  const dumpPath = path.join(tmpDir, "target.sql");
+  let emergency: any = null; let markerCreated = false; let rollbackResult = "NOT_NEEDED";
+  try {
+    await ensurePrivateDir(tmpDir);
+    emergency = await createBackupInternal({ reason: "pre_restore", actor, keepPlaintext: true, protectedFileIds: [String(fileId || "")] });
+    const file = await downloadDriveBackup(String(fileId), encryptedPath);
+    const header = await decryptBackupFile(encryptedPath, dumpPath);
+    await validateDumpInTemporaryDatabase(dumpPath);
+    await ensurePrivateDir(getConfigDir());
+    await fsp.writeFile(getRestoreMarkerPath(), JSON.stringify({ at: new Date().toISOString(), actorId: actor?.id, backupId: fileId }), { mode: 0o600 });
+    markerCreated = true;
+    const production = parseDatabaseUrl();
+    try { await importDump(dumpPath, production.database); }
+    catch (restoreError) {
+      if (emergency?.plainPath) {
+        try { await importDump(emergency.plainPath, production.database); rollbackResult = "PASS"; }
+        catch { rollbackResult = "FAIL"; }
+      }
+      throw restoreError;
+    }
+    await appendAudit({ action: "RESTORE", status: "PASS", actorUserId: actor?.id, actorEmail: actor?.email, backupId: file.id, backupName: file.name, detail: `sha256=${header.sha256}; emergency=${emergency?.backup?.id || ""}` });
+    return { success: true, backup: publicBackup(file), emergencyBackup: emergency?.backup || null, rollbackResult };
+  } catch (error: any) {
+    await appendAudit({ action: "RESTORE", status: "FAIL", actorUserId: actor?.id, actorEmail: actor?.email, backupId: fileId, detail: `${cleanText(error?.message, 600)}; rollback=${rollbackResult}` }).catch(() => null);
+    throw error;
+  } finally {
+    if (markerCreated) await fsp.unlink(getRestoreMarkerPath()).catch(() => null);
+    await fsp.rm(tmpDir, { recursive: true, force: true }).catch(() => null);
+    if (emergency?.tmpDir) await fsp.rm(emergency.tmpDir, { recursive: true, force: true }).catch(() => null);
+    await release();
+  }
+}
+
+export async function getTcrmDatabaseBackupStatus() {
+  const config = await readConfig(); const state = await readState();
+  let backups: any[] = []; let driveError = "";
+  if (secretUsable(config.googleDrive.refreshTokenEnc)) {
+    try { const { drive, config: liveConfig } = await getDriveClient(); const folderId = await resolveDriveFolder(drive, liveConfig, false); backups = (await listDriveBackups(drive, folderId)).slice(0, 20).map(publicBackup); }
+    catch (error: any) { driveError = cleanText(error?.message, 800); }
+  }
+  return { config: publicConfig(config), state, backups, driveError, restoreInProgress: isTcrmDatabaseRestoreInProgress(), audit: await getRecentAudit(20), databaseEngine: "mysql", dumpBinary: process.env.TCRM_MYSQLDUMP_BIN || "mysqldump", restoreBinary: process.env.TCRM_MYSQL_BIN || "mysql" };
+}
+
+function localDateTimeParts(now: Date, timeZone: string) {
+  const parts = new Intl.DateTimeFormat("en-CA", { timeZone, year: "numeric", month: "2-digit", day: "2-digit", hour: "2-digit", minute: "2-digit", hourCycle: "h23" }).formatToParts(now);
+  const map = Object.fromEntries(parts.map((part) => [part.type, part.value]));
+  return { date: `${map.year}-${map.month}-${map.day}`, time: `${map.hour}:${map.minute}` };
+}
+function minutesOfDay(value: string) { const [h, m] = value.split(":").map(Number); return h * 60 + m; }
+
+async function schedulerTick() {
+  try {
+    const config = await readConfig();
+    if (!config.enabled || !secretUsable(config.googleDrive.refreshTokenEnc) || !encryptionReady() || isTcrmDatabaseRestoreInProgress()) return;
+    const state = await readState(); const local = localDateTimeParts(new Date(), config.timeZone);
+    if (state.lastScheduledAttemptDate === local.date) return;
+    if (minutesOfDay(local.time) < minutesOfDay(config.scheduleTime)) return;
+    await writeState({ lastScheduledAttemptDate: local.date });
+    await createTcrmDatabaseBackup({ reason: "scheduled" });
+  } catch (error: any) { console.error("[TCRM Database Backup] scheduled backup failed:", cleanText(error?.message, 500)); }
+}
+
+export function startTcrmDatabaseBackupScheduler() {
+  if (schedulerTimer) return schedulerTimer;
+  const first = setTimeout(() => schedulerTick().catch(() => null), 15_000); first.unref?.();
+  schedulerTimer = setInterval(() => schedulerTick().catch(() => null), 60_000); schedulerTimer.unref?.();
+  return schedulerTimer;
+}
