+const clean=(v:any,n=12000)=>String(v??"").trim().slice(0,n);
+async function ensureDir(d:string){ await fsp.mkdir(d,{recursive:true,mode:0o700}); }
+async function readJson(p:string,f:any){ try{return {...f,...JSON.parse(await fsp.readFile(p,"utf8"))};}catch(e:any){if(e?.code==="ENOENT")return {...f};throw e;} }
