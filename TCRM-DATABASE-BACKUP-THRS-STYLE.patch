+function dbUrl(){const raw=process.env.DATABASE_URL||process.env.MYSQL_URL;if(!raw)throw new TcrmDbBackupError("DATABASE_URL is not configured",503);const u=new URL(raw);if(!/^mysql/.test(u.protocol))throw new TcrmDbBackupError("TCRM database URL is not MySQL/MariaDB",500);return {host:u.hostname,port:u.port||"3306",user:decodeURIComponent(u.username),password:decodeURIComponent(u.password),database:u.pathname.replace(/^\//,"")};}
