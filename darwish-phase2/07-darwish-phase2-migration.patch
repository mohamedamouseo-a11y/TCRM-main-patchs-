+CREATE TABLE IF NOT EXISTS darwish_intelligence (
+  id BIGINT NOT NULL AUTO_INCREMENT,
+  source_job_id BIGINT NOT NULL,
+  client_id BIGINT NULL,
+  group_jid VARCHAR(255) NOT NULL,
+  group_name VARCHAR(255) NULL,
+  evolution_instance VARCHAR(160) NOT NULL,
+  chatwoot_conversation_id VARCHAR(255) NULL,
+  mapping_status VARCHAR(32) NULL,
+  summary TEXT NOT NULL,
+  sentiment ENUM('positive','neutral','negative','mixed') NOT NULL DEFAULT 'neutral',
+  urgency ENUM('low','medium','high','critical') NOT NULL DEFAULT 'low',
+  complaint_detected TINYINT(1) NOT NULL DEFAULT 0,
+  issue_categories JSON NULL,
+  issues JSON NULL,
+  customer_needs JSON NULL,
+  risks JSON NULL,
+  recommended_actions JSON NULL,
+  escalation_required TINYINT(1) NOT NULL DEFAULT 0,
+  escalation_reason TEXT NULL,
+  provider VARCHAR(80) NULL,
+  model VARCHAR(160) NULL,
+  latency_ms INT NULL,
+  analysis_version VARCHAR(64) NOT NULL,
+  generated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
+  created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
+  updated_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
+  PRIMARY KEY (id),
+  UNIQUE KEY uq_darwish_intelligence_source_job (source_job_id),
+  KEY idx_darwish_intelligence_client (client_id, generated_at),
+  KEY idx_darwish_intelligence_urgency (urgency, generated_at),
+  KEY idx_darwish_intelligence_complaint (complaint_detected, generated_at),
+  KEY idx_darwish_intelligence_escalation (escalation_required, generated_at)
+) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci;
