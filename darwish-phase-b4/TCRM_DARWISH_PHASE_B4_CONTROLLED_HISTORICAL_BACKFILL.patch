+describe("Darwish Phase B4 controlled historical backfill safety", () => {
+  it("requires the exact explicit write confirmation and bounds the batch size", async () => {
+    const module = await import("./darwishHistoricalBackfillService");
+    expect(() => module.normalizeDarwishHistoricalBackfillBatchInput({
+      cutoffSourceRowId: 100,
+      confirmation: "wrong",
+    })).toThrow(/confirmation required/i);
+    expect(module.normalizeDarwishHistoricalBackfillBatchInput({
+      cutoffSourceRowId: 100,
+      afterSourceRowId: 10,
+      limit: 9999,
+      confirmation: module.DARWISH_PHASE_B4_CONFIRMATION,
+    })).toEqual({ cutoffSourceRowId: 100, afterSourceRowId: 10, limit: 500 });
+  });
+
+  it("derives sender role conservatively from proven direction and group context", async () => {
+    const module = await import("./darwishHistoricalBackfillService");
+    expect(module.classifyDarwishHistoricalSenderRole("outbound", false)).toBe("business");
+    expect(module.classifyDarwishHistoricalSenderRole("inbound", false)).toBe("customer");
+    expect(module.classifyDarwishHistoricalSenderRole("inbound", true)).toBe("participant");
+    expect(module.classifyDarwishHistoricalSenderRole("unknown", true)).toBe("unknown");
+  });
+
+  it("rejects invalid or completed cursors before any write path can run", async () => {
+    const module = await import("./darwishHistoricalBackfillService");
+    expect(() => module.normalizeDarwishHistoricalBackfillBatchInput({
+      cutoffSourceRowId: 100,
+      afterSourceRowId: 100,
+      confirmation: module.DARWISH_PHASE_B4_CONFIRMATION,
+    })).toThrow(/cursor must be lower than cutoff/i);
+    expect(() => module.normalizeDarwishHistoricalBackfillBatchInput({
+      cutoffSourceRowId: 0,
+      confirmation: module.DARWISH_PHASE_B4_CONFIRMATION,
+    })).toThrow(/invalid.*cutoff/i);
+  });
+});
diff --git a/server/services/darwish/chatwoot/darwishHistoricalBackfillService.ts b/server/services/darwish/chatwoot/darwishHistoricalBackfillService.ts
