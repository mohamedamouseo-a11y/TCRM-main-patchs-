--- /dev/null
+++ b/shared/globalSearchScope.ts
@@ -0,0 +1,19 @@
+export const GLOBAL_SEARCH_CLIENT_LIMIT = 6;
+
+const CLIENT_GLOBAL_SEARCH_ROLES = new Set([
+  "admin",
+  "salesmanager",
+  "accountmanager",
+  "accountmanagerlead",
+]);
+
+/**
+ * Keep client expansion in Global Search deliberately narrower than the
+ * application-wide search shell. The actual records still come from the
+ * existing scoped accountManagement.listClients procedure; this gate prevents
+ * roles that do not use Account Management from making unnecessary requests.
+ */
+export function canIncludeClientsInGlobalSearch(role: unknown): boolean {
+  const normalizedRole = String(role ?? "").trim().toLowerCase();
+  return CLIENT_GLOBAL_SEARCH_ROLES.has(normalizedRole);
+}
diff --git a/shared/globalSearchScope.test.ts b/shared/globalSearchScope.test.ts
--- /dev/null
+++ b/shared/globalSearchScope.test.ts
@@ -0,0 +1,34 @@
+import { describe, expect, it } from "vitest";
+import {
+  canIncludeClientsInGlobalSearch,
+  GLOBAL_SEARCH_CLIENT_LIMIT,
+} from "./globalSearchScope";
+
+describe("global search client scope", () => {
+  it.each([
+    "Admin",
+    "admin",
+    "SalesManager",
+    "AccountManager",
+    "AccountManagerLead",
+  ])("allows the known Account Management role %s", role => {
+    expect(canIncludeClientsInGlobalSearch(role)).toBe(true);
+  });
+
+  it.each([
+    "MediaBuyer",
+    "SalesAgent",
+    "ServiceAdvisor",
+    "PartsAgent",
+    "CrmFollowUp",
+    "Moderator",
+    "",
+  ])("does not add client search for unrelated role %s", role => {
+    expect(canIncludeClientsInGlobalSearch(role)).toBe(false);
+  });
+
+  it("keeps the client result fan-out bounded", () => {
+    expect(GLOBAL_SEARCH_CLIENT_LIMIT).toBeGreaterThan(0);
+    expect(GLOBAL_SEARCH_CLIENT_LIMIT).toBeLessThanOrEqual(8);
+  });
+});
