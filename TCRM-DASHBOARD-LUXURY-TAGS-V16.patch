--- /dev/null
+++ b/client/src/dashboard-premium-luminous-v16.css
@@ -0,0 +1,138 @@
+/* TCRM Dashboard Premium Luminous V16
+   Luxury Hot/Warm/Cold/Bad/Unknown lead-quality chips.
+   Visual-only: replaces emoji treatment with restrained Lucide jewel badges.
+*/
+
+.tcrm-premium-dashboard .lead-quality-premium {
+  --quality-rgb: 100, 116, 139;
+  --quality-ink: #475569;
+  --quality-a: rgba(255,255,255,.98);
+  --quality-b: rgba(241,245,249,.90);
+  position: relative;
+  isolation: isolate;
+  overflow: hidden;
+  gap: 6px !important;
+  min-height: 24px;
+  border-radius: 999px !important;
+  border: 1px solid rgba(var(--quality-rgb), .24) !important;
+  background: linear-gradient(145deg, var(--quality-a), var(--quality-b)) !important;
+  color: var(--quality-ink) !important;
+  font-weight: 650 !important;
+  letter-spacing: -.01em;
+  box-shadow:
+    inset 0 1px 0 rgba(255,255,255,.95),
+    0 7px 18px -14px rgba(var(--quality-rgb), .72),
+    0 1px 3px rgba(15,23,42,.05) !important;
+  backdrop-filter: blur(10px) saturate(130%);
+  -webkit-backdrop-filter: blur(10px) saturate(130%);
+  transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease, filter .2s ease;
+}
+
+.tcrm-premium-dashboard .lead-quality-premium::before {
+  content: "";
+  position: absolute;
+  inset: 1px 14% auto;
+  height: 1px;
+  border-radius: 999px;
+  background: linear-gradient(90deg, transparent, rgba(255,255,255,.92), transparent);
+  pointer-events: none;
+}
+
+.tcrm-premium-dashboard .lead-quality-premium:hover {
+  transform: translateY(-1px);
+  border-color: rgba(var(--quality-rgb), .38) !important;
+  box-shadow:
+    inset 0 1px 0 rgba(255,255,255,.98),
+    0 10px 22px -15px rgba(var(--quality-rgb), .80) !important;
+  filter: saturate(1.05);
+}
+
+.tcrm-premium-dashboard .lead-quality-premium-icon-shell {
+  display: inline-grid;
+  place-items: center;
+  flex: 0 0 auto;
+  width: 17px;
+  height: 17px;
+  border-radius: 999px;
+  border: 1px solid rgba(var(--quality-rgb), .25);
+  background:
+    radial-gradient(circle at 32% 24%, rgba(255,255,255,.98) 0 8%, transparent 9%),
+    linear-gradient(145deg, rgba(255,255,255,.94), rgba(var(--quality-rgb), .13));
+  color: var(--quality-ink);
+  box-shadow:
+    inset 0 1px 0 rgba(255,255,255,.96),
+    0 3px 8px -6px rgba(var(--quality-rgb), .90);
+}
+
+.tcrm-premium-dashboard .lead-quality-premium-icon {
+  width: 10.5px;
+  height: 10.5px;
+  color: currentColor !important;
+}
+
+.tcrm-premium-dashboard .lead-quality-premium.lead-quality-hot {
+  --quality-rgb: 244, 92, 67;
+  --quality-ink: #c2412d;
+  --quality-a: rgba(255,251,247,.99);
+  --quality-b: rgba(255,237,226,.91);
+}
+
+.tcrm-premium-dashboard .lead-quality-premium.lead-quality-warm {
+  --quality-rgb: 217, 158, 34;
+  --quality-ink: #946200;
+  --quality-a: rgba(255,253,244,.99);
+  --quality-b: rgba(255,246,207,.91);
+}
+
+.tcrm-premium-dashboard .lead-quality-premium.lead-quality-cold {
+  --quality-rgb: 59, 130, 246;
+  --quality-ink: #2459b8;
+  --quality-a: rgba(248,252,255,.99);
+  --quality-b: rgba(224,242,254,.91);
+}
+
+.tcrm-premium-dashboard .lead-quality-premium.lead-quality-bad {
+  --quality-rgb: 225, 70, 94;
+  --quality-ink: #b42346;
+  --quality-a: rgba(255,249,250,.99);
+  --quality-b: rgba(255,228,233,.91);
+}
+
+.tcrm-premium-dashboard .lead-quality-premium.lead-quality-unknown {
+  --quality-rgb: 124, 58, 237;
+  --quality-ink: #5b21b6;
+  --quality-a: rgba(250,249,255,.99);
+  --quality-b: rgba(237,233,254,.91);
+}
+
+.dark .tcrm-premium-dashboard .lead-quality-premium {
+  background:
+    linear-gradient(145deg, rgba(var(--quality-rgb), .14), rgba(15,23,42,.90)) !important;
+  border-color: rgba(var(--quality-rgb), .30) !important;
+  color: #e2e8f0 !important;
+  box-shadow:
+    inset 0 1px 0 rgba(255,255,255,.07),
+    0 9px 22px -16px rgba(var(--quality-rgb), .68) !important;
+}
+
+.dark .tcrm-premium-dashboard .lead-quality-premium::before {
+  opacity: .32;
+}
+
+.dark .tcrm-premium-dashboard .lead-quality-premium-icon-shell {
+  border-color: rgba(var(--quality-rgb), .38);
+  background:
+    radial-gradient(circle at 32% 24%, rgba(255,255,255,.28) 0 7%, transparent 8%),
+    linear-gradient(145deg, rgba(var(--quality-rgb), .28), rgba(15,23,42,.76));
+  color: rgb(var(--quality-rgb));
+  box-shadow:
+    inset 0 1px 0 rgba(255,255,255,.10),
+    0 0 12px rgba(var(--quality-rgb), .12);
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .tcrm-premium-dashboard .lead-quality-premium {
+    transition: none !important;
+    transform: none !important;
+  }
+}
